mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkCtxGrant(): ToolCtx {
    var c = mkCtx()
    c.grant(PERM_FS_WRITE())
    return c
}

test "fs metadata size and hash" {
    mkFile("build/tt/m.kf", "12345\n")
    var r = toolExec(defaultRegistry(), mkCtx(), ToolCall("fs.metadata", "t4", "build/tt/m.kf", "", 0))
    assert(r.data.contains("\"size\":6"))
}
main() {
}
