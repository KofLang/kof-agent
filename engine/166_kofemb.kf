// E8b: head treinavel (logistico, softmax-CE, SGD int64-micro) SOBRE os
// embeddings CONGELADOS do TinyLlama (transfer learning real em Kof puro).
// feature h = media dos rows token_embd dos ids do prompt (nano, dim=cfg.embd),
// normalizada na esfera micro. score_c = dot(h, w_c)/1e6 + bias_c — 3 classes
// (EXECUTE/ASK/REFUSE). custo por exemplo = milissegundos (vs ~100s do forward).
// Layout KFEH v1: 'KFEH'(4) ver(1) e i32(4) crc i32(4) | pesos 3*e i64 | bias 3 i64.
//
// PERFORMANCE (medido nesta maquina, kof 0.4.0 native): String.charAt/length/
// substring sao O(posicao) — charAt em janela alta custa ~50us, e substring de
// 314B num txt de 191KB levou 200s. Regra: o texto cru so e tocado por
// splitStr (em C, linear). Todo parse roda sobre a linha pequena.

record KofEmbModel(Int e, Long[] w, Long[] bias)

KOFEMB_MICRO(): Long { return 1000000 }

kofEmbInit(Int e): KofEmbModel {
    var w = new Long[e * 3]
    var i = 0
    while (i < e * 3) {
        w[i] = 0
        i = i + 1
    }
    return KofEmbModel(e, w, new Long[3])
}

kofEmbReady(KofEmbModel m): Bool { return m.e > 0 && m.w.length == m.e * 3 }

// ids -> feature NA BASE CONGELADA, normalizada p/ esfera unitaria (micro).
// sem normalizar, tokens raros (norm enorme) dominam o mean-pool e destroem
// a separacao entre classes (medido: conf=1000 na classe errada).
kofEmbFeature(KofLmWeights W, KofLmCfg cfg, Int[] ids, Long[] h) {
    var e = cfg.embd
    var i = 0
    while (i < e) {
        h[i] = 0
        i = i + 1
    }
    if (ids.length == 0) {
        return
    }
    var t = 0
    while (t < ids.length) {
        var tok = ids[t]
        if (tok < 0) {
            tok = 0
        }
        if (tok >= cfg.vocab) {
            tok = cfg.vocab - 1
        }
        var base = tok * e
        i = 0
        while (i < e) {
            h[i] = h[i] + W.embd[base + i]
            i = i + 1
        }
        t = t + 1
    }
    i = 0
    while (i < e) {
        h[i] = h[i] / ids.length
        i = i + 1
    }
    // micro p/ caber no isqrt: hm = h/1000
    var sq: Long = 0
    i = 0
    while (i < e) {
        var hm = h[i] / 1000
        sq = sq + hm * hm / 1000000
        i = i + 1
    }
    var norm = kofLmIsqrt(sq)
    if (norm < 1) {
        norm = 1
    }
    i = 0
    while (i < e) {
        h[i] = (h[i] / 1000) * 1000000 / norm
        i = i + 1
    }
}

// scores micro (3) — h micro, w micro => dot/1e6 = micro
kofEmbScores(KofEmbModel m, Long[] h): Long[] {
    var out = new Long[3]
    var c = 0
    while (c < 3) {
        var acc: Long = 0
        var off = c * m.e
        var i = 0
        while (i < m.e) {
            acc = acc + h[i] * m.w[off + i] / 1000000
            i = i + 1
        }
        out[c] = acc + m.bias[c]
        c = c + 1
    }
    return out
}

kofEmbSoftmaxMicro(Long[] sc, Long[] p) {
    var mx = sc[0]
    if (sc[1] > mx) {
        mx = sc[1]
    }
    if (sc[2] > mx) {
        mx = sc[2]
    }
    var sum: Long = 0
    var c = 0
    while (c < 3) {
        p[c] = kofLmExpMicro(sc[c] - mx)
        sum = sum + p[c]
        c = c + 1
    }
    c = 0
    while (c < 3) {
        p[c] = p[c] * 1000000 / sum
        c = c + 1
    }
}

// um passo SGD — g = (y - p) micro; w += g * h / 1e6 * lr / 1e6 (micro)
kofEmbTrainStep(KofEmbModel m, Long[] h, Int gold, Long lrMicro) {
    var sc = kofEmbScores(m, h)
    var p = new Long[3]
    kofEmbSoftmaxMicro(sc, p)
    var c = 0
    while (c < 3) {
        var y: Long = 0
        if (c == gold) {
            y = 1000000
        }
        var g = y - p[c]
        var off = c * m.e
        var i = 0
        while (i < m.e) {
            m.w[off + i] = m.w[off + i] + (g * h[i] / 1000000) * lrMicro / 1000000
            i = i + 1
        }
        m.bias[c] = m.bias[c] + g * lrMicro / 1000000
        c = c + 1
    }
}

kofEmbPredict(KofEmbModel m, Long[] h): Int {
    var sc = kofEmbScores(m, h)
    var best = 0
    if (sc[1] > sc[best]) {
        best = 1
    }
    if (sc[2] > sc[best]) {
        best = 2
    }
    return best
}

// confianca da classe vencedora em micro
kofEmbConf(KofEmbModel m, Long[] h): Long {
    var sc = kofEmbScores(m, h)
    var p = new Long[3]
    kofEmbSoftmaxMicro(sc, p)
    return p[kofEmbPredict(m, h)]
}

// --------- parse de jsonl sobre linhas pequenas ---------

// le o arquivo UMA vez; splitStr roda em C, linear no tamanho.
kofEmbLines(String path): List<String> {
    var f = File(path)
    if (!f.exists()) {
        return listOf<String>()
    }
    return splitStr(f.readText(), "\n")
}

// campo "key":"valor" da linha (escapes \" viram o char cru)
kflJsonFieldLn(String ln, String key): String {
    var at = ln.indexOf("\"" + key + "\"")
    if (at < 0) {
        return ""
    }
    var i = at + key.length + 2
    var n2 = ln.length
    while (i < n2 && (ln.charAt(i) == 32 || ln.charAt(i) == 58)) {
        i = i + 1
    }
    if (i >= n2 || ln.charAt(i) != 34) {
        return ""
    }
    i = i + 1
    var out = ""
    while (i < n2) {
        var ch = ln.charAt(i)
        if (ch == 92) {
            if (i + 1 < n2) {
                out = out + ln.substring(i + 1, i + 2)
            }
            i = i + 2
        } else {
            if (ch == 34) {
                return out
            }
            out = out + ln.substring(i, i + 1)
            i = i + 1
        }
    }
    return out
}

// gold na linha: "action" (treino) ou "expected_action" (eval). E=0 A=1 R=2.
kflLabelLn(String ln): Int {
    var at = ln.indexOf("\"action\"")
    var off = 8
    if (at < 0) {
        at = ln.indexOf("\"expected_action\"")
        off = 17
    }
    if (at < 0) {
        return 0 - 1
    }
    var i = at + off
    var n2 = ln.length
    while (i < n2 && (ln.charAt(i) == 32 || ln.charAt(i) == 58)) {
        i = i + 1
    }
    if (i >= n2 || ln.charAt(i) != 34) {
        return 0 - 1
    }
    var c = ln.charAt(i + 1)
    if (c == 69) {
        return 0
    }
    if (c == 65) {
        return 1
    }
    if (c == 82) {
        return 2
    }
    return 0 - 1
}

// --------- contexto (indice de vocab + linhas ja partidas) ---------
//
// O idx cacheado importa: sem ele, kofLmTokEncode re-construa a tabela de
// 32k por linha = 12GB de garbage num epoch (OOM medido 15.4GB anon).
record KofEmbCtx(KofLmTokIndex idx, List<String> lines)

kofEmbCtxNew(String[] tokens): KofEmbCtx {
    return KofEmbCtx(kofLmTokIndexBuild(tokens), listOf<String>())
}

kofEmbCtxFile(String[] tokens, String path): KofEmbCtx {
    return KofEmbCtx(kofLmTokIndexBuild(tokens), kofEmbLines(path))
}

// treina epochs sobre ctx.lines (v4: instruction+action). retorna vistos.
// se ctx nao trouxer linhas, le path 1x.
kofEmbTrainFileC(KofEmbModel m, KofLmWeights W, KofLmCfg cfg, KofEmbCtx ctx, String path, Int epochs, Long lrMicro): Int {
    var lines = ctx.lines
    if (lines.size() == 0) {
        lines = kofEmbLines(path)
    }
    var seen = 0
    var e = 0
    var h = new Long[cfg.embd]
    var n = lines.size()
    while (e < epochs) {
        var li = 0
        while (li < n) {
            var ln = lines.get(li)
            li = li + 1
            if (ln.length < 13) {
                continue
            }
            var gold = kflLabelLn(ln)
            if (gold < 0) {
                continue
            }
            var ins = kflJsonFieldLn(ln, "instruction")
            if (ins.length == 0) {
                continue
            }
            var ids = kofLmTokEncodeIdx(ctx.idx, ins, 1)
            kofEmbFeature(W, cfg, ids, h)
            kofEmbTrainStep(m, h, gold, lrMicro)
            seen = seen + 1
        }
        e = e + 1
    }
    return seen
}

// eval honesto: abster por conf < confMinMilli (0..1000); conta no total
kofEmbEvalFileC(KofEmbModel m, KofLmWeights W, KofLmCfg cfg, KofEmbCtx ctx, String path, Long confMinMilli): String {
    var lines = ctx.lines
    if (lines.size() == 0) {
        lines = kofEmbLines(path)
    }
    var total = 0
    var ok = 0
    var perguntou = 0
    var chute = 0
    var h = new Long[cfg.embd]
    var n = lines.size()
    var li = 0
    while (li < n) {
        var ln = lines.get(li)
        li = li + 1
        if (li % 50 == 0) { embT("eval li=" + li) }
        if (ln.length < 13) {
            continue
        }
        var gold = kflLabelLn(ln)
        if (gold < 0) {
            continue
        }
        var ins = kflJsonFieldLn(ln, "instruction")
        if (ins.length == 0) {
            continue
        }
        total = total + 1
        var ids = kofLmTokEncodeIdx(ctx.idx, ins, 1)
        kofEmbFeature(W, cfg, ids, h)
        var p = kofEmbPredict(m, h)
        var conf = kofEmbConf(m, h) * 1000 / 1000000
        if (conf >= confMinMilli) {
            perguntou = perguntou + 1
            if (p == gold) {
                ok = ok + 1
            } else {
                chute = chute + 1
            }
        }
    }
    return "total=" + total + " acc=" + ok * 100 / (total + 1) + "% chute=" + chute * 100 / (total + 1) + "% perguntou=" + perguntou
}

// wrappers da API lenta antiga (reconstrui idx; le 1x)
kofEmbTrainFile(KofEmbModel m, KofLmWeights W, KofLmCfg cfg, String[] tokens, Long[] scores, String path, Int epochs, Long lrMicro): Int {
    return kofEmbTrainFileC(m, W, cfg, kofEmbCtxNew(tokens), path, epochs, lrMicro)
}

kofEmbEvalFile(KofEmbModel m, KofLmWeights W, KofLmCfg cfg, String[] tokens, Long[] scores, String path, Long confMinMilli): String {
    return kofEmbEvalFileC(m, W, cfg, kofEmbCtxNew(tokens), path, confMinMilli)
}

// --------- persistencia binaria KFEH (crc cobre payload) ---------

kofEmbSave(String path, KofEmbModel m): Bool {
    if (!kofEmbReady(m)) {
        return false
    }
    var payload = m.e * 24 + 24
    var b = new Int[13 + payload]
    b[0] = 75
    b[1] = 69
    b[2] = 69
    b[3] = 72
    b[4] = 1
    kflqPutI32(b, 5, m.e)
    var k = 13
    var c = 0
    while (c < 3) {
        var off = c * m.e
        var i = 0
        while (i < m.e) {
            kflqPutI64(b, k, m.w[off + i])
            k = k + 8
            i = i + 1
        }
        c = c + 1
    }
    c = 0
    while (c < 3) {
        kflqPutI64(b, k, m.bias[c])
        k = k + 8
        c = c + 1
    }
    var crc = kflqCrc(b, 13, payload)
    kflqPutI32(b, 9, crc)
    var f = File(path)
    return f.writeBytes(b)
}

kofEmbLoad(String path): KofEmbModel {
    var empty = KofEmbModel(0, new Long[0], new Long[0])
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return empty
    }
    var hb = f.readRange(0, 13)
    if (hb.length < 13 || hb[0] != 75 || hb[1] != 69 || hb[2] != 69 || hb[3] != 72) {
        return empty
    }
    var e = kflqGetI32(hb, 5)
    if (e <= 0 || e > 8388608) {
        return empty
    }
    var payload = e * 24 + 24
    var all = f.readRange(0, 13 + payload)
    if (all.length < 13 + payload) {
        return empty
    }
    if (kflqCrc(all, 13, payload) != kflqGetI32(all, 9)) {
        return empty
    }
    var m = kofEmbInit(e)
    var k = 13
    var c = 0
    while (c < 3) {
        var off = c * e
        var i = 0
        while (i < e) {
            m.w[off + i] = kflqGetI64(all, k)
            k = k + 8
            i = i + 1
        }
        c = c + 1
    }
    c = 0
    while (c < 3) {
        m.bias[c] = kflqGetI64(all, k)
        k = k + 8
        c = c + 1
    }
    return m
}

embT(s: String) {
    var f = File("/tmp/opencode/embT.log")
    if (f.exists()) { f.appendText(s + "\n") } else { f.writeText(s + "\n") }
}
