        var s = ""
        var i = 0
        while (i < out.size()) {
            s = s + out.get(i) + " "
            i = i + 1
        }
        return s
    }

    explain(String target): String {
        return "explain:" + target
    }
}

// M30: Model Manager — biblioteca GGUF local

record ModelEntry(String name, String path, Int version, Int checksum)

class ModelManager {
    List<ModelEntry> models = listOf<ModelEntry>()

    register(String name, String path, Int ver): Bool {
        var i = 0
        while (i < models.size()) {
            if (models.get(i).name == name) { return false }
            i = i + 1
        }
        models.add(ModelEntry(name, path, ver, name.length * 7919))
        return true
    }

    remove(String name): Bool {
        var i = 0
        while (i < models.size()) {
            if (models.get(i).name == name) {
                models.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    count(): Int { return models.size() }

    supportsQuant(Int modelQuant, Int runtimeQuant): Bool {
        return modelQuant <= runtimeQuant
    }
}

WS_ROOT_C(): String { return "build/ws_c" }

setupC(): WorkspaceIndex {
    mkFile("build/ws_c/lib.kf", "record Shared(Int v)\n")
    var idx = WorkspaceIndex(WS_ROOT_C(), freshBus(), FixedClock(77))
    idx.fullRescan()
    return idx
}

test "dep edge from import to declaring file" {
    var wsDel1 = Directory("build/ws_c")
    if (wsDel1.exists()) {
        wsDel1.delete()
    }
    mkFile("build/ws_c/app.kf", "import Shared\n\nmain() {\n}\n")
    var idx = setupC()
    assert(idx.depsFrom(joinPath(WS_ROOT_C(), "app.kf")).size == 1)
    assert(idx.depsFrom(joinPath(WS_ROOT_C(), "lib.kf")).size == 0)
}

test "unknown import produces no edge" {
    mkFile("build/ws_c/ext.kf", "import java.util.List\n\nmain() {\n}\n")
    var idx = setupC()
    var deps = idx.depsFrom(joinPath(WS_ROOT_C(), "ext.kf"))
    assert(deps.size == 0)
}

test "cycle detected between two files" {
    mkFile("build/ws_c/ca.kf", "import TypeB\n\nrecord TypeA(Int v)\n")
    mkFile("build/ws_c/cb.kf", "import TypeA\n\nrecord TypeB(Int v)\n")
    var idx = WorkspaceIndex(WS_ROOT_C(), freshBus(), FixedClock(77))
    idx.fullRescan()
    var cyc = idx.cycles()
    assert(cyc.size > 0)
}

test "acyclic graph has no cycle" {
    // hermético: remove o par cíclico criado pelo teste anterior
    var caDel = File(joinPath(WS_ROOT_C(), "ca.kf"))
    if (caDel.exists()) {
        caDel.delete()
    }
    var cbDel = File(joinPath(WS_ROOT_C(), "cb.kf"))
    if (cbDel.exists()) {
        cbDel.delete()
    }
    var idx = setupC()
    assert(idx.cycles().size == 0)
}

test "unused import flagged" {
    mkFile("build/ws_c/unused.kf", "import Shared\nimport NeverUsed\n\nmain() {\n}\n")
    var idx = WorkspaceIndex(WS_ROOT_C(), freshBus(), FixedClock(77))
    idx.fullRescan()
    var unused = idx.unusedImports()
    var foundNever = false
    var foundSharedUnused = false
    for (var u in unused) {
        if (u.name == "NeverUsed") {
            foundNever = true
        }
        if (u.file.contains("unused.kf") && u.name == "Shared") {
            foundSharedUnused = true
        }
    }
    assert(foundNever)
    assert(foundSharedUnused)
}

main() {
}
