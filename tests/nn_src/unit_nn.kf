test "rmsnorm approx scales" {
    var x = new Int[2]
    x[0] = 10
    x[1] = 20
    var r = nnRMSNormApprox(x)
    assert(r.length == 2)
}
test "rope swaps pairs" {
    var q = new Int[2]
    q[0] = 3
    q[1] = 4
    var r = nnRopeRotatePairs(q)
    assert(r[0] == 4 && r[1] == -3)
}
test "ff multiplies" {
    var x = new Int[1]
    x[0] = 7
    assert(nnFeedForwardInt(x, 2)[0] == 14)
}
test "residual adds" {
    var a = new Int[1]
    var b = new Int[1]
    a[0] = 2
    b[0] = 3
    var r = nnResidual(a, b)
    assert(r[0] == 5)
}
test "attention scores per key" {
    var q = new Int[1]
    q[0] = 2
    var ks = listOf<Int[]>()
    var k1 = new Int[1]
    k1[0] = 3
    ks.add(k1)
    var sc = nnAttentionScoresInt(q, ks)
    assert(sc.get(0) == 6)
}
test "repeat penalty reduces seen positive logits" {
    var lg = new Int[2]
    lg[0] = 10
    lg[1] = 10
    var recent = listOf<Int>()
    recent.add(0)
    var out = samplerRepeatPenalty(lg, recent, 13, 10)
    assert(out[0] < out[1])
}
test "topp approx picks within mass" {
    var lg = new Int[2]
    lg[0] = 8
    lg[1] = 2
    assert(samplerTopPApprox(lg, 2, 500, 1) == 0)
}
main() {
}
