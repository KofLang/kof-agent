// M20: Agent Runtime unificado — plan DAG → tools → repair → response + journal

record PlanNode(String id, Int kind, Int dependsOn)
record RunMetrics(Int totalMs, Int plannerMs, Int toolsMs, Int toolCount)
record JournalEntry(Int step, String kind, String detail)
record AgentRunResult(String response, Int steps, Int failedSteps)
record ResponseEvent(Int kind, String delta)

class AgentRuntime {
    EventBus bus
    TimeSource clock
    ToolOrchestrator orch
    List<JournalEntry> journal = listOf<JournalEntry>()
    Int stepSeq = 0
    Int cancelledRun = false

    constructor(EventBus b, TimeSource ts) {
        bus = b
        clock = ts
        orch = ToolOrchestrator(b, ts)
    }

    jlog(String kind, String detail) {
        stepSeq = stepSeq + 1
        journal.add(JournalEntry(stepSeq, kind, detail))
    }

    validatePlan(List<PlanNode> nodes): Bool {
        var i = 0
        while (i < nodes.size()) {
            var n = nodes.get(i)
            if (n.dependsOn >= i) {
                return false
            }
            i = i + 1
        }
        return true
    }

    executePlan(List<PlanNode> nodes, OrchTool cfg): Int {
        var okc = 0
        var i = 0
        while (i < nodes.size()) {
            if (cancelledRun == 1) { break }
            var n = nodes.get(i)
            jlog("step", n.id)
            var sp = orch.trace.begin(n.id)
            var r = orch.executeTool(n.id, cfg)
            orch.trace.end(sp)
            if (r.state == 6) { okc = okc + 1 }
            i = i + 1
        }
        return okc
    }

    runPlan(List<PlanNode> nodes, OrchTool cfg): AgentRunResult {
        jlog("run", "start")
        if (!validatePlan(nodes)) {
            jlog("error", "invalid-dag")
            return AgentRunResult("", 0, 1)
        }
        var okc = executePlan(nodes, cfg)
        var resp = "done:" + okc + "/" + nodes.size()
        if (okc < nodes.size() && cancelledRun != 1) {
            jlog("repair", "retry-failed")
            okc = okc + retryFailed(nodes, cfg)
        }
        jlog("run", "end")
        return AgentRunResult(resp, okc, nodes.size() - okc)
    }

    retryFailed(List<PlanNode> nodes, OrchTool cfg): Int {
        var r = orch.retryOnce(nodes.get(0).id, cfg)
        if (r.state == 6) {
            return 1
        }
        return 0
    }

    streamRun(List<PlanNode> nodes, OrchTool cfg): List<ResponseEvent> {
        var evs = listOf<ResponseEvent>()
        evs.add(ResponseEvent(0, "start"))
        var r = runPlan(nodes, cfg)
        if (cancelledRun == 1) {
            evs.add(ResponseEvent(2, "cancelled"))
        } else {
            evs.add(ResponseEvent(3, r.response))
        }
        return evs
    }

    cancelRun() {
        cancelledRun = 1
        orch.cancelExecution()
    }

    dryRun(List<PlanNode> nodes): Bool {
        return validatePlan(nodes)
    }

    snapshot(): List<JournalEntry> {
        return journal
    }

    journalSize(): Int {
        return journal.size()
    }
}
