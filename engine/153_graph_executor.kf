// M31.1/.2: GraphExecutor — sequência decoder por camada com arena reutilizável

record LayerPlan(Int idx, Int hidden, Int ffMult)
record GraphStats(Int layers, Int steps)

class GraphExecutor {
    List<LayerPlan> plan = listOf<LayerPlan>()
    TensorArena arena
    Int steps = 0

    constructor() {
        arena = TensorArena()
    }

    buildPlan(Int numLayers, Int hidden) {
        var i = 0
        while (i < numLayers) {
            plan.add(LayerPlan(i, hidden, 4))
            i = i + 1
        }
    }

    layerCount(): Int { return plan.size() }

    execLayer(TensorR x, LayerPlan lp): TensorR {
        steps = steps + 1
        // attention real (scaled dot-product causal) sobre a própria seq
        var scores = attnScores(x, x, x.rows)
        var attnOut = attnContext(scores, x, x.rows)
        // residual
        var resid = tensorAdd(x, attnOut)
        // FFN SwiGLU real
        var ffnOut = swigluFFN(resid, lp.hidden * lp.ffMult)
        // segunda residual + norm final
        var out = tensorAdd(resid, ffnOut)
        return tensorRmsNorm(out)
    }

    forwardAllLayers(TensorR x): TensorR {
        var i = 0
        while (i < plan.size()) {
            x = execLayer(x, plan.get(i))
            i = i + 1
        }
        return x
    }

    stepCount(): Int { return steps }
}
