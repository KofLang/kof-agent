VERSION_STR(): String { return "0.1.0-m01" }
TARGET_STR(): String { return "native" }

usageText(): String {
    var u = ""
    u = u + "kof-agent " + VERSION_STR() + "\n"
    u = u + "\n"
    u = u + "usage:\n"
    u = u + "  kof-agent version\n"
    u = u + "  kof-agent help\n"
    u = u + "  kof-agent status [--root DIR] [--json]\n"
    u = u + "  kof-agent doctor [--root DIR] [--json]\n"
    u = u + "  kof-agent ask [--root DIR] [--json] <pedido>
  kof-agent config show [--file PATH] [--json]\n"
    u = u + "  kof-agent quant --file IN --out OUT\n"
    u = u + "\n"
    u = u + "exit codes: 0 ok · 1 usage · 2 failure\n"
    return u
}

class CliOpts {
    String cmd = "help"
    String sub = ""
    Bool jsonFlag = false
    String root = "."
    String file = ""
    String text = ""
    String out = ""
    Int epochs = 15
}

parseOptsList(List<String> raw): CliOpts {
    var o = CliOpts()
    var i = 0
    while (i < raw.size) {
        var a = raw.get(i)
        if (a == "--json") {
            o.jsonFlag = true
        } else if (a == "--root") {
            i = i + 1
            if (i < raw.size) {
                o.root = raw.get(i)
            }
        } else if (a == "--file") {
            i = i + 1
            if (i < raw.size) {
                o.file = raw.get(i)
            }
        } else if (a == "--out") {
            i = i + 1
            if (i < raw.size) {
                o.out = raw.get(i)
            }
        } else if (a == "--epochs") {
            i = i + 1
            if (i < raw.size) {
                o.epochs = parseIntStr(raw.get(i))
            }
        } else if (o.cmd == "help") {
            o.cmd = a
        } else if (o.sub == "" && (o.cmd == "config")) {
            o.sub = a
        } else if (o.cmd == "ask") {
            var add = " "
            if (o.text == "") {
                add = ""
            }
            o.text = o.text + add + a
        } else {
            throw "cli: unknown argument '" + a + "'"
        }
        i = i + 1
    }
    return o
}

cmdVersion(Bool json): Int {
    if (json) {
        println("{\"name\":\"kof-agent\",\"version\":\"" + VERSION_STR() + "\",\"target\":\"" + TARGET_STR() + "\"}")
    } else {
        println("kof-agent " + VERSION_STR() + " (target " + TARGET_STR() + ")")
    }
    return 0
}

class StatusProbe implements TaskBody {
    run(ContextView v) {
        v.incMetric("tasks.completed")
    }
}

bootQuiet(CliOpts o): RuntimeContext {
    var cfg = Config()
    var path = o.file
    if (path == "") {
        path = joinPath(o.root, "kof.config")
    }
    cfg.loadFile(path)
    var ctx = RuntimeContext(cfg, RealTimeClock())
    ctx.logger.quiet = true
    ctx.wire()
    return ctx
}

wsJson(WorkspaceReport r): String {
    var out = "{\"valid\":" + r.valid
    out = out + ",\"kfFiles\":" + r.kfFiles
    out = out + ",\"hasGit\":" + r.hasGit
    out = out + ",\"hasConfigFile\":" + r.hasConfigFile
    out = out + ",\"ignoreRules\":" + r.ignoreRules
    out = out + "}"
    return out
}

cmdStatus(CliOpts o): Int {
    var ws = scanWorkspace(o.root)
    if (!ws.valid) {
        if (o.jsonFlag) {
            println("{\"error\":\"workspace invalid\",\"detail\":\"" + escapeJson(ws.detail) + "\"}")
        } else {
            println("status: workspace invalid: " + ws.detail)
        }
        return 2
    }
    var ctx = bootQuiet(o)
    ctx.life.transition(LC_INITIALIZING())
    ctx.finishBoot()
    ctx.sched.launch(StatusProbe(), "status-probe", 5)
    ctx.shutdownGraceful()
    if (o.jsonFlag) {
        var line = runtimeStatusJson(ctx)
        line = line.substring(0, line.length - 1)
        line = line + ",\"workspace\":" + wsJson(ws) + "}"
        println(line)
    } else {
        println("state      : " + ctx.life.stateName())
        println("scheduler  : launched=" + ctx.met.tasksLaunched + " completed=" + ctx.met.tasksCompleted + " pending=" + ctx.sched.pending())
        println("events     : published=" + ctx.met.eventsPublished + " handlers=" + ctx.met.handlersCalled)
        println("uptime     : " + ctx.met.uptimeMs(ctx.clock) + " ms")
        println("workspace  : kfFiles=" + ws.kfFiles + " git=" + ws.hasGit + " config=" + ws.hasConfigFile)
    }
    return 0
}

doctorCheckWorkspace(CliOpts o): CheckRec {
    var d = Directory(o.root)
    if (d.exists() && d.isDirectory()) {
        return CheckRec("workspace", true, "root ok: " + o.root)
    }
    return CheckRec("workspace", false, "root missing or not a directory: " + o.root)
}

doctorCheckConfig(CliOpts o): CheckRec {
    var cfg = Config()
    var path = o.file
    if (path == "") {
        path = joinPath(o.root, "kof.config")
    }
    var ok = cfg.loadFile(path)
    if (ok) {
        return CheckRec("config", true, "loaded " + path + " (" + cfg.entries.size + " entries)")
    }
    if (!File(path).exists()) {
        return CheckRec("config", true, "no config file; defaults in effect")
    }
    return CheckRec("config", false, "config exists but failed to load: " + path)
}

doctorCheckLogLevel(CliOpts o): CheckRec {
    var cfg = Config()
    var path = o.file
    if (path == "") {
        path = joinPath(o.root, "kof.config")
    }
    cfg.loadFile(path)
    var name = cfg.getStr("log.level", "INFO")
    var lvl = logLevelFromName(name)
    if (lvl >= 0) {
        return CheckRec("log-level", true, "log.level=" + name)
    }
    return CheckRec("log-level", false, "invalid log.level '" + name + "'")
}

doctorCheckCache(CliOpts o): CheckRec {
    var dirPath = joinPath(o.root, "build/cache")
    var d = Directory(dirPath)
    if (!d.exists()) {
        if (!d.createDirectories()) {
            return CheckRec("cache", false, "cannot create " + dirPath)
        }
    }
    var probe = File(joinPath(dirPath, ".probe"))
    if (!probe.writeText("ok")) {
        return CheckRec("cache", false, "cannot write probe in " + dirPath)
    }
    if (!probe.delete()) {
        return CheckRec("cache", false, "cannot remove probe in " + dirPath)
    }
    return CheckRec("cache", true, "writable at " + dirPath)
}

checkJson(CheckRec c): String {
    return "{\"id\":\"" + c.id + "\",\"ok\":" + c.ok + ",\"detail\":\"" + escapeJson(c.detail) + "\"}"
}

cmdDoctor(CliOpts o): Int {
    var c1 = doctorCheckWorkspace(o)
    var c2 = doctorCheckConfig(o)
    var c3 = doctorCheckLogLevel(o)
    var c4 = doctorCheckCache(o)
    var allOk = c1.ok && c2.ok && c3.ok && c4.ok
    if (o.jsonFlag) {
        var out = "{\"checks\":[" + checkJson(c1) + "," + checkJson(c2) + "," + checkJson(c3) + "," + checkJson(c4) + "],\"allOk\":" + allOk + "}"
        println(out)
    } else {
        println("check workspace : " + c1.detail + " -> " + c1.ok)
        println("check config    : " + c2.detail + " -> " + c2.ok)
        println("check log-level : " + c3.detail + " -> " + c3.ok)
        println("check cache     : " + c4.detail + " -> " + c4.ok)
        println("overall         : " + allOk)
    }
    if (allOk) {
        return 0
    }
    return 2
}

cmdConfigShow(CliOpts o): Int {
    if (o.sub != "" && o.sub != "show") {
        println("kof-agent: unknown config subcommand '" + o.sub + "'")
        return 1
    }
    var cfg = Config()
    var ok = cfg.loadFile(o.file)
    if (o.jsonFlag) {
        println(cfg.snapshotJson())
    } else {
        if (!ok) {
            println("config: file not loaded (" + o.file + "); defaults in effect")
            return 0
        }
        println("source: " + cfg.sourcePath + " entries=" + cfg.entries.size)
        for (var e in cfg.entries) {
            println("  " + e.key + " = " + e.value)
        }
    }
    return 0
}

cmdAsk(CliOpts o): Int {
    var ctx = bootQuiet(o)
    ctx.life.transition(LC_INITIALIZING())
    ctx.finishBoot()
    var ix = CorpusIndex()
    if (o.jsonFlag) {
        ix = corpusLoad(ctx.bus, joinPath(o.root, "corpus"), ctx.clock)
    }
    var c = ctxLoad(joinPath(o.root, "workspace/context.yaml"))
    var km = kflLoadModel(joinPath(o.root, "build/koflearn.w"))
    if (km.ready()) {
        var pred = kflPredict(km, o.text)
        var conf = kflConfMicro(km, o.text) * 1000 / KFL_MICRO()
        if (conf < c.confiancaMin) {
            kflHarvest(o.root, o.text, pred, conf)
            ctx.shutdownGraceful()
            println(outAsk("nao sei classificar isso (conf=" + conf + "/1000) — me ensine: o que deveria ser? colhido em koflm-errors.jsonl"))
            return 2
        }
        if (pred == KFL_ASK()) {
            ctx.shutdownGraceful()
            println(outAsk("o que exatamente devo mudar? aponte arquivo/acao."))
            return 2
        }
        if (pred == KFL_REFUSE()) {
            ctx.shutdownGraceful()
            println(outRefuse("o modelo classificou REFUSE (pedido fora do escopo Kof)"))
            return 2
        }
        var planK = brainProcess(ctx.bus, ix, o.text, listOf<String>(), listOf<String>())
        ctx.shutdownGraceful()
        println(outFmt("intent=" + planK.intent + " tools=" + planK.candidateToolsCsv + " via=koflearn conf=" + conf, "intencao decidida pelo modelo treinado em Kof (E8); execucao real pending executor", c.linhasMax))
        return 0
    }
    var label = koflmIntent(joinPath(o.root, "models/gguf/koflm-v1-q4.gguf"), o.text)
    if (label == "EXECUTE" || label == "ASK" || label == "REFUSE") {
        ctx.shutdownGraceful()
        if (label == "ASK") {
            println(outAsk("o modelo pediu esclarecimento: reformule com arquivo/acao especificos."))
            return 2
        }
        if (label == "REFUSE") {
            println(outRefuse("o modelo classificou o pedido como fora do escopo Kof."))
            return 2
        }
        var plan = brainProcess(ctx.bus, ix, o.text, listOf<String>(), listOf<String>())
        println(outFmt("intent=" + plan.intent + " conf=" + plan.confidence + " tools=" + plan.candidateToolsCsv + " via=koflm", "EXECUTE decidido por KofLM; execucao real pending executor", c.linhasMax))
        return 0
    }
    var plan = brainProcess(ctx.bus, ix, o.text, listOf<String>(), listOf<String>())
    ctx.shutdownGraceful()
    if (o.jsonFlag) {
        println(brainPlanJson(plan))
        return 0
    }
    var req = brainRequiredEntity(plan.intent)
    if (plan.intent == B_INTENT_UNKNOWN() || plan.confidence * 10 < c.confiancaMin) {
        var q = "qual arquivo e qual acao exatas?"
        if (req != "") {
            q = "falta '" + req + "' no pedido — informe."
        }
        println(outAsk(q))
        return 2
    }
    println(outFmt("intent=" + plan.intent + " conf=" + plan.confidence + " tools=" + plan.candidateToolsCsv + " via=matcher:" + label, "KofLM indisponivel (" + label + "); usei o matcher de bootstrapping — nao e entendimento real", c.linhasMax))
    return 0
}

cmdConfMilli(CliOpts o): Int {
    var c = ctxLoad(joinPath(o.root, "workspace/context.yaml"))
    return c.confiancaMin
}

cmdQuant(CliOpts o): Int {
    var src = o.file
    if (src == "") {
        println("quant: use --file <in.gguf>")
        return 1
    }
    var dst = o.out
    if (dst == "") {
        println("quant: use --out <in.gguf>")
        return 1
    }
    if (src.endsWith(".w") || dst.endsWith(".kflq")) {
        println("quantizando classificador " + src + " -> " + dst + " (KFLQ int8)...")
        var mk = kflLoadModel(src)
        if (!mk.ready()) {
            println("kflq: sem pesos em " + src + " — rode train antes")
            return 2
        }
        if (!kflQuantSave(dst, mk)) {
            println("kflq: falha ao gravar " + dst)
            return 2
        }
        var mq = kflQuantLoad(dst)
        if (!mq.ready()) {
            println("kflq: roundtrip falhou (CRC/corrompido)")
            return 2
        }
        var suite = joinPath(o.root, "eval/ptbr-suite-v4.jsonl")
        var agree = kflqAgreement(mk, mq, suite)
        println("kflq: ok — concordancia de previsao na suite = " + agree + "/1000")
        return 0
    }
    println("quantizando " + src + " -> " + dst + " (Q4_K em Kof)...")
    println(kofqGguf(src, dst))
    return 0
}

kofEmbBase(): String { return "/home/mel/Downloads/kof-data/models/TinyLlama-Q4_K_M.gguf" }

cmdEmbTrain(CliOpts o): Int {
    var base = kofEmbBase()
    var dst = joinPath(o.root, "build/kofemb.head")
    println("emb-train: base=" + base + " head=" + dst)
    var t0 = now()
    var m = kofGgufBinOpen(base)
    if (m.errorCount > 0) {
        println("emb-train: ERR:" + m.errorCode)
        return 1
    }
    embT("T-binok")
    var cfg = kofLmCfgFromKv(m)
    embT("T-cfg")
    var W = kofLmWeightsLoadEmb(base, m, cfg)
    embT("T-wload")
    var v = kofLmTokLoadVocab(base, m)
    embT("T-vocab n=" + v.tokens.length)
    if (v.tokens.length == 0) {
        println("emb-train: NO-VOCAB")
        return 1
    }
    println("emb-train: load=" + (now() - t0) + "ms e=" + cfg.embd)
    var em = kofEmbInit(cfg.embd)
    var ds = o.file
    if (ds == "") {
        ds = joinPath(o.root, "datasets/jsonl/koflm-v4.jsonl")
    }
    var t1 = now()
    println("emb-train: fase=ctxFile t=" + (now()/1000))
    var ctx = kofEmbCtxFile(v.tokens, ds)
    println("emb-train: fase=linhas t=" + (now()/1000))
    var seen = kofEmbTrainFileC(em, W, cfg, ctx, ds, o.epochs, 200)
    println("emb-train: fase=train1 t=" + (now()/1000))
    embT("ctx-file-ok")
    embT("ctx-v4-ok seen=" + seen)
    var ctxE = kofEmbCtxFile(v.tokens, joinPath(o.root, "datasets/jsonl/koflm-errors.jsonl"))
    seen = seen + kofEmbTrainFileC(em, W, cfg, ctxE, joinPath(o.root, "datasets/jsonl/koflm-errors.jsonl"), o.epochs, 200)
    embT("ctx-err-ok seen=" + seen)
    embT("ctx-e-ok")
    println("emb-train: fase=train2 t=" + (now()/1000))
    embT("train-done seen=" + seen + " ms=" + (now() - t1))
    if (!kofEmbSave(dst, em)) {
        embT("save-fail")
        return 2
    }
    var ctx2 = kofEmbCtxFile(v.tokens, joinPath(o.root, "eval/ptbr-suite-v4.jsonl"))
    println("emb-eval: " + kofEmbEvalFileC(em, W, cfg, ctx2, joinPath(o.root, "eval/ptbr-suite-v4.jsonl"), cmdConfMilli(o)))
    return 0
}

cmdEmbEval(CliOpts o): Int {
    var base = kofEmbBase()
    var hp = joinPath(o.root, "build/kofemb.head")
    embT("eval0")
    var em = kofEmbLoad(hp)
    if (!kofEmbReady(em)) {
        println("emb-eval: sem head — rode: kof-agent emb-train")
        return 2
    }
    var m = kofGgufBinOpen(base)
    if (m.errorCount > 0) {
        println("emb-eval: ERR:" + m.errorCode)
        return 1
    }
    embT("E-binok")
    var cfg = kofLmCfgFromKv(m)
    embT("E-cfg")
    var W = kofLmWeightsLoadEmb(base, m, cfg)
    embT("E-wload")
    var v = kofLmTokLoadVocab(base, m)
    embT("E-vocab n=" + v.tokens.length)
    var file = o.file
    if (file == "") {
        file = joinPath(o.root, "eval/ptbr-suite-v4.jsonl")
    }
    embT("eval-ctx")
    var ctx3 = kofEmbCtxFile(v.tokens, file)
    embT("eval-run")
    println("emb-eval: " + kofEmbEvalFileC(em, W, cfg, ctx3, file, cmdConfMilli(o)))
    embT("eval-done")
    return 0
}

cmdTrain(CliOpts o): Int {
    var m = kflLoadModel(joinPath(o.root, "build/koflearn.w"))
    if (!m.ready()) {
        m.init(KFL_NFEAT())
    }
    var ds = o.file
    if (ds == "") {
        ds = joinPath(o.root, "datasets/jsonl/koflm-v4.jsonl")
    }
    var seen = kflTrainFile(m, ds, o.epochs)
    seen = seen + kflTrainFile(m, joinPath(o.root, "datasets/jsonl/koflm-errors.jsonl"), o.epochs)
    var ok = kflSaveModel(joinPath(o.root, "build/koflearn.w"), m)
    println("treino: exemplos=" + seen + " epochs=" + o.epochs + " salvo=" + ok)
    println("eval: " + kflEvalFile(m, joinPath(o.root, "eval/ptbr-suite-v4.jsonl"), cmdConfMilli(o)))
    return 0
}

cmdEval(CliOpts o): Int {
    var m = kflLoadModel(joinPath(o.root, "build/koflearn.w"))
    if (!m.ready()) {
        println("eval: sem pesos — rode: kof-agent train")
        return 2
    }
    var file = o.file
    if (file == "") {
        file = joinPath(o.root, "eval/ptbr-suite-v4.jsonl")
    }
    var r = kflEvalFile(m, file, cmdConfMilli(o))
    println("eval: " + r)
    if (r.contains("acc=100%") || r.contains("acc=9") || r.contains("acc=8")) {
        return 0
    }
    return 2
}

main() {
    var argv = loadArgsFile(".kofargs")
    var code = 0
    try {
        var o = parseOptsList(argv)
        if (o.cmd == "version") {
            code = cmdVersion(o.jsonFlag)
        } else if (o.cmd == "help" || o.cmd == "--help") {
            print(usageText())
            code = 0
        } else if (o.cmd == "status") {
            code = cmdStatus(o)
        } else if (o.cmd == "doctor") {
            code = cmdDoctor(o)
        } else if (o.cmd == "config") {
            code = cmdConfigShow(o)
        } else if (o.cmd == "train") {
            code = cmdTrain(o)
        } else if (o.cmd == "emb-train") {
            code = cmdEmbTrain(o)
        } else if (o.cmd == "emb-eval") {
            code = cmdEmbEval(o)
        } else if (o.cmd == "eval") {
            code = cmdEval(o)
        } else if (o.cmd == "quant") {
            code = cmdQuant(o)
        } else if (o.cmd == "ask") {
            if (o.text == "") {
                println("ask: pedido vazio")
                code = 1
            } else {
                code = cmdAsk(o)
            }
        } else {
            println("kof-agent: unknown command '" + o.cmd + "'")
            print(usageText())
            code = 1
        }
    } catch (String e) {
        println("kof-agent: error: " + e)
        code = 1
    }
    process.exit(code)
}

