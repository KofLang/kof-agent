#version 450
// M31 compute HAL — matmul: C[M×N] = A[M×K] × B[K×N]
// Ponto fixo de milésimos (int), coerente com o runtime Kof.
// Dispatch: local_size 16×16; push constants: M, N, K.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BufA { int a[]; };
layout(set = 0, binding = 1) readonly buffer BufB { int b[]; };
layout(set = 0, binding = 2) writeonly buffer BufC { int c[]; };

layout(push_constant) uniform Push {
    int M;  // linhas de A
    int N;  // colunas de B
    int K;  // colunas de A / linhas de B
} pc;

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;
    if (gx >= uint(pc.N) || gy >= uint(pc.M)) {
        return;
    }
    int acc = 0;
    for (int k = 0; k < pc.K; k++) {
        acc += a[int(gy) * pc.K + k] * b[k * pc.N + int(gx)];
    }
    c[int(gy) * pc.N + int(gx)] = acc;
}
