#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// M36.1 matvec32: y[M] = W[M x K] * x[K] — W/x/y em INT32 (metade dos bytes
// no PCIe), acumulador e divisão em INT64 no shader. Ponto fixo do koflama:
// |W| < 2^31 (attention ~1e6, down micro ~3.6e8), |x| < 2^31 (nano < 2.3e8),
// acc i64 (k ≤ 32000 × 2e6×2e6 = 1.3e17 < 9.2e18).
// W residente (buffer por id, binding 0), x/y buffers pequenos (bindings 1,2).
// 1 workgroup por row, 64 threads strided + tree reduce em shared.
// div vem por push (i64): y = acc / div (trunc, igual ao Kof).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BufW { int w[]; };
layout(set = 0, binding = 1) readonly buffer BufX { int x[]; };
layout(set = 0, binding = 2) writeonly buffer BufY { int y[]; };

layout(push_constant) uniform Push {
    int m;      // rows de W
    int k;      // cols de W
    int pad0;
    int pad1;
    int64_t div; // divisor do acc (1e9/1e6/1e12)
} pc;

shared int64_t red[64];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= uint(pc.m)) {
        return;
    }
    uint off = row * uint(pc.k);
    int64_t part = int64_t(0);
    for (uint c = tid; c < uint(pc.k); c += 64u) {
        part += int64_t(w[off + c]) * int64_t(x[c]);
    }
    red[tid] = part;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) {
            red[tid] += red[tid + s];
        }
        barrier();
    }
    if (tid == 0u) {
        y[row] = int(red[0] / pc.div);
    }
}
