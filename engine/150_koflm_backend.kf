// M31/M32: Backend Abstraction — CPU real + Vulkan/OpenGL detect/fallback.
// Máquinas alvo: dGPU dedicada, híbridos (iGPU+dGPU), notebooks só-iGPU,
// VMs/PC fraco (llvmpipe → cpu). Sempre degrada: nunca falha.

record RuntimeInfo(String backend, Int gpuLayers, Int threads)

class CPUBackend {
    Bool ready = false

    init() { ready = true }

    matmul(TensorR a, TensorR b): TensorR {
        return tensorMatMul(a, b)
    }

    rmsNormT(TensorR t): TensorR {
        return tensorRmsNorm(t)
    }

    name(): String { return "cpu" }
}

Bool detectVulkan() {
    var f = File("/usr/share/vulkan/icd.d")
    if (!f.exists()) { return false }
    // icd.d é um diretório: listar .json em vez de readText (null/NPE)
    var files = f.list()
    if (files == null) { return false }
    var found = false
    for (var name in files) {
        if (name.endsWith(".json")) {
            found = true
        }
    }
    return found
}

// llvmpipe/lavapipe = rasterizador de software: compute neles é MAIS LENTO
// que o CPU puro (comprovado no M32.1 — lvp nem escreve o resultado).
Bool isSoftwareVkIcd(name: String) {
    return name.contains("lvp") || name.contains("swiftshader")
        || name.contains("virtio") || name.contains("gfxstream")
}

Bool hasHardwareVk() {
    var f = File("/usr/share/vulkan/icd.d")
    if (!f.exists()) { return false }
    var files = f.list()
    if (files == null) { return false }
    var found = false
    for (var name in files) {
        if (name.endsWith(".json") && !isSoftwareVkIcd(name)) {
            found = true
        }
    }
    return found
}

Bool detectOpenGL() {
    // card[0-9] real (card1 = RX 550 no OptiPlex; card0 nem sempre existe)
    var i = 0
    while (i < 8) {
        var f = File("/sys/class/drm/card" + i)
        if (f.exists()) { return true }
        i = i + 1
    }
    return false
}

// E3 (specs/ENGINE_V2.md §3.2): OpenCL existe quando ha loader ICD E ao menos
// um vendor .icd instalado (mesmo com libOpenCL sem plataforma o build de
// kernels nao roda — ver gpu/tests_ocl.c rc=77). Logica pura p/ teste:
oclDetectFrom(Bool loader, Bool vendorIcd): Bool {
    return loader && vendorIcd
}

Bool hasOpenclLoader(): Bool {
    var p = listOf<String>()
    p.add("/usr/lib/x86_64-linux-gnu/libOpenCL.so.1")
    p.add("/usr/lib/libOpenCL.so.1")
    p.add("/usr/lib/x86_64-linux-gnu/libOpenCL.so")
    for (var one in p) {
        var f = File(one)
        if (f.exists()) { return true }
    }
    return false
}

Bool hasOpenclVendor(): Bool {
    var v = listOf<String>()
    v.add("/etc/OpenCL/vendors/mesa_icd.x86_64.icd")
    v.add("/etc/OpenCL/vendors/nvidia.icd")
    v.add("/etc/OpenCL/vendors/amdocl64.icd")
    v.add("/etc/OpenCL/vendors/pocl.icd")
    for (var one in v) {
        var f = File(one)
        if (f.exists()) { return true }
    }
    return false
}

detectOpenCL(): Bool {
    return oclDetectFrom(hasOpenclLoader(), hasOpenclVendor())
}

// Override por ambiente (gpu-env.sh): KOF_GPU_BACKEND=vulkan|opengl|cpu.
// secrets.get lê /proc/self/environ no nativo e System.getenv no JVM.
String envBackendOverride() {
    var v = secrets.get("KOF_GPU_BACKEND")
    if (v == null) { return "" }
    return v
}

backendAutoSelect(): RuntimeInfo {
    var forced = envBackendOverride()
    if (forced == "cpu") {
        return RuntimeInfo("cpu", 0, 6)
    }
    if (forced == "vulkan") {
        return RuntimeInfo("vulkan", 99, 6)
    }
    if (forced == "opengl") {
        return RuntimeInfo("opengl", 32, 6)
    }
    // automático: hardware VK > GL > cpu (llvmpipe NÃO conta como VK)
    if (hasHardwareVk()) {
        return RuntimeInfo("vulkan", 99, 6)
    }
    if (detectOpenGL()) {
        return RuntimeInfo("opengl", 32, 6)
    }
    return RuntimeInfo("cpu", 0, 6)
}
