test "lm head produces bounded logits" {
    var h = tensorNew(1, 4)
    tensorSet(h, 0, 0, 100)
    var w = tensorNew(8, 4)
    tensorSet(w, 0, 0, 2)
    var lg = lmHead(h, w, 16)
    assert(lg.length == 16)
    assert(lg[0] >= 0)
}

test "q4_0 decode block scales" {
    var raw = new Int[9]
    raw[0] = 200
    raw[1] = 50
    var v = q40DecodeBlock(raw, 0)
    assert(v == 4)
    assert(v >= 0)
}

test "quant decode tensor full pass" {
    var raw = new Int[18]
    raw[0] = 100
    raw[9] = 300
    var o = quantDecodeTensor(raw, 2)
    assert(o.length == 2)
}
