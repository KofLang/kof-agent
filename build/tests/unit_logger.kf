record CheckRec(String id, Bool ok, String detail)

interface TimeSource {
    nowMs(): Long
}

class FixedClock implements TimeSource {
    Long value = 0
    constructor(Long v) {
        value = v
    }
    nowMs(): Long {
        return value
    }
    advance(Long ms) {
        value = value + ms
    }
}

class RealTimeClock implements TimeSource {
    constructor() {
    }
    nowMs(): Long {
        return now()
    }
}

parseIntStr(String s): Int {
    var n = 0
    var i = 0
    if (s.length == 0) {
        throw "parse: empty integer"
    }
    var start = 0
    if (s.charAt(0) == 45) {
        start = 1
        if (s.length == 1) {
            throw "parse: invalid integer '" + s + "'"
        }
    }
    i = start
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < 48 || c > 57) {
            throw "parse: invalid integer '" + s + "'"
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if (start == 1) {
        n = 0 - n
    }
    return n
}

parseBoolStr(String s): Bool {
    var v = s.toLowerCase()
    if (v == "true" || v == "1" || v == "yes" || v == "on") {
        return true
    }
    if (v == "false" || v == "0" || v == "no" || v == "off" || v == "") {
        return false
    }
    throw "parse: invalid boolean '" + s + "'"
}

escapeJson(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 34) {
            out = out + "\\\""
        } else if (c == 92) {
            out = out + "\\\\"
        } else if (c == 10) {
            out = out + "\\n"
        } else if (c == 13) {
            out = out + "\\r"
        } else if (c == 9) {
            out = out + "\\t"
        } else {
            out = out + s.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

joinPath(String a, String b): String {
    if (a == "") {
        return b
    }
    if (a.substring(a.length - 1, a.length) == "/") {
        return a + b
    }
    return a + "/" + b
}

splitStr(String s, String sep): List<String> {
    var out = listOf<String>()
    if (s.length == 0) {
        return out
    }
    var sc = sep.charAt(0)
    var start = 0
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == sc) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, s.length))
    return out
}

loadArgsFile(String path): List<String> {
    var argv = listOf<String>()
    var f = File(path)
    if (!f.exists()) {
        return argv
    }
    var txt = f.readText()
    var lines = splitStr(txt, "\n")
    for (var line in lines) {
        var t = line.trim()
        if (t.length > 0) {
            argv.add(t)
        }
    }
    return argv
}

sortInts(Int[] a, Int n) {
    var i = 1
    while (i < n) {
        var key = a[i]
        var j = i - 1
        var placed = false
        while (!placed) {
            if (j < 0) {
                placed = true
            } else {
                if (a[j] > key) {
                    a[j + 1] = a[j]
                    j = j - 1
                } else {
                    placed = true
                }
            }
        }
        a[j + 1] = key
        i = i + 1
    }
}

retLower(String s): String {
    return s.toLowerCase()
}

mkFile(String path, String content): Bool {
    var parent = ""
    var parts = splitStr(path, "/")
    if (parts.size > 1) {
        var i = 0
        while (i < parts.size - 1) {
            if (parent == "") {
                parent = parts.get(i)
            } else {
                parent = joinPath(parent, parts.get(i))
            }
            i = i + 1
        }
        var d = Directory(parent)
        if (!d.exists()) {
            d.createDirectories()
        }
    }
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
    return f.writeText(content)
}

class EventCounter implements EventHandler {
    Int count = 0
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        count = count + 1
        return true
    }
}

class RecordingHandler implements EventHandler {
    List<String> seen = listOf<String>()
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        seen.add(e.topic + "=" + e.payload)
        return true
    }
}

freshBus(): EventBus {
    return EventBus()
}

record LogLine(Long ts, String level, String req, String msg)

LOG_TRACE(): Int { return 0 }
LOG_DEBUG(): Int { return 1 }
LOG_INFO(): Int { return 2 }
LOG_WARN(): Int { return 3 }
LOG_ERROR(): Int { return 4 }
LOG_FATAL(): Int { return 5 }

logLevelName(Int lvl): String {
    if (lvl == 0) { return "TRACE" }
    if (lvl == 1) { return "DEBUG" }
    if (lvl == 2) { return "INFO" }
    if (lvl == 3) { return "WARN" }
    if (lvl == 4) { return "ERROR" }
    return "FATAL"
}

logLevelFromName(String s): Int {
    var v = s.toUpperCase()
    if (v == "TRACE") { return 0 }
    if (v == "DEBUG") { return 1 }
    if (v == "INFO") { return 2 }
    if (v == "WARN") { return 3 }
    if (v == "ERROR") { return 4 }
    if (v == "FATAL") { return 5 }
    return -1
}

class Logger {
    Int level = LOG_INFO()
    Bool color = false
    Bool json = false
    Bool quiet = false
    String requestId = "-"
    TimeSource clock

    constructor(TimeSource ts) {
        clock = ts
    }

    configure(Int lvl, Bool col, Bool js) {
        level = lvl
        color = col
        json = js
    }

    setRequestId(String rid) {
        requestId = rid
    }

    trace(String m): String { return write(LOG_TRACE(), m) }
    debug(String m): String { return write(LOG_DEBUG(), m) }
    info(String m): String { return write(LOG_INFO(), m) }
    warn(String m): String { return write(LOG_WARN(), m) }
    error(String m): String { return write(LOG_ERROR(), m) }
    fatal(String m): String { return write(LOG_FATAL(), m) }

    isEnabled(Int lvl): Bool {
        return lvl >= level
    }

    write(Int lvl, String msg): String {
        if (!isEnabled(lvl)) {
            return ""
        }
        var ts = clock.nowMs()
        var name = logLevelName(lvl)
        var line = ""
        if (json) {
            line = "{\"ts\":\"" + ts + "\",\"level\":\"" + name + "\",\"req\":\"" + escapeJson(requestId) + "\",\"msg\":\"" + escapeJson(msg) + "\"}"
        } else {
            var body = "[" + name + "] [" + requestId + "] " + msg
            if (color) {
                body = ansiFor(lvl) + body + "\u001b[0m"
            }
            line = ts + " " + body
        }
        if (!quiet) {
            println(line)
        }
        return line
    }

    ansiFor(Int lvl): String {
        if (lvl <= LOG_DEBUG()) {
            return "\u001b[90m"
        }
        if (lvl == LOG_INFO()) {
            return "\u001b[36m"
        }
        if (lvl == LOG_WARN()) {
            return "\u001b[33m"
        }
        if (lvl == LOG_ERROR()) {
            return "\u001b[31m"
        }
        return "\u001b[35m"
    }
}

record CfgEntry(String key, String value)

class Config {
    List<CfgEntry> entries = listOf<CfgEntry>()
    String sourcePath = ""
    Bool loaded = false

    loadFile(String path): Bool {
        entries = listOf<CfgEntry>()
        sourcePath = path
        var f = File(path)
        if (!f.exists()) {
            loaded = false
            return false
        }
        if (!f.isFile()) {
            loaded = false
            return false
        }
        var text = f.readText()
        parseInto(text)
        loaded = true
        return true
    }

    reload(): Bool {
        return loadFile(sourcePath)
    }

    parseInto(String text) {
        var lines = splitStr(text, "\n")
        for (var raw in lines) {
            var line = raw.trim()
            if (line.length > 0) {
                if (!line.startsWith("#")) {
                    var kv = splitStr(line, "=")
                    if (kv.size == 2) {
                        var k = kv.get(0).trim()
                        var v = kv.get(1).trim()
                        entries.add(CfgEntry(k, v))
                    }
                }
            }
        }
    }

    has(String key): Bool {
        for (var e in entries) {
            if (e.key == key) {
                return true
            }
        }
        return false
    }

    getRaw(String key): String {
        for (var e in entries) {
            if (e.key == key) {
                return e.value
            }
        }
        throw "config: missing key '" + key + "'"
    }

    getStr(String key, String def): String {
        if (!has(key)) {
            return def
        }
        return getRaw(key)
    }

    getInt(String key, Int def): Int {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseIntStr(v)
        } catch (String e) {
            throw "config: invalid integer for '" + key + "': '" + v + "'"
        }
    }

    getBool(String key, Bool def): Bool {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseBoolStr(v)
        } catch (String e) {
            throw "config: invalid boolean for '" + key + "': '" + v + "'"
        }
    }

    snapshotJson(): String {
        var out = "{\"source\":\"" + escapeJson(sourcePath) + "\",\"loaded\":"
        if (loaded) {
            out = out + "true"
        } else {
            out = out + "false"
        }
        out = out + ",\"entries\":["
        var first = true
        for (var e in entries) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"key\":\"" + escapeJson(e.key) + "\",\"value\":\"" + escapeJson(e.value) + "\"}"
        }
        out = out + "]}"
        return out
    }
}

class Metrics {
    Long startedAt = 0
    Int eventsPublished = 0
    Int handlersCalled = 0
    Int eventsFailed = 0
    Int tasksLaunched = 0
    Int tasksCompleted = 0
    Int tasksFailed = 0
    Int tasksCancelled = 0
    Int tasksRejected = 0

    constructor() {
    }

    start(TimeSource clock) {
        startedAt = clock.nowMs()
    }

    incByName(String name) {
        if (name == "events.published") {
            eventsPublished = eventsPublished + 1
        } else if (name == "events.handlers") {
            handlersCalled = handlersCalled + 1
        } else if (name == "events.failed") {
            eventsFailed = eventsFailed + 1
        } else if (name == "tasks.launched") {
            tasksLaunched = tasksLaunched + 1
        } else if (name == "tasks.completed") {
            tasksCompleted = tasksCompleted + 1
        } else if (name == "tasks.failed") {
            tasksFailed = tasksFailed + 1
        } else if (name == "tasks.cancelled") {
            tasksCancelled = tasksCancelled + 1
        } else if (name == "tasks.rejected") {
            tasksRejected = tasksRejected + 1
        }
    }

    uptimeMs(TimeSource clock): Long {
        return clock.nowMs() - startedAt
    }

    snapshotJson(TimeSource clock): String {
        var out = "{\"uptimeMs\":" + uptimeMs(clock)
        out = out + ",\"events\":{\"published\":" + eventsPublished + ",\"handlersCalled\":" + handlersCalled + ",\"failed\":" + eventsFailed + "}"
        out = out + ",\"tasks\":{\"launched\":" + tasksLaunched + ",\"completed\":" + tasksCompleted + ",\"failed\":" + tasksFailed + ",\"cancelled\":" + tasksCancelled + ",\"rejected\":" + tasksRejected + "}"
        out = out + "}"
        return out
    }
}

TASK_CREATED(): Int { return 0 }
TASK_QUEUED(): Int { return 1 }
TASK_RUNNING(): Int { return 2 }
TASK_WAITING(): Int { return 3 }
TASK_COMPLETED(): Int { return 4 }
TASK_CANCELLED(): Int { return 5 }
TASK_FAILED(): Int { return 6 }

taskStateName(Int st): String {
    if (st == TASK_CREATED()) { return "CREATED" }
    if (st == TASK_QUEUED()) { return "QUEUED" }
    if (st == TASK_RUNNING()) { return "RUNNING" }
    if (st == TASK_WAITING()) { return "WAITING" }
    if (st == TASK_COMPLETED()) { return "COMPLETED" }
    if (st == TASK_CANCELLED()) { return "CANCELLED" }
    return "FAILED"
}

interface ContextView {
    incMetric(String name)
}

interface TaskBody {
    run(ContextView v)
}

class Future {
    Bool done = false
    Bool ok = false
    Int result = 0
    String error = ""
    constructor() {
    }
}

class TaskNode {
    Int id
    Int priority
    Int seq
    String name
    Int st = TASK_CREATED()
    Bool cancelled = false
    TaskBody body
    constructor(Int tid, Int prio, Int sq, String nm, TaskBody b) {
        id = tid
        priority = prio
        seq = sq
        name = nm
        body = b
    }
}

class FutureJob implements TaskBody {
    TaskBody inner
    Future future
    constructor(TaskBody i, Future f) {
        inner = i
        future = f
    }
    run(ContextView v) {
        try {
            inner.run(v)
            future.ok = true
        } catch (String e) {
            future.error = e
            throw e
        } finally {
            future.done = true
        }
    }
}

class Scheduler {
    List<TaskNode> tasks = listOf<TaskNode>()
    Int[] heapPrio = new Int[64]
    Int[] heapSeq = new Int[64]
    Int[] heapIdx = new Int[64]
    Int heapSize = 0
    Int heapCap = 64
    Int nextId = 1
    Int nextSeq = 1
    Int maxPending = 0
    Bool accepting = true
    Int launchedCount = 0
    Int completedCount = 0
    Int failedCount = 0
    Int cancelledCount = 0
    Int rejectedCount = 0
    String lastError = ""
    ContextView view

    constructor(ContextView v) {
        view = v
    }

    ensureCap(Int need) {
        if (need <= heapCap) {
            return
        }
        var nc = heapCap * 2
        while (nc < need) {
            nc = nc * 2
        }
        var np = new Int[nc]
        var ns = new Int[nc]
        var ni = new Int[nc]
        var i = 0
        while (i < heapSize) {
            np[i] = heapPrio[i]
            ns[i] = heapSeq[i]
            ni[i] = heapIdx[i]
            i = i + 1
        }
        heapPrio = np
        heapSeq = ns
        heapIdx = ni
        heapCap = nc
    }

    lessThan(Int a, Int b): Bool {
        if (heapPrio[a] > heapPrio[b]) {
            return true
        }
        if (heapPrio[a] < heapPrio[b]) {
            return false
        }
        return heapSeq[a] < heapSeq[b]
    }

    swapAt(Int a, Int b) {
        var tp = heapPrio[a]
        heapPrio[a] = heapPrio[b]
        heapPrio[b] = tp
        var ts = heapSeq[a]
        heapSeq[a] = heapSeq[b]
        heapSeq[b] = ts
        var ti = heapIdx[a]
        heapIdx[a] = heapIdx[b]
        heapIdx[b] = ti
    }

    heapPush(Int taskIndex) {
        ensureCap(heapSize + 1)
        var i = heapSize
        heapPrio[i] = tasks.get(taskIndex).priority
        heapSeq[i] = tasks.get(taskIndex).seq
        heapIdx[i] = taskIndex
        heapSize = heapSize + 1
        while (i > 0) {
            var parent = (i - 1) / 2
            if (lessThan(i, parent)) {
                swapAt(i, parent)
                i = parent
            } else {
                break
            }
        }
    }

    heapPop(): Int {
        var top = heapIdx[0]
        heapSize = heapSize - 1
        if (heapSize > 0) {
            heapPrio[0] = heapPrio[heapSize]
            heapSeq[0] = heapSeq[heapSize]
            heapIdx[0] = heapIdx[heapSize]
            var i = 0
            while (true) {
                var l = i * 2 + 1
                var r = l + 1
                var m = i
                if (l < heapSize) {
                    if (lessThan(l, m)) {
                        m = l
                    }
                }
                if (r < heapSize) {
                    if (lessThan(r, m)) {
                        m = r
                    }
                }
                if (m == i) {
                    break
                }
                swapAt(i, m)
                i = m
            }
        }
        return top
    }

    launch(TaskBody body, String name, Int priority): Int {
        if (!accepting) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: rejecting launch after shutdown"
        }
        if (maxPending > 0 && heapSize >= maxPending) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: backpressure (pending=" + heapSize + ", max=" + maxPending + ")"
        }
        var node = TaskNode(nextId, priority, nextSeq, name, body)
        nextId = nextId + 1
        nextSeq = nextSeq + 1
        node.st = TASK_QUEUED()
        tasks.add(node)
        heapPush(tasks.size - 1)
        launchedCount = launchedCount + 1
        return node.id
    }

    launchFuture(TaskBody body, String name, Int priority): Future {
        var f = Future()
        var wrapped = FutureJob(body, f)
        launch(wrapped, name, priority)
        return f
    }

    cancel(Int taskId): Bool {
        var idx = taskId - 1
        if (idx < 0 || idx >= tasks.size) {
            return false
        }
        var node = tasks.get(idx)
        if (node.st == TASK_QUEUED() && !node.cancelled) {
            node.cancelled = true
            node.st = TASK_CANCELLED()
            cancelledCount = cancelledCount + 1
            return true
        }
        return false
    }

    executeOne(): Bool {
        if (heapSize == 0) {
            return false
        }
        var idx = heapPop()
        var node = tasks.get(idx)
        if (node.cancelled || node.st == TASK_CANCELLED()) {
            return true
        }
        node.st = TASK_RUNNING()
        try {
            node.body.run(view)
            node.st = TASK_COMPLETED()
            completedCount = completedCount + 1
        } catch (String e) {
            node.st = TASK_FAILED()
            failedCount = failedCount + 1
            lastError = e
        }
        return true
    }

    run(Int maxTasks): Int {
        var n = 0
        while (n < maxTasks) {
            if (!executeOne()) {
                break
            }
            n = n + 1
        }
        return n
    }

    drain() {
        while (executeOne()) {
        }
    }

    await(Future f) {
        while (!f.done) {
            if (heapSize == 0) {
                throw "scheduler: deadlock in await (future unresolved, queue empty)"
            }
            executeOne()
        }
    }

    pending(): Int {
        return heapSize
    }

    gracefulShutdown() {
        accepting = false
        drain()
    }

    statsJson(): String {
        return "{\"pending\":" + heapSize + ",\"launched\":" + launchedCount + ",\"completed\":" + completedCount + ",\"failed\":" + failedCount + ",\"cancelled\":" + cancelledCount + ",\"rejected\":" + rejectedCount + ",\"accepting\":" + accepting + "}"
    }
}

class WorkerPool {
    Int size = 1
    Scheduler sched
    String affinityHint = ""

    constructor(Scheduler s, Int n) {
        sched = s
        if (n != 1) {
            throw "TP001: worker pool size " + n + " unsupported on this target (upstream CONC001); use 1"
        }
        size = n
    }

    launch(TaskBody body, String name): Int {
        return sched.launch(body, name, 5)
    }

    dynamicResize(Int n) {
        throw "TP001: dynamic pool resize unsupported on this target (upstream CONC001)"
    }

    setAffinity(String hint) {
        throw "TP002: affinity unsupported on this target"
    }
}

record EventEnvelope(String topic, String payload, Int seq)

interface EventHandler {
    onEvent(EventEnvelope e): Bool
}

class Subscription {
    Int id
    String topic
    EventHandler h
    Bool once = false
    constructor(Int sid, String t, EventHandler handler, Bool onceFlag) {
        id = sid
        topic = t
        h = handler
        once = onceFlag
    }
}

class EventBus {
    List<Subscription> subs = listOf<Subscription>()
    Int nextId = 1
    Int seq = 1

    subscribe(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, false)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    once(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, true)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    unsubscribe(Int id): Bool {
        var i = 0
        while (i < subs.size) {
            if (subs.get(i).id == id) {
                subs.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    publishEnvelope(EventEnvelope e): Int {
        var matched = listOf<Int>()
        var i = 0
        while (i < subs.size) {
            var s = subs.get(i)
            if (s.topic == e.topic || s.topic == "*") {
                matched.add(i)
            }
            i = i + 1
        }
        var called = 0
        for (var m in matched) {
            var sub = subs.get(m)
            if (sub.once) {
                unsubscribe(sub.id)
            }
            called = called + 1
            var cont = sub.h.onEvent(e)
            if (!cont) {
                break
            }
        }
        return called
    }

    publish(String topic, String payload): Int {
        var env = EventEnvelope(topic, payload, seq)
        seq = seq + 1
        return publishEnvelope(env)
    }

    broadcast(String payload): Int {
        return publish("*", payload)
    }

    publishAsync(Scheduler sched, ContextView view, String topic, String payload): Int {
        var job = PublishJob(this, topic, payload)
        return sched.launch(job, "event.publish", 5)
    }

    statsJson(): String {
        return "{\"subscribers\":" + subs.size + ",\"published\":" + (seq - 1) + "}"
    }
}

class PublishJob implements TaskBody {
    EventBus bus
    String topic
    String payload
    constructor(EventBus b, String t, String p) {
        bus = b
        topic = t
        payload = p
    }
    run(ContextView v) {
        bus.publish(topic, payload)
    }
}

LC_BOOTING(): Int { return 0 }
LC_INITIALIZING(): Int { return 1 }
LC_READY(): Int { return 2 }
LC_BUSY(): Int { return 3 }
LC_STOPPING(): Int { return 4 }
LC_STOPPED(): Int { return 5 }
LC_FAILED(): Int { return 6 }

lcName(Int st): String {
    if (st == LC_BOOTING()) { return "BOOTING" }
    if (st == LC_INITIALIZING()) { return "INITIALIZING" }
    if (st == LC_READY()) { return "READY" }
    if (st == LC_BUSY()) { return "BUSY" }
    if (st == LC_STOPPING()) { return "STOPPING" }
    if (st == LC_STOPPED()) { return "STOPPED" }
    return "FAILED"
}

interface LifecycleHook {
    onTransition(Int from, Int to): Bool
}

class Lifecycle {
    Int st = LC_BOOTING()
    String lastError = ""
    List<LifecycleHook> bootHooks = listOf<LifecycleHook>()
    List<LifecycleHook> readyHooks = listOf<LifecycleHook>()
    List<LifecycleHook> shutdownHooks = listOf<LifecycleHook>()
    List<LifecycleHook> crashHooks = listOf<LifecycleHook>()

    state(): Int {
        return st
    }

    stateName(): String {
        return lcName(st)
    }

    isAlive(): Bool {
        return st != LC_STOPPED() && st != LC_FAILED()
    }

    registerBoot(LifecycleHook h) {
        bootHooks.add(h)
    }

    registerReady(LifecycleHook h) {
        readyHooks.add(h)
    }

    registerShutdown(LifecycleHook h) {
        shutdownHooks.add(h)
    }

    registerCrash(LifecycleHook h) {
        crashHooks.add(h)
    }

    allowed(Int from, Int to): Bool {
        if (to == LC_FAILED()) {
            return from != LC_STOPPED() && from != LC_FAILED()
        }
        if (from == LC_BOOTING()) {
            return to == LC_INITIALIZING()
        }
        if (from == LC_INITIALIZING()) {
            return to == LC_READY()
        }
        if (from == LC_READY()) {
            return to == LC_BUSY() || to == LC_STOPPING()
        }
        if (from == LC_BUSY()) {
            return to == LC_READY() || to == LC_STOPPING()
        }
        if (from == LC_STOPPING()) {
            return to == LC_STOPPED()
        }
        return false
    }

    transition(Int to) {
        if (!allowed(st, to)) {
            throw "lifecycle: illegal transition " + lcName(st) + " -> " + lcName(to)
        }
        var from = st
        var target = to
        var hooks = bootHooks
        if (target == LC_READY()) {
            hooks = readyHooks
        } else if (target == LC_STOPPING()) {
            hooks = shutdownHooks
        }
        for (var h in hooks) {
            var cont = h.onTransition(from, target)
            if (!cont) {
                throw "lifecycle: hook veto on transition to " + lcName(target)
            }
        }
        st = target
    }

    crash(String reason) {
        if (!isAlive()) {
            return
        }
        var from = st
        lastError = reason
        for (var h in crashHooks) {
            try {
                h.onTransition(from, LC_FAILED())
            } catch (String e) {
                println("lifecycle: crash hook failed: " + e)
            }
        }
        st = LC_FAILED()
    }

    summaryJson(): String {
        var out = "{\"state\":\"" + stateName() + "\",\"lastError\":\"" + escapeJson(lastError) + "\"}"
        return out
    }
}

class NameRecorder implements LifecycleHook {
    List<String> items = listOf<String>()
    String prefix = ""
    constructor(String p) {
        prefix = p
    }
    onTransition(Int from, Int to): Bool {
        items.add(prefix + ":" + lcName(from) + "->" + lcName(to))
        return true
    }
    recorded(): Int {
        return items.size
    }
    last(): String {
        return items.get(items.size - 1)
    }
}

class WorkspaceReport {
    String root = ""
    Bool valid = false
    Bool hasGit = false
    Bool hasConfigFile = false
    Bool hasCacheDir = false
    Int kfFiles = 0
    Int totalEntries = 0
    Int ignoreRules = 0
    String detail = ""
}

countKfFiles(String dir, Int depth): Int {
    if (depth > 3) {
        return 0
    }
    var d = Directory(dir)
    if (!d.exists() || !d.isDirectory()) {
        return 0
    }
    var names = d.list()
    var n = 0
    for (var name in names) {
        var child = joinPath(dir, name)
        var f = File(child)
        if (f.isFile()) {
            if (name.length >= 3) {
                var ext = name.substring(name.length - 3, name.length)
                if (ext == ".kf") {
                    n = n + 1
                }
            }
        } else if (f.isDirectory()) {
            if (name != ".git") {
                n = n + countKfFiles(child, depth + 1)
            }
        }
    }
    return n
}

listTopEntries(String dir): Int {
    var d = Directory(dir)
    if (!d.exists() || !d.isDirectory()) {
        return 0
    }
    var names = d.list()
    return names.size
}

scanWorkspace(String root): WorkspaceReport {
    var r = WorkspaceReport()
    r.root = root
    var d = Directory(root)
    if (!d.exists()) {
        r.valid = false
        r.detail = "root does not exist"
        return r
    }
    if (!d.isDirectory()) {
        r.valid = false
        r.detail = "root is not a directory"
        return r
    }
    r.valid = true
    r.detail = "ok"
    var gitDir = Directory(joinPath(root, ".git"))
    r.hasGit = gitDir.exists()
    var cfgFile = File(joinPath(root, "kof.config"))
    r.hasConfigFile = cfgFile.exists()
    var cacheDir = Directory(joinPath(root, "build"))
    r.hasCacheDir = cacheDir.exists()
    r.kfFiles = countKfFiles(root, 1)
    r.totalEntries = listTopEntries(root)
    var gi = File(joinPath(root, ".gitignore"))
    if (gi.exists() && gi.isFile()) {
        var txt = gi.readText()
        var lines = splitStr(txt, "\n")
        for (var raw in lines) {
            var line = raw.trim()
            if (line.length > 0) {
                var first = line.substring(0, 1)
                if (first != "#") {
                    r.ignoreRules = r.ignoreRules + 1
                }
            }
        }
    }
    return r
}

WS_IDX_VERSION(): Int { return 3 }

WsSnapEmpty(): WsSnap {
    return WsSnap()
}


WS_MAGIC_A(): Int { return 87 }
WS_MAGIC_B(): Int { return 83 }
WS_MAGIC_C(): Int { return 73 }
WS_MAGIC_D(): Int { return 88 }

record WsFileRec(String path, Int hash, Int sizeChars)
record WsSymRec(String name, String kind, String file)
record WsImpRec(String file, String name)
record WsEdgeRec(String from, String to)
record WsGitRec(String branch, String commit)
class WsSnap {
    String workspaceId = ""
    String root = ""
    String gitBranch = ""
    String gitCommit = ""
    String target = ""
    Long timestamp = 0
    List<WsFileRec> files = listOf<WsFileRec>()
    List<WsSymRec> symbols = listOf<WsSymRec>()
    List<WsImpRec> imports = listOf<WsImpRec>()
    List<WsEdgeRec> deps = listOf<WsEdgeRec>()
    constructor() {
    }
}

record WsParsedRec(String path, Int hash, String pkg, List<String> imports, List<WsSymRec> syms)
record WsDiffRec(List<String> added, List<String> modified, List<String> deleted, List<String> renamedOld, List<String> renamedNew, List<String> symAdded, List<String> symRemoved)
record WsDiagRec(String file, Int hash, Int diagCount, String codes)

wsHash(String s): Int {
    var h = 5381
    var i = 0
    while (i < s.length) {
        h = h * 33 + s.charAt(i)
        i = i + 1
    }
    return h
}

wsSanitize(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 1 || c == 2 || c == 3) {
            out = out + "?"
        } else {
            out = out + s.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

wsJoin(List<String> xs, String sep): String {
    var out = ""
    var first = true
    for (var x in xs) {
        if (!first) {
            out = out + sep
        }
        first = false
        out = out + x
    }
    return out
}

wsInList(List<String> xs, String v): Bool {
    for (var x in xs) {
        if (x == v) {
            return true
        }
    }
    return false
}

parseLongSafe(String s): Long {
    var n = 0
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c >= 48 && c <= 57) {
            n = n * 10 + (c - 48)
        }
        i = i + 1
    }
    return n
}

wsCountOccurrences(String textIn, String needle): Int {
    var n = 0
    var rest = textIn
    while (rest.length >= needle.length) {
        var idx = rest.indexOf(needle)
        if (idx < 0) {
            break
        }
        n = n + 1
        rest = rest.substring(idx + needle.length, rest.length)
    }
    return n
}

wsFirstToken(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 40 || c == 32 || c == 123 || c == 58 || c == 61) {
            break
        }
        out = out + s.substring(i, i + 1)
        i = i + 1
    }
    return out.trim()
}

wsLastSpace(String s): Int {
    var found = 0 - 1
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == 32) {
            found = i
        }
        i = i + 1
    }
    return found
}

wsIsKeyword(String t): Bool {
    if (t == "if") { return true }
    if (t == "for") { return true }
    if (t == "while") { return true }
    if (t == "switch") { return true }
    if (t == "return") { return true }
    if (t == "catch") { return true }
    if (t == "else") { return true }
    if (t == "do") { return true }
    if (t == "spawn") { return true }
    if (t == "assert") { return true }
    return false
}

wsCollectFiles(String dir, Int depth, List<String> out) {
    if (depth > 6) {
        return
    }
    var d = Directory(dir)
    if (!d.exists()) {
        return
    }
    if (!d.isDirectory()) {
        return
    }
    var names = d.list()
    for (var n in names) {
        var skipIt = n == ".git" || n == "build" || n == "out"
        if (!skipIt) {
            var child = joinPath(dir, n)
            var f = File(child)
            if (f.isFile()) {
                if (n.length >= 3) {
                    var ext = n.substring(n.length - 3, n.length)
                    if (ext == ".kf") {
                        out.add(child)
                    }
                }
            } else {
                if (f.isDirectory()) {
                    wsCollectFiles(child, depth + 1, out)
                }
            }
        }
    }
}

wsParseFile(String path): WsParsedRec {
    var f = File(path)
    var txt = ""
    if (f.exists() && f.isFile()) {
        txt = f.readText()
    }
    var hash = wsHash(txt)
    var imports = listOf<String>()
    var syms = listOf<WsSymRec>()
    var pkg = ""
    var lines = splitStr(txt, "\n")
    for (var raw in lines) {
        var t = raw.trim()
        if (t.length > 0) {
            var isComment = t.startsWith("//")
            if (!isComment) {
                var isPkg = t.startsWith("package ")
                var isImp = t.startsWith("import ")
                if (isPkg) {
                    pkg = t.substring(8, t.length).trim()
                }
                if (isImp) {
                    imports.add(t.substring(7, t.length).trim())
                }
                if (!isPkg && !isImp) {
                    var kind = ""
                    if (t.startsWith("record ")) {
                        kind = "record"
                    }
                    if (kind == "" && t.startsWith("interface ")) {
                        kind = "interface"
                    }
                    if (kind == "" && t.startsWith("entity ")) {
                        kind = "entity"
                    }
                    if (kind == "" && t.startsWith("abstract class ")) {
                        kind = "class"
                    }
                    if (kind == "" && t.startsWith("class ")) {
                        kind = "class"
                    }
                    if (kind != "") {
                        var rest = ""
                        if (t.startsWith("abstract class ")) {
                            rest = t.substring(15, t.length)
                        } else if (t.startsWith("record ")) {
                            rest = t.substring(7, t.length)
                        } else if (t.startsWith("interface ")) {
                            rest = t.substring(10, t.length)
                        } else if (t.startsWith("entity ")) {
                            rest = t.substring(7, t.length)
                        } else {
                            rest = t.substring(6, t.length)
                        }
                        var nm = wsFirstToken(rest)
                        if (nm.length > 0) {
                            syms.add(WsSymRec(nm, kind, path))
                        }
                    } else {
                        var p2 = t.indexOf("(")
                        if (p2 > 0) {
                            var head = t.substring(0, p2).trim()
                            var sp = wsLastSpace(head)
                            var cand = head
                            if (sp >= 0) {
                                cand = head.substring(sp + 1, head.length)
                            }
                            var looksFn = false
                            if (cand.length > 0) {
                                var c0 = cand.charAt(0)
                                var alpha = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
                                if (alpha) {
                                    var kw = wsIsKeyword(cand)
                                    if (!kw) {
                                        var hasRet = t.contains("): ")
                                        var hasExpr = t.contains(") = ")
                                        var hasBrace = t.endsWith("{")
                                        if (hasRet || hasExpr || hasBrace) {
                                            looksFn = true
                                        }
                                    }
                                }
                            }
                            if (looksFn) {
                                syms.add(WsSymRec(cand, "function", path))
                            }
                        }
                    }
                }
            }
        }
    }
    return WsParsedRec(path, hash, pkg, imports, syms)
}

wsGitInfo(String root): WsGitRec {
    var headFile = File(joinPath(joinPath(root, ".git"), "HEAD"))
    var branch = ""
    var commit = ""
    if (headFile.exists() && headFile.isFile()) {
        var head = headFile.readText().trim()
        if (head.startsWith("ref: refs/heads/")) {
            branch = head.substring(16, head.length).trim()
            var refFile = File(joinPath(joinPath(root, ".git"), joinPath("refs", "heads")))
            var shaFile = File(joinPath(joinPath(joinPath(root, ".git"), "refs"), joinPath("heads", branch)))
            if (shaFile.exists() && shaFile.isFile()) {
                commit = shaFile.readText().trim()
            }
        } else {
            commit = head
        }
    }
    return WsGitRec(branch, commit)
}

wsBuildEdges(List<WsParsedRec> parsed, List<WsImpRec> flatImports): List<WsEdgeRec> {
    var edges = listOf<WsEdgeRec>()
    for (var imp in flatImports) {
        var target = ""
        for (var p in parsed) {
            if (target == "") {
                for (var s in p.syms) {
                    if (target == "" && s.name == imp.name && s.file != imp.file) {
                        target = p.path
                    }
                }
            }
        }
        if (target != "") {
            edges.add(WsEdgeRec(imp.file, target))
        }
    }
    return edges
}

wsUnusedImports(List<WsParsedRec> parsed, List<WsImpRec> flatAll): List<WsImpRec> {
    var unused = listOf<WsImpRec>()
    for (var imp in flatAll) {
        var txt = ""
        var rf = File(imp.file)
        if (rf.exists() && rf.isFile()) {
            txt = rf.readText()
        }
        var occurrences = wsCountOccurrences(txt, imp.name)
        if (occurrences <= 1) {
            unused.add(imp)
        }
    }
    return unused
}

wsHasCycleRec(String node, List<WsEdgeRec> edges, List<String> visited, List<String> stack, List<String> cycleOut): Bool {
    if (wsInList(stack, node)) {
        cycleOut.add(node)
        return true
    }
    if (wsInList(visited, node)) {
        return false
    }
    visited.add(node)
    stack.add(node)
    for (var e in edges) {
        if (e.from == node) {
            var found = wsHasCycleRec(e.to, edges, visited, stack, cycleOut)
            if (found) {
                return true
            }
        }
    }
    stack.remove(stack.size - 1)
    return false
}

wsDetectCycle(List<WsEdgeRec> edges): List<String> {
    var visited = listOf<String>()
    var stack = listOf<String>()
    var cycle = listOf<String>()
    var roots = listOf<String>()
    for (var e in edges) {
        if (!wsInList(roots, e.from)) {
            roots.add(e.from)
        }
    }
    for (var r in roots) {
        var found = wsHasCycleRec(r, edges, visited, stack, cycle)
        if (found) {
            return cycle
        }
    }
    return cycle
}

wsFullScan(EventBus bus, String root, TimeSource clock): WsSnap {
    bus.publish("workspace.indexing", root)
    var paths = listOf<String>()
    wsCollectFiles(root, 1, paths)
    var files = listOf<WsFileRec>()
    var syms = listOf<WsSymRec>()
    var imps = listOf<WsImpRec>()
    var parsedAll = listOf<WsParsedRec>()
    for (var p in paths) {
        var pr = wsParseFile(p)
        parsedAll.add(pr)
        var sz = 0
        var rf = File(p)
        if (rf.exists() && rf.isFile()) {
            sz = rf.readText().length
        }
        files.add(WsFileRec(p, pr.hash, sz))
        for (var s in pr.syms) {
            syms.add(s)
        }
        for (var i in pr.imports) {
            imps.add(WsImpRec(p, i))
        }
    }
    var deps = wsBuildEdges(parsedAll, imps)
    var gi = wsGitInfo(root)
    var cfg = Config()
    cfg.loadFile(joinPath(root, "kof.config"))
    var target = cfg.getStr("target", "native")
    var wsId = "" + wsHash(root + "|" + gi.branch + "|" + gi.commit)
    var snap = WsSnap()
    snap.workspaceId = wsId
    snap.root = root
    snap.gitBranch = gi.branch
    snap.gitCommit = gi.commit
    snap.target = target
    snap.timestamp = clock.nowMs()
    snap.files = files
    snap.symbols = syms
    snap.imports = imps
    snap.deps = deps
    bus.publish("snapshot.created", root)
    bus.publish("workspace.indexed", "files=" + files.size + " symbols=" + syms.size)
    return snap
}


wsMetaLine(WsSnap snap): String {
    return snap.workspaceId + "\u0003" + wsSanitize(snap.root) + "\u0003" + wsSanitize(snap.gitBranch) + "\u0003" + wsSanitize(snap.gitCommit) + "\u0003" + snap.target + "\u0003" + snap.timestamp
}

wsSerializeIndex(WsSnap snap): String {
    var filesSec = ""
    var firstF = true
    for (var f in snap.files) {
        if (!firstF) {
            filesSec = filesSec + "\u0002"
        }
        firstF = false
        filesSec = filesSec + f.path + "\u0003" + f.hash + "\u0003" + f.sizeChars
    }
    var symSec = ""
    var firstS = true
    for (var x in snap.symbols) {
        if (!firstS) {
            symSec = symSec + "\u0002"
        }
        firstS = false
        symSec = symSec + x.name + "\u0003" + x.kind + "\u0003" + x.file
    }
    var impSec = ""
    var firstI = true
    for (var x in snap.imports) {
        if (!firstI) {
            impSec = impSec + "\u0002"
        }
        firstI = false
        impSec = impSec + x.file + "\u0003" + x.name
    }
    var depSec = ""
    var firstD = true
    for (var x in snap.deps) {
        if (!firstD) {
            depSec = depSec + "\u0002"
        }
        firstD = false
        depSec = depSec + x.from + "\u0003" + x.to
    }
    var payload = wsMetaLine(snap)
    payload = payload + "\u0001" + filesSec
    payload = payload + "\u0001" + symSec
    payload = payload + "\u0001" + impSec
    payload = payload + "\u0001" + depSec
    return payload
}

wsWriteVersioned(String path, String magic, Int version, String payload): Bool {
    var crc = wsHash(payload)
    var head = magic + "|" + version + "|" + crc + "\n"
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
    return f.writeText(head + payload)
}

wsSaveAll(EventBus bus, String dir, WsSnap snap): Bool {
    var d = Directory(dir)
    if (!d.exists()) {
        d.createDirectories()
    }
    var body = wsSerializeIndex(snap)
    var okIdx = wsWriteVersioned(joinPath(dir, "workspace.idx"), "WSIDX", WS_IDX_VERSION(), body)
    var okSnap = wsWriteVersioned(joinPath(dir, "workspace.snapshot"), "WSSNP", WS_IDX_VERSION(), body)
    var hashes = listOf<String>()
    for (var f in snap.files) {
        hashes.add("" + f.hash)
    }
    var okH = wsWriteVersioned(joinPath(dir, "workspace.hashes"), "WSHSH", WS_IDX_VERSION(), wsJoin(hashes, "\u0002"))
    bus.publish("snapshot.created", dir)
    return okIdx && okSnap && okH
}

wsReadVersioned(String path, String wantMagic): String {
    var f = File(path)
    if (!f.exists()) {
        return ""
    }
    if (!f.isFile()) {
        return ""
    }
    var txt = f.readText()
    var nl = txt.indexOf("\n")
    if (nl < 0) {
        return ""
    }
    var head = txt.substring(0, nl)
    var payload = txt.substring(nl + 1, txt.length)
    var hp = splitStr(head, "|")
    if (hp.size != 3) {
        return ""
    }
    if (hp.get(0) != wantMagic) {
        return ""
    }
    var crc = parseLongSafe(hp.get(2))
    if (wsHash(payload) != crc) {
        return ""
    }
    return payload
}

wsSection(String payload, Int idx): String {
    var parts = splitStr(payload, "\u0001")
    if (idx < parts.size) {
        return parts.get(idx)
    }
    return ""
}

wsParseMeta(String sec, String fallbackRoot): WsSnap {
    var f6 = splitStr(sec, "\u0003")
    if (f6.size < 6) {
        return WsSnapEmpty()
    }
    var out2 = WsSnap()
    if (f6.size >= 6) {
        out2.workspaceId = f6.get(0)
        out2.root = f6.get(1)
        out2.gitBranch = f6.get(2)
        out2.gitCommit = f6.get(3)
        out2.target = f6.get(4)
        out2.timestamp = parseLongSafe(f6.get(5))
    }
    return out2
}

wsLoadIndex(String path): WsSnap {
    var payload = wsReadVersioned(path, "WSIDX")
    if (payload == "") {
        return WsSnapEmpty()
    }
    var meta = wsParseMeta(wsSection(payload, 0), "")
    var files = meta.files
    var fsec = wsSection(payload, 1)
    for (var entry in splitStr(fsec, "\u0002")) {
        var fl = splitStr(entry, "\u0003")
        if (fl.size == 3) {
            files.add(WsFileRec(fl.get(0), parseIntStr(fl.get(1)), parseIntStr(fl.get(2))))
        }
    }
    var syms = meta.symbols
    var ssec = wsSection(payload, 2)
    for (var entry in splitStr(ssec, "\u0002")) {
        var sl = splitStr(entry, "\u0003")
        if (sl.size == 3) {
            syms.add(WsSymRec(sl.get(0), sl.get(1), sl.get(2)))
        }
    }
    var imps = meta.imports
    var isec = wsSection(payload, 3)
    for (var entry in splitStr(isec, "\u0002")) {
        var il = splitStr(entry, "\u0003")
        if (il.size == 2) {
            imps.add(WsImpRec(il.get(0), il.get(1)))
        }
    }
    var deps = meta.deps
    var dsec = wsSection(payload, 4)
    for (var entry in splitStr(dsec, "\u0002")) {
        var dl = splitStr(entry, "\u0003")
        if (dl.size == 2) {
            deps.add(WsEdgeRec(dl.get(0), dl.get(1)))
        }
    }
    meta.files = files
    meta.symbols = syms
    meta.imports = imps
    meta.deps = deps
    return meta
}

wsDiff(List<WsFileRec> prevFiles, List<WsFileRec> nextFiles): WsDiffRec {
    var added = listOf<String>()
    var modified = listOf<String>()
    var unchanged = listOf<String>()
    var deleted = listOf<String>()
    for (var nf in nextFiles) {
        var found = false
        var oldHash = 0
        for (var pf in prevFiles) {
            if (pf.path == nf.path) {
                found = true
                oldHash = pf.hash
            }
        }
        if (!found) {
            added.add(nf.path)
        } else if (oldHash != nf.hash) {
            modified.add(nf.path)
        } else {
            unchanged.add(nf.path)
        }
    }
    for (var pf in prevFiles) {
        var still = false
        for (var nf in nextFiles) {
            if (nf.path == pf.path) {
                still = true
            }
        }
        if (!still) {
            deleted.add(pf.path)
        }
    }
    var renamedOld = listOf<String>()
    var renamedNew = listOf<String>()
    for (var delPath in deleted) {
        var delHash = 0
        for (var pf in prevFiles) {
            if (pf.path == delPath) {
                delHash = pf.hash
            }
        }
        for (var addPath in added) {
            var addHash = 0
            for (var nf in nextFiles) {
                if (nf.path == addPath) {
                    addHash = nf.hash
                }
            }
            if (addHash == delHash && delHash != 0) {
                renamedOld.add(delPath)
                renamedNew.add(addPath)
            }
        }
    }
    var realAdded = listOf<String>()
    for (var a in added) {
        if (!wsInList(renamedNew, a)) {
            realAdded.add(a)
        }
    }
    var realDeleted = listOf<String>()
    for (var d in deleted) {
        if (!wsInList(renamedOld, d)) {
            realDeleted.add(d)
        }
    }
    return WsDiffRec(realAdded, modified, realDeleted, renamedOld, renamedNew, listOf<String>(), listOf<String>())
}

class WorkspaceIndex {
    String root = "."
    EventBus bus
    WsSnap current = WsSnap()
    List<WsDiagRec> diagCache = listOf<WsDiagRec>()
    Bool loaded = false

    TimeSource clock

    constructor(String r, EventBus b) {
        root = r
        bus = b
        clock = RealTimeClock()
    }

    constructor(String r, EventBus b, TimeSource ts) {
        root = r
        bus = b
        clock = ts
    }

    fullRescan(): WsSnap {
        var snap = wsFullScan(bus, root, clock)
        var diff = wsDiff(current.files, snap.files)
        publishFileEvents(diff)
        current = snap
        loaded = true
        return snap
    }

    incremental(): WsSnap {
        if (!loaded) {
            return fullRescan()
        }
        var fresh = wsFullScan(bus, root, clock)
        var diff = wsDiff(current.files, fresh.files)
        fresh.workspaceId = current.workspaceId
        current = fresh
        bus.publish("workspace.changed", "added=" + diff.added.size + " modified=" + diff.modified.size + " deleted=" + diff.deleted.size + " renamed=" + diff.renamedOld.size)
        publishFileEvents(diff)
        return fresh
    }

    publishFileEvents(WsDiffRec d) {
        for (var a in d.added) {
            bus.publish("file.added", a)
        }
        for (var m in d.modified) {
            bus.publish("file.modified", m)
        }
        for (var x in d.deleted) {
            bus.publish("file.removed", x)
        }
        if (d.renamedOld.size > 0) {
            bus.publish("file.renamed", d.renamedOld.get(0) + "->" + d.renamedNew.get(0))
        }
        bus.publish("diff.computed", "added=" + d.added.size + ",deleted=" + d.deleted.size + ",modified=" + d.modified.size)
    }

    save(): Bool {
        return wsSaveAll(bus, joinPath(root, "build"), current)
    }

    load(): Bool {
        var idxPath = joinPath(joinPath(root, "build"), "workspace.idx")
        var snap = wsLoadIndex(idxPath)
        if (snap.root == "") {
            loaded = false
            bus.publish("workspace.cacheInvalid", idxPath)
            return false
        }
        if (snap.root != root) {
            bus.publish("workspace.cacheInvalid", "root mismatch")
            return false
        }
        current = snap
        loaded = true
        return true
    }

    symbolsOf(String file): List<WsSymRec> {
        var out = listOf<WsSymRec>()
        for (var s in current.symbols) {
            if (s.file == file) {
                out.add(s)
            }
        }
        return out
    }

    findSymbol(String name): List<WsSymRec> {
        var out = listOf<WsSymRec>()
        for (var s in current.symbols) {
            if (s.name == name) {
                out.add(s)
            }
        }
        return out
    }

    importsOf(String file): List<String> {
        var out = listOf<String>()
        for (var i in current.imports) {
            if (i.file == file) {
                out.add(i.name)
            }
        }
        return out
    }

    depsFrom(String file): List<String> {
        var out = listOf<String>()
        for (var e in current.deps) {
            if (e.from == file) {
                out.add(e.to)
            }
        }
        return out
    }

    cycles(): List<String> {
        return wsDetectCycle(current.deps)
    }

    unusedImports(): List<WsImpRec> {
        var parsed = listOf<WsParsedRec>()
        for (var f in current.files) {
            parsed.add(wsParseFile(f.path))
        }
        var flat = current.imports
        return wsUnusedImports(parsed, flat)
    }

    diffVsCurrent(): WsDiffRec {
        var freshPaths = listOf<String>()
        wsCollectFiles(root, 1, freshPaths)
        var nextFiles = listOf<WsFileRec>()
        for (var p in freshPaths) {
            var pr = wsParseFile(p)
            var sz = 0
            nextFiles.add(WsFileRec(p, pr.hash, sz))
        }
        return wsDiff(current.files, nextFiles)
    }

    putDiag(String file, Int hash, Int count, String codes) {
        diagCache.add(WsDiagRec(file, hash, count, codes))
    }

    cachedDiag(String file, Int hash): WsDiagRec {
        for (var d in diagCache) {
            if (d.file == file && d.hash == hash) {
                return d
            }
        }
        return WsDiagRec("", 0, -1, "")
    }

    statsJson(): String {
        var out = "{\"root\":\"" + escapeJson(root) + "\""
        out = out + ",\"files\":" + current.files.size
        out = out + ",\"symbols\":" + current.symbols.size
        out = out + ",\"imports\":" + current.imports.size
        out = out + ",\"deps\":" + current.deps.size
        out = out + ",\"branch\":\"" + escapeJson(current.gitBranch) + "\""
        out = out + ",\"commit\":\"" + escapeJson(current.gitCommit) + "\""
        out = out + ",\"target\":\"" + current.target + "\""
        out = out + ",\"loaded\":" + loaded
        out = out + "}"
        return out
    }
}

toolGap(String gapCode, String detail): ToolResult {
    var r = ToolResult()
    r.status = "gap"
    r.data = gapCode + "|" + detail
    return r
}

toolDenied(String perm): ToolResult {
    var r = ToolResult()
    r.status = "denied"
    r.data = perm
    return r
}

toolCancelled(): ToolResult {
    var r = ToolResult()
    r.status = "cancelled"
    r.data = ""
    return r
}

toolOk(String data): ToolResult {
    var r = ToolResult()
    r.status = "ok"
    r.data = data
    return r
}

toolErr(String code, String detail): ToolResult {
    var r = ToolResult()
    r.status = "error"
    r.data = code + "|" + detail
    return r
}

record ToolSpec(String id, String name, String category, String description, String inputSchema, String outputSchema, String permission)
record ToolCall(String toolId, String requestId, String a, String b, Int n)
PERM_FS_READ(): String { return "filesystem.read" }
PERM_FS_WRITE(): String { return "filesystem.write" }
PERM_COMPILER_EXEC(): String { return "compiler.execute" }
PERM_GIT_WRITE(): String { return "git.write" }
PERM_SYSTEM_EXEC(): String { return "system.execute" }
PERM_WEB_NETWORK(): String { return "web.network" }







class ToolCtx {
    String requestId = "-"
    EventBus bus
    TimeSource clock
    List<String> grants = listOf<String>()
    Bool cancelled = false
    Metrics met = Metrics()
    WorkspaceIndex wsi

    constructor(EventBus b, TimeSource ts) {
        bus = b
        clock = ts
        wsi = WorkspaceIndex(".", b, ts)
    }

    grant(String p) {
        grants.add(p)
    }

    revoke(String p) {
        var i = 0
        while (i < grants.size) {
            if (grants.get(i) == p) {
                grants.remove(i)
                return
            }
            i = i + 1
        }
    }

    hasGrant(String p): Bool {
        for (var g in grants) {
            if (g == p) {
                return true
            }
        }
        return false
    }
}

class ToolEntry {
    ToolSpec spec
    DispatchHandler handler
    Int version = 1
    constructor(ToolSpec s, DispatchHandler h) {
        spec = s
        handler = h
    }
}

class ToolRegistry {
    List<ToolEntry> entries = listOf<ToolEntry>()

    register(ToolSpec s, DispatchHandler h) {
        entries.add(ToolEntry(s, h))
    }

    findById(String id): ToolEntry {
        for (var e in entries) {
            if (e.spec.id == id) {
                return e
            }
        }
        return ToolEntry(ToolSpec("", "", "", "", "", "", ""), DispatchHandler())
    }

    hasId(String id): Bool {
        for (var e in entries) {
            if (e.spec.id == id) {
                return true
            }
        }
        return false
    }

    byCategory(String cat): List<ToolSpec> {
        var out = listOf<ToolSpec>()
        for (var e in entries) {
            if (e.spec.category == cat) {
                out.add(e.spec)
            }
        }
        return out
    }

    size(): Int {
        return entries.size
    }

    missingPermFor(ToolCtx c, String id): String {
        var e = findById(id)
        return entryMissingPerm(c, e)
    }

    entryMissingPerm(ToolCtx c, ToolEntry e): String {
        var need = e.spec.permission
        if (need == "") {
            return ""
        }
        if (!c.hasGrant(need)) {
            return need
        }
        return ""
    }
}

class DispatchHandler {
    constructor() {
    }
    call(ToolCtx c, ToolCall t): ToolResult {
        if (t.toolId == "fs.read") {
            return tlFsRead(c, t)
        }
        if (t.toolId == "fs.exists") {
            return tlFsExists(c, t)
        }
        if (t.toolId == "fs.metadata") {
            return tlFsMetadata(c, t)
        }
        if (t.toolId == "fs.list") {
            return tlFsList(c, t)
        }
        if (t.toolId == "fs.append") {
            return tlFsAppend(c, t)
        }
        if (t.toolId == "fs.copy") {
            return tlFsCopy(c, t)
        }
        if (t.toolId == "fs.mkdir") {
            return tlFsMkdir(c, t)
        }
        if (t.toolId == "fs.write") {
            return tlFsWrite(c, t)
        }
        if (t.toolId == "fs.delete") {
            return tlFsDelete(c, t)
        }
        if (t.toolId == "fs.rename") {
            return tlFsRename(c, t)
        }
        if (t.toolId == "fs.rollbackRestore") {
            return tlFsRestoreBackup(c, t)
        }
        if (t.toolId.startsWith("ws.")) {
            return tlWorkspace(c, t)
        }
        if (t.toolId == "search.text") {
            return tlSearchText(c, t)
        }
        if (t.toolId == "search.symbol") {
            return tlSearchSymbol(c, t)
        }
        if (t.toolId == "search.path") {
            return tlSearchPath(c, t)
        }
        if (t.toolId == "patch.file") {
            return tlPatchFile(c, t)
        }
        if (t.toolId == "patch.replace") {
            return tlPatchReplace(c, t)
        }
        if (t.toolId == "patch.append") {
            return tlPatchAppend(c, t)
        }
        if (t.toolId == "diff.file") {
            return tlDiffFile(c, t)
        }
        if (t.toolId == "git.branch") {
            return tlGitBranch(c, t)
        }
        if (t.toolId == "git.log") {
            return tlGitLog(c, t)
        }
        if (t.toolId.startsWith("compiler.")) {
            return toolGap("GW-EXEC", "process.run indisponivel (J2/GW001); usar ponte scripts/golden_compiler.sh")
        }
        if (t.toolId.startsWith("ast.")) {
            return toolGap("GW-AST-DUMP", "compilador ainda nao expoe AST estruturada")
        }
        if (t.toolId.startsWith("web.") || t.toolId.startsWith("http.")) {
            return toolGap("GW-NET", "rede chega com kof.http/kof.web na plataforma")
        }
        if (t.toolId.startsWith("ui.")) {
            return toolGap("GW-UI", "ui via kof.ui/KofJS em milestone futura")
        }
        if (t.toolId.startsWith("system.")) {
            return toolGap("GW-SYS", "execucao de sistema depende de process.run upstream")
        }
        return toolErr("TOOL-NOTFOUND", t.toolId)
    }
}
tlBackup(String path): String {
    var bak = path + ".katool-bak"
    var src = File(path)
    if (src.exists() && src.isFile()) {
        var b = File(bak)
        if (b.exists()) {
            b.delete()
        }
        b.writeText(src.readText())
        return bak
    }
    return ""
}

replaceAllStr(String body, String from, String to): String {
    var out = ""
    var rest = body
    while (rest.length > 0) {
        var at = rest.indexOf(from)
        if (at < 0) {
            out = out + rest
            rest = ""
        } else {
            out = out + rest.substring(0, at) + to
            rest = rest.substring(at + from.length, rest.length)
        }
    }
    return out
}

tlFsRead(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    if (!f.exists() || !f.isFile()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    return toolOk(f.readText())
}

tlFsExists(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    var d = Directory(t.a)
    var isFile = f.exists() && f.isFile()
    var isDir = d.exists() && d.isDirectory()
    if (isFile) {
        return toolOk("{\"exists\":true,\"kind\":\"file\"}")
    }
    if (isDir) {
        return toolOk("{\"exists\":true,\"kind\":\"dir\"}")
    }
    return toolOk("{\"exists\":false}")
}

tlFsMetadata(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    if (!f.exists() || !f.isFile()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    var txt = f.readText()
    return toolOk("{\"size\":" + txt.length + ",\"hash\":" + wsHash(txt) + "}")
}

tlFsList(ToolCtx c, ToolCall t): ToolResult {
    var d = Directory(t.a)
    if (!d.exists() || !d.isDirectory()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    var names = d.list()
    var out = "["
    var first = true
    for (var n in names) {
        if (!first) {
            out = out + ","
        }
        first = false
        out = out + "\"" + escapeJson(n) + "\""
    }
    return toolOk(out + "]")
}

tlFsAppend(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    if (!f.appendText(t.b)) {
        return toolErr("FS-WRITEFAIL", t.a)
    }
    return toolOk("appended")
}

tlFsCopy(ToolCtx c, ToolCall t): ToolResult {
    var s = File(t.a)
    if (!s.exists() || !s.isFile()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    var d = File(t.b)
    if (d.exists()) {
        d.delete()
    }
    if (!d.writeText(s.readText())) {
        return toolErr("FS-WRITEFAIL", t.b)
    }
    return toolOk("copied")
}

tlFsMkdir(ToolCtx c, ToolCall t): ToolResult {
    var d = Directory(t.a)
    if (d.exists()) {
        return toolOk("exists")
    }
    if (!d.createDirectories()) {
        return toolErr("FS-MKDIRFAIL", t.a)
    }
    return toolOk("created")
}

tlFsWrite(ToolCtx c, ToolCall t): ToolResult {
    var existed = File(t.a).exists()
    var bak = tlBackup(t.a)
    var f = File(t.a)
    if (!f.writeText(t.b)) {
        return toolErr("FS-WRITEFAIL", t.a)
    }
    var r = toolOk("{\"bytes\":" + t.b.length + "}")
    if (existed) {
        r.rollback = ToolRollback("restore", bak)
    } else {
        r.rollback = ToolRollback("delete-created", t.a)
    }
    c.bus.publish("patch.applied", t.a)
    return r
}

tlFsDelete(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    if (!f.exists()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    var bak = tlBackup(t.a)
    if (!f.delete()) {
        return toolErr("FS-DELETEFAIL", t.a)
    }
    var r = toolOk("deleted")
    r.rollback = ToolRollback("restore", bak)
    return r
}

tlFsRename(ToolCtx c, ToolCall t): ToolResult {
    var s = File(t.a)
    if (!s.exists()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    var d = File(t.b)
    if (d.exists()) {
        return toolErr("FS-EXISTS", t.b)
    }
    var content = s.readText()
    s.delete()
    if (!d.writeText(content)) {
        return toolErr("FS-WRITEFAIL", t.b)
    }
    return toolOk("renamed")
}

tlFsRestoreBackup(ToolCtx c, ToolCall t): ToolResult {
    var bak = File(t.a)
    if (!bak.exists()) {
        return toolErr("FS-NOBACKUP", t.a)
    }
    var target = File(t.b)
    if (target.exists()) {
        target.delete()
    }
    target.writeText(bak.readText())
    bak.delete()
    return toolOk("restored")
}
tlWorkspace(ToolCtx c, ToolCall t): ToolResult {
    var idx = c.wsi
    if (!idx.loaded) {
        return toolGap("WS-NOTLOADED", "host injeta WorkspaceIndex carregado")
    }
    if (t.toolId == "ws.snapshot") {
        if (!idx.save()) {
            return toolErr("WS-SAVEFAIL", idx.root)
        }
        return toolOk(idx.statsJson())
    }
    if (t.toolId == "ws.diff") {
        var d = idx.diffVsCurrent()
        return toolOk("{\"added\":" + d.added.size + ",\"modified\":" + d.modified.size + ",\"deleted\":" + d.deleted.size + ",\"renamed\":" + d.renamedOld.size + "}")
    }
    if (t.toolId == "ws.findSymbol") {
        var hits = idx.findSymbol(t.a)
        var out = "["
        var first = true
        for (var h in hits) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"name\":\"" + escapeJson(h.name) + "\",\"kind\":\"" + h.kind + "\",\"file\":\"" + escapeJson(h.file) + "\"}"
        }
        return toolOk(out + "]")
    }
    if (t.toolId == "ws.findFile") {
        var out2 = "["
        var first2 = true
        for (var ff in idx.current.files) {
            if (ff.path.contains(t.a)) {
                if (!first2) {
                    out2 = out2 + ","
                }
                first2 = false
                out2 = out2 + "\"" + escapeJson(ff.path) + "\""
            }
        }
        return toolOk(out2 + "]")
    }
    if (t.toolId == "ws.graph") {
        var cyc = idx.cycles()
        return toolOk("{\"edges\":" + idx.current.deps.size + ",\"cycles\":" + cyc.size + "}")
    }
    if (t.toolId == "ws.invalidate") {
        var pf = File(joinPath(joinPath(idx.root, "build"), "workspace.idx"))
        if (pf.exists()) {
            pf.delete()
        }
        idx.loaded = false
        return toolOk("invalidated")
    }
    if (t.toolId == "ws.open") {
        var snap = idx.fullRescan()
        return toolOk("{\"files\":" + snap.files.size + ",\"symbols\":" + snap.symbols.size + "}")
    }
    return toolErr("TOOL-NOTFOUND", t.toolId)
}

tlSearchText(ToolCtx c, ToolCall t): ToolResult {
    var idx = c.wsi
    if (!idx.loaded) {
        return toolGap("WS-NOTLOADED", "search usa indice do workspace")
    }
    var out = "["
    var first = true
    for (var ff in idx.current.files) {
        var rf = File(ff.path)
        if (rf.exists() && rf.isFile()) {
            var body = rf.readText()
            var n = wsCountOccurrences(body, t.a)
            if (n > 0) {
                if (!first) {
                    out = out + ","
                }
                first = false
                out = out + "{\"file\":\"" + escapeJson(ff.path) + "\",\"count\":" + n + "}"
            }
        }
    }
    return toolOk(out + "]")
}

tlSearchSymbol(ToolCtx c, ToolCall t): ToolResult {
    return tlWorkspace(c, ToolCall("ws.findSymbol", t.requestId, t.a, "", 0))
}

tlSearchPath(ToolCtx c, ToolCall t): ToolResult {
    return tlWorkspace(c, ToolCall("ws.findFile", t.requestId, t.a, "", 0))
}

tlPatchFile(ToolCtx c, ToolCall t): ToolResult {
    return tlFsWrite(c, t)
}

tlPatchReplace(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    if (!f.exists() || !f.isFile()) {
        return toolErr("FS-NOTFOUND", t.a)
    }
    var sep = t.b.indexOf("|")
    if (sep < 1) {
        return toolErr("PATCH-ARGS", "esperado from|to")
    }
    var from = t.b.substring(0, sep)
    var to = t.b.substring(sep + 1, t.b.length)
    var body = f.readText()
    var n = wsCountOccurrences(body, from)
    if (n == 0) {
        return toolErr("PATCH-TARGET-MISSING", from)
    }
    var bak = tlBackup(t.a)
    var replaced = replaceAllStr(body, from, to)
    if (!f.writeText(replaced)) {
        return toolErr("FS-WRITEFAIL", t.a)
    }
    var r = toolOk("{\"replacements\":" + n + "}")
    r.rollback = ToolRollback("restore", bak)
    c.bus.publish("patch.applied", t.a)
    return r
}

tlPatchAppend(ToolCtx c, ToolCall t): ToolResult {
    var f = File(t.a)
    var cur = ""
    if (f.exists() && f.isFile()) {
        cur = f.readText()
    }
    return tlFsWrite(c, ToolCall("fs.write", t.requestId, t.a, cur + t.b, 0))
}

tlDiffFile(ToolCtx c, ToolCall t): ToolResult {
    var fa = File(t.a)
    var fb = File(t.b)
    if (!fa.exists() || !fb.exists()) {
        return toolErr("FS-NOTFOUND", t.a + "|" + t.b)
    }
    var la = splitStr(fa.readText(), "\n")
    var lb = splitStr(fb.readText(), "\n")
    var samePrefix = 0
    var minL = la.size
    if (lb.size < minL) {
        minL = lb.size
    }
    var i = 0
    while (i < minL) {
        if (la.get(i) == lb.get(i)) {
            samePrefix = i + 1
            i = i + 1
        } else {
            i = minL
        }
    }
    var added = lb.size - samePrefix
    var removed = la.size - samePrefix
    var same = added == 0 && removed == 0
    return toolOk("{\"same\":" + same + ",\"addedLines\":" + added + ",\"removedLines\":" + removed + ",\"firstDiffLine\":" + samePrefix + "}")
}

tlGitBranch(ToolCtx c, ToolCall t): ToolResult {
    var gi = wsGitInfo(t.a)
    return toolOk("{\"branch\":\"" + escapeJson(gi.branch) + "\",\"commit\":\"" + escapeJson(gi.commit) + "\"}")
}

tlGitLog(ToolCtx c, ToolCall t): ToolResult {
    var lf = File(joinPath(joinPath(joinPath(t.a, ".git"), "logs"), "HEAD"))
    if (!lf.exists() || !lf.isFile()) {
        return toolGap("GIT-NOLOG", "sem reflog em " + t.a)
    }
    var lines = splitStr(lf.readText(), "\n")
    var count = 0
    for (var x in lines) {
        if (x.trim().length > 0) {
            count = count + 1
        }
    }
    return toolOk("{\"entries\":" + count + "}")
}

regTool(ToolRegistry reg, String id, String name, String cat, String desc, String inS, String outS, String perm) {
    reg.register(ToolSpec(id, name, cat, desc, inS, outS, perm), DispatchHandler())
}

defaultRegistry(): ToolRegistry {
