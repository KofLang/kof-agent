SEEDB(): String { return "build/brain_corpus" }

seedBrain() {
    mkFile("build/brain_corpus/language/spawn-doc.md", "---\nid: b-spawn\ntitle: spawn task scheduler\nmodule: language\ncategory: language\nkeywords: spawn,task,scheduler\nsymbols: spawn\n---\nspawn executa tarefas.")
    mkFile("build/brain_corpus/diagnostics/E999.md", "---\nid: b-e999\ntitle: erro E999\nmodule: diagnostics\ncategory: diagnostics\nkeywords: e999\n---\nworkaround documentado.")
}

mkPlan(String text): BrainPlan {
    seedBrain()
    return brainProcess(freshBus(), corpusLoad(freshBus(), SEEDB(), FixedClock(1)), text, listOf<String>(), listOf<String>())
}

test "intent create website" {
    var p = mkPlan("cria um site")
    assert(p.intent == "CreateWebsite")
}

test "intent faz website sinonimo" {
    var p = mkPlan("faz um site")
    assert(p.intent == "CreateWebsite")
}

test "intent gere site" {
    var p = mkPlan("gere um site")
    assert(p.intent == "CreateWebsite")
}

test "intent edita website" {
    var p = mkPlan("edita esse site")
    assert(p.intent == "EditWebsite")
}

test "intent cria api" {
    var p = mkPlan("cria uma api rest")
    assert(p.intent == "CreateAPI")
}

test "intent gera crud" {
    var p = mkPlan("gera um crud de produtos")
    assert(p.intent == "GenerateCRUD")
}

test "intent arruma erro com codigo" {
    var p = mkPlan("arruma o erro ARITH001")
    assert(p.intent == "RepairDiagnostic")
}

test "intent explique diagnostico" {
    var p = mkPlan("explique o erro SEM011")
    assert(p.intent != "Unknown")
}

test "intent busca simbolo" {
    var p = mkPlan("busque a funcao soma")
    assert(p.intent.contains("Search") || p.intent.contains("search"))
}

test "intent roda testes" {
    var p = mkPlan("rode os testes")
    assert(p.intent.contains("RunTests"))
}

test "intent rpa" {
    var p = mkPlan("cria uma automacao rpa")
    assert(p.intent == "CreateRPA")
}

test "unknown intent para texto vazio de verbos" {
    var p = mkPlan("janela janela janela")
    assert(p.intent == "Unknown")
}
main() {
}
