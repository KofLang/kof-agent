test "tool started and finished events fire" {
    mkFile("build/tt/e1.txt", "x\n")
    var rec = RecordingHandler()
    var bus = freshBus()
    bus.subscribe("tool.started", rec)
    bus.subscribe("tool.finished", rec)
    var c = ToolCtx(bus, FixedClock(3))
    toolExec(defaultRegistry(), c, ToolCall("fs.read", "m1", "build/tt/e1.txt", "", 0))
    assert(rec.seen.size == 2)
}

test "failed event on unknown tool" {
    var rec = RecordingHandler()
    var bus = freshBus()
    bus.subscribe("tool.failed", rec)
    var c = ToolCtx(bus, FixedClock(3))
    var r = toolExec(defaultRegistry(), c, ToolCall("nao.existe", "m2", "", "", 0))
    assert(r.status == "error")
    assert(rec.seen.size == 1)
}

test "duration measured via injected clock" {
    var clock = FixedClock(100)
    var c = ToolCtx(freshBus(), clock)
    mkFile("build/tt/dur.txt", "conteudo\n")
    var r = toolExec(defaultRegistry(), c, ToolCall("fs.read", "m3", "build/tt/dur.txt", "", 0))
    assert(r.durationMs == 0)
    clock.advance(50)
}

test "metrics counters increment on execution" {
    var c = ToolCtx(freshBus(), FixedClock(7))
    mkFile("build/tt/m.txt", "z\n")
    toolExec(defaultRegistry(), c, ToolCall("fs.read", "m4", "build/tt/m.txt", "", 0))
    assert(c.met.tasksLaunched == 1)
    assert(c.met.tasksCompleted == 1)
}

test "cancellation returns cancelled status" {
    var c = ToolCtx(freshBus(), FixedClock(7))
    c.cancelled = true
    var r = toolExec(defaultRegistry(), c, ToolCall("fs.read", "m5", "", "", 0))
    assert(r.status == "cancelled")
}

test "request id flows into started event" {
    var rec = RecordingHandler()
    var bus = freshBus()
    bus.subscribe("tool.started", rec)
    mkFile("build/tt/rid.txt", "q\n")
    var c = ToolCtx(bus, FixedClock(9))
    c.requestId = "req-77"
    toolExec(defaultRegistry(), c, ToolCall("fs.read", "m6", "build/tt/rid.txt", "", 0))
    assert(rec.seen.get(0).contains("req-77"))
}

test "git.branch reads fixture git dir" {
    mkFile("build/tt_g/.git/HEAD", "ref: refs/heads/main\n")
    mkFile("build/tt_g/.git/refs/heads/main", "deadbeef\n")
    var r = toolExec(defaultRegistry(), mkCtx(), ToolCall("git.branch", "m7", "build/tt_g", "", 0))
    assert(r.data.contains("\"branch\":\"main\""))
    assert(r.data.contains("deadbeef"))
}

test "git.log counts reflog entries" {
    mkFile("build/tt_g2/.git/logs/HEAD", "e1\n\ne2\n")
    var r = toolExec(defaultRegistry(), mkCtx(), ToolCall("git.log", "m8", "build/tt_g2"))
    assert(r.data.contains("\"entries\":2"))
}

main() {
}
