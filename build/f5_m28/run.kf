record CheckRec(String id, Bool ok, String detail)

interface TimeSource {
    nowMs(): Long
}

class FixedClock implements TimeSource {
    Long value = 0
    constructor(Long v) {
        value = v
    }
    nowMs(): Long {
        return value
    }
    advance(Long ms) {
        value = value + ms
    }
}

parseIntStr(String s): Int {
    var n = 0
    var i = 0
    if (s.length == 0) {
        throw "parse: empty integer"
    }
    var start = 0
    if (s.charAt(0) == 45) {
        start = 1
        if (s.length == 1) {
            throw "parse: invalid integer '" + s + "'"
        }
    }
    i = start
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < 48 || c > 57) {
            throw "parse: invalid integer '" + s + "'"
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if (start == 1) {
        n = 0 - n
    }
    return n
}

parseBoolStr(String s): Bool {
    var v = s.toLowerCase()
    if (v == "true" || v == "1" || v == "yes" || v == "on") {
        return true
    }
    if (v == "false" || v == "0" || v == "no" || v == "off" || v == "") {
        return false
    }
    throw "parse: invalid boolean '" + s + "'"
}

escapeJson(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 34) {
            out = out + "\\\""
        } else if (c == 92) {
            out = out + "\\\\"
        } else if (c == 10) {
            out = out + "\\n"
        } else if (c == 13) {
            out = out + "\\r"
        } else if (c == 9) {
            out = out + "\\t"
        } else {
            out = out + s.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

joinPath(String a, String b): String {
    if (a == "") {
        return b
    }
    if (a.substring(a.length - 1, a.length) == "/") {
        return a + b
    }
    return a + "/" + b
}

splitStr(String s, String sep): List<String> {
    var out = listOf<String>()
    if (s.length == 0) {
        return out
    }
    var sc = sep.charAt(0)
    var start = 0
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == sc) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, s.length))
    return out
}

loadArgsFile(String path): List<String> {
    var argv = listOf<String>()
    var f = File(path)
    if (!f.exists()) {
        return argv
    }
    var txt = f.readText()
    var lines = splitStr(txt, "\n")
    for (var line in lines) {
        var t = line.trim()
        if (t.length > 0) {
            argv.add(t)
        }
    }
    return argv
}

sortInts(Int[] a, Int n) {
    var i = 1
    while (i < n) {
        var key = a[i]
        var j = i - 1
        var placed = false
        while (!placed) {
            if (j < 0) {
                placed = true
            } else {
                if (a[j] > key) {
                    a[j + 1] = a[j]
                    j = j - 1
                } else {
                    placed = true
                }
            }
        }
        a[j + 1] = key
        i = i + 1
    }
}

mkFile(String path, String content): Bool {
    var parent = ""
    var parts = splitStr(path, "/")
    if (parts.size > 1) {
        var i = 0
        while (i < parts.size - 1) {
            if (parent == "") {
                parent = parts.get(i)
            } else {
                parent = joinPath(parent, parts.get(i))
            }
            i = i + 1
        }
        var d = Directory(parent)
        if (!d.exists()) {
            d.createDirectories()
        }
    }
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
    return f.writeText(content)
}

class EventCounter implements EventHandler {
    Int count = 0
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        count = count + 1
        return true
    }
}

class RecordingHandler implements EventHandler {
    List<String> seen = listOf<String>()
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        seen.add(e.topic + "=" + e.payload)
        return true
    }
}

freshBus(): EventBus {
    return EventBus()
}

record CfgEntry(String key, String value)

class Config {
    List<CfgEntry> entries = listOf<CfgEntry>()
    String sourcePath = ""
    Bool loaded = false

    loadFile(String path): Bool {
        entries = listOf<CfgEntry>()
        sourcePath = path
        var f = File(path)
        if (!f.exists()) {
            loaded = false
            return false
        }
        if (!f.isFile()) {
            loaded = false
            return false
        }
        var text = f.readText()
        parseInto(text)
        loaded = true
        return true
    }

    reload(): Bool {
        return loadFile(sourcePath)
    }

    parseInto(String text) {
        var lines = splitStr(text, "\n")
        for (var raw in lines) {
            var line = raw.trim()
            if (line.length > 0) {
                if (!line.startsWith("#")) {
                    var kv = splitStr(line, "=")
                    if (kv.size == 2) {
                        var k = kv.get(0).trim()
                        var v = kv.get(1).trim()
                        entries.add(CfgEntry(k, v))
                    }
                }
            }
        }
    }

    has(String key): Bool {
        for (var e in entries) {
            if (e.key == key) {
                return true
            }
        }
        return false
    }

    getRaw(String key): String {
        for (var e in entries) {
            if (e.key == key) {
                return e.value
            }
        }
        throw "config: missing key '" + key + "'"
    }

    getStr(String key, String def): String {
        if (!has(key)) {
            return def
        }
        return getRaw(key)
    }

    getInt(String key, Int def): Int {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseIntStr(v)
        } catch (String e) {
            throw "config: invalid integer for '" + key + "': '" + v + "'"
        }
    }

    getBool(String key, Bool def): Bool {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseBoolStr(v)
        } catch (String e) {
            throw "config: invalid boolean for '" + key + "': '" + v + "'"
        }
    }

    snapshotJson(): String {
        var out = "{\"source\":\"" + escapeJson(sourcePath) + "\",\"loaded\":"
        if (loaded) {
            out = out + "true"
        } else {
            out = out + "false"
        }
        out = out + ",\"entries\":["
        var first = true
        for (var e in entries) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"key\":\"" + escapeJson(e.key) + "\",\"value\":\"" + escapeJson(e.value) + "\"}"
        }
        out = out + "]}"
        return out
    }
}

TASK_CREATED(): Int { return 0 }
TASK_QUEUED(): Int { return 1 }
TASK_RUNNING(): Int { return 2 }
TASK_WAITING(): Int { return 3 }
TASK_COMPLETED(): Int { return 4 }
TASK_CANCELLED(): Int { return 5 }
TASK_FAILED(): Int { return 6 }

taskStateName(Int st): String {
    if (st == TASK_CREATED()) { return "CREATED" }
    if (st == TASK_QUEUED()) { return "QUEUED" }
    if (st == TASK_RUNNING()) { return "RUNNING" }
    if (st == TASK_WAITING()) { return "WAITING" }
    if (st == TASK_COMPLETED()) { return "COMPLETED" }
    if (st == TASK_CANCELLED()) { return "CANCELLED" }
    return "FAILED"
}

interface ContextView {
    incMetric(String name)
}

interface TaskBody {
    run(ContextView v)
}

class Future {
    Bool done = false
    Bool ok = false
    Int result = 0
    String error = ""
    constructor() {
    }
}

class TaskNode {
    Int id
    Int priority
    Int seq
    String name
    Int st = TASK_CREATED()
    Bool cancelled = false
    TaskBody body
    constructor(Int tid, Int prio, Int sq, String nm, TaskBody b) {
        id = tid
        priority = prio
        seq = sq
        name = nm
        body = b
    }
}

class FutureJob implements TaskBody {
    TaskBody inner
    Future future
    constructor(TaskBody i, Future f) {
        inner = i
        future = f
    }
    run(ContextView v) {
        try {
            inner.run(v)
            future.ok = true
        } catch (String e) {
            future.error = e
            throw e
        } finally {
            future.done = true
        }
    }
}

class Scheduler {
    List<TaskNode> tasks = listOf<TaskNode>()
    Int[] heapPrio = new Int[64]
    Int[] heapSeq = new Int[64]
    Int[] heapIdx = new Int[64]
    Int heapSize = 0
    Int heapCap = 64
    Int nextId = 1
    Int nextSeq = 1
    Int maxPending = 0
    Bool accepting = true
    Int launchedCount = 0
    Int completedCount = 0
    Int failedCount = 0
    Int cancelledCount = 0
    Int rejectedCount = 0
    String lastError = ""
    ContextView view

    constructor(ContextView v) {
        view = v
    }

    ensureCap(Int need) {
        if (need <= heapCap) {
            return
        }
        var nc = heapCap * 2
        while (nc < need) {
            nc = nc * 2
        }
        var np = new Int[nc]
        var ns = new Int[nc]
        var ni = new Int[nc]
        var i = 0
        while (i < heapSize) {
            np[i] = heapPrio[i]
            ns[i] = heapSeq[i]
            ni[i] = heapIdx[i]
            i = i + 1
        }
        heapPrio = np
        heapSeq = ns
        heapIdx = ni
        heapCap = nc
    }

    lessThan(Int a, Int b): Bool {
        if (heapPrio[a] > heapPrio[b]) {
            return true
        }
        if (heapPrio[a] < heapPrio[b]) {
            return false
        }
        return heapSeq[a] < heapSeq[b]
    }

    swapAt(Int a, Int b) {
        var tp = heapPrio[a]
        heapPrio[a] = heapPrio[b]
        heapPrio[b] = tp
        var ts = heapSeq[a]
        heapSeq[a] = heapSeq[b]
        heapSeq[b] = ts
        var ti = heapIdx[a]
        heapIdx[a] = heapIdx[b]
        heapIdx[b] = ti
    }

    heapPush(Int taskIndex) {
        ensureCap(heapSize + 1)
        var i = heapSize
        heapPrio[i] = tasks.get(taskIndex).priority
        heapSeq[i] = tasks.get(taskIndex).seq
        heapIdx[i] = taskIndex
        heapSize = heapSize + 1
        while (i > 0) {
            var parent = (i - 1) / 2
            if (lessThan(i, parent)) {
                swapAt(i, parent)
                i = parent
            } else {
                break
            }
        }
    }

    heapPop(): Int {
        var top = heapIdx[0]
        heapSize = heapSize - 1
        if (heapSize > 0) {
            heapPrio[0] = heapPrio[heapSize]
            heapSeq[0] = heapSeq[heapSize]
            heapIdx[0] = heapIdx[heapSize]
            var i = 0
            while (true) {
                var l = i * 2 + 1
                var r = l + 1
                var m = i
                if (l < heapSize) {
                    if (lessThan(l, m)) {
                        m = l
                    }
                }
                if (r < heapSize) {
                    if (lessThan(r, m)) {
                        m = r
                    }
                }
                if (m == i) {
                    break
                }
                swapAt(i, m)
                i = m
            }
        }
        return top
    }

    launch(TaskBody body, String name, Int priority): Int {
        if (!accepting) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: rejecting launch after shutdown"
        }
        if (maxPending > 0 && heapSize >= maxPending) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: backpressure (pending=" + heapSize + ", max=" + maxPending + ")"
        }
        var node = TaskNode(nextId, priority, nextSeq, name, body)
        nextId = nextId + 1
        nextSeq = nextSeq + 1
        node.st = TASK_QUEUED()
        tasks.add(node)
        heapPush(tasks.size - 1)
        launchedCount = launchedCount + 1
        return node.id
    }

    launchFuture(TaskBody body, String name, Int priority): Future {
        var f = Future()
        var wrapped = FutureJob(body, f)
        launch(wrapped, name, priority)
        return f
    }

    cancel(Int taskId): Bool {
        var idx = taskId - 1
        if (idx < 0 || idx >= tasks.size) {
            return false
        }
        var node = tasks.get(idx)
        if (node.st == TASK_QUEUED() && !node.cancelled) {
            node.cancelled = true
            node.st = TASK_CANCELLED()
            cancelledCount = cancelledCount + 1
            return true
        }
        return false
    }

    executeOne(): Bool {
        if (heapSize == 0) {
            return false
        }
        var idx = heapPop()
        var node = tasks.get(idx)
        if (node.cancelled || node.st == TASK_CANCELLED()) {
            return true
        }
        node.st = TASK_RUNNING()
        try {
            node.body.run(view)
            node.st = TASK_COMPLETED()
            completedCount = completedCount + 1
        } catch (String e) {
            node.st = TASK_FAILED()
            failedCount = failedCount + 1
            lastError = e
        }
        return true
    }

    run(Int maxTasks): Int {
        var n = 0
        while (n < maxTasks) {
            if (!executeOne()) {
                break
            }
            n = n + 1
        }
        return n
    }

    drain() {
        while (executeOne()) {
        }
    }

    await(Future f) {
        while (!f.done) {
            if (heapSize == 0) {
                throw "scheduler: deadlock in await (future unresolved, queue empty)"
            }
            executeOne()
        }
    }

    pending(): Int {
        return heapSize
    }

    gracefulShutdown() {
        accepting = false
        drain()
    }

    statsJson(): String {
        return "{\"pending\":" + heapSize + ",\"launched\":" + launchedCount + ",\"completed\":" + completedCount + ",\"failed\":" + failedCount + ",\"cancelled\":" + cancelledCount + ",\"rejected\":" + rejectedCount + ",\"accepting\":" + accepting + "}"
    }
}

class WorkerPool {
    Int size = 1
    Scheduler sched
    String affinityHint = ""

    constructor(Scheduler s, Int n) {
        sched = s
        if (n != 1) {
            throw "TP001: worker pool size " + n + " unsupported on this target (upstream CONC001); use 1"
        }
        size = n
    }

    launch(TaskBody body, String name): Int {
        return sched.launch(body, name, 5)
    }

    dynamicResize(Int n) {
        throw "TP001: dynamic pool resize unsupported on this target (upstream CONC001)"
    }

    setAffinity(String hint) {
        throw "TP002: affinity unsupported on this target"
    }
}

record EventEnvelope(String topic, String payload, Int seq)

interface EventHandler {
    onEvent(EventEnvelope e): Bool
}

class Subscription {
    Int id
    String topic
    EventHandler h
    Bool once = false
    constructor(Int sid, String t, EventHandler handler, Bool onceFlag) {
        id = sid
        topic = t
        h = handler
        once = onceFlag
    }
}

class EventBus {
    List<Subscription> subs = listOf<Subscription>()
    Int nextId = 1
    Int seq = 1

    subscribe(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, false)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    once(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, true)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    unsubscribe(Int id): Bool {
        var i = 0
        while (i < subs.size) {
            if (subs.get(i).id == id) {
                subs.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    publishEnvelope(EventEnvelope e): Int {
        var matched = listOf<Int>()
        var i = 0
        while (i < subs.size) {
            var s = subs.get(i)
            if (s.topic == e.topic || s.topic == "*") {
                matched.add(i)
            }
            i = i + 1
        }
        var called = 0
        for (var m in matched) {
            var sub = subs.get(m)
            if (sub.once) {
                unsubscribe(sub.id)
            }
            called = called + 1
            var cont = sub.h.onEvent(e)
            if (!cont) {
                break
            }
        }
        return called
    }

    publish(String topic, String payload): Int {
        var env = EventEnvelope(topic, payload, seq)
        seq = seq + 1
        return publishEnvelope(env)
    }

    broadcast(String payload): Int {
        return publish("*", payload)
    }

    publishAsync(Scheduler sched, ContextView view, String topic, String payload): Int {
        var job = PublishJob(this, topic, payload)
        return sched.launch(job, "event.publish", 5)
    }

    statsJson(): String {
        return "{\"subscribers\":" + subs.size + ",\"published\":" + (seq - 1) + "}"
    }
}

class PublishJob implements TaskBody {
    EventBus bus
    String topic
    String payload
    constructor(EventBus b, String t, String p) {
        bus = b
        topic = t
        payload = p
    }
    run(ContextView v) {
        bus.publish(topic, payload)
    }
}

record GgufInfoRec(String path, Bool magicOk, Int version, Int nTensors)
record TensorR(Int rows, Int cols, Int[] data)

tkTokenize(String text): List<String> {
    var out = listOf<String>()
    var cur = ""
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)
        if (alpha) {
            cur = cur + text.substring(i, i + 1)
        } else {
            if (cur.length > 0) {
                out.add(cur)
                cur = ""
            }
        }
        i = i + 1
    }
    if (cur.length > 0) {
        out.add(cur)
    }
    return out
}

class Vocab {
    List<String> tokens = listOf<String>()
    constructor() {
    }
    addToken(String t): Int {
        var id = tkId(t)
        tokens.add(t)
        return id
    }
    size(): Int {
        return tokens.size
    }
    tokenAt(Int i): String {
        return tokens.get(i)
    }
}

tkId(String t): Int {
    var h = wsHash(retLower(t))
    if (h < 0) {
        h = 0 - h
    }
    return h % 50000
}

vocabBuildFromCorpus(CorpusIndex ix): Vocab {
    var v = Vocab()
    for (var d in ix.docs) {
        var toks = tkTokenize(d.meta.title + " " + d.body)
        for (var t in toks) {
            if (v.size() < 4096) {
                var dup = false
                for (var e in v.tokens) {
                    if (e == t) {
                        dup = true
                    }
                }
                if (!dup) {
                    v.addToken(t)
                }
            }
        }
    }
    return v
}

tkEncode(Vocab v, String text): List<Int> {
    var ids = listOf<Int>()
    for (var t in tkTokenize(text)) {
        ids.add(tkId(t))
    }
    return ids
}

tkDecode(List<Int> ids): String {
    var out = ""
    for (var id in ids) {
        out = out + "<" + id + ">"
    }
    return out
}

samplerLcg(Int seed): Int {
    var x = seed * 1103515245 + 12345
    if (x < 0) {
        x = 0 - x
    }
    return x % 2147483647
}

samplerTopK(Int[] logits, Int n, Int k, Int seed): Int {
    var best = logits[0]
    var bi = 0
    var s = samplerLcg(seed)
    var i = 0
    while (i < n) {
        if (logits[i] > best) {
            best = logits[i]
            bi = i
        }
        i = i + 1
    }
    var jitter = s % (k + 1)
    if (jitter == 0) {
        return bi
    }
    var alt = (bi + jitter) % n
    return alt
}

tensorNew(Int rows, Int cols): TensorR {
    return TensorR(rows, cols, new Int[rows * cols])
}

tensorGet(TensorR t, Int r, Int cc): Int {
    return t.data[r * t.cols + cc]
}

tensorSet(TensorR t, Int r, Int cc, Int v) {
    t.data[r * t.cols + cc] = v
}

tensorTranspose(TensorR t): TensorR {
    var o = tensorNew(t.cols, t.rows)
    var r = 0
    while (r < t.rows) {
        var c2 = 0
        while (c2 < t.cols) {
            tensorSet(o, c2, r, tensorGet(t, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

tensorMatMul(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows, b.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < b.cols) {
            var acc = 0
            var kk = 0
            while (kk < a.cols) {
                acc = acc + tensorGet(a, r, kk) * tensorGet(b, kk, c2)
                kk = kk + 1
            }
            tensorSet(o, r, c2, acc)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

ggufParseHeader(String path): GgufInfoRec {
    var f = File(path)
    if (!f.exists()) {
        return GgufInfoRec(path, false, 0, 0)
    }
    var txt = f.readText()
    var magicOk = txt.startsWith("GGUF")
    var ver = 0
    var nt = 0
    if (magicOk && txt.length > 9) {
        ver = parseIntStr(txt.substring(4, 6))
        nt = parseIntStr(txt.substring(6, 9))
    }
    return GgufInfoRec(path, magicOk, ver, nt)
}

record TVView(TensorR base, Int offR, Int offC, Int rows, Int cols)

tvGet(TVView v, Int r, Int c): Int {
    return tensorGet(v.base, v.offR + r, v.offC + c)
}

tvSet(TVView v, Int r, Int c2, Int newVal) {
    tensorSet(v.base, v.offR + r, v.offC + c2, newVal)
}

tvSliceRows(TensorR t, Int offR, Int rows): TVView {
    return TVView(t, offR, 0, rows, t.cols)
}

tvBroadcast(Int fill, Int rows, Int cols): TensorR {
    var t = tensorNew(rows, cols)
    var r = 0
    while (r < rows) {
        var c2 = 0
        while (c2 < cols) {
            tensorSet(t, r, c2, fill)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return t
}

tensorReshape(TensorR t, Int rows, Int cols): TensorR {
    var o = tensorNew(rows, cols)
    var i = 0
    while (i < rows * cols && i < t.data.length) {
        o.data[i] = t.data[i]
        i = i + 1
    }
    return o
}

tensorConcatRows(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows + b.rows, a.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < a.cols) {
            tensorSet(o, r, c2, tensorGet(a, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    r = 0
    while (r < b.rows) {
        var c3 = 0
        while (c3 < b.cols) {
            tensorSet(o, a.rows + r, c3, tensorGet(b, r, c3))
            c3 = c3 + 1
        }
        r = r + 1
    }
    return o
}

class Arena {
    Int[] buf = new Int[1024]
    Int used = 0
    constructor() {
    }
    alloc(Int n): Int {
        var at = used
        if (used + n > buf.length) {
            return -1
        }
        used = used + n
        return at
    }
    reset() {
        used = 0
    }
    capacity(): Int {
        return buf.length
    }
    utilization(): Int {
        return used
    }
}

Q8_BLOCK(): Int { return 32 }

quantizeQ8Block(Int[] src, Int off): Int[] {
    var out = new Int[Q8_BLOCK() + 1]
    var maxAbs = 0
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        if (v < 0) {
            if ((0 - v) > maxAbs) {
                maxAbs = 0 - v
            }
        } else {
            if (v > maxAbs) {
                maxAbs = v
            }
        }
        i = i + 1
    }
    out[0] = maxAbs
    i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var q = 0
        if (maxAbs > 0) {
            q = v * 127 / maxAbs
        }
        out[i + 1] = q
        i = i + 1
    }
    return out
}

dequantizeQ8Block(Int[] blk): Int[] {
    var o = new Int[Q8_BLOCK()]
    var scale = blk[0]
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = blk[i + 1]
        if (scale > 0) {
            v = v * scale / 127
        }
        o[i] = v
        i = i + 1
    }
    return o
}

class KVCache {
    List<Int[]> keys = listOf<Int[]>()
    List<Int[]> vals = listOf<Int[]>()
    Int window = 64
    Int evictions = 0
    constructor() {
    }
    append(Int[] k, Int[] v) {
        keys.add(k)
        vals.add(v)
        if (keys.size > window) {
            keys.remove(0)
            vals.remove(0)
            evictions = evictions + 1
        }
    }
    size(): Int {
        return keys.size
    }
    compact() {
        keys = keys
        vals = vals
    }
}

// M16 part 82: Tensor ops V2 — arena, stable softmax, rmsnorm, gelu/silu, causal mask

record ArenaStats(Int allocs, Int reuses, Int peakBytes)
record ArenaSlot(Int key, TensorR tensor)

class TensorArena {
    List<ArenaSlot> free = listOf<ArenaSlot>()
    ArenaStats stats = ArenaStats(0, 0, 0)

    acquire(Int rows, Int cols): TensorR {
        var key = rows * 100000 + cols
        var i = 0
        while (i < free.size()) {
            var s = free.get(i)
            if (s.key == key) {
                var out2 = s.tensor
                var j = i
                while (j < free.size() - 1) {
                    free.set(j, free.get(j + 1))
                    j = j + 1
                }
                stats = ArenaStats(stats.allocs + 1, stats.reuses + 1, stats.peakBytes)
                return out2
            }
            i = i + 1
        }
        stats = ArenaStats(stats.allocs + 1, stats.reuses, stats.peakBytes)
        return tensorNew(rows, cols)
    }

    release(TensorR t) {
        free.add(ArenaSlot(t.rows * 100000 + t.cols, t))
        var bytes = t.rows * t.cols * 4
        if (bytes > stats.peakBytes) {
            stats = ArenaStats(stats.allocs, stats.reuses, bytes)
        }
    }
}

tensorSoftmaxRow(TensorR t, Int row): TensorR {
    var out = tensorNew(1, t.cols)
    var maxv = tensorGet(t, row, 0)
    var c2 = 1
    while (c2 < t.cols) {
        if (tensorGet(t, row, c2) > maxv) {
            maxv = tensorGet(t, row, c2)
        }
        c2 = c2 + 1
    }
    var sum = 0
    c2 = 0
    while (c2 < t.cols) {
        var d = maxv - tensorGet(t, row, c2)
        var e = 10000000 / (10 + d)
        tensorSet(out, 0, c2, e)
        sum = sum + e
        c2 = c2 + 1
    }
    if (sum == 0) { sum = 1 }
    c2 = 0
    while (c2 < t.cols) {
        tensorSet(out, 0, c2, tensorGet(out, 0, c2) * 10000 / sum)
        c2 = c2 + 1
    }
    return out
}

tensorRmsNorm(TensorR t): TensorR {
    var out = tensorNew(t.rows, t.cols)
    var r = 0
    while (r < t.rows) {
        var ss = 0
        var c2 = 0
        while (c2 < t.cols) {
            var v = tensorGet(t, r, c2)
            ss = ss + v * v / 1000
            c2 = c2 + 1
        }
        var inv = 31623 * 1000 / (100 + ss)
        c2 = 0
        while (c2 < t.cols) {
            tensorSet(out, r, c2, tensorGet(t, r, c2) * inv / 100000)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return out
}

gelu(x: Int): Int {
    var x3 = x * x * x / 1000000
    return (x + x3 / 6) / 2
}

silu(x: Int): Int {
    if (x <= 0) { return x / 4 }
    return x
}

record CausalMask(Int penalty)

tensorCausalMask(Int seqLen): TensorR {
    var m = tensorNew(seqLen, seqLen)
    var cm = CausalMask(1000000)
    var i = 0
    while (i < seqLen) {
        var j = 0
        while (j < seqLen) {
            if (j > i) {
                tensorSet(m, i, j, cm.penalty)
            } else {
                tensorSet(m, i, j, 0)
            }
            j = j + 1
        }
        i = i + 1
    }
    return m
}

// M16.2: RoPE V2, KV Cache V2, Quantizacao Q4-Q8, Sampler V3, Arena checkpoints

record RopeFreqs(Int[] cosT, Int[] sinT, Int dims, Int scalePct)

ropeBuild(Int maxPos, Int dims): RopeFreqs {
    var cosT = new Int[maxPos * dims]
    var sinT = new Int[maxPos * dims]
    var p = 0
    while (p < maxPos) {
        var i = 0
        while (i < dims) {
            var freqNum = p * (i + 2)
            var freqDen = dims * 2
            var ang = (freqNum * 3141 / freqDen) % 6283
            var deg = ang * 360 / 6283
            var rad = deg
            var c = 10000
            if (deg <= 90) { c = 10000 - deg * deg * 121 / 10000 / 10 }
            else { c = (180 - deg) * (180 - deg) * 121 / 100000 }
            var s = deg * 1745 / 10000
            if (s > 10000) { s = 10000 }
            cosT[p * dims + i] = c
            sinT[p * dims + i] = s
            i = i + 1
        }
        p = p + 1
    }
    return RopeFreqs(cosT, sinT, dims, 100)
}

applyRope(TensorR q, TensorR k, RopeFreqs rf, Int posOffset) {
    var half = rf.dims / 2
    var r = 0
    while (r < q.rows) {
        var pos = posOffset + r
        var i = 0
        while (i < half) {
            var j = i + half
            var qc = tensorGet(q, r, i)
            var qj = tensorGet(q, r, j)
            var cs = rf.cosT[pos * rf.dims + i]
            var sn = rf.sinT[pos * rf.dims + i]
            tensorSet(q, r, i, (qc * cs - qj * sn) / 10000)
            tensorSet(q, r, j, (qj * cs + qc * sn) / 10000)
            var kc = tensorGet(k, r, i)
            var kj = tensorGet(k, r, j)
            tensorSet(k, r, i, (kc * cs - kj * sn) / 10000)
            tensorSet(k, r, j, (kj * cs + kc * sn) / 10000)
            i = i + 1
        }
        r = r + 1
    }
}

record KVEntry(Int token, Int layer)
record KVSnapshot(Int size, Int cap)

class KVCacheV2 {
    List<Int[]> keys = listOf<Int[]>()
    List<Int[]> values = listOf<Int[]>()
    Int size = 0
    Int window = 0

    initKv(Int win) {
        window = win
        size = 0
    }

    append(Int[] key, Int[] vals) {
        keys.add(key)
        values.add(vals)
        size = size + 1
        if (window > 0 && size > window) {
            keys.remove(0)
            values.remove(0)
            size = size - 1
        }
    }

    keyAt(Int i): Int[] {
        return keys.get(i)
    }

    reset() {
        while (keys.size() > 0) {
            keys.remove(0)
            values.remove(0)
        }
        size = 0
    }

    snapshot(): KVSnapshot {
        return KVSnapshot(size, keys.size())
    }
}

fn quantizeQ4(Int[] src, Int off): Int[] {
    var out = new Int[Q8_BLOCK() / 2 + 1]
    var maxAbs = 0
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var mag = v
        if (mag > maxAbs) { maxAbs = mag }
        var nv = 0 - v
        if (nv > maxAbs) { maxAbs = nv }
        i = i + 1
    }
    out[0] = maxAbs
    i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var q = 0
        if (maxAbs > 0) { q = v * 7 / maxAbs }
        if (q < 0) { q = q + 15 }
        else { q = q }
        var nib = q
        if (nib > 15) { nib = 15 }
        var packed = out[i / 2 + 1]
        if (i % 2 == 0) {
            out[i / 2 + 1] = nib * 16 + packed % 16
        } else {
            out[(i - 1) / 2 + 1] = (packed / 16) * 16 + nib
        }
        i = i + 1
    }
    return out
}

fn dequantizeQ4(Int[] blk): Int[] {
    var o = new Int[Q8_BLOCK()]
    var scale = blk[0]
    var i = 0
    while (i < Q8_BLOCK()) {
        var packed = blk[i / 2 + 1]
        var nib = packed / 16
        if (i % 2 == 1) { nib = packed % 16 }
        var v = nib * scale / 7
        o[i] = v
        i = i + 1
    }
    return o
}

record SamplerConfig(Int temperature, Int topK, Int topP, Int minP, Int repPenalty, Int seed)

fn samplerGreedy(Int[] logits, Int n): Int {
    var best = 0
    var bv = logits[0]
    var i = 1
    while (i < n) {
        var v = logits[i]
        if (v > bv) { bv = v; best = i }
        i = i + 1
    }
    return best
}

record LcgState(Int v)

fn lcgNext(LcgState st): Int {
    var nv = st.v * 1103515245 + 12345
    if (nv < 0) { nv = 0 - nv }
    return nv % 2147483647
}

fn samplerTopKV3(Int[] logits, Int n, Int k, Int seed): Int {
    var chosen = samplerGreedy(logits, n)
    if (k >= n || k <= 0) { return chosen }
    var idx = lcgNext(LcgState(seed)) % n
    return idx
}

// M17: GGUF loader V2/V3 — parser tipado sobre bytes (IO binario pende RTL002)

record TokenizerMetadata(Int vocabSize, Int bosId, Int eosId, Int padId, Int unkId)
record RopeMetadataRec(Int dims, Int freqBase, String scaling, Int ctxLen)
record GgufHeader(Int version, Int tensorCount, Int metaCount, Int align)
record MetaValue(Int kind, Int intVal, String strVal)
record TensorEntry(String name, Int nDims, Int d0, Int d1, Int dtype, Int offset, Int size)
record GgufHandle(GgufHeader header, List<MetaValue> metaKeys, List<String> metaNames, List<TensorEntry> tensors, List<Int[]> blobs, Int errorCount, String errorCode)

fn ggufHexVal(Char c): Int {
    if (c >= '0' && c <= '9') { return c - '0' }
    return (c - 'a') + 10
}

fn ggufDecodeHex(String hex, Int byteOff): Int {
    var i = byteOff * 2
    if (i + 1 >= hex.length) { return 0 }
    var hi = ggufHexVal(hex.charAt(i))
    var lo = ggufHexVal(hex.charAt(i + 1))
    return hi * 16 + lo
}

ggufParseMeta(String metaLine): List<String> {
    var out = listOf<String>()
    var parts = splitStr(metaLine, "|")
    var i = 1
    while (i < parts.size()) {
        out.add(parts.get(i))
        i = i + 1
    }
    return out
}

record MetaPair(String key, Int kind, Int intVal)

ggufParsePairs(String metaLine): List<MetaPair> {
    var out = listOf<MetaPair>()
    var raw = ggufParseMeta(metaLine)
    var i = 0
    while (i < raw.size()) {
        var kv = splitStr(raw.get(i), "=")
        if (kv.size() == 2 && i + 1 < raw.size()) {
            out.add(MetaPair(kv.get(0), parseIntStr(kv.get(1)), parseIntStr(raw.get(i + 1))))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return out
}

record TensorSpec(String name, Int d0, Int d1, Int dtype, Int size, Int offset)

ggufParseTensors(String dirLine): List<TensorSpec> {
    var out = listOf<TensorSpec>()
    var dparts = splitStr(dirLine, "|")
    var align = 32
    var nSpecs = dparts.size()
    if (nSpecs > 0) {
        align = parseIntStr(dparts.get(nSpecs - 1))
        nSpecs = nSpecs - 1
    }
    var i = 0
    while (i < nSpecs) {
        var tp = splitStr(dparts.get(i), ",")
        if (tp.size() == 6) {
            var off = parseIntStr(tp.get(5))
            var sz = parseIntStr(tp.get(4))
            out.add(TensorSpec(tp.get(0), parseIntStr(tp.get(2)), parseIntStr(tp.get(3)), sz, sz, off))
        }
        i = i + 1
    }
    return out
}

ggufParse(String magicLine, String metaLine, String dirLine, String blobLine): GgufHandle {
    var errs = listOf<String>()
    if (!magicLine.startsWith("GGUF")) {
        errs.add("E_MAGIC")
    }
    var ver = parseIntStr(magicLine.substring(4))
    if (ver != 2 && ver != 3) {
        errs.add("E_VERSION")
    }
    var pairs = ggufParsePairs(metaLine)
    var names = listOf<String>()
    var vals = listOf<MetaValue>()
    var i = 0
    while (i < pairs.size()) {
        var pr = pairs.get(i)
        names.add(pr.key)
        vals.add(MetaValue(pr.kind, pr.intVal, ""))
        i = i + 1
    }
    var tensors = listOf<TensorEntry>()
    var specs = ggufParseTensors(dirLine)
    i = 0
    while (i < specs.size()) {
        var sp = specs.get(i)
        tensors.add(TensorEntry(sp.name, 2, sp.d0, sp.d1, sp.dtype, sp.offset, sp.size))
        i = i + 1
    }
    var blobs = listOf<Int[]>()
    var bparts = splitStr(blobLine, ":")
    if (bparts.size() == 2 && bparts.get(0) == "HEX") {
        var hexs = bparts.get(1)
        var total = hexs.length / 2
        var arr = new Int[total]
        var b = 0
        while (b < total) {
            arr[b] = ggufDecodeHex(hexs, b)
            b = b + 1
        }
        blobs.add(arr)
    }
    var align = 32
    var ec = errs.size()
    var code = ""
    if (ec > 0) {
        code = errs.get(0)
    }
    return GgufHandle(GgufHeader(ver, tensors.size(), pairs.size(), align), vals, names, tensors, blobs, ec, code)
}

openGGUF(String specPath): GgufHandle {
    var f = File(specPath)
    if (!f.exists()) {
        return GgufHandle(GgufHeader(0, 0, 0, 32), listOf<MetaValue>(), listOf<String>(), listOf<TensorEntry>(), listOf<Int[]>(), 1, "E_FILE_NOT_FOUND")
    }
    var lines = splitStr(f.readText(), "\n")
    if (lines.size() < 4) {
        return GgufHandle(GgufHeader(0, 0, 0, 32), listOf<MetaValue>(), listOf<String>(), listOf<TensorEntry>(), listOf<Int[]>(), 1, "E_FORMAT")
    }
    var blob = ""
    var li = 0
    while (li < lines.size()) {
        if (lines.get(li).startsWith("HEX")) {
            blob = lines.get(li)
        }
        li = li + 1
    }
    return ggufParse(lines.get(0), lines.get(1), lines.get(2), blob)
}

getMetadata(GgufHandle h, String key): MetaValue {
    var i = 0
    while (i < h.metaNames.size()) {
        if (h.metaNames.get(i) == key) {
            return h.metaKeys.get(i)
        }
        i = i + 1
    }
    return MetaValue(-1, 0, "")
}

hasTensor(GgufHandle h, String name): Bool {
    var i = 0
    while (i < h.tensors.size()) {
        if (h.tensors.get(i).name == name) {
            return true
        }
        i = i + 1
    }
    return false
}

listTensors(GgufHandle h): List<String> {
    var out = listOf<String>()
    var i = 0
    while (i < h.tensors.size()) {
        out.add(h.tensors.get(i).name)
        i = i + 1
    }
    return out
}

getTensorLazy(GgufHandle h, String name): Int[] {
    var i = 0
    while (i < h.tensors.size()) {
        if (h.tensors.get(i).name == name) {
            return h.blobs.get(0)
        }
        i = i + 1
    }
    return new Int[0]
}

tokenizerInfo(GgufHandle h): TokenizerMetadata {
    var bos = getMetadata(h, "tokenizer.bos_id")
    var eos = getMetadata(h, "tokenizer.eos_id")
    var pad = getMetadata(h, "tokenizer.pad_id")
    var unk = getMetadata(h, "tokenizer.unk_id")
    var vocab = getMetadata(h, "context_length")
    return TokenizerMetadata(vocab.intVal, bos.intVal, eos.intVal, pad.intVal, unk.intVal)
}

ropeInfo(GgufHandle h): RopeMetadataRec {
    var dim = getMetadata(h, "rope.dimension_count")
    var freq = getMetadata(h, "rope.freq_base")
    var scaling = getMetadata(h, "rope.scaling.type")
    var ctx = getMetadata(h, "context_length")
    return RopeMetadataRec(dim.intVal, freq.intVal, scaling.strVal, ctx.intVal)
}

ggufVersion(GgufHandle h): Int {
    var hdr = h.header
    return hdr.version
}

ggufTensorCount(GgufHandle h): Int {
    var hdr = h.header
    return hdr.tensorCount
}

ggufErrorCount(GgufHandle h): Int {
    return h.errorCount
}

ggufErrorCode(GgufHandle h): String {
    return h.errorCode
}

ggufMetaCount(GgufHandle h): Int {
    var hdr = h.header
    return hdr.metaCount
}

ggufTensorCount2(GgufHandle h): Int {
    var n = listTensors(h)
    return n.size()
}

// M18: Local Model Runner — loadModel/generate/stream/cancel sobre GGUF+RoPE+KV+Sampler

record RunnerConfig(Int maxTokens, Int topK, Int temperature, Int seed)
record GenMetrics(Int promptTokens, Int genTokens, Int elapsedMs)
record StreamEvent(Int kind, Int token)

fn mrEmbed(GgufHandle h, Int tokenId, Int dims): TensorR {
    var t = tensorNew(1, dims)
    var blob = getTensorLazy(h, "tok_embd")
    var i = 0
    while (i < dims) {
        var v = 0
        if (blob.length > 0) {
            v = blob[(tokenId * 7 + i) % blob.length] % 97 - 48
            if (v < 0) { v = 0 - v }
        } else {
            v = (tokenId * 31 + i) % 97
        }
        tensorSet(t, 0, i, v)
        i = i + 1
    }
    return t
}

fn mrLogits(GgufHandle h, TensorR hidden, Int vocab): Int[] {
    var lg = new Int[vocab]
    var proj = getTensorLazy(h, "out_proj")
    var i = 0
    while (i < vocab) {
        var sum = 0
        var j = 0
        while (j < hidden.cols && j < 16) {
            var w = 1
            if (proj.length > 0) {
                w = proj[(i + j) % proj.length]
                if (w < 0) { w = 0 - w }
                w = w % 13 + 1
            }
            sum = sum + tensorGet(hidden, 0, j) * w
            j = j + 1
        }
        lg[i] = sum % 1000003
        if (lg[i] < 0) { lg[i] = 0 - lg[i] }
        i = i + 1
    }
    return lg
}

class ModelRunner {
    GgufHandle model
    Bool loaded = false
    RopeFreqs rf
    KVCacheV2 kv
    Int vocabSize = 512
    Int ctxLen = 512
    Bool cancelled = false
    Int lastSeed = 1

    loadModel(GgufHandle h) {
        model = h
        loaded = true
        cancelled = false
        var ri = ropeInfo(h)
        ctxLen = ri.ctxLen
        if (ctxLen <= 0) { ctxLen = 512 }
        kv = KVCacheV2()
        kv.initKv(ctxLen)
        rf = ropeBuild(ctxLen, 4)
    }

    unloadModel() {
        loaded = false
        kv.reset()
    }

    cancelGeneration() {
        cancelled = true
    }

    resetContext() {
        kv.reset()
        cancelled = false
    }

    modelIsLoaded(): Bool {
        return loaded
    }

    kvDepth(): Int {
        return kv.size
    }

    generateStep(Int tokenId, Int cfg_seed): Int {
        var emb = mrEmbed(model, tokenId, 4)
        var k = tensorNew(1, 4)
        applyRope(emb, k, rf, kv.size)
        kv.append(new Int[4], new Int[4])
        var lg = mrLogits(model, emb, vocabSize)
        lastSeed = lcgNext(LcgState(cfg_seed))
        return samplerGreedy(lg, vocabSize)
    }

    generate(Int promptToken, RunnerConfig cfg): List<Int> {
        var out = listOf<Int>()
        var tok = promptToken
        var i = 0
        while (i < cfg.maxTokens) {
            if (cancelled) {
                break
            }
            tok = generateStep(tok, cfg.seed + i)
            out.add(tok)
            if (tok == tokenizerInfo(model).eosId) {
                break
            }
            i = i + 1
        }
        return out
    }

    streamGenerate(Int promptToken, RunnerConfig cfg): List<StreamEvent> {
        var evs = listOf<StreamEvent>()
        var tok = promptToken
        var i = 0
        while (i < cfg.maxTokens) {
            if (cancelled) {
                evs.add(StreamEvent(9, tok))
                break
            }
            tok = generateStep(tok, cfg.seed + i)
            evs.add(StreamEvent(2, tok))
            if (tok == tokenizerInfo(model).eosId) {
                evs.add(StreamEvent(5, tok))
                break
            }
            i = i + 1
        }
        return evs
    }
}

// M28: AI Coding Engine sobre ModelRunner

class AiEngine {
    ModelRunner runner

    bind(ModelRunner r) {
        runner = r
    }

    complete(Int promptToken, Int maxTokens): String {
        var cfg = RunnerConfig(maxTokens, 0, 100, 42)
        var out = runner.generate(promptToken, cfg)
        var s = ""
        var i = 0
        while (i < out.size()) {
            s = s + out.get(i) + " "
            i = i + 1
        }
        return s
    }

    explain(String target): String {
        return "explain:" + target
    }
}

test "explain wraps target" {
    var e = AiEngine()
    var s = e.explain("N17")
    assert(s == "explain:N17")
}