main() {
    var t0 = now()
    var m = kofGgufBinOpen("/home/mel/Downloads/kof-data/models/TinyLlama-Q4_K_M.gguf")
    var t1 = now()
    var v = kofLmTokLoadVocab("/home/mel/Downloads/kof-data/models/TinyLlama-Q4_K_M.gguf", m)
    var t2 = now()
    var ids = kofLmTokEncode(v.tokens, v.scores, "ola tudo bem", 1)
    var t3 = now()
    File("/tmp/opencode/p4.log").writeText("open=" + (t1 - t0) + " vocab=" + (t2 - t1) + " encode=" + (t3 - t2) + " n=" + ids.length + "\n")
}
