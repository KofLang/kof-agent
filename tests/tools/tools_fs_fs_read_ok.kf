mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkCtxGrant(): ToolCtx {
    var c = mkCtx()
    c.grant(PERM_FS_WRITE())
    return c
}

test "fs read ok" {
    mkFile("build/tt/a.kf", "conteudo\n")
    var r = toolExec(defaultRegistry(), mkCtx(), ToolCall("fs.read", "t1", "build/tt/a.kf", "", 0))
    assert(r.status == "ok")
}
main() {
}
