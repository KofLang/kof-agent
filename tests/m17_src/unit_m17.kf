test "header valid v3 via file" {
    var h = openGGUF("fixtures/tiny.gguf")
    assert(h.header.version == 3)
    assert(h.header.tensorCount == 2)
}

test "bad magic yields error" {
    var h = openGGUF("fixtures/bad_magic.gguf")
    assert(h.errors.size() >= 1)
}

test "bad version yields error" {
    var h = openGGUF("fixtures/bad_version.gguf")
    assert(h.errors.size() >= 1)
}

test "metadata typed read bos" {
    var mv = getMetadata(openGGUF("fixtures/tiny.gguf"), "tokenizer.bos_id")
    assert(mv.intVal == 1)
}

test "metadata missing kind -1" {
    assert(getMetadata(openGGUF("fixtures/tiny.gguf"), "nope").kind == -1)
}

test "tensor lookup by name" {
    var h = openGGUF("fixtures/tiny.gguf")
    assert(hasTensor(h, "tok_embd"))
    assert(!hasTensor(h, "nope"))
}

test "list tensors two entries" {
    assert(listTensors(openGGUF("fixtures/tiny.gguf")).size() == 2)
}

test "lazy tensor hex decoded" {
    var b = getTensorLazy(openGGUF("fixtures/tiny.gguf"), "tok_embd")
    assert(b.length == 32)
    assert(b[31] == 31)
}

test "missing file typed error" {
    var h = openGGUF("fixtures/nope.gguf")
    assert(h.errors.size() == 1)
}

test "tokenizer info bos eos" {
    var ti = tokenizerInfo(openGGUF("fixtures/tiny.gguf"))
    assert(ti.bosId == 1)
}

test "rope ctx len" {
    assert(ropeInfo(openGGUF("fixtures/tiny.gguf")).ctxLen == 512)
}
