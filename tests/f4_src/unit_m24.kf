test "failure signature deterministic same input" {
    var a = failureSignature("N17 cmp broken")
    var b = failureSignature("N17 cmp broken")
    assert(a.hash == b.hash)
}

test "failure kind classified native" {
    var f = failureSignature("N99 whatever")
    assert(f.kind == "native")
}

test "repair memory learn and lookup" {
    var m = RepairMemory()
    m.learn("sig1", "fix=clamp")
    var p = m.lookup("sig1")
    assert(p == "fix=clamp")
    var miss = m.lookup("none")
    assert(miss == "")
}
