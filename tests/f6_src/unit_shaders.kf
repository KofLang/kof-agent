test "spirv matmul header valid" {
    var m = spvParseHeader("gpu/shaders/matmul.spv")
    assert(m.magicOk == 1)
    assert(m.words > 100)
}

test "spirv all 7 hal modules valid" {
    assert(shadersValid())
}

test "spirv missing file rejected" {
    var m = spvParseHeader("gpu/shaders/nao_existe.spv")
    assert(m.magicOk == 0)
    assert(m.words == 0)
}

test "golden attention scores causal mask" {
    var q = tensorNew(3, 2)
    var k = tensorNew(3, 2)
    tensorSet(q, 0, 0, 1000)
    tensorSet(q, 0, 1, 0)
    tensorSet(k, 0, 0, 1000)
    tensorSet(k, 0, 1, 0)
    var s = goldenAttnScores(q, k, 1000)
    // causal: linha 0 só vê j=0
    assert(tensorGet(s, 0, 1) == -2147483647)
    assert(tensorGet(s, 0, 0) == 1000000)
}

test "golden embedding negative token id wraps" {
    var t = tensorNew(4, 2)
    tensorSet(t, 1, 0, 42)
    var e = goldenEmbedding(t, -3)
    // -3 % 4 = -3 → +4 = 1
    assert(tensorGet(e, 0, 0) == 42)
}

test "golden rmsnorm matches runtime op" {
    var x = tensorNew(1, 4)
    tensorSet(x, 0, 0, 1000)
    tensorSet(x, 0, 1, 1000)
    tensorSet(x, 0, 2, 1000)
    tensorSet(x, 0, 3, 1000)
    var g = goldenRmsNorm(x)
    var rt = tensorRmsNorm(x)
    assert(tensorGet(g, 0, 0) == tensorGet(rt, 0, 0))
}

test "gpu matmul dispatch com fallback golden" {
    var a = tensorNew(2, 3)
    tensorSet(a, 0, 0, 1); tensorSet(a, 0, 1, 2); tensorSet(a, 0, 2, 3)
    tensorSet(a, 1, 0, 4); tensorSet(a, 1, 1, 5); tensorSet(a, 1, 2, 6)
    var b = tensorNew(3, 2)
    tensorSet(b, 0, 0, 7); tensorSet(b, 0, 1, 8)
    tensorSet(b, 1, 0, 9); tensorSet(b, 1, 1, 10)
    tensorSet(b, 2, 0, 11); tensorSet(b, 2, 1, 12)
    var c = gpuMatmul(a, b)
    // golden CPU: A×B com A={1,2,3,4,5,6}, B={7,8,9,10,11,12} → {58,64,139,154}
    assert(tensorGet(c, 0, 0) == 58)
    assert(tensorGet(c, 0, 1) == 64)
    assert(tensorGet(c, 1, 0) == 139)
    assert(tensorGet(c, 1, 1) == 154)
    // M32.3: dispatch real ativo (libvkchain + ICD) — os asserts acima cobrem
    // o matmul GPU; sem GPU o HAL cai pros goldens CPU e o teste também passa.
}
