test "memory put get" {
    var m = MemoryLayer(FixedClock(100))
    m.put("k1", "session", "v1", 0)
    assert(m.get("k1") == "v1")
}

test "summarize older returns removed prefix" {
    var cv = ConversationEngine(FixedClock(1))
    cv.add("user", "primeira")
    cv.add("agent", "segunda")
    var s = cv.summarizeOlder(1)
    assert(s.contains("primeira"))
}
main() {
}
