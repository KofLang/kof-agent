WS_T(): String { return "build/tt_ws" }

setupWsT(): ToolCtx {
    mkFile("build/tt_ws/lib.kf", "record Shared(Int v)\n")
    mkFile("build/tt_ws/app.kf", "import Shared\n\nmain() {\n}\n")
    var c = mkCtx()
    c.wsi = WorkspaceIndex(WS_T(), c.bus, FixedClock(5))
    c.wsi.fullRescan()
    return c
}

test "ws.snapshot persists" {
    var r = toolExec(defaultRegistry(), setupWsT(), ToolCall("ws.snapshot", "w2", "", "", 0))
    assert(r.status == "ok")
    assert(File(joinPath(joinPath(WS_T(), "build"), "workspace.idx")).exists())
}
main() {
}
