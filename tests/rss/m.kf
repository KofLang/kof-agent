dbg(String s) {
    var f = File("/tmp/opencode/mdbg.log")
    if (f.exists()) {
        f.appendText(s + "\n")
    } else {
        f.writeText(s + "\n")
    }
}

main() {
    var path = "/home/mel/Downloads/kof-data/models/TinyLlama-Q4_K_M.gguf"
    var m = kofGgufBinOpen(path)
    var n = m.tensors.size()
    dbg("open err=" + m.errorCount + " tensors=" + n)
    var i = 0
    while (i < 45) {
        var t = m.tensors.get(i)
        dbg("t" + i + " " + t.name + " q=" + t.quant + " " + t.d0 + "x" + t.d1)
        i = i + 1
    }
    i = n - 10
    while (i < n) {
        var t2 = m.tensors.get(i)
        dbg("t" + i + " " + t2.name + " q=" + t2.quant + " " + t2.d0 + "x" + t2.d1)
        i = i + 1
    }
}
