mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkCtxGrant(): ToolCtx {
    var c = mkCtx()
    c.grant(PERM_FS_WRITE())
    return c
}

test "fs rename moves content" {
    mkFile("build/tt/rn1.txt", "mudou\n")
    var res = toolExec(defaultRegistry(), mkCtxGrant(), ToolCall("fs.rename", "t12", "build/tt/rn1.txt", "build/tt/rn2.txt", 0))
    assert(res.status == "ok")
    assert(File("build/tt/rn1.txt").exists() == false)
    assert(File("build/tt/rn2.txt").readText().contains("mudou"))
}
main() {
}
