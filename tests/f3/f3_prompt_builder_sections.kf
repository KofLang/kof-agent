test "memory put get" {
    var m = MemoryLayer(FixedClock(100))
    m.put("k1", "session", "v1", 0)
    assert(m.get("k1") == "v1")
}

test "prompt builder sections" {
    mkFile("build/pb_corpus/x.md", "---\nid: pb-x\ntitle: X\n---\nconteudo x\n")
    var ix = corpusLoad(freshBus(), "build/pb_corpus", FixedClock(1))
    var cv = ConversationEngine(FixedClock(1))
    cv.add("user", "pergunta sobre x")
    var p = promptBuild(ix, cv, "x")
    assert(p.contains("## Query"))
    assert(p.contains("pb-x"))
}
main() {
}
