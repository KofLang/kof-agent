// E1 (specs/ENGINE_V2.md §4): swap de contexto em YAML em tempo real.
// Subset YAML proprio e deliberado: escalares `chave: valor` no topo, blocos
// de lista `  - item`, pares `  chave: valor` dentro de regras_vivas.
// Hot-reload = recarregar por HASH DO CONTEUDO a cada turno (stdlib nao tem
// mtime; ler um arquivo de <1KB por turno e custo zero pragmatico e
// deterministico — hash no journal torna qualquer resposta reprodutivel).

record CtxSnapshot(String persona, String intencao, List<String> estado, List<String> pendencias, List<String> regras, Int linhasMax, Int confiancaMin, Int yhash)

ctxTextHash(String s): Int {
    var h = 5381
    var i = 0
    while (i < s.length) {
        h = h * 33 + s.charAt(i)
        i = i + 1
    }
    return h
}

ctxStripComment(String s): String {
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == 35) {
            return s.substring(0, i).trim()
        }
        i = i + 1
    }
    return s.trim()
}

ctxUnquote(String s): String {
    if (s.length >= 2) {
        var a = s.charAt(0)
        var b = s.charAt(s.length - 1)
        if (a == 34 && b == 34) {
            return s.substring(1, s.length - 1)
        }
    }
    return s
}

// 0.7 -> 700 / 0.95 -> 950 / 1 -> 1000. Sem float: milli-inteiro.
ctxParseThreshold(String s): Int {
    var milli = 0
    var frac = -1
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 46) {
            frac = 0
        } else if (c >= 48 && c <= 57) {
            if (frac < 0) {
                milli = milli * 10 + (c - 48)
            } else if (frac < 3) {
                milli = milli * 10 + (c - 48)
                frac = frac + 1
            }
        }
        i = i + 1
    }
    while (frac >= 0 && frac < 3) {
        milli = milli * 10
        frac = frac + 1
    }
    if (frac < 0) {
        milli = milli * 1000
    }
    return milli
}

ctxParseYaml(String txt): CtxSnapshot {
    var persona = ""
    var intencao = ""
    var estado = listOf<String>()
    var pendencias = listOf<String>()
    var regras = listOf<String>()
    var linhasMax = 2
    var confiancaMin = 700
    var mode = ""
    var ylines = splitStr(txt, "\n")
    for (var raw in ylines) {
        var indented = false
        if (raw.length > 0) {
            indented = raw.charAt(0) == 32
        }
        var t = raw.trim()
        if (t == "" || t.charAt(0) == 35) {
            indented = false
            t = ""
        }
        if (t != "" && indented && t.charAt(0) == 45 && t.length >= 3) {
            var item = ctxUnquote(ctxStripComment(t.substring(2, t.length)))
            if (mode == "estado") {
                estado.add(item)
            }
            if (mode == "pendencias") {
                pendencias.add(item)
            }
        }
        if (t != "" && t.charAt(0) != 45) {
            var sep = t.indexOf(":")
            if (sep > 0) {
                var key = t.substring(0, sep).trim()
                var v = ctxUnquote(ctxStripComment(t.substring(sep + 1, t.length)))
                if (!indented) {
                    mode = key
                    if (key == "persona") { persona = v }
                    if (key == "intencao_atual") { intencao = v }
                }
                if (indented && mode == "regras_vivas") {
                    regras.add(key + "=" + v)
                    if (key == "max_explicacao_linhas") {
                        linhasMax = parseIntStr(v)
                    }
                    if (key == "perguntar_se_confianca") {
                        confiancaMin = ctxParseThreshold(v)
                    }
                }
            }
        }
    }
    return CtxSnapshot(persona, intencao, estado, pendencias, regras, linhasMax, confiancaMin, ctxTextHash(txt))
}

ctxLoad(String path): CtxSnapshot {
    var f = File(path)
    var txt = ""
    if (f.exists() && f.isFile()) {
        txt = f.readText()
    }
    return ctxParseYaml(txt)
}

// true = contexto mudou desde o ultimo snapshot (trigger de rebuild no caller)
ctxChanged(CtxSnapshot prev, String path): Bool {
    return ctxLoad(path).yhash != prev.yhash
}

ctxLines(String s): Int {
    if (s == "") {
        return 0
    }
    return splitStr(s, "\n").size
}

// prefixo de prompt deterministico: persona + estado minimo, ~300 tokens alvo
ctxPrompt(CtxSnapshot c): String {
    var out = "[persona] " + c.persona + "\n"
    out = out + "[intencao] " + c.intencao + "\n"
    for (var e in c.estado) {
        out = out + "[estado] " + e + "\n"
    }
    for (var p in c.pendencias) {
        out = out + "[pendencia] " + p + "\n"
    }
    for (var r in c.regras) {
        out = out + "[regra] " + r + "\n"
    }
    return out
}

// Contrato §2.1: saida = resultado + no maximo `linhasMax` linhas de explicacao.
ctxClampExplanation(String text, Int maxLines): String {
    var lines = splitStr(text, "\n")
    if (lines.size <= maxLines) {
        return text
    }
    var out = ""
    var i = 0
    while (i < maxLines) {
        out = out + lines.get(i)
        if (i < maxLines - 1) {
            out = out + "\n"
        }
        i = i + 1
    }
    return out
}
