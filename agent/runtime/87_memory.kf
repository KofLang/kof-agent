record MemEntry(String key, String kind, String value, Int checksum, Long createdAt, Long expiresAt)

class MemoryLayer {
    List<MemEntry> entries = listOf<MemEntry>()
    TimeSource clock
    String storeDir = "build/memory"
    constructor(TimeSource ts) {
        clock = ts
    }

    put(String key, String kind, String value, Long ttlMs) {
        remove(key)
        var exp = 0
        if (ttlMs > 0) {
            exp = clock.nowMs() + ttlMs
        }
        entries.add(MemEntry(key, kind, value, wsHash(value), clock.nowMs(), exp))
    }

    get(String key): String {
        var now = clock.nowMs()
        var i = 0
        while (i < entries.size) {
            var e = entries.get(i)
            if (e.key == key) {
                if (e.expiresAt > 0 && e.expiresAt < now) {
                    entries.remove(i)
                    return ""
                }
                return e.value
            }
            i = i + 1
        }
        return ""
    }

    remove(String key): Bool {
        var i = 0
        while (i < entries.size) {
            if (entries.get(i).key == key) {
                entries.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    purgeExpired(): Int {
        var now = clock.nowMs()
        var removed = 0
        var i = 0
        while (i < entries.size) {
            var e = entries.get(i)
            var expired = e.expiresAt > 0 && e.expiresAt < now
            if (expired) {
                entries.remove(i)
                removed = removed + 1
            } else {
                i = i + 1
            }
        }
        return removed
    }

    byKind(String kind): List<MemEntry> {
        var out = listOf<MemEntry>()
        for (var e in entries) {
            if (e.kind == kind) {
                out.add(e)
            }
        }
        return out
    }

    snapshotTo(String dirPath): Bool {
        var d = Directory(dirPath)
        if (!d.exists()) {
            d.createDirectories()
        }
        var secs = listOf<String>()
        for (var e in entries) {
            secs.add(e.key + "\u0003" + e.kind + "\u0003" + escapeJson(e.value) + "\u0003" + e.createdAt + "\u0003" + e.expiresAt)
        }
        return wsWriteVersioned(joinPath(dirPath, "memory.snap"), "MEMSNP", 1, wsJoin(secs, "\u0002"))
    }

    restoreFrom(String dirPath): Bool {
        var body = wsReadVersioned(joinPath(dirPath, "memory.snap"), "MEMSNP")
        if (body == "") {
            return false
        }
        entries = listOf<MemEntry>()
        for (var entry in splitStr(body, "\u0002")) {
            var f = splitStr(entry, "\u0003")
            if (f.size == 5) {
                entries.add(MemEntry(f.get(0), f.get(1), f.get(2), wsHash(f.get(2)), parseLongSafe(f.get(3)), parseLongSafe(f.get(4))))
            }
        }
        return true
    }

    statsJson(): String {
        var ep = 0
        var sem = 0
        var ses = 0
        for (var e in entries) {
            if (e.kind == "episodic") {
                ep = ep + 1
            } else if (e.kind == "semantic") {
                sem = sem + 1
            } else {
                ses = ses + 1
            }
        }
        return "{\"episodic\":" + ep + ",\"semantic\":" + sem + ",\"session\":" + ses + ",\"total\":" + entries.size + "}"
    }
}
