test "cpu always available" {
    assert(halDetect().size >= 1)
    assert(halSelect("").kind == "CPU")
}

test "override selects backend when present" {
    assert(halSelect("CPU").name == "cpu-simd")
}

test "hal copy preserves" {
    var a = new Int[3]
    a[0] = 1
    a[1] = 2
    var b = halCopy(a)
    b[2] = 9
    assert(a[0] == 1 && b[2] == 9)
}

test "hal scale" {
    var a = new Int[2]
    a[0] = 3
    a[1] = 4
    var r = halScale(a, 2)
    assert(r[0] == 6 && r[1] == 8)
}

test "hal dot product" {
    var a = new Int[2]
    var b = new Int[2]
    a[0] = 2
    a[1] = 3
    b[0] = 4
    b[1] = 5
    assert(halDot(a, b) == 23)
}
main() {
}
