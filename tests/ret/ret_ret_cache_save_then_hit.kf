SEED(): String { return "build/ret_corpus" }

seedCorpus() {
    mkFile("build/ret_corpus/language/spawn-doc.md", "---\nid: r-spawn\ntitle: spawn task runtime\nmodule: language\ncategory: language\nkeywords: spawn,scheduler,task\nsymbols: spawn\n---\nspawn roda tarefas com scheduler e future.")
    mkFile("build/ret_corpus/diagnostics/E999.md", "---\nid: r-e999\ntitle: erro E999 workaround\nmodule: diagnostics\ncategory: diagnostics\nkeywords: e999\n---\nworkaround N2 exemplo corrigido.")
    mkFile("build/ret_corpus/recipes/rest-doc.md", "---\nid: r-rest\ntitle: recipe rest api crud http json\nmodule: recipes\ncategory: recipes\nkeywords: rest,crud,http,json\n---\nreceita rest api com http json database validation testing.")
}

test "cache save then hit" {
    seedCorpus()
    var bus = freshBus()
    var missRec = EventCounter()
    var hitRec = EventCounter()
    bus.subscribe("cache.miss", missRec)
    bus.subscribe("cache.hit", hitRec)
    var ix = corpusLoad(bus, SEED(), FixedClock(1))
    var q = "consulta unica xyz"
    var ctx = retBuildContext(ix, q, 3, 1000, listOf<String>())
    retCacheSave(bus, "build/ret_cache", q, ctx)
    var again = retCacheLoad(bus, "build/ret_cache", q)
    assert(again == ctx)
    assert(hitRec.count == 1)
}
main() {
}
