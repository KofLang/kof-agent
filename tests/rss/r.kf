dbg(String s) {
    var f = File("/tmp/opencode/rdbg.log")
    if (f.exists()) {
        f.appendText(s + "\n")
    } else {
        f.writeText(s + "\n")
    }
}

main() {
    var path = "/home/mel/Downloads/kof-data/models/TinyLlama-Q4_K_M.gguf"
    dbg("start")
    var m = kofGgufBinOpen(path)
    dbg("open err=" + m.errorCount)
    var cfg = kofLmCfgFromKv(m)
    dbg("cfg embd=" + cfg.embd + " layers=" + cfg.layers + " ffn=" + cfg.ffn + " heads=" + cfg.heads + " kv=" + cfg.kvHeads)
    var v = kofLmTokLoadVocab(path, m)
    var ids = kofLmTokEncode(v.tokens, v.scores, "ola tudo bem", 1)
    dbg("ids n=" + ids.length + " first=" + ids[0])
    var t0 = now()
    var W = kofLmWeightsLoad(path, m, cfg)
    dbg("load ms=" + (now() - t0))
    var cache = listOf<List<KofLmKv>>()
    var t1 = now()
    var lg = kofLmForwardW(W, cfg, ids[0], 0, cache)
    dbg("fwd1 ms=" + (now() - t1) + " argmax=" + kofLmArgmax(lg, cfg.vocab))
    var t2 = now()
    var lg2 = kofLmForwardW(W, cfg, ids[1], 1, cache)
    dbg("fwd2 ms=" + (now() - t2) + " argmax=" + kofLmArgmax(lg2, cfg.vocab))
    dbg("tok=" + v.tokens[kofLmArgmax(lg, cfg.vocab)])
}
