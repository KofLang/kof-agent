test "tv slice rows reads base" {
    var t = tensorNew(2, 3)
    tensorSet(t, 1, 0, 7)
    var v = tvSliceRows(t, 1, 1)
    assert(tvGet(v, 0, 0) == 7)
}

test "reshape keeps linear data" {
    var t = tensorNew(2, 3)
    tensorSet(t, 1, 0, 42)
    var r = tensorReshape(t, 3, 2)
    assert(r.data[3] == 42)
}
main() {
}
