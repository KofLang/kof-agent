    regTool(r, "search.text", "search.text", "Search", "ocorrencias de texto nos arquivos do indice", "needle", "[{file,count}]", PERM_FS_READ())
    regTool(r, "search.symbol", "search.symbol", "Search", "delega para ws.findSymbol", "name", "[hits]", PERM_FS_READ())
    regTool(r, "search.path", "search.path", "Search", "delega para ws.findFile", "substr", "[paths]", PERM_FS_READ())
    regTool(r, "patch.file", "patch.file", "Patch", "escreve conteudo completo com backup", "path,content", "{bytes}", PERM_FS_WRITE())
    regTool(r, "patch.replace", "patch.replace", "Patch", "substitui todas as ocorrencias", "file,from,to(n)", "{replacements}", PERM_FS_WRITE())
    regTool(r, "patch.append", "patch.append", "Patch", "anexa conteudo via write com backup", "path,text", "{bytes}", PERM_FS_WRITE())
    regTool(r, "diff.file", "diff.file", "Diff", "diff posicional entre dois arquivos", "a,b", "{same,addedLines,removedLines,firstDiffLine}", PERM_FS_READ())
    regTool(r, "git.branch", "git.branch", "Git", "branch/commit lidos de .git (somente leitura)", "root", "{branch,commit}", PERM_FS_READ())
    regTool(r, "git.log", "git.log", "Git", "contagem de entradas do reflog local", "root", "{entries}", PERM_FS_READ())
    var gapPerms = ""
