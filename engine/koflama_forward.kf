// koflama — forward LLM 100% Kof puro sobre o parser GGUF binário
// (koflama_gguf.kf). Renomeado de 162_llm_forward.kf; símbolos kofLm*.
// TinyLlama-1.1B / LLaMA: embd=2048, 22 layers, 32 q-heads, 4 kv-heads,
// head_dim=64, ffn=5632, rope_dims=64, vocab=32000.
// Escalas fixed-point: pesos NANO (1e-9, Long[]), estados MICRO (1e-3 × 1e3).
// matvec: acc Long = Σ W_nano × x_micro → /1e9 → MICRO.
// RMSNorm: y = x_w / rms com tudo MICRO.
// Q6_K v/down/output + Q4_K q/k/gate/up + F32 norms.

record KofLmCfg(Int embd, Int layers, Int heads, Int kvHeads, Int headDim,
               Int ffn, Int ropeDims, Int vocab, Long eps)

record KofLmKv(Long[] k, Long[] v)

kofLmIsqrt(Long v): Long {
    if (v <= 0) { return 0 }
    var r: Long = v
    var q: Long = 0
    if (v > 4294967296) { r = v / 65536 + 65536 } else { r = v + 2 }
    var k = 0
    while (k < 24) {
        q = (r + v / r) / 2
        if (q >= r) { break }
        r = q
        k = k + 1
    }
    // round: floor(r) vs floor(r)+1 — o mais próximo de sqrt(v)
    if (r < 2000000000 && (r + 1) * (r + 1) - v < v - r * r) { r = r + 1 }
    return r
}

kofLmMatvecCpuI(Int[] W, Long[] x, Int nRows, Int kdim, Long div): Long[] {
    var y = new Long[nRows]
    var xh = new Long[kdim]
    var xl = new Long[kdim]
    var hc = 0
    while (hc < kdim) {
        xh[hc] = x[hc] / 1000000
        xl[hc] = x[hc] % 1000000
        hc = hc + 1
    }
    var r = 0
    while (r < nRows) {
        var off = r * kdim
        var accA: Long = 0
        var accB: Long = 0
        var accC: Long = 0
        var accD: Long = 0
        var c = 0
        while (c < kdim) {
            var wv: Long = W[off + c]
            var wh = wv / 1000
            var wl = wv - wh * 1000
            accA = accA + wh * xh[c]
            accB = accB + wh * xl[c]
            accC = accC + wl * xh[c]
            accD = accD + wl * xl[c]
            c = c + 1
        }
        if (div == 1000000000) {
            var remT1 = (accB % 1000000) * 1000 + (accC % 1000) * 1000000 + accD
            y[r] = accA + accB / 1000000 + accC / 1000 + remT1 / 1000000000
        } else if (div == 1000000) {
            var remT2 = (accB % 1000) * 1000000 + accD
            y[r] = accA * 1000 + accB / 1000 + accC + remT2 / 1000000
        } else {
            var remT3 = (accA % 1000) * 1000000000 + (accB % 1000000000) * 1000 + (accC % 1000000) * 1000000 + accD
            y[r] = accA / 1000 + accB / 1000000000 + accC / 1000000 + remT3 / 1000000000000
        }
        r = r + 1
    }
    return y
}

kofLmRopeTable(Int pos, Int ropeDims): Long[] {
    // retorna [cos0, sin0, cos1, sin1, ...] ropeDims/2 pares em MICRO
    var half = ropeDims / 2
    var tab = new Long[half * 2]
    var i = 0
    while (i < half) {
        // freq = 10000^(-2i/ropeDims) → ângulo = pos * freq
        var ang = kofLmAngle(pos, i, half)
        tab[i * 2] = kofLmCos(ang)
        tab[i * 2 + 1] = kofLmSin(ang)
        i = i + 1
    }
    return tab
}

// ang = pos * 10000^(-2i/ropeDims) — em "mili-radianos"? Trabalhamos com
// graus×1000 (decimiligraus) p/ as séries trigonométricas.
kofLmAngle(Int pos, Int fi, Int half): Long {
    // 10000^(-2i/64): log2 = -(2i/64)·log2(10000) ≈ -0.2083·i·... precomputar
    // por potências: freq = 10000^(-fi/half). Implementação: exp2 fracionário.
    var l2: Long = 13288  // log2(10000)×1000 = 13.2877×1000
    var expo: Long = (0 - (2 * fi) * l2) / (2 * half)   // ×1000
    // ang_graus1000 = pos × 2^(expo/1000) × (180/π) × 1000
    // 2^(e/1000): série — usamos pow2Fix
    var pow2v = kofLmPow2Fix(expo)
    // rad → decimiligraus: rad × 572958 (180/π×1000... 57.2958° = 1 rad → ×1000)
    // rad→decimiligraus: pos×freq(rad)×57.2958×1000 = pos×pow2v(micro)×572958/1e7
    var ang: Long = pos * pow2v * 572958 / 10000000
    if (ang < 0) { ang = 0 - ang }
    // reduzir a 360000 (360°×1000)
    ang = ang % 360000
    return ang
}

// 2^(e/1000) em MICRO (e Long)
kofLmPow2Fix(Long e): Long {
    // 2^(e/1000) = 2^int × 2^(frac/1000)
    var inteiro = e / 1000
    var frac = e % 1000
    if (e < 0 && frac != 0) {
        inteiro = inteiro - 1
        frac = frac + 1000
    }
    var r: Long = 1000000
    if (inteiro >= 0) {
        var k = 0
        while (k < inteiro) {
            r = r * 2
            k = k + 1
        }
    } else {
        var k = 0
        while (k < 0 - inteiro) {
            r = r / 2
            k = k + 1
        }
    }
    // 2^(frac/1000) = exp(t), t = frac×ln2/1000 — em MICRO: ×1e6
    var tf: Long = frac * 6931 / 10       // t em MICRO (frac×ln2/1000×1e6)
    var term: Long = 1000000
    var sum: Long = 1000000
    var k2 = 1
    while (k2 < 8) {
        term = term * tf / 1000000 / k2
        sum = sum + term
        k2 = k2 + 1
    }
    return r * sum / 1000000
}

// cos de ang em decimiligraus (×1000 graus) → MICRO, série de Taylor
kofLmCos(Long ang): Long {
    // reduzir para [-180000, 180000]
    var a = ang % 360000
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = 360000 - a }
    // cos(180°-x) = -cos(x): a≤180000 ok
    // quadrante: cos(90..180) = -cos(180-θ): manter direto na série com x rad
    // x rad = a × π/180000 = a × 17453 / 10000000 (π=3.14159: π/180=0.017453)
    var x = a * 174533 / 10000   // micro rad (1 rad = 1e6)
    // cos(x) série (x em micro rad): term = x²; cos = 1 - x²/2 + x⁴/24 - ...
    var x2 = x * x / 1000000       // x² em micro rad²
    var sum: Long = 1000000
    var term: Long = 1000000
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k - 1) * (2 * k))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    return sum
}

// sin de ang em decimiligraus → MICRO
kofLmSin(Long ang): Long {
    var a = ang % 360000
    var sign = 1
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = a - 360000 }
    if (a < 0) { a = 0 - a; sign = 0 - 1 }
    if (a > 90000) { a = 180000 - a }
    var x = a * 174533 / 10000   // micro rad (1 rad = 1e6)
    var x2 = x * x / 1000000
    var sum: Long = x
    var term: Long = x
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k) * (2 * k + 1))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    if (sign < 0) { sum = 0 - sum }
    return sum
}

// aplicar RoPE em q/k (Long[] micro), head h, posição pos
kofLmApplyRope(Long[] vec, Int vecOff, Int headDim, Int pos, Int ropeDims) {
    var tab = kofLmRopeTable(pos, ropeDims)
    var half = ropeDims / 2
    var i = 0
    while (i < half) {
        var cosv = tab[i * 2]
        var sinv = tab[i * 2 + 1]
        var x0 = vec[vecOff + i]
        var x1 = vec[vecOff + i + half]
        vec[vecOff + i] = (x0 * cosv - x1 * sinv) / 1000000
        vec[vecOff + i + half] = (x0 * sinv + x1 * cosv) / 1000000
        i = i + 1
    }
}

// ── sigmoid micro (para silu): sig(x)=1/(1+e^-t), t=x/1e6 ───────────────
// E = e^|t| em MICRO via série: term_k = term_{k-1}×ax/(k×1e6), term0=1e6
// x>0: sig = E/(E+1e6) · x<0: sig = 1e6/(1e6+E)
kofLmSigmoid(Long x): Long {
    var neg = 0
    var ax = x
    if (x < 0) { neg = 1; ax = 0 - x }
    if (ax > 12000000) {
        if (neg == 1) { return 0 }
        return 1000000
    }
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 14) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    var sig: Long = 0
    if (neg == 1) {
        sig = 1000000000000 / (1000000 + E)
    } else {
        sig = E * 1000000 / (E + 1000000)
    }
    if (sig > 1000000) { sig = 1000000 }
    return sig
}

// silu(g)*u: g,u NANO; sig do g em MICRO (g/1000); act NANO =
// (g×sig real)×(u real)×1e9: gm=g_n/1e6 (milli), um=u_n/1e6:
// gs = gm×sig/1e6 = (g×sig real)×1e3 (milli); act_n = gs×um×1e3
// = (g×sig×u real)×1e9 ✓ NANO exato (sem trunc por elem).
kofLmSwiglu(Long[] g, Long[] u, Int n): Long[] {
    var out = new Long[n]
    var i = 0
    while (i < n) {
        var sig = kofLmSigmoid(g[i] / 1000)
        var gm = g[i] / 1000000
        var um = u[i] / 1000000
        var gs = gm * sig / 1000000
        out[i] = gs * um * 1000
        i = i + 1
    }
    return out
}

// ── attention single/multi-token com KV cache ───────────────────────────
// scores por q-head: q_h · k_pos / sqrt(headDim); softmax causal; out_h =
// Σ p·v_pos(kv-group(h)). GQA: q head h usa kv head h/(heads/kvHeads).
kofLmAttention(Long[] q, Long[] kc, Long[] vc, Int nPos, Int heads,
              Int kvHeads, Int headDim): Long[] {
    var embd = heads * headDim
    var out = new Long[embd]
    var group = heads / kvHeads
    var scaleDiv = kofLmIsqrt(headDim * 1000000)
    if (scaleDiv <= 0) { scaleDiv = 1 }
    var h = 0
    while (h < heads) {
        var kvh = h / group
        var qOff = h * headDim
        var kvOff = kvh * headDim
        // scores
        var mx: Long = 0 - 900000000000000
        var scores = new Long[nPos]
        var p = 0
        while (p < nPos) {
            // dot exato por split: q_n = qh×1e6 + ql (qh=milli), idem k.
            // q·k(nano²) = accHi×1e12 + accMid×1e6 + accLo — acumuladores
            // separados (o acc combinado estoura p/ q·k real > 9: head 64d).
            // sc micro = accHi×1000/scaleDiv + accMid/(scaleDiv×1000)
            //          + accLo/(scaleDiv×1e9), scaleDiv = isqrt(hd×1e6).
            var accHi: Long = 0
            var accMid: Long = 0
            var accLo: Long = 0
            var d = 0
            while (d < headDim) {
                var qv = q[qOff + d]
                var kv = kc[p * (kvHeads * headDim) + kvOff + d]
                var qh = qv / 1000000
                var ql = qv % 1000000
                var kh = kv / 1000000
                var kl = kv % 1000000
                accHi = accHi + qh * kh
                accMid = accMid + qh * kl + ql * kh
                accLo = accLo + ql * kl
                d = d + 1
            }
            var sc = accHi * 1000 / scaleDiv + accMid / (scaleDiv * 1000) + accLo / (scaleDiv * 1000000000)
            scores[p] = sc
            if (sc > mx) { mx = sc }
            p = p + 1
        }
        // softmax com exp micro
        var sum: Long = 0
        p = 0
        while (p < nPos) {
            var e = kofLmExpMicro(scores[p] - mx)
            scores[p] = e
            sum = sum + e
            p = p + 1
        }
        if (sum <= 0) { sum = 1 }
        // out_h = Σ p·v (v NANO): out NANO = Σ wgt(micro)×v(nano)/1e6
        var oOff = h * headDim
        p = 0
        while (p < nPos) {
            var wgt = scores[p] * 1000000 / sum
            var d = 0
            while (d < headDim) {
                out[oOff + d] = out[oOff + d] + wgt * vc[p * (kvHeads * headDim) + kvOff + d] / 1000000
                d = d + 1
            }
            p = p + 1
        }
        h = h + 1
    }
    return out
}

// e^((x)/1e6) em MICRO — x micro (diferença de scores, ≤0): e^(-t),
// t = |x|/1e6 real. Estável: E = e^t (série positiva, sem cancela-
// mento); e^-t = 1e12/E (micro × micro / 1e6... E micro: e^-t micro =
// 1e6×1e6/E).
kofLmExpMicro(Long x): Long {
    if (x < 0 - 12000000) { return 0 }
    var ax = 0 - x
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 20) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    return 1000000000000 / E
}

class KofLmLayer {
    Int[] q = new Int[0]
    Int[] k = new Int[0]
    Int[] v = new Int[0]
    Int[] o = new Int[0]
    Int[] gate = new Int[0]
    Int[] up = new Int[0]
    Int[] down = new Int[0]
    Int[] n1 = new Int[0]
    Int[] n2 = new Int[0]
}

class KofLmWeights {
    Int[] embd = new Int[0]
    Int[] lm = new Int[0]
    Int[] fin = new Int[0]
    KofLmLayer[] layers = new KofLmLayer[0]
}

// tensor inteiro (ou em fatias de maxRows) -> Long[] nano residente
void kofLmLoadInto(String path, KofGgufBinModel m, String tensor, Int rows, Int kdim,
                   Int maxRows, Int[] out, Int[] win) {
    var ltmp = new Long[256]
    var r0 = 0
    while (r0 < rows) {
        var n = maxRows
        if (r0 + n > rows) { n = rows - r0 }
        kofGgufDecodeRowsNTo(path, m, tensor, r0, n, kdim, out, win, ltmp)
        r0 = r0 + n
    }
}

// variante SO-COM-BASE p/ transfer learning do head (166). Nao carrega as
// 22 camadas (i32 residente = 6.5GB de nada p/ o head, que so usa token_embd).
KofLmWeights kofLmWeightsLoadEmb(String path, KofGgufBinModel m, KofLmCfg cfg) {
    var W = KofLmWeights()
    var win = new Int[11000000]
    W.embd = new Int[cfg.vocab * cfg.embd]
    kofLmLoadInto(path, m, "token_embd.weight", cfg.vocab, cfg.embd, 4096, W.embd, win)
    var fnd = kofGgufF32DecodeRows(path, m, "output_norm.weight", 0, 1, cfg.embd)
    W.fin = new Int[cfg.embd]
    var fi = 0
    while (fi < cfg.embd) {
        W.fin[fi] = (fnd[fi] * 1000)
        fi = fi + 1
    }
    return W
}

KofLmWeights kofLmWeightsLoad(String path, KofGgufBinModel m, KofLmCfg cfg) {
    var W = KofLmWeights()
        var win = new Int[11000000]
    var kv = cfg.kvHeads * cfg.headDim
    W.embd = new Int[cfg.vocab * cfg.embd]
    kofLmLoadInto(path, m, "token_embd.weight", cfg.vocab, cfg.embd, 4096, W.embd, win)
    W.lm = new Int[cfg.vocab * cfg.embd]
    kofLmLoadInto(path, m, "output.weight", cfg.vocab, cfg.embd, 4096, W.lm, win)
    var fnd = kofGgufF32DecodeRows(path, m, "output_norm.weight", 0, 1, cfg.embd)
    W.fin = new Int[cfg.embd]
    var fi = 0
    while (fi < cfg.embd) {
        W.fin[fi] = (fnd[fi] * 1000)
        fi = fi + 1
    }
    W.layers = new KofLmLayer[cfg.layers]
    var l = 0
    while (l < cfg.layers) {
        var P = "blk." + l + "."
        var Ly = KofLmLayer()
        Ly.q = new Int[cfg.embd * cfg.embd]
        kofLmLoadInto(path, m, P + "attn_q.weight", cfg.embd, cfg.embd, 4096, Ly.q, win)
        Ly.k = new Int[kv * cfg.embd]
        kofLmLoadInto(path, m, P + "attn_k.weight", kv, cfg.embd, 4096, Ly.k, win)
        Ly.v = new Int[kv * cfg.embd]
        kofLmLoadInto(path, m, P + "attn_v.weight", kv, cfg.embd, 4096, Ly.v, win)
        Ly.o = new Int[cfg.embd * cfg.embd]
        kofLmLoadInto(path, m, P + "attn_output.weight", cfg.embd, cfg.embd, 4096, Ly.o, win)
        Ly.gate = new Int[cfg.ffn * cfg.embd]
        kofLmLoadInto(path, m, P + "ffn_gate.weight", cfg.ffn, cfg.embd, 4096, Ly.gate, win)
        Ly.up = new Int[cfg.ffn * cfg.embd]
        kofLmLoadInto(path, m, P + "ffn_up.weight", cfg.ffn, cfg.embd, 4096, Ly.up, win)
        Ly.down = new Int[cfg.embd * cfg.ffn]
        kofLmLoadInto(path, m, P + "ffn_down.weight", cfg.embd, cfg.ffn, 4096, Ly.down, win)
        var di = 0
        while (di < cfg.embd * cfg.ffn) {
            Ly.down[di] = Ly.down[di] / 1000
            di = di + 1
        }
        var an = kofGgufF32DecodeRows(path, m, P + "attn_norm.weight", 0, 1, cfg.embd)
        Ly.n1 = new Int[cfg.embd]
        var ni = 0
        while (ni < cfg.embd) {
            Ly.n1[ni] = (an[ni] * 1000)
            ni = ni + 1
        }
        var f2 = kofGgufF32DecodeRows(path, m, P + "ffn_norm.weight", 0, 1, cfg.embd)
        Ly.n2 = new Int[cfg.embd]
        ni = 0
        while (ni < cfg.embd) {
            Ly.n2[ni] = (f2[ni] * 1000)
            ni = ni + 1
        }
        W.layers[l] = Ly
        l = l + 1
    }
    return W
}

// forward 1 token sobre pesos residentes — mesma matematica do ForwardInt
kofLmForwardW(KofLmWeights W, KofLmCfg cfg, Int token, Int pos,
              List<List<KofLmKv>> kvCache): Long[] {
    var xs = new Long[cfg.embd]
    var ei = 0
    var ebase = token * cfg.embd
    while (ei < cfg.embd) {
        xs[ei] = W.embd[ebase + ei]
        ei = ei + 1
    }
    var l = 0
    while (l < cfg.layers) {
        var Ly = W.layers[l]
        var h = kofLmRmsNormI(xs, Ly.n1, cfg.embd, cfg.eps)
        var q = kofLmMatvecCpuI(Ly.q, h, cfg.embd, cfg.embd, 1000000000)
        var kv = cfg.kvHeads * cfg.headDim
        var k = kofLmMatvecCpuI(Ly.k, h, kv, cfg.embd, 1000000000)
        var v = kofLmMatvecCpuI(Ly.v, h, kv, cfg.embd, 1000000000)
        var hd = 0
        while (hd < cfg.heads) {
            kofLmApplyRope(q, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        hd = 0
        while (hd < cfg.kvHeads) {
            kofLmApplyRope(k, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        if (kvCache.size() <= l) {
            kvCache.add(listOf<KofLmKv>())
        }
        kvCache.get(l).add(KofLmKv(k, v))
        var nPos = pos + 1
        var kcache = new Long[nPos * kv]
        var vcache = new Long[nPos * kv]
        var layerCache = kvCache.get(l)
        var pi = 0
        while (pi < nPos) {
            var kvEnt = layerCache.get(pi)
            var ci = 0
            while (ci < kv) {
                kcache[pi * kv + ci] = kvEnt.k[ci]
                vcache[pi * kv + ci] = kvEnt.v[ci]
                ci = ci + 1
            }
            pi = pi + 1
        }
        var attn = kofLmAttention(q, kcache, vcache, nPos, cfg.heads,
                                  cfg.kvHeads, cfg.headDim)
        var attno = kofLmMatvecCpuI(Ly.o, attn, cfg.embd, cfg.embd, 1000000000)
        var i2 = 0
        while (i2 < cfg.embd) {
            xs[i2] = xs[i2] + attno[i2]
            i2 = i2 + 1
        }
        var h2 = kofLmRmsNormI(xs, Ly.n2, cfg.embd, cfg.eps)
        var g = kofLmMatvecCpuI(Ly.gate, h2, cfg.ffn, cfg.embd, 1000000000)
        var u = kofLmMatvecCpuI(Ly.up, h2, cfg.ffn, cfg.embd, 1000000000)
        var act = kofLmSwiglu(g, u, cfg.ffn)
        var d = kofLmMatvecCpuI(Ly.down, act, cfg.embd, cfg.ffn, 1000000)
        i2 = 0
        while (i2 < cfg.embd) {
            xs[i2] = xs[i2] + d[i2]
            i2 = i2 + 1
        }
        l = l + 1
    }
    var hf = kofLmRmsNormI(xs, W.fin, cfg.embd, cfg.eps)
    return kofLmMatvecCpuI(W.lm, hf, cfg.vocab, cfg.embd, 1000000000000)
}

// ── forward completo de 1 token (com cache) ─────────────────────────────// Retorna logits[vocab] micro.
class KofLmScratch {
    Int[] win = new Int[0]
    Int[] w = new Int[0]
    Long[] tmp = new Long[256]
}

kofLmRmsNormI(Long[] x, Int[] w, Int n, Long eps): Long[] {
    var sq: Long = 0
    var i = 0
    while (i < n) {
        var acc: Long = 0
        var ce = 0
        while (ce < 8 && i < n) {
            var m = (x[i] + 500) / 1000
            if (x[i] < 0) { m = (x[i] - 500) / 1000 }
            acc = acc + m * m
            i = i + 1
            ce = ce + 1
        }
        sq = sq + acc
    }
    var mean = sq / n + eps
    var rmsMicro = kofLmIsqrt(mean)
    if (rmsMicro <= 0) { rmsMicro = 1 }
    var rmsN: Long = rmsMicro * 1000
    var y = new Long[n]
    i = 0
    while (i < n) {
        var xv = x[i]
        var wv: Long = w[i]
        var q = xv / rmsN
        var r = xv % rmsN
        y[i] = q * wv + (r * wv) / rmsN
        i = i + 1
    }
    return y
}

kofLmArgmax(Long[] logits, Int n): Int {
    var best = 0
    var i = 1
    while (i < n) {
        if (logits[i] > logits[best]) { best = i }
        i = i + 1
    }
    return best
}

// rank do token alvo (debug de divergência)
kofLmRank(Long[] logits, Int n, Int target): Int {
    var rank = 1
    var i = 0
    while (i < n) {
        if (logits[i] > logits[target]) { rank = rank + 1 }
        i = i + 1
    }
    return rank
}

// ── smoke: forward 1 token + argmax ─────────────────────────────────────
kofLmForwardSmoke(String path): String {
    var m = kofGgufBinOpen(path)
    if (m.errorCount > 0) {
        return "ERR " + m.errorCode
    }
    var cfg = kofLmCfgFromKv(m)
    var report = "cfg " + cfg.embd + "/" + cfg.layers + "/" + cfg.heads + "/" + cfg.kvHeads
    report = report + " hd=" + cfg.headDim + " ffn=" + cfg.ffn + " vocab=" + cfg.vocab
    var cache = listOf<List<KofLmKv>>()
    var W = kofLmWeightsLoad(path, m, cfg)
    var t0 = now()
    var logits = kofLmForwardW(W, cfg, 1, 0, cache)
    var t1 = now()
    var dt = t1 - t0
    var best = kofLmArgmax(logits, cfg.vocab)
    report = report + " tok1→" + best + " in=" + dt + "ms"
    report = report + " rank29958=" + kofLmRank(logits, cfg.vocab, 29958) + " lg29958=" + logits[29958]
    report = report + " lg[max]=" + logits[best] + " lg[0..3]=" + logits[0] + "," + logits[1] + "," + logits[2] + "," + logits[3]
    return report
}

kofLmCfgFromKv(KofGgufBinModel m): KofLmCfg {
    var embd = 0
    var layers = 0
    var heads = 0
    var kvHeads = 0
    var ffn = 0
    var vocab = 0
    var i = 0
    while (i < m.kv.size()) {
        var kv = m.kv.get(i)
        if (kv.key == "llama.embedding_length") { embd = kv.intVal }
        if (kv.key == "llama.block_count") { layers = kv.intVal }
        if (kv.key == "llama.attention.head_count") { heads = kv.intVal }
        if (kv.key == "llama.attention.head_count_kv") { kvHeads = kv.intVal }
        if (kv.key == "llama.feed_forward_length") { ffn = kv.intVal }
        if (kv.key == "llama.vocab_size") { vocab = kv.intVal }
        i = i + 1
    }
    var keyLen = 64
    var ropeDims = 64
    // eps = 1e-5 unidade² → 1e7 (mean de (x/1000)² = real²×1e12)
    return KofLmCfg(embd, layers, heads, kvHeads, keyLen, ffn, ropeDims, vocab, 10000000)
}
