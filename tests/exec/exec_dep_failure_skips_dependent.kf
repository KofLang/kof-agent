mkCtxGrant(): ToolCtx {
    var c = ToolCtx(freshBus(), FixedClock(10))
    c.grant(PERM_FS_WRITE())
    return c
}

mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkExec(): ToolCtx {
    var c = mkCtxGrant()
    c.wsi = WorkspaceIndex("build/tt_exec", c.bus, FixedClock(2))
    return c
}

test "dep failure skips dependent" {
    var plan0 = ExecutionPlan()
    plan0.id = "p-skip"
    plTask(plan0.tasks, "p-skip", 1, "Broken", "nao.existe", "", "", "", "")
    plTask(plan0.tasks, "p-skip", 2, "Dependent", "fs.write", "build/tt_exec/skip.kf", "x", "p-skip-t1", "")
    var r = exExecutePlan(defaultRegistry(), mkExec(), plan0, 0)
    assert(r.failed == 1)
}
main() {
}
