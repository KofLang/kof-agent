WS_ROOT_E(): String { return "build/ws_e" }

setupE(): WorkspaceIndex {
    mkFile("build/ws_e/one.kf", "record One(Int v)\n")
    var idx = WorkspaceIndex(WS_ROOT_E(), freshBus(), FixedClock(77))
    idx.fullRescan()
    return idx
}

test "incremental on cold index falls back to full" {
    var idx = WorkspaceIndex(WS_ROOT_E(), freshBus(), FixedClock(77))
    var snap = idx.incremental()
    assert(snap.files.size >= 1)
}
main() {
}
