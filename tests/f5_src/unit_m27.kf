test "session open close" {
    var svc = AgentService()
    var sid = svc.openSession("chat")
    assert(svc.sessionCount() == 1)
    svc.closeSession(sid)
    assert(svc.sessionCount() == 0)
}

test "dispatch counts requests" {
    var svc = AgentService()
    svc.dispatch("lsp.hover", 1)
    var n = svc.requests
    assert(n == 1)
}
