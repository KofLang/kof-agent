record CheckRec(String id, Bool ok, String detail)

interface TimeSource {
    nowMs(): Long
}

class FixedClock implements TimeSource {
    Long value = 0
    constructor(Long v) {
        value = v
    }
    nowMs(): Long {
        return value
    }
    advance(Long ms) {
        value = value + ms
    }
}

parseIntStr(String s): Int {
    var n = 0
    var i = 0
    if (s.length == 0) {
        throw "parse: empty integer"
    }
    var start = 0
    if (s.charAt(0) == 45) {
        start = 1
        if (s.length == 1) {
            throw "parse: invalid integer '" + s + "'"
        }
    }
    i = start
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < 48 || c > 57) {
            throw "parse: invalid integer '" + s + "'"
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if (start == 1) {
        n = 0 - n
    }
    return n
}

parseBoolStr(String s): Bool {
    var v = s.toLowerCase()
    if (v == "true" || v == "1" || v == "yes" || v == "on") {
        return true
    }
    if (v == "false" || v == "0" || v == "no" || v == "off" || v == "") {
        return false
    }
    throw "parse: invalid boolean '" + s + "'"
}

escapeJson(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 34) {
            out = out + "\\\""
        } else if (c == 92) {
            out = out + "\\\\"
        } else if (c == 10) {
            out = out + "\\n"
        } else if (c == 13) {
            out = out + "\\r"
        } else if (c == 9) {
            out = out + "\\t"
        } else {
            out = out + s.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

joinPath(String a, String b): String {
    if (a == "") {
        return b
    }
    if (a.substring(a.length - 1, a.length) == "/") {
        return a + b
    }
    return a + "/" + b
}

splitStr(String s, String sep): List<String> {
    var out = listOf<String>()
    if (s.length == 0) {
        return out
    }
    var sc = sep.charAt(0)
    var start = 0
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == sc) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, s.length))
    return out
}

loadArgsFile(String path): List<String> {
    var argv = listOf<String>()
    var f = File(path)
    if (!f.exists()) {
        return argv
    }
    var txt = f.readText()
    var lines = splitStr(txt, "\n")
    for (var line in lines) {
        var t = line.trim()
        if (t.length > 0) {
            argv.add(t)
        }
    }
    return argv
}

sortInts(Int[] a, Int n) {
    var i = 1
    while (i < n) {
        var key = a[i]
        var j = i - 1
        var placed = false
        while (!placed) {
            if (j < 0) {
                placed = true
            } else {
                if (a[j] > key) {
                    a[j + 1] = a[j]
                    j = j - 1
                } else {
                    placed = true
                }
            }
        }
        a[j + 1] = key
        i = i + 1
    }
}

mkFile(String path, String content): Bool {
    var parent = ""
    var parts = splitStr(path, "/")
    if (parts.size > 1) {
        var i = 0
        while (i < parts.size - 1) {
            if (parent == "") {
                parent = parts.get(i)
            } else {
                parent = joinPath(parent, parts.get(i))
            }
            i = i + 1
        }
        var d = Directory(parent)
        if (!d.exists()) {
            d.createDirectories()
        }
    }
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
    return f.writeText(content)
}

class EventCounter implements EventHandler {
    Int count = 0
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        count = count + 1
        return true
    }
}

class RecordingHandler implements EventHandler {
    List<String> seen = listOf<String>()
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        seen.add(e.topic + "=" + e.payload)
        return true
    }
}

freshBus(): EventBus {
    return EventBus()
}

record CfgEntry(String key, String value)

class Config {
    List<CfgEntry> entries = listOf<CfgEntry>()
    String sourcePath = ""
    Bool loaded = false

    loadFile(String path): Bool {
        entries = listOf<CfgEntry>()
        sourcePath = path
        var f = File(path)
        if (!f.exists()) {
            loaded = false
            return false
        }
        if (!f.isFile()) {
            loaded = false
            return false
        }
        var text = f.readText()
        parseInto(text)
        loaded = true
        return true
    }

    reload(): Bool {
        return loadFile(sourcePath)
    }

    parseInto(String text) {
        var lines = splitStr(text, "\n")
        for (var raw in lines) {
            var line = raw.trim()
            if (line.length > 0) {
                if (!line.startsWith("#")) {
                    var kv = splitStr(line, "=")
                    if (kv.size == 2) {
                        var k = kv.get(0).trim()
                        var v = kv.get(1).trim()
                        entries.add(CfgEntry(k, v))
                    }
                }
            }
        }
    }

    has(String key): Bool {
        for (var e in entries) {
            if (e.key == key) {
                return true
            }
        }
        return false
    }

    getRaw(String key): String {
        for (var e in entries) {
            if (e.key == key) {
                return e.value
            }
        }
        throw "config: missing key '" + key + "'"
    }

    getStr(String key, String def): String {
        if (!has(key)) {
            return def
        }
        return getRaw(key)
    }

    getInt(String key, Int def): Int {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseIntStr(v)
        } catch (String e) {
            throw "config: invalid integer for '" + key + "': '" + v + "'"
        }
    }

    getBool(String key, Bool def): Bool {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseBoolStr(v)
        } catch (String e) {
            throw "config: invalid boolean for '" + key + "': '" + v + "'"
        }
    }

    snapshotJson(): String {
        var out = "{\"source\":\"" + escapeJson(sourcePath) + "\",\"loaded\":"
        if (loaded) {
            out = out + "true"
        } else {
            out = out + "false"
        }
        out = out + ",\"entries\":["
        var first = true
        for (var e in entries) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"key\":\"" + escapeJson(e.key) + "\",\"value\":\"" + escapeJson(e.value) + "\"}"
        }
        out = out + "]}"
        return out
    }
}

TASK_CREATED(): Int { return 0 }
TASK_QUEUED(): Int { return 1 }
TASK_RUNNING(): Int { return 2 }
TASK_WAITING(): Int { return 3 }
TASK_COMPLETED(): Int { return 4 }
TASK_CANCELLED(): Int { return 5 }
TASK_FAILED(): Int { return 6 }

taskStateName(Int st): String {
    if (st == TASK_CREATED()) { return "CREATED" }
    if (st == TASK_QUEUED()) { return "QUEUED" }
    if (st == TASK_RUNNING()) { return "RUNNING" }
    if (st == TASK_WAITING()) { return "WAITING" }
    if (st == TASK_COMPLETED()) { return "COMPLETED" }
    if (st == TASK_CANCELLED()) { return "CANCELLED" }
    return "FAILED"
}

interface ContextView {
    incMetric(String name)
}

interface TaskBody {
    run(ContextView v)
}

class Future {
    Bool done = false
    Bool ok = false
    Int result = 0
    String error = ""
    constructor() {
    }
}

class TaskNode {
    Int id
    Int priority
    Int seq
    String name
    Int st = TASK_CREATED()
    Bool cancelled = false
    TaskBody body
    constructor(Int tid, Int prio, Int sq, String nm, TaskBody b) {
        id = tid
        priority = prio
        seq = sq
        name = nm
        body = b
    }
}

class FutureJob implements TaskBody {
    TaskBody inner
    Future future
    constructor(TaskBody i, Future f) {
        inner = i
        future = f
    }
    run(ContextView v) {
        try {
            inner.run(v)
            future.ok = true
        } catch (String e) {
            future.error = e
            throw e
        } finally {
            future.done = true
        }
    }
}

class Scheduler {
    List<TaskNode> tasks = listOf<TaskNode>()
    Int[] heapPrio = new Int[64]
    Int[] heapSeq = new Int[64]
    Int[] heapIdx = new Int[64]
    Int heapSize = 0
    Int heapCap = 64
    Int nextId = 1
    Int nextSeq = 1
    Int maxPending = 0
    Bool accepting = true
    Int launchedCount = 0
    Int completedCount = 0
    Int failedCount = 0
    Int cancelledCount = 0
    Int rejectedCount = 0
    String lastError = ""
    ContextView view

    constructor(ContextView v) {
        view = v
    }

    ensureCap(Int need) {
        if (need <= heapCap) {
            return
        }
        var nc = heapCap * 2
        while (nc < need) {
            nc = nc * 2
        }
        var np = new Int[nc]
        var ns = new Int[nc]
        var ni = new Int[nc]
        var i = 0
        while (i < heapSize) {
            np[i] = heapPrio[i]
            ns[i] = heapSeq[i]
            ni[i] = heapIdx[i]
            i = i + 1
        }
        heapPrio = np
        heapSeq = ns
        heapIdx = ni
        heapCap = nc
    }

    lessThan(Int a, Int b): Bool {
        if (heapPrio[a] > heapPrio[b]) {
            return true
        }
        if (heapPrio[a] < heapPrio[b]) {
            return false
        }
        return heapSeq[a] < heapSeq[b]
    }

    swapAt(Int a, Int b) {
        var tp = heapPrio[a]
        heapPrio[a] = heapPrio[b]
        heapPrio[b] = tp
        var ts = heapSeq[a]
        heapSeq[a] = heapSeq[b]
        heapSeq[b] = ts
        var ti = heapIdx[a]
        heapIdx[a] = heapIdx[b]
        heapIdx[b] = ti
    }

    heapPush(Int taskIndex) {
        ensureCap(heapSize + 1)
        var i = heapSize
        heapPrio[i] = tasks.get(taskIndex).priority
        heapSeq[i] = tasks.get(taskIndex).seq
        heapIdx[i] = taskIndex
        heapSize = heapSize + 1
        while (i > 0) {
            var parent = (i - 1) / 2
            if (lessThan(i, parent)) {
                swapAt(i, parent)
                i = parent
            } else {
                break
            }
        }
    }

    heapPop(): Int {
        var top = heapIdx[0]
        heapSize = heapSize - 1
        if (heapSize > 0) {
            heapPrio[0] = heapPrio[heapSize]
            heapSeq[0] = heapSeq[heapSize]
            heapIdx[0] = heapIdx[heapSize]
            var i = 0
            while (true) {
                var l = i * 2 + 1
                var r = l + 1
                var m = i
                if (l < heapSize) {
                    if (lessThan(l, m)) {
                        m = l
                    }
                }
                if (r < heapSize) {
                    if (lessThan(r, m)) {
                        m = r
                    }
                }
                if (m == i) {
                    break
                }
                swapAt(i, m)
                i = m
            }
        }
        return top
    }

    launch(TaskBody body, String name, Int priority): Int {
        if (!accepting) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: rejecting launch after shutdown"
        }
        if (maxPending > 0 && heapSize >= maxPending) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: backpressure (pending=" + heapSize + ", max=" + maxPending + ")"
        }
        var node = TaskNode(nextId, priority, nextSeq, name, body)
        nextId = nextId + 1
        nextSeq = nextSeq + 1
        node.st = TASK_QUEUED()
        tasks.add(node)
        heapPush(tasks.size - 1)
        launchedCount = launchedCount + 1
        return node.id
    }

    launchFuture(TaskBody body, String name, Int priority): Future {
        var f = Future()
        var wrapped = FutureJob(body, f)
        launch(wrapped, name, priority)
        return f
    }

    cancel(Int taskId): Bool {
        var idx = taskId - 1
        if (idx < 0 || idx >= tasks.size) {
            return false
        }
        var node = tasks.get(idx)
        if (node.st == TASK_QUEUED() && !node.cancelled) {
            node.cancelled = true
            node.st = TASK_CANCELLED()
            cancelledCount = cancelledCount + 1
            return true
        }
        return false
    }

    executeOne(): Bool {
        if (heapSize == 0) {
            return false
        }
        var idx = heapPop()
        var node = tasks.get(idx)
        if (node.cancelled || node.st == TASK_CANCELLED()) {
            return true
        }
        node.st = TASK_RUNNING()
        try {
            node.body.run(view)
            node.st = TASK_COMPLETED()
            completedCount = completedCount + 1
        } catch (String e) {
            node.st = TASK_FAILED()
            failedCount = failedCount + 1
            lastError = e
        }
        return true
    }

    run(Int maxTasks): Int {
        var n = 0
        while (n < maxTasks) {
            if (!executeOne()) {
                break
            }
            n = n + 1
        }
        return n
    }

    drain() {
        while (executeOne()) {
        }
    }

    await(Future f) {
        while (!f.done) {
            if (heapSize == 0) {
                throw "scheduler: deadlock in await (future unresolved, queue empty)"
            }
            executeOne()
        }
    }

    pending(): Int {
        return heapSize
    }

    gracefulShutdown() {
        accepting = false
        drain()
    }

    statsJson(): String {
        return "{\"pending\":" + heapSize + ",\"launched\":" + launchedCount + ",\"completed\":" + completedCount + ",\"failed\":" + failedCount + ",\"cancelled\":" + cancelledCount + ",\"rejected\":" + rejectedCount + ",\"accepting\":" + accepting + "}"
    }
}

class WorkerPool {
    Int size = 1
    Scheduler sched
    String affinityHint = ""

    constructor(Scheduler s, Int n) {
        sched = s
        if (n != 1) {
            throw "TP001: worker pool size " + n + " unsupported on this target (upstream CONC001); use 1"
        }
        size = n
    }

    launch(TaskBody body, String name): Int {
        return sched.launch(body, name, 5)
    }

    dynamicResize(Int n) {
        throw "TP001: dynamic pool resize unsupported on this target (upstream CONC001)"
    }

    setAffinity(String hint) {
        throw "TP002: affinity unsupported on this target"
    }
}

record EventEnvelope(String topic, String payload, Int seq)

interface EventHandler {
    onEvent(EventEnvelope e): Bool
}

class Subscription {
    Int id
    String topic
    EventHandler h
    Bool once = false
    constructor(Int sid, String t, EventHandler handler, Bool onceFlag) {
        id = sid
        topic = t
        h = handler
        once = onceFlag
    }
}

class EventBus {
    List<Subscription> subs = listOf<Subscription>()
    Int nextId = 1
    Int seq = 1

    subscribe(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, false)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    once(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, true)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    unsubscribe(Int id): Bool {
        var i = 0
        while (i < subs.size) {
            if (subs.get(i).id == id) {
                subs.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    publishEnvelope(EventEnvelope e): Int {
        var matched = listOf<Int>()
        var i = 0
        while (i < subs.size) {
            var s = subs.get(i)
            if (s.topic == e.topic || s.topic == "*") {
                matched.add(i)
            }
            i = i + 1
        }
        var called = 0
        for (var m in matched) {
            var sub = subs.get(m)
            if (sub.once) {
                unsubscribe(sub.id)
            }
            called = called + 1
            var cont = sub.h.onEvent(e)
            if (!cont) {
                break
            }
        }
        return called
    }

    publish(String topic, String payload): Int {
        var env = EventEnvelope(topic, payload, seq)
        seq = seq + 1
        return publishEnvelope(env)
    }

    broadcast(String payload): Int {
        return publish("*", payload)
    }

    publishAsync(Scheduler sched, ContextView view, String topic, String payload): Int {
        var job = PublishJob(this, topic, payload)
        return sched.launch(job, "event.publish", 5)
    }

    statsJson(): String {
        return "{\"subscribers\":" + subs.size + ",\"published\":" + (seq - 1) + "}"
    }
}

class PublishJob implements TaskBody {
    EventBus bus
    String topic
    String payload
    constructor(EventBus b, String t, String p) {
        bus = b
        topic = t
        payload = p
    }
    run(ContextView v) {
        bus.publish(topic, payload)
    }
}

record GgufInfoRec(String path, Bool magicOk, Int version, Int nTensors)
record TensorR(Int rows, Int cols, Int[] data)

tkTokenize(String text): List<String> {
    var out = listOf<String>()
    var cur = ""
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)
        if (alpha) {
            cur = cur + text.substring(i, i + 1)
        } else {
            if (cur.length > 0) {
                out.add(cur)
                cur = ""
            }
        }
        i = i + 1
    }
    if (cur.length > 0) {
        out.add(cur)
    }
    return out
}

class Vocab {
    List<String> tokens = listOf<String>()
    constructor() {
    }
    addToken(String t): Int {
        var id = tkId(t)
        tokens.add(t)
        return id
    }
    size(): Int {
        return tokens.size
    }
    tokenAt(Int i): String {
        return tokens.get(i)
    }
}

tkId(String t): Int {
    var h = wsHash(retLower(t))
    if (h < 0) {
        h = 0 - h
    }
    return h % 50000
}

vocabBuildFromCorpus(CorpusIndex ix): Vocab {
    var v = Vocab()
    for (var d in ix.docs) {
        var toks = tkTokenize(d.meta.title + " " + d.body)
        for (var t in toks) {
            if (v.size() < 4096) {
                var dup = false
                for (var e in v.tokens) {
                    if (e == t) {
                        dup = true
                    }
                }
                if (!dup) {
                    v.addToken(t)
                }
            }
        }
    }
    return v
}

tkEncode(Vocab v, String text): List<Int> {
    var ids = listOf<Int>()
    for (var t in tkTokenize(text)) {
        ids.add(tkId(t))
    }
    return ids
}

tkDecode(List<Int> ids): String {
    var out = ""
    for (var id in ids) {
        out = out + "<" + id + ">"
    }
    return out
}

samplerLcg(Int seed): Int {
    var x = seed * 1103515245 + 12345
    if (x < 0) {
        x = 0 - x
    }
    return x % 2147483647
}

samplerTopK(Int[] logits, Int n, Int k, Int seed): Int {
    var best = logits[0]
    var bi = 0
    var s = samplerLcg(seed)
    var i = 0
    while (i < n) {
        if (logits[i] > best) {
            best = logits[i]
            bi = i
        }
        i = i + 1
    }
    var jitter = s % (k + 1)
    if (jitter == 0) {
        return bi
    }
    var alt = (bi + jitter) % n
    return alt
}

tensorNew(Int rows, Int cols): TensorR {
    return TensorR(rows, cols, new Int[rows * cols])
}

tensorGet(TensorR t, Int r, Int cc): Int {
    return t.data[r * t.cols + cc]
}

tensorSet(TensorR t, Int r, Int cc, Int v) {
    t.data[r * t.cols + cc] = v
}

tensorTranspose(TensorR t): TensorR {
    var o = tensorNew(t.cols, t.rows)
    var r = 0
    while (r < t.rows) {
        var c2 = 0
        while (c2 < t.cols) {
            tensorSet(o, c2, r, tensorGet(t, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

tensorMatMul(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows, b.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < b.cols) {
            var acc = 0
            var kk = 0
            while (kk < a.cols) {
                acc = acc + tensorGet(a, r, kk) * tensorGet(b, kk, c2)
                kk = kk + 1
            }
            tensorSet(o, r, c2, acc)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

ggufParseHeader(String path): GgufInfoRec {
    var f = File(path)
    if (!f.exists()) {
        return GgufInfoRec(path, false, 0, 0)
    }
    var txt = f.readText()
    var magicOk = txt.startsWith("GGUF")
    var ver = 0
    var nt = 0
    if (magicOk && txt.length > 9) {
        ver = parseIntStr(txt.substring(4, 6))
        nt = parseIntStr(txt.substring(6, 9))
    }
    return GgufInfoRec(path, magicOk, ver, nt)
}

record TVView(TensorR base, Int offR, Int offC, Int rows, Int cols)

tvGet(TVView v, Int r, Int c): Int {
    return tensorGet(v.base, v.offR + r, v.offC + c)
}

tvSet(TVView v, Int r, Int c2, Int newVal) {
    tensorSet(v.base, v.offR + r, v.offC + c2, newVal)
}

tvSliceRows(TensorR t, Int offR, Int rows): TVView {
    return TVView(t, offR, 0, rows, t.cols)
}

tvBroadcast(Int fill, Int rows, Int cols): TensorR {
    var t = tensorNew(rows, cols)
    var r = 0
    while (r < rows) {
        var c2 = 0
        while (c2 < cols) {
            tensorSet(t, r, c2, fill)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return t
}

tensorReshape(TensorR t, Int rows, Int cols): TensorR {
    var o = tensorNew(rows, cols)
    var i = 0
    while (i < rows * cols && i < t.data.length) {
        o.data[i] = t.data[i]
        i = i + 1
    }
    return o
}

tensorConcatRows(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows + b.rows, a.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < a.cols) {
            tensorSet(o, r, c2, tensorGet(a, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    r = 0
    while (r < b.rows) {
        var c3 = 0
        while (c3 < b.cols) {
            tensorSet(o, a.rows + r, c3, tensorGet(b, r, c3))
            c3 = c3 + 1
        }
        r = r + 1
    }
    return o
}

class Arena {
    Int[] buf = new Int[1024]
    Int used = 0
    constructor() {
    }
    alloc(Int n): Int {
        var at = used
        if (used + n > buf.length) {
            return -1
        }
        used = used + n
        return at
    }
    reset() {
        used = 0
    }
    capacity(): Int {
        return buf.length
    }
    utilization(): Int {
        return used
    }
}

Q8_BLOCK(): Int { return 32 }

quantizeQ8Block(Int[] src, Int off): Int[] {
    var out = new Int[Q8_BLOCK() + 1]
    var maxAbs = 0
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        if (v < 0) {
            if ((0 - v) > maxAbs) {
                maxAbs = 0 - v
            }
        } else {
            if (v > maxAbs) {
                maxAbs = v
            }
        }
        i = i + 1
    }
    out[0] = maxAbs
    i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var q = 0
        if (maxAbs > 0) {
            q = v * 127 / maxAbs
        }
        out[i + 1] = q
        i = i + 1
    }
    return out
}

dequantizeQ8Block(Int[] blk): Int[] {
    var o = new Int[Q8_BLOCK()]
    var scale = blk[0]
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = blk[i + 1]
        if (scale > 0) {
            v = v * scale / 127
        }
        o[i] = v
        i = i + 1
    }
    return o
}

class KVCache {
    List<Int[]> keys = listOf<Int[]>()
    List<Int[]> vals = listOf<Int[]>()
    Int window = 64
    Int evictions = 0
    constructor() {
    }
    append(Int[] k, Int[] v) {
        keys.add(k)
        vals.add(v)
        if (keys.size > window) {
            keys.remove(0)
            vals.remove(0)
            evictions = evictions + 1
        }
    }
    size(): Int {
        return keys.size
    }
    compact() {
        keys = keys
        vals = vals
    }
}

// M16 part 82: Tensor ops V2 — arena, stable softmax, rmsnorm, gelu/silu, causal mask

record ArenaStats(Int allocs, Int reuses, Int peakBytes)
record ArenaSlot(Int key, TensorR tensor)

class TensorArena {
    List<ArenaSlot> free = listOf<ArenaSlot>()
    ArenaStats stats = ArenaStats(0, 0, 0)

    acquire(Int rows, Int cols): TensorR {
        var key = rows * 100000 + cols
        var i = 0
        while (i < free.size()) {
            var s = free.get(i)
            if (s.key == key) {
                var out2 = s.tensor
                var j = i
                while (j < free.size() - 1) {
                    free.set(j, free.get(j + 1))
                    j = j + 1
                }
                stats = ArenaStats(stats.allocs + 1, stats.reuses + 1, stats.peakBytes)
                return out2
            }
            i = i + 1
        }
        stats = ArenaStats(stats.allocs + 1, stats.reuses, stats.peakBytes)
        return tensorNew(rows, cols)
    }

    release(TensorR t) {
        free.add(ArenaSlot(t.rows * 100000 + t.cols, t))
        var bytes = t.rows * t.cols * 4
        if (bytes > stats.peakBytes) {
            stats = ArenaStats(stats.allocs, stats.reuses, bytes)
        }
    }
}

tensorSoftmaxRow(TensorR t, Int row): TensorR {
    var out = tensorNew(1, t.cols)
    var maxv = tensorGet(t, row, 0)
    var c2 = 1
    while (c2 < t.cols) {
        if (tensorGet(t, row, c2) > maxv) {
            maxv = tensorGet(t, row, c2)
        }
        c2 = c2 + 1
    }
    var sum = 0
    c2 = 0
    while (c2 < t.cols) {
        var d = maxv - tensorGet(t, row, c2)
        var e = 10000000 / (10 + d)
        tensorSet(out, 0, c2, e)
        sum = sum + e
        c2 = c2 + 1
    }
    if (sum == 0) { sum = 1 }
    c2 = 0
    while (c2 < t.cols) {
        tensorSet(out, 0, c2, tensorGet(out, 0, c2) * 10000 / sum)
        c2 = c2 + 1
    }
    return out
}

tensorRmsNorm(TensorR t): TensorR {
    var out = tensorNew(t.rows, t.cols)
    var r = 0
    while (r < t.rows) {
        var ss = 0
        var c2 = 0
        while (c2 < t.cols) {
            var v = tensorGet(t, r, c2)
            ss = ss + v * v / 1000
            c2 = c2 + 1
        }
        var inv = 31623 * 1000 / (100 + ss)
        c2 = 0
        while (c2 < t.cols) {
            tensorSet(out, r, c2, tensorGet(t, r, c2) * inv / 100000)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return out
}

gelu(x: Int): Int {
    var x3 = x * x * x / 1000000
    return (x + x3 / 6) / 2
}

silu(x: Int): Int {
    if (x <= 0) { return x / 4 }
    return x
}

record CausalMask(Int penalty)

tensorCausalMask(Int seqLen): TensorR {
    var m = tensorNew(seqLen, seqLen)
    var cm = CausalMask(1000000)
    var i = 0
    while (i < seqLen) {
        var j = 0
        while (j < seqLen) {
            if (j > i) {
                tensorSet(m, i, j, cm.penalty)
            } else {
                tensorSet(m, i, j, 0)
            }
            j = j + 1
        }
        i = i + 1
    }
    return m
}

// M31.3.3/.4: LMHeadExecutor + QuantDecoder (F32/Q8_0-like/Q4_0)

record QuantBlock(Int scale, Int baseVal)

fn q40DecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 9) {
        var nib = raw[off + i] % 16
        acc = acc + nib * scale / 100
        i = i + 1
    }
    return acc
}

lmHead(TensorR hidden, TensorR w, Int vocab): Int[] {
    var lg = new Int[vocab]
    var i = 0
    while (i < vocab) {
        var sum = 0
        var j = 0
        while (j < hidden.cols) {
            var wv = tensorGet(w, i % w.rows, j)
            sum = sum + tensorGet(hidden, 0, j) * wv
            j = j + 1
        }
        lg[i] = sum % 1000003
        if (lg[i] < 0) { lg[i] = 0 - lg[i] }
        i = i + 1
    }
    return lg
}

quantDecodeTensor(Int[] raw, Int nBlocks): Int[] {
    var out = new Int[nBlocks]
    var b = 0
    while (b < nBlocks) {
        out[b] = q40DecodeBlock(raw, b * 9)
        b = b + 1
    }
    return out
}

test "lm head produces bounded logits" {
    var h = tensorNew(1, 4)
    tensorSet(h, 0, 0, 100)
    var w = tensorNew(8, 4)
    tensorSet(w, 0, 0, 2)
    var lg = lmHead(h, w, 16)
    assert(lg.length == 16)
    assert(lg[0] >= 0)
}