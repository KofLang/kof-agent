#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// M36.1 matvecw32: y[M] = W[M x K] * x[K] com W em INT32 (o W domina o trafego
// PCIe: 33MB de W vs 16KB de x) e x/y em INT64 (o residuo nano do koflama
// passa de 2^31 em tokens profundos). Acumulador e divisao int64.
// W residente (buffer por id, binding 0), x/y buffers pequenos (bindings 1,2).
// 1 workgroup por row, 64 threads strided + tree reduce em shared.
// div por push (i64): y = acc / div (trunc, igual ao Kof).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BufW { int w[]; };
layout(set = 0, binding = 1) readonly buffer BufX { int64_t x[]; };
layout(set = 0, binding = 2) writeonly buffer BufY { int64_t y[]; };

layout(push_constant) uniform Push {
    int m;
    int k;
    int pad0;
    int pad1;
    int64_t div;
} pc;

shared int64_t red[64];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= uint(pc.m)) {
        return;
    }
    uint off = row * uint(pc.k);
    int64_t part = int64_t(0);
    for (uint c = tid; c < uint(pc.k); c += 64u) {
        part += int64_t(w[off + c]) * x[c];
    }
    red[tid] = part;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (tid < s) {
            red[tid] += red[tid + s];
        }
        barrier();
    }
    if (tid == 0u) {
        y[row] = red[0] / pc.div;
    }
}
