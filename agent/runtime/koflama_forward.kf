// koflama — forward LLM 100% Kof puro sobre o parser GGUF binário
// (koflama_gguf.kf). Renomeado de 162_llm_forward.kf; símbolos kofLm*.
// TinyLlama-1.1B / LLaMA: embd=2048, 22 layers, 32 q-heads, 4 kv-heads,
// head_dim=64, ffn=5632, rope_dims=64, vocab=32000.
// Escalas fixed-point: pesos NANO (1e-9, Long[]), estados MICRO (1e-3 × 1e3).
// matvec: acc Long = Σ W_nano × x_micro → /1e9 → MICRO.
// RMSNorm: y = x_w / rms com tudo MICRO.
// Q6_K v/down/output + Q4_K q/k/gate/up + F32 norms.

record KofLmCfg(Int embd, Int layers, Int heads, Int kvHeads, Int headDim,
               Int ffn, Int ropeDims, Int vocab, Long eps)

record KofLmKv(Long[] k, Long[] v)

// ── rmsnorm NANO ────────────────────────────────────────────────────────
// x,w em NANO (1e9). Σx² em nano² estoura: somamos (x/1000)² =
// real²×1e12: |x|=1e8 → x/1e3=1e5 → sq=1e10 per term (chunk 8 =
// 8e10 seguro; Σ2048 = 2e13 ✓). mean = real²×1e12; eps = 1e-5
// real² ×1e12 = 1e7. rms_nano = isqrt(mean)×1e3 (trunc 1e-6 rel).
kofLmRmsNorm(Long[] x, Long[] w, Int n, Long eps): Long[] {
    var sq: Long = 0
    var i = 0
    while (i < n) {
        var acc: Long = 0
        var ce = 0
        while (ce < 8 && i < n) {
            // m = x/1000 ARREDONDADO (não trunc): trunc p/ zero tem bias
            // sistemático −|x| no sq (≈2% rel) que amplifica pela rede.
            var m = (x[i] + 500) / 1000
            if (x[i] < 0) { m = (x[i] - 500) / 1000 }
            acc = acc + m * m
            i = i + 1
            ce = ce + 1
        }
        sq = sq + acc
    }
    var mean = sq / n + eps
    var rmsMicro = kofLmIsqrt(mean)
    if (rmsMicro <= 0) { rmsMicro = 1 }
    var rmsN: Long = rmsMicro * 1000
    var y = new Long[n]
    i = 0
    while (i < n) {
        var xv = x[i]
        var wv = w[i]
        var q = xv / rmsN
        var r = xv % rmsN
        y[i] = q * wv + (r * wv) / rmsN
        i = i + 1
    }
    return y
}

// sqrt inteiro (Newton), Long
kofLmIsqrt(Long v): Long {
    if (v <= 0) { return 0 }
    var r: Long = v
    var q: Long = 0
    if (v > 4294967296) { r = v / 65536 + 65536 } else { r = v + 2 }
    var k = 0
    while (k < 24) {
        q = (r + v / r) / 2
        if (q >= r) { break }
        r = q
        k = k + 1
    }
    // round: floor(r) vs floor(r)+1 — o mais próximo de sqrt(v)
    if (r < 2000000000 && (r + 1) * (r + 1) - v < v - r * r) { r = r + 1 }
    return r
}

// ── matvec: W[N×K] nano × x[K] nano → y[N] (nano ou micro) ─────────────
// Produto W×x chega a 3.1e9×3e9 = 9.3e18 > Long.MAX (9.22e18) — estoura
// mesmo por termo (bug k[174]: diff = 2^64/1e9). Split exato:
// W = Wh×1e3 + Wl; x = xh×1e6 + xl →
// W×x = A×1e9 + B×1e3 + C×1e6 + D com A=Σ Wh×xh (≤8e14), B=Σ Wh×xl
// (≤6.3e15), C=Σ Wl×xh (≤4e11), D=Σ Wl×xl (≤5.6e12) — sem overflow.
// div: 1e9 (y nano) · 1e6 (ffn_down, W pré-/1000) · 1e12 (lm_head, micro).
// M36 FASE B: GPU path — dispatchMatmul64 calcula acc TOTAL exato (produto
// unitário nano×micro ~3.6e14, acc ~7e17 < 9.22e18 = Long.MAX ✓ sem split);
// y[r] = acc/div (os restos do split CPU estão dentro do acc — exatidão ≥ CPU).
// Fallback CPU: split 4-acumuladores (A/B/C/D) + recomposição com remT.
kofLmMatvec(Long[] W, Long[] x, Int nRows, Int kdim, Long div): Long[] {
    return kofLmMatvecIdOld(0 - 1, W, x, nRows, kdim, div)
}

// wId >= 0: W residente (mvPutW na 1a vez via flag global de warm? não — o warm
// do entry já fez mvPutW; aqui só mvRun). wId < 0: FASE B dispatch → CPU.
// wId >= 0: residente (o W é ignorado — decode lazy só no fallback CPU).
// wId < 0: decode-then-CPU (comportamento antigo do matvec).
kofLmMatvecId(Int wId, String path, KofGgufBinModel gg, String tensor,
              Long[] x, Int nRows, Int kdim, Long div): Long[] {
    var y = new Long[nRows]
    // 0) residente: sem decode, sem cópia de W. O shader (matvecsim64)
    // reproduz o split do CPU bit-exato (4 accs + recomposição).
    if (wId >= 0) {
        var out64 = new Long[nRows]
        var rcRes: Int = gpu.mvRunSp(wId, x, out64, nRows, kdim, div)
        if (rcRes == 0) {
            var rg0 = 0
            while (rg0 < nRows) {
                y[rg0] = out64[rg0]
                rg0 = rg0 + 1
            }
            return y
        }
        // fallback: decodifica aqui e cai no CPU abaixo
        var W = kofGgufDecodeRowsN(path, gg, tensor, 0, nRows, kdim)
        if (wId % 7 == 6) {
            var iwz = 0
            while (iwz < nRows * kdim) {
                W[iwz] = W[iwz] / 1000
                iwz = iwz + 1
            }
        }
        return kofLmMatvec(W, x, nRows, kdim, div)
    }
    var W2 = kofGgufDecodeRowsN(path, gg, tensor, 0, nRows, kdim)
    if (wId <= 0 - 2000) {
        // ids negativos grandes (< -2000): down com W cru → divide p/ micro
        var iwz2 = 0
        while (iwz2 < nRows * kdim) {
            W2[iwz2] = W2[iwz2] / 1000
            iwz2 = iwz2 + 1
        }
    }
    return kofLmMatvec(W2, x, nRows, kdim, div)
}

kofLmMatvecIdOld(Int wId, Long[] W, Long[] x, Int nRows, Int kdim, Long div): Long[] {
    var y = new Long[nRows]
    // 1) dispatch FASE B (gpu.available() da lib32 + set_shape/load_w)
    var gpuOk: Bool = gpu.available()
    if (gpuOk) {
        var rcShape: Int = gpu.mvSetShape(nRows, kdim)
        if (rcShape == 0) {
            var rcW: Int = gpu.mvLoadW(W, nRows, kdim)
            if (rcW == 0) {
                var xCol = new Long[kdim]
                var c0 = 0
                while (c0 < kdim) {
                    xCol[c0] = x[c0]
                    c0 = c0 + 1
                }
                var out = new Long[nRows]
                var rc: Int = gpu.mvMatvec(xCol, out, nRows, kdim)
                if (rc == 0) {
                    var rg = 0
                    while (rg < nRows) {
                        y[rg] = out[rg] / div
                        rg = rg + 1
                    }
                    return y
                }
            }
        }
        var xCol2 = new Long[kdim]
        var c1 = 0
        while (c1 < kdim) {
            xCol2[c1] = x[c1]
            c1 = c1 + 1
        }
        var out2 = new Long[nRows]
        var rc2: Int = gpu.dispatchMatmul64(W, xCol2, out2, nRows, 1, kdim)
        if (rc2 == 0) {
            var rg2 = 0
            while (rg2 < nRows) {
                y[rg2] = out2[rg2] / div
                rg2 = rg2 + 1
            }
            return y
        }
    }
    // 3) CPU split (sempre correto — W local cru OU dividido conforme div)
    var r = 0
    while (r < nRows) {
        var off = r * kdim
        var accA: Long = 0
        var accB: Long = 0
        var accC: Long = 0
        var accD: Long = 0
        var c = 0
        while (c < kdim) {
            var wv = W[off + c]
            var xv = x[c]
            var wh = wv / 1000
            var wl = wv % 1000
            var xh = xv / 1000000
            var xl = xv % 1000000
            accA = accA + wh * xh
            accB = accB + wh * xl
            accC = accC + wl * xh
            accD = accD + wl * xl
            c = c + 1
        }
        if (div == 1000000000) {
            var remT = (accB % 1000000) * 1000 + (accC % 1000) * 1000000 + accD
            y[r] = accA + accB / 1000000 + accC / 1000 + remT / 1000000000
        } else if (div == 1000000) {
            var remT = (accB % 1000) * 1000000 + accD
            y[r] = accA * 1000 + accB / 1000 + accC + remT / 1000000
        } else {
            var remT = (accA % 1000) * 1000000000 + (accB % 1000000000) * 1000 + (accC % 1000000) * 1000000 + accD
            y[r] = accA / 1000 + accB / 1000000000 + accC / 1000000 + remT / 1000000000000
        }
        r = r + 1
    }
    return y
}

// ── RoPE (rotary) — tabela cos/sin micro pré-computada por (pos, freqIdx)
// ângulo = pos / (10000^(2i/ropeDims)); cos/sin em MICRO.
kofLmRopeTable(Int pos, Int ropeDims): Long[] {
    // retorna [cos0, sin0, cos1, sin1, ...] ropeDims/2 pares em MICRO
    var half = ropeDims / 2
    var tab = new Long[half * 2]
    var i = 0
    while (i < half) {
        // freq = 10000^(-2i/ropeDims) → ângulo = pos * freq
        var ang = kofLmAngle(pos, i, half)
        tab[i * 2] = kofLmCos(ang)
        tab[i * 2 + 1] = kofLmSin(ang)
        i = i + 1
    }
    return tab
}

// ang = pos * 10000^(-2i/ropeDims) — em "mili-radianos"? Trabalhamos com
// graus×1000 (decimiligraus) p/ as séries trigonométricas.
kofLmAngle(Int pos, Int fi, Int half): Long {
    // 10000^(-2i/64): log2 = -(2i/64)·log2(10000) ≈ -0.2083·i·... precomputar
    // por potências: freq = 10000^(-fi/half). Implementação: exp2 fracionário.
    var l2: Long = 13288  // log2(10000)×1000 = 13.2877×1000
    var expo: Long = (0 - (2 * fi) * l2) / (2 * half)   // ×1000
    // ang_graus1000 = pos × 2^(expo/1000) × (180/π) × 1000
    // 2^(e/1000): série — usamos pow2Fix
    var pow2v = kofLmPow2Fix(expo)
    // rad → decimiligraus: rad × 572958 (180/π×1000... 57.2958° = 1 rad → ×1000)
    // rad→decimiligraus: pos×freq(rad)×57.2958×1000 = pos×pow2v(micro)×572958/1e7
    var ang: Long = pos * pow2v * 572958 / 10000000
    if (ang < 0) { ang = 0 - ang }
    // reduzir a 360000 (360°×1000)
    ang = ang % 360000
    return ang
}

// 2^(e/1000) em MICRO (e Long)
kofLmPow2Fix(Long e): Long {
    // 2^(e/1000) = 2^int × 2^(frac/1000)
    var inteiro = e / 1000
    var frac = e % 1000
    if (e < 0 && frac != 0) {
        inteiro = inteiro - 1
        frac = frac + 1000
    }
    var r: Long = 1000000
    if (inteiro >= 0) {
        var k = 0
        while (k < inteiro) {
            r = r * 2
            k = k + 1
        }
    } else {
        var k = 0
        while (k < 0 - inteiro) {
            r = r / 2
            k = k + 1
        }
    }
    // 2^(frac/1000) = exp(t), t = frac×ln2/1000 — em MICRO: ×1e6
    var tf: Long = frac * 6931 / 10       // t em MICRO (frac×ln2/1000×1e6)
    var term: Long = 1000000
    var sum: Long = 1000000
    var k2 = 1
    while (k2 < 8) {
        term = term * tf / 1000000 / k2
        sum = sum + term
        k2 = k2 + 1
    }
    return r * sum / 1000000
}

// cos de ang em decimiligraus (×1000 graus) → MICRO, série de Taylor
kofLmCos(Long ang): Long {
    // reduzir para [-180000, 180000]
    var a = ang % 360000
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = 360000 - a }
    // cos(180°-x) = -cos(x): a≤180000 ok
    // quadrante: cos(90..180) = -cos(180-θ): manter direto na série com x rad
    // x rad = a × π/180000 = a × 17453 / 10000000 (π=3.14159: π/180=0.017453)
    var x = a * 174533 / 10000   // micro rad (1 rad = 1e6)
    // cos(x) série (x em micro rad): term = x²; cos = 1 - x²/2 + x⁴/24 - ...
    var x2 = x * x / 1000000       // x² em micro rad²
    var sum: Long = 1000000
    var term: Long = 1000000
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k - 1) * (2 * k))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    return sum
}

// sin de ang em decimiligraus → MICRO
kofLmSin(Long ang): Long {
    var a = ang % 360000
    var sign = 1
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = a - 360000 }
    if (a < 0) { a = 0 - a; sign = 0 - 1 }
    if (a > 90000) { a = 180000 - a }
    var x = a * 174533 / 10000   // micro rad (1 rad = 1e6)
    var x2 = x * x / 1000000
    var sum: Long = x
    var term: Long = x
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k) * (2 * k + 1))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    if (sign < 0) { sum = 0 - sum }
    return sum
}

// aplicar RoPE em q/k (Long[] micro), head h, posição pos
kofLmApplyRope(Long[] vec, Int vecOff, Int headDim, Int pos, Int ropeDims) {
    var tab = kofLmRopeTable(pos, ropeDims)
    var half = ropeDims / 2
    var i = 0
    while (i < half) {
        var cosv = tab[i * 2]
        var sinv = tab[i * 2 + 1]
        var x0 = vec[vecOff + i]
        var x1 = vec[vecOff + i + half]
        vec[vecOff + i] = (x0 * cosv - x1 * sinv) / 1000000
        vec[vecOff + i + half] = (x0 * sinv + x1 * cosv) / 1000000
        i = i + 1
    }
}

// ── sigmoid micro (para silu): sig(x)=1/(1+e^-t), t=x/1e6 ───────────────
// E = e^|t| em MICRO via série: term_k = term_{k-1}×ax/(k×1e6), term0=1e6
// x>0: sig = E/(E+1e6) · x<0: sig = 1e6/(1e6+E)
kofLmSigmoid(Long x): Long {
    var neg = 0
    var ax = x
    if (x < 0) { neg = 1; ax = 0 - x }
    if (ax > 12000000) {
        if (neg == 1) { return 0 }
        return 1000000
    }
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 14) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    var sig: Long = 0
    if (neg == 1) {
        sig = 1000000000000 / (1000000 + E)
    } else {
        sig = E * 1000000 / (E + 1000000)
    }
    if (sig > 1000000) { sig = 1000000 }
    return sig
}

// silu(g)*u: g,u NANO; sig do g em MICRO (g/1000); act NANO =
// (g×sig real)×(u real)×1e9: gm=g_n/1e6 (milli), um=u_n/1e6:
// gs = gm×sig/1e6 = (g×sig real)×1e3 (milli); act_n = gs×um×1e3
// = (g×sig×u real)×1e9 ✓ NANO exato (sem trunc por elem).
kofLmSwiglu(Long[] g, Long[] u, Int n): Long[] {
    var out = new Long[n]
    var i = 0
    while (i < n) {
        var sig = kofLmSigmoid(g[i] / 1000)
        var gm = g[i] / 1000000
        var um = u[i] / 1000000
        var gs = gm * sig / 1000000
        out[i] = gs * um * 1000
        i = i + 1
    }
    return out
}

// ── attention single/multi-token com KV cache ───────────────────────────
// scores por q-head: q_h · k_pos / sqrt(headDim); softmax causal; out_h =
// Σ p·v_pos(kv-group(h)). GQA: q head h usa kv head h/(heads/kvHeads).
kofLmAttention(Long[] q, Long[] kc, Long[] vc, Int nPos, Int heads,
              Int kvHeads, Int headDim): Long[] {
    var embd = heads * headDim
    var out = new Long[embd]
    var group = heads / kvHeads
    var scaleDiv = kofLmIsqrt(headDim * 1000000)
    if (scaleDiv <= 0) { scaleDiv = 1 }
    var h = 0
    while (h < heads) {
        var kvh = h / group
        var qOff = h * headDim
        var kvOff = kvh * headDim
        // scores
        var mx: Long = 0 - 900000000000000
        var scores = new Long[nPos]
        var p = 0
        while (p < nPos) {
            // dot exato por split: q_n = qh×1e6 + ql (qh=milli), idem k.
            // q·k(nano²) = accHi×1e12 + accMid×1e6 + accLo — acumuladores
            // separados (o acc combinado estoura p/ q·k real > 9: head 64d).
            // sc micro = accHi×1000/scaleDiv + accMid/(scaleDiv×1000)
            //          + accLo/(scaleDiv×1e9), scaleDiv = isqrt(hd×1e6).
            var accHi: Long = 0
            var accMid: Long = 0
            var accLo: Long = 0
            var d = 0
            while (d < headDim) {
                var qv = q[qOff + d]
                var kv = kc[p * (kvHeads * headDim) + kvOff + d]
                var qh = qv / 1000000
                var ql = qv % 1000000
                var kh = kv / 1000000
                var kl = kv % 1000000
                accHi = accHi + qh * kh
                accMid = accMid + qh * kl + ql * kh
                accLo = accLo + ql * kl
                d = d + 1
            }
            var sc = accHi * 1000 / scaleDiv + accMid / (scaleDiv * 1000) + accLo / (scaleDiv * 1000000000)
            scores[p] = sc
            if (sc > mx) { mx = sc }
            p = p + 1
        }
        // softmax com exp micro
        var sum: Long = 0
        p = 0
        while (p < nPos) {
            var e = kofLmExpMicro(scores[p] - mx)
            scores[p] = e
            sum = sum + e
            p = p + 1
        }
        if (sum <= 0) { sum = 1 }
        // out_h = Σ p·v (v NANO): out NANO = Σ wgt(micro)×v(nano)/1e6
        var oOff = h * headDim
        p = 0
        while (p < nPos) {
            var wgt = scores[p] * 1000000 / sum
            var d = 0
            while (d < headDim) {
                out[oOff + d] = out[oOff + d] + wgt * vc[p * (kvHeads * headDim) + kvOff + d] / 1000000
                d = d + 1
            }
            p = p + 1
        }
        h = h + 1
    }
    return out
}

// e^((x)/1e6) em MICRO — x micro (diferença de scores, ≤0): e^(-t),
// t = |x|/1e6 real. Estável: E = e^t (série positiva, sem cancela-
// mento); e^-t = 1e12/E (micro × micro / 1e6... E micro: e^-t micro =
// 1e6×1e6/E).
kofLmExpMicro(Long x): Long {
    if (x < 0 - 12000000) { return 0 }
    var ax = 0 - x
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 20) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    return 1000000000000 / E
}

// M36.3: W cru Long[] → wh = w/1000, wl = w%1000 (i32; |wh| ≤ 3.6e5 ✓).
// O par alimenta o matvecsplit (bit-exato com o CPU, zero div por termo).
kofLmToWh(Long[] w, Int n): Int[] {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        var h = w[i] / 1000
        if (h > 2147483647) {
            out[i] = 2147483647
        } else if (h < 0 - 2147483648) {
            out[i] = 0 - 2147483648
        } else {
            out[i] = h
        }
        i = i + 1
    }
    return out
}

kofLmToWl(Long[] w, Int n): Int[] {
    var out = new Int[n]
    var i = 0
    while (i < n) {
        out[i] = w[i] % 1000
        i = i + 1
    }
    return out
}

// M36.1: Long[] → Int[] (o W do koflama cabe em i32; overflow vira clamp
// silencioso — o caller confere o retorno de estourados)
kofLmToI32(Long[] w, Int n): Int[] {
    var out = new Int[n]
    var i = 0
    var over = 0
    var min = 0 - 2147483648
    while (i < n) {
        var v = w[i]
        if (v > 2147483647) {
            out[i] = 2147483647
            over = over + 1
        } else if (v < min) {
            out[i] = min
            over = over + 1
        } else {
            out[i] = v
        }
        i = i + 1
    }
    if (over > 0) {
        println("TOI32 OVER=" + over + " de " + n)
    }
    return out
}

// ── M36 FASE C2b: warm — sobe TODOS os W residentes (uma vez no boot) ──
// ids: layer l: q=7l, k=7l+1, v=7l+2, o=7l+3, gate=7l+4, up=7l+5, down=7l+6;
// lm_head=190. down já sobe DIVIDIDO por 1000 (contrato do forward).
// Retorna 0 ok / != 0 (nº do primeiro id que falhou + 1).
kofLmWarmWeights(String path, KofGgufBinModel m, KofLmCfg cfg): Int {
    // NÃO usa gpu.available() (gate da lib32 — falha independente):
    // o mvPutW abaixo faz o init da lib64 (mv64_ready) internamente.
    var l = 0
    while (l < cfg.layers) {
        var qW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_q.weight", 0, cfg.embd, cfg.embd)
        var nq = cfg.embd * cfg.embd
        var rcq: Int = gpu.mvPutSp(7 * l, kofLmToWh(qW, nq), kofLmToWl(qW, nq), cfg.embd, cfg.embd)
        if (rcq != 0) { return 7 * l + 1 }
        var kW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_k.weight", 0, cfg.kvHeads * cfg.headDim, cfg.embd)
        var nk = cfg.kvHeads * cfg.headDim * cfg.embd
        var rck: Int = gpu.mvPutSp(7 * l + 1, kofLmToWh(kW, nk), kofLmToWl(kW, nk), cfg.kvHeads * cfg.headDim, cfg.embd)
        if (rck != 0) { return 7 * l + 2 }
        var vW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_v.weight", 0, cfg.kvHeads * cfg.headDim, cfg.embd)
        var nv = cfg.kvHeads * cfg.headDim * cfg.embd
        var rcv: Int = gpu.mvPutSp(7 * l + 2, kofLmToWh(vW, nv), kofLmToWl(vW, nv), cfg.kvHeads * cfg.headDim, cfg.embd)
        if (rcv != 0) { return 7 * l + 3 }
        var oW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_output.weight", 0, cfg.embd, cfg.embd)
        var no = cfg.embd * cfg.embd
        var rco: Int = gpu.mvPutSp(7 * l + 3, kofLmToWh(oW, no), kofLmToWl(oW, no), cfg.embd, cfg.embd)
        if (rco != 0) { return 7 * l + 4 }
        var gW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_gate.weight", 0, cfg.ffn, cfg.embd)
        var ng = cfg.ffn * cfg.embd
        var rcg: Int = gpu.mvPutSp(7 * l + 4, kofLmToWh(gW, ng), kofLmToWl(gW, ng), cfg.ffn, cfg.embd)
        if (rcg != 0) { return 7 * l + 5 }
        var uW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_up.weight", 0, cfg.ffn, cfg.embd)
        var nu = cfg.ffn * cfg.embd
        var rcu: Int = gpu.mvPutSp(7 * l + 5, kofLmToWh(uW, nu), kofLmToWl(uW, nu), cfg.ffn, cfg.embd)
        if (rcu != 0) { return 7 * l + 6 }
        var dW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_down.weight", 0, cfg.embd, cfg.ffn)
        var nd = cfg.embd * cfg.ffn
        var rcd: Int = gpu.mvPutSp(7 * l + 6, kofLmToWh(dW, nd), kofLmToWl(dW, nd), cfg.embd, cfg.ffn)
        if (rcd != 0) { return 7 * l + 7 }
        println("warm L" + l + " ok")
        l = l + 1
    }
    var lgW = kofGgufDecodeRowsN(path, m, "output.weight", 0, cfg.vocab, cfg.embd)
    var nl = cfg.vocab * cfg.embd
    var rclm: Int = gpu.mvPutSp(190, kofLmToWh(lgW, nl), kofLmToWl(lgW, nl), cfg.vocab, cfg.embd)
    if (rclm != 0) { return 191 }
    return 0
}

// ── forward completo de 1 token (com cache) ─────────────────────────────
// Retorna logits[vocab] micro.
kofLmForward(String path, KofGgufBinModel m, KofLmCfg cfg, Int token, Int pos,
            List<List<KofLmKv>> kvCache): Long[] {
    // estados em NANO (Long): xs = dequant direto (já é nano)
    var xs = kofGgufDecodeRowsN(path, m, "token_embd.weight", token, 1, cfg.embd)
    var i = 0

    var normW = new Long[cfg.embd]
    var l = 0
    while (l < cfg.layers) {
        var attnNorm = kofGgufF32DecodeRows(path, m, "blk." + l + ".attn_norm.weight", 0, 1, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            normW[i] = attnNorm[i] * 1000
            i = i + 1
        }
        var h = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
        // q/k/v
        var q = kofLmMatvecId(7 * l, path, m, "blk." + l + ".attn_q.weight", h, cfg.embd, cfg.embd, 1000000000)
        var k = kofLmMatvecId(7 * l + 1, path, m, "blk." + l + ".attn_k.weight", h, cfg.kvHeads * cfg.headDim, cfg.embd, 1000000000)
        var v = kofLmMatvecId(7 * l + 2, path, m, "blk." + l + ".attn_v.weight", h, cfg.kvHeads * cfg.headDim, cfg.embd, 1000000000)
        // RoPE em q e k (pos atual)
        var hd = 0
        while (hd < cfg.heads) {
            kofLmApplyRope(q, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        hd = 0
        while (hd < cfg.kvHeads) {
            kofLmApplyRope(k, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        // cache por layer: cache[l] = K/v das posições 0..pos
        var kvEnt2 = KofLmKv(k, v)
        if (kvCache.size() <= l) {
            kvCache.add(listOf<KofLmKv>())
        }
        kvCache.get(l).add(kvEnt2)
        // attention sobre 0..pos (só o próprio k/v quando pos=0)
        var nPos = pos + 1
        var kcache = new Long[nPos * cfg.kvHeads * cfg.headDim]
        var vcache = new Long[nPos * cfg.kvHeads * cfg.headDim]
        var layerCache = kvCache.get(l)
        var pi = 0
        while (pi < nPos) {
            var kvEnt = layerCache.get(pi)
            var ci = 0
            while (ci < cfg.kvHeads * cfg.headDim) {
                kcache[pi * (cfg.kvHeads * cfg.headDim) + ci] = kvEnt.k[ci]
                vcache[pi * (cfg.kvHeads * cfg.headDim) + ci] = kvEnt.v[ci]
                ci = ci + 1
            }
            pi = pi + 1
        }
        var attn = kofLmAttention(q, kcache, vcache, nPos, cfg.heads,
                                 cfg.kvHeads, cfg.headDim)
        // attn_output
        var attno = kofLmMatvecId(7 * l + 3, path, m, "blk." + l + ".attn_output.weight", attn, cfg.embd, cfg.embd, 1000000000)
        i = 0
        while (i < cfg.embd) {
            xs[i] = xs[i] + attno[i]
            i = i + 1
        }
        // FFN
        var ffnNorm = kofGgufF32DecodeRows(path, m, "blk." + l + ".ffn_norm.weight", 0, 1, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            normW[i] = ffnNorm[i] * 1000
            i = i + 1
        }
        var h2 = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
        var g = kofLmMatvecId(7 * l + 4, path, m, "blk." + l + ".ffn_gate.weight", h2, cfg.ffn, cfg.embd, 1000000000)
        var u = kofLmMatvecId(7 * l + 5, path, m, "blk." + l + ".ffn_up.weight", h2, cfg.ffn, cfg.embd, 1000000000)
        var act = kofLmSwiglu(g, u, cfg.ffn)
        // W em MICRO (w_n/1000) × act NANO: acc = w×act real ×1e15;
        // d NANO = acc/1e6 (exato p/ o cancelamento do outlier).
        // Residente: o warm já subiu o dW DIVIDIDO (mvRun ignora o local).
        // O /1000 local abaixo serve so p/ o fallback CPU (split assume micro).
        var d = kofLmMatvecId(7 * l + 6, path, m, "blk." + l + ".ffn_down.weight", act, cfg.embd, cfg.ffn, 1000000)
        var i2 = 0
        while (i2 < cfg.embd) {
            xs[i2] = xs[i2] + d[i2]
            i2 = i2 + 1
        }
        l = l + 1
    }
    var outNorm = kofGgufF32DecodeRows(path, m, "output_norm.weight", 0, 1, cfg.embd)
    i = 0
    while (i < cfg.embd) {
        normW[i] = outNorm[i] * 1000
        i = i + 1
    }
    var hf = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
    // lm_head: output.weight Q6_K (2048, 32000) — 32000 linhas de 2048
    var logits = kofLmMatvecId(190, path, m, "output.weight", hf, cfg.vocab, cfg.embd, 1000000000000)
    return logits
}

// argmax dos logits
kofLmArgmax(Long[] logits, Int n): Int {
    var best = 0
    var i = 1
    while (i < n) {
        if (logits[i] > logits[best]) { best = i }
        i = i + 1
    }
    return best
}

// rank do token alvo (debug de divergência)
kofLmRank(Long[] logits, Int n, Int target): Int {
    var rank = 1
    var i = 0
    while (i < n) {
        if (logits[i] > logits[target]) { rank = rank + 1 }
        i = i + 1
    }
    return rank
}

// ── smoke: forward 1 token + argmax ─────────────────────────────────────
kofLmForwardSmoke(String path): String {
    var m = kofGgufBinOpen(path)
    if (m.errorCount > 0) {
        return "ERR " + m.errorCode
    }
    var cfg = kofLmCfgFromKv(m)
    var report = "cfg " + cfg.embd + "/" + cfg.layers + "/" + cfg.heads + "/" + cfg.kvHeads
    report = report + " hd=" + cfg.headDim + " ffn=" + cfg.ffn + " vocab=" + cfg.vocab
    var cache = listOf<List<KofLmKv>>()
    var t0 = now()
    var logits = kofLmForward(path, m, cfg, 1, 0, cache)
    var t1 = now()
    var dt = t1 - t0
    var best = kofLmArgmax(logits, cfg.vocab)
    report = report + " tok1→" + best + " in=" + dt + "ms"
    report = report + " rank29958=" + kofLmRank(logits, cfg.vocab, 29958) + " lg29958=" + logits[29958]
    report = report + " lg[max]=" + logits[best] + " lg[0..3]=" + logits[0] + "," + logits[1] + "," + logits[2] + "," + logits[3]
    return report
}

kofLmCfgFromKv(KofGgufBinModel m): KofLmCfg {
    var embd = 0
    var layers = 0
    var heads = 0
    var kvHeads = 0
    var ffn = 0
    var vocab = 0
    var i = 0
    while (i < m.kv.size()) {
        var kv = m.kv.get(i)
        if (kv.key == "llama.embedding_length") { embd = kv.intVal }
        if (kv.key == "llama.block_count") { layers = kv.intVal }
        if (kv.key == "llama.attention.head_count") { heads = kv.intVal }
        if (kv.key == "llama.attention.head_count_kv") { kvHeads = kv.intVal }
        if (kv.key == "llama.feed_forward_length") { ffn = kv.intVal }
        if (kv.key == "llama.vocab_size") { vocab = kv.intVal }
        i = i + 1
    }
    var keyLen = 64
    var ropeDims = 64
    // eps = 1e-5 unidade² → 1e7 (mean de (x/1000)² = real²×1e12)
    return KofLmCfg(embd, layers, heads, kvHeads, keyLen, ffn, ropeDims, vocab, 10000000)
}
