class Metrics {
    Long startedAt = 0
    Int eventsPublished = 0
    Int handlersCalled = 0
    Int eventsFailed = 0
    Int tasksLaunched = 0
    Int tasksCompleted = 0
    Int tasksFailed = 0
    Int tasksCancelled = 0
    Int tasksRejected = 0

    constructor() {
    }

    start(TimeSource clock) {
        startedAt = clock.nowMs()
    }

    incByName(String name) {
        if (name == "events.published") {
            eventsPublished = eventsPublished + 1
        } else if (name == "events.handlers") {
            handlersCalled = handlersCalled + 1
        } else if (name == "events.failed") {
            eventsFailed = eventsFailed + 1
        } else if (name == "tasks.launched") {
            tasksLaunched = tasksLaunched + 1
        } else if (name == "tasks.completed") {
            tasksCompleted = tasksCompleted + 1
        } else if (name == "tasks.failed") {
            tasksFailed = tasksFailed + 1
        } else if (name == "tasks.cancelled") {
            tasksCancelled = tasksCancelled + 1
        } else if (name == "tasks.rejected") {
            tasksRejected = tasksRejected + 1
        }
    }

    uptimeMs(TimeSource clock): Long {
        return clock.nowMs() - startedAt
    }

    snapshotJson(TimeSource clock): String {
        var out = "{\"uptimeMs\":" + uptimeMs(clock)
        out = out + ",\"events\":{\"published\":" + eventsPublished + ",\"handlersCalled\":" + handlersCalled + ",\"failed\":" + eventsFailed + "}"
        out = out + ",\"tasks\":{\"launched\":" + tasksLaunched + ",\"completed\":" + tasksCompleted + ",\"failed\":" + tasksFailed + ",\"cancelled\":" + tasksCancelled + ",\"rejected\":" + tasksRejected + "}"
        out = out + "}"
        return out
    }
}

record CorpMeta(String id, String title, String module, String category, String version, String languageVersion, String author, String createdAt, String updatedAt, String keywordsCsv, String symbolsCsv, String dependenciesCsv, String status, String tagsCsv, String extraKey, String extraValue)
class CorpusDoc {
    CorpMeta meta = CorpMeta("", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "")
    String body = ""
    String relPath = ""
    Int checksum = 0
    constructor() {
    }
}

CORPUS_IDX_VERSION(): Int { return 1 }

collectMdFiles(String dir, Int depth, List<String> out) {
    if (depth > 5) {
        return
    }
    var d = Directory(dir)
    if (!d.exists() || !d.isDirectory()) {
        return
    }
    var names = d.list()
    for (var n in names) {
        var skipIt = n == ".git" || n == "build"
        if (!skipIt) {
            var child = joinPath(dir, n)
            var f = File(child)
            if (f.isFile()) {
                if (n.length >= 3) {
                    var ext = n.substring(n.length - 3, n.length)
                    if (ext == ".md") {
                        out.add(child)
                    }
                }
            } else {
                if (f.isDirectory()) {
                    collectMdFiles(child, depth + 1, out)
                }
            }
        }
    }
}

metaField(String block, String key): String {
    var lines = splitStr(block, "\n")
    var prefix = key + ":"
    for (var raw in lines) {
        var t = raw.trim()
        if (t.startsWith(prefix)) {
            return t.substring(prefix.length, t.length).trim()
        }
    }
    return ""
}

parseCorpusDoc(String path, String root): CorpusDoc {
    var d = CorpusDoc()
    d.relPath = path
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return d
    }
    var txt = f.readText()
    d.checksum = wsHash(txt)
    var rest = txt
    if (txt.startsWith("---\n")) {
        var end = txt.indexOf("\n---\n", 4)
        if (end > 0) {
            var block = txt.substring(4, end)
            rest = txt.substring(end + 5, txt.length)
            d.meta = CorpMeta(metaField(block, "id"), metaField(block, "title"), metaField(block, "module"), metaField(block, "category"), metaField(block, "version"), metaField(block, "languageVersion"), metaField(block, "author"), metaField(block, "createdAt"), metaField(block, "updatedAt"), metaField(block, "keywords"), metaField(block, "symbols"), metaField(block, "dependencies"), metaField(block, "status"), metaField(block, "tags"), metaField(block, "example"), "")
        }
    }
    if (d.meta.id == "") {
        d.meta.id = wsSanitize(path)
        d.meta.title = d.meta.id
        d.meta.status = "unparsed"
    }
    d.body = rest
    return d
}

record SymRef(String symbol, String docId)
record DiagRegRec(String code, String docPath, String workaroundId)
record RecipeRec(String name, String docPath, String examplePath, Bool exampleExists)

class CorpusIndex {
    List<CorpusDoc> docs = listOf<CorpusDoc>()
    List<SymRef> symIndex = listOf<SymRef>()
    List<DiagRegRec> diagRegistry = listOf<DiagRegRec>()
    List<RecipeRec> recipeRegistry = listOf<RecipeRec>()
    List<String> builtinSymbols = listOf<String>()

    constructor() {
        builtinSymbols.add("spawn")
        builtinSymbols.add("record")
        builtinSymbols.add("constructor")
        builtinSymbols.add("Window")
        builtinSymbols.add("Palette.red")
        builtinSymbols.add("web.app")
        builtinSymbols.add("json.decode")
        builtinSymbols.add("json.encode")
        builtinSymbols.add("passwords.hash")
        builtinSymbols.add("db.connect")
        builtinSymbols.add("orm.save")
        builtinSymbols.add("log.info")
        builtinSymbols.add("config.str")
        builtinSymbols.add("crypto.sha256")
        builtinSymbols.add("secrets.get")
        builtinSymbols.add("jwt.verify")
    }
}

wsAddDoc(CorpusIndex ix, CorpusDoc d) {
    ix.docs.add(d)
    var syms = d.meta.symbolsCsv
    if (syms.length > 0) {
        var parts = splitStr(syms, ",")
        for (var p in parts) {
            var name = p.trim()
            if (name.length > 0) {
                ix.symIndex.add(SymRef(name, d.meta.id))
            }
        }
    }
}

wsBuildRegistries(CorpusIndex ix) {
    ix.diagRegistry = listOf<DiagRegRec>()
    ix.recipeRegistry = listOf<RecipeRec>()
    for (var d in ix.docs) {
        if (d.meta.category == "diagnostics") {
            var code = d.meta.id
            var w = ""
            if (d.body.contains("String_kof_string_to_int")) {
                w = "N2"
            }
            if (d.body.contains("CONC001")) {
                w = "CONC001"
            }
            ix.diagRegistry.add(DiagRegRec(code, d.relPath, w))
        }
        if (d.meta.category == "recipes") {
            var ex = d.meta.extraKey
            var exOk = false
            if (ex.length > 0) {
                var ef = File(ex)
                exOk = ef.exists() && ef.isFile()
            }
            ix.recipeRegistry.add(RecipeRec(d.meta.title, d.relPath, ex, exOk))
        }
    }
    if (ix.diagRegistry.size > 0 || ix.recipeRegistry.size > 0) {
    }
}

corpusLoad(EventBus bus, String root, TimeSource clock): CorpusIndex {
    bus.publish("corpus.loading", root)
    var ix = CorpusIndex()
    var paths = listOf<String>()
    collectMdFiles(root, 1, paths)
    for (var p in paths) {
        wsAddDoc(ix, parseCorpusDoc(p, root))
    }
    wsBuildRegistries(ix)
    bus.publish("corpus.loaded", "docs=" + ix.docs.size)
    return ix
}

record CorpIssueRec(String kind, String detail)


corpusValidate(CorpusIndex ix, String root): List<CorpIssueRec> {
    var issues = listOf<CorpIssueRec>()
    var i = 0
    while (i < ix.docs.size) {
        var a = ix.docs.get(i)
        if (a.meta.status == "unparsed") {
            issues.add(CorpIssueRec("invalid-file", a.relPath))
        }
        var j = i + 1
        while (j < ix.docs.size) {
            var b = ix.docs.get(j)
            if (b.meta.id == a.meta.id && a.meta.id != "") {
                issues.add(CorpIssueRec("duplicate-id", a.meta.id))
            }
            j = j + 1
        }
        var recomputed = wsHash(File(a.relPath).readText())
        if (recomputed != a.checksum) {
            issues.add(CorpIssueRec("checksum-changed", a.relPath))
        }
        var links = listOf<String>()
        for (var ln in splitStr(a.body, "\n")) {
            if (ln.contains("](") ) {
                var open = ln.indexOf("](")
                var close = ln.indexOf(")", open)
                if (close > open) {
                    links.add(ln.substring(open + 2, close))
                }
            }
        }
        for (var l in links) {
            if (!l.startsWith("http")) {
                var target = joinPath(joinPath(root, ""), l)
                var tf = File(target)
                if (!tf.exists()) {
                    issues.add(CorpIssueRec("broken-link", a.relPath + " -> " + l))
                }
            }
        }
        for (var sr in ix.symIndex) {
            if (sr.docId == a.meta.id) {
                var known = false
                for (var b in ix.builtinSymbols) {
                    if (b == sr.symbol) {
                        known = true
                    }
                }
                if (!known) {
                    issues.add(CorpIssueRec("orphan-symbol", sr.symbol + "@" + a.meta.id))
                }
            }
        }
        i = i + 1
    }
    return issues
}

corpusById(CorpusIndex ix, String id): CorpusDoc {
    for (var d in ix.docs) {
        if (d.meta.id == id) {
            return d
        }
    }
    return CorpusDoc()
}


corpusByCategory(CorpusIndex ix, String cat): List<CorpusDoc> {
    var out = listOf<CorpusDoc>()
    for (var d in ix.docs) {
        if (d.meta.category == cat) {
            out.add(d)
        }
    }
    return out
}

corpusSearchKeyword(CorpusIndex ix, String kw): List<CorpusDoc> {
    var out = listOf<CorpusDoc>()
    for (var d in ix.docs) {
        if (d.meta.keywordsCsv.contains(kw) || d.meta.title.contains(kw)) {
            out.add(d)
        }
    }
    return out
}

corpusSymbolDocs(CorpusIndex ix, String symbol): List<String> {
    var out = listOf<String>()
    for (var sr in ix.symIndex) {
        if (sr.symbol == symbol) {
            out.add(sr.docId)
        }
    }
    return out
}

corpusSerialize(CorpusIndex ix): String {
    var meta = ""
    var firstD = true
    for (var d in ix.docs) {
        if (!firstD) {
            meta = meta + "\u0002"
        }
        firstD = false
        meta = meta + d.relPath + "\u0003" + d.checksum + "\u0003" + d.meta.id
    }
    var symSec = ""
    var firstS = true
    for (var sr in ix.symIndex) {
        if (!firstS) {
            symSec = symSec + "\u0002"
        }
        firstS = false
        symSec = symSec + sr.symbol + "\u0003" + sr.docId
    }
    return meta + "\u0001" + symSec
}

corpusSaveCache(EventBus bus, String dir, CorpusIndex ix): Bool {
    var d = Directory(dir)
    if (!d.exists()) {
        d.createDirectories()
    }
    var body = corpusSerialize(ix)
    var okIdx = wsWriteVersioned(joinPath(dir, "corpus.idx"), "CRPIDX", CORPUS_IDX_VERSION(), body)
    var hashes = listOf<String>()
    for (var doc in ix.docs) {
        hashes.add(doc.relPath + "\u0003" + doc.checksum)
    }
    var okH = wsWriteVersioned(joinPath(dir, "corpus.hashes"), "CRPHSH", CORPUS_IDX_VERSION(), wsJoin(hashes, "\u0002"))
    var info = "{\"docs\":" + ix.docs.size + ",\"symbols\":" + ix.symIndex.size + ",\"diagnostics\":" + ix.diagRegistry.size + ",\"recipes\":" + ix.recipeRegistry.size + "}"
    var okM = wsWriteVersioned(joinPath(dir, "corpus.meta"), "CRPMET", CORPUS_IDX_VERSION(), info)
    bus.publish("registry.updated", info)
    return okIdx && okH && okM
}

record RetHit(String source, String id, String title, Int score, String snippet)
record CtxItem(String source, String id, String title, String body)
record RetOpts(String query, Int topK, Int maxChars, Bool useWorkspaceBoost)

retTokenize(String s): List<String> {
    var out = listOf<String>()
    var clean = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 46
        if (alpha) {
            if (c >= 65 && c <= 90) {
                clean = clean + " "
            }
            clean = clean + s.substring(i, i + 1)
        } else {
            clean = clean + " "
        }
        i = i + 1
    }
    for (var tk in splitStr(clean, " ")) {
        var t = tk.trim()
        if (t.length > 1) {
            out.add(t)
        }
    }
    return out
}

retLower(String s): String {
    return s.toLowerCase()
}

embedDocumentTokens(String title, String body): List<String> {
    var toks = retTokenize(title)
    for (var t in retTokenize(body)) {
        toks.add(t)
    }
    return toks
}

embedQueryTokens(String q): List<String> {
    return retTokenize(q)
}

embedWorkspaceTokens(CorpusIndex ix): List<String> {
    var out = listOf<String>()
    for (var d in ix.docs) {
        for (var k in splitStr(d.meta.keywordsCsv, ",")) {
            var kk = k.trim()
            if (kk.length > 0) {
                out.add(kk)
            }
        }
    }
    return out
}

embedSymbolTokens(String symbol): List<String> {
    return retTokenize(symbol)
}

embedDiagnosticTokens(String code, String message): List<String> {
    var out = retTokenize(code)
    for (var t in retTokenize(message)) {
        out.add(t)
    }
    return out
}

retOverlap(List<String> q, List<String> doc): Int {
    var n = 0
    for (var qt in q) {
        var ql = retLower(qt)
        for (var dt in doc) {
            if (retLower(dt) == ql) {
                n = n + 1
            }
        }
    }
    return n
}

retExpandSymbol(String symbol): List<String> {
    var out = listOf<String>(symbol)
    var s = retLower(symbol)
    if (s.contains("spawn")) {
        out.add("scheduler")
        out.add("task")
        out.add("future")
        out.add("runtime")
    }
    if (s.contains("record")) {
        out.add("dados")
        out.add("imutavel")
        out.add("constructor")
    }
    if (s.contains("json")) {
        out.add("decode")
        out.add("encode")
        out.add("serializacao")
    }
    return out
}

retExpandRecipe(String recipe): List<String> {
    var out = listOf<String>(recipe)
    var s = retLower(recipe)
    if (s.contains("crud") || s.contains("rest") || s.contains("api")) {
        out.add("http")
        out.add("json")
        out.add("database")
        out.add("validation")
        out.add("testing")
    }
    return out
}

retExpandDiagnostic(String code, CorpusIndex ix): List<String> {
    var out = listOf<String>(code)
    for (var d in ix.diagRegistry) {
        if (d.code.contains(code)) {
            if (d.workaroundId != "") {
                out.add("workaround-" + d.workaroundId)
            }
            out.add("exemplo-corrigido")
            out.add("documentacao")
        }
    }
    return out
}

retScoreDoc(List<String> qTokens, CorpusDoc d, List<String> recentFiles, List<SymRef> symIndex): Int {
    var docToks = embedDocumentTokens(d.meta.title + " " + d.meta.keywordsCsv, d.body)
    var score = retOverlap(qTokens, docToks)
    for (var qt in qTokens) {
        var ql = retLower(qt)
        for (var sr in symIndex) {
            if (retLower(sr.symbol).contains(ql)) {
                score = score + 3
                break
            }
        }
        if (d.meta.category == "diagnostics" && d.meta.id.contains(ql.toUpperCase())) {
            score = score + 4
        }
        if (d.meta.category == "recipes" && d.meta.title.contains(ql)) {
            score = score + 2
        }
        for (var rf in recentFiles) {
            if (rf == d.relPath) {
                score = score + 2
            }
        }
    }
    return score
}

retBuildContext(CorpusIndex ix, String query, Int topK, Int maxChars, List<String> recentFiles): String {
    var qTokens = embedQueryTokens(query)
    var expanded = listOf<String>()
    for (var qt in qTokens) {
        for (var e in retExpandSymbol(retLower(qt))) {
            expanded.add(e)
        }
    }
    var scored = listOf<RetHit>()
    for (var d in ix.docs) {
        var base = embedDocumentTokens(d.meta.title + " " + d.meta.keywordsCsv, d.body)
        var sc = retOverlap(expanded, base)
        for (var qt in qTokens) {
            var ql = retLower(qt)
            if (d.meta.id.contains(ql) || d.meta.title.contains(ql)) {
                sc = sc + 5
            }
            for (var sr in ix.symIndex) {
                if (sr.docId == d.meta.id && retLower(sr.symbol).contains(ql)) {
                    sc = sc + 3
                }
            }
            if (d.meta.category == "diagnostics" && d.meta.id.contains(ql.toUpperCase())) {
                sc = sc + 4
            }
            if (d.meta.category == "recipes") {
                for (var re in retExpandRecipe(query)) {
                    if (d.meta.title.contains(re) || d.body.contains(re)) {
                        sc = sc + 2
                    }
                }
            }
            for (var rf in recentFiles) {
                if (rf == d.relPath) {
                    sc = sc + 2
                }
            }
        }
        scored.add(RetHit("corpus", d.meta.id, d.meta.title, sc, d.relPath))
    }
    var picked = listOf<RetHit>()
    var budget = maxChars
    var k = 0
    while (k < topK) {
        var bestIdx = -1
        var bestScore = -1
        var i = 0
        while (i < scored.size) {
            var already = false
            for (var p in picked) {
                if (p.id == scored.get(i).id && p.source == scored.get(i).source) {
                    already = true
                }
            }
            if (!already && scored.get(i).score > bestScore) {
                bestScore = scored.get(i).score
                bestIdx = i
            }
            i = i + 1
        }
        if (bestIdx < 0) {
            break
        }
        var hit = scored.get(bestIdx)
        var cost = hit.title.length + hit.snippet.length + 10
        if (budget - cost < 0) {
            break
        }
        budget = budget - cost
        picked.add(hit)
        k = k + 1
    }
    var out = "{\"query\":\"" + escapeJson(query) + "\",\"items\":["
    var first = true
    for (var p in picked) {
        if (!first) {
            out = out + ","
        }
        first = false
        out = out + "{\"source\":\"" + p.source + "\",\"id\":\"" + escapeJson(p.id) + "\",\"title\":\"" + escapeJson(p.title) + "\",\"score\":" + p.score + "}"
    }
    out = out + "]}"
    return out
}

retCachePath(String dir, String qHash): String {
    return joinPath(dir, "q." + qHash + ".cache")
}

retCacheSave(EventBus bus, String dir, String query, String contextJson): Bool {
    var h = wsHash(retLower(query))
    var ok = wsWriteVersioned(retCachePath(dir, "" + h), "RETC", 1, contextJson)
    bus.publish("cache.miss", query)
    return ok
}

retCacheLoad(EventBus bus, String dir, String query): String {
    var h = wsHash(retLower(query))
    var body = wsReadVersioned(retCachePath(dir, "" + h), "RETC")
    if (body != "") {
        bus.publish("cache.hit", query)
    }
    return body
}

record GgufInfoRec(String path, Bool magicOk, Int version, Int nTensors)
record TensorR(Int rows, Int cols, Int[] data)

tkTokenize(String text): List<String> {
    var out = listOf<String>()
    var cur = ""
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)
        if (alpha) {
            cur = cur + text.substring(i, i + 1)
        } else {
            if (cur.length > 0) {
                out.add(cur)
                cur = ""
            }
        }
        i = i + 1
    }
    if (cur.length > 0) {
        out.add(cur)
    }
    return out
}

class Vocab {
    List<String> tokens = listOf<String>()
    constructor() {
    }
    addToken(String t): Int {
        var id = tkId(t)
        tokens.add(t)
        return id
    }
    size(): Int {
        return tokens.size
    }
    tokenAt(Int i): String {
        return tokens.get(i)
    }
}

tkId(String t): Int {
    var h = wsHash(retLower(t))
    if (h < 0) {
        h = 0 - h
    }
    return h % 50000
}

vocabBuildFromCorpus(CorpusIndex ix): Vocab {
    var v = Vocab()
    for (var d in ix.docs) {
        var toks = tkTokenize(d.meta.title + " " + d.body)
        for (var t in toks) {
            if (v.size() < 4096) {
                var dup = false
                for (var e in v.tokens) {
                    if (e == t) {
                        dup = true
                    }
                }
                if (!dup) {
                    v.addToken(t)
                }
            }
        }
    }
    return v
}

tkEncode(Vocab v, String text): List<Int> {
    var ids = listOf<Int>()
    for (var t in tkTokenize(text)) {
        ids.add(tkId(t))
    }
    return ids
}

tkDecode(List<Int> ids): String {
    var out = ""
    for (var id in ids) {
        out = out + "<" + id + ">"
    }
    return out
}

samplerLcg(Int seed): Int {
    var x = seed * 1103515245 + 12345
    if (x < 0) {
        x = 0 - x
    }
    return x % 2147483647
}

samplerTopK(Int[] logits, Int n, Int k, Int seed): Int {
    var best = logits[0]
    var bi = 0
    var s = samplerLcg(seed)
    var i = 0
    while (i < n) {
        if (logits[i] > best) {
            best = logits[i]
            bi = i
        }
        i = i + 1
    }
    var jitter = s % (k + 1)
    if (jitter == 0) {
        return bi
    }
    var alt = (bi + jitter) % n
    return alt
}

tensorNew(Int rows, Int cols): TensorR {
    return TensorR(rows, cols, new Int[rows * cols])
}

tensorGet(TensorR t, Int r, Int cc): Int {
    return t.data[r * t.cols + cc]
}

tensorSet(TensorR t, Int r, Int cc, Int v) {
    t.data[r * t.cols + cc] = v
}

tensorTranspose(TensorR t): TensorR {
    var o = tensorNew(t.cols, t.rows)
    var r = 0
    while (r < t.rows) {
        var c2 = 0
        while (c2 < t.cols) {
            tensorSet(o, c2, r, tensorGet(t, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

tensorMatMul(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows, b.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < b.cols) {
            var acc = 0
            var kk = 0
            while (kk < a.cols) {
                acc = acc + tensorGet(a, r, kk) * tensorGet(b, kk, c2)
                kk = kk + 1
            }
            tensorSet(o, r, c2, acc)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

ggufParseHeader(String path): GgufInfoRec {
    var f = File(path)
    if (!f.exists()) {
        return GgufInfoRec(path, false, 0, 0)
    }
    var txt = f.readText()
    var magicOk = txt.startsWith("GGUF")
    var ver = 0
    var nt = 0
    if (magicOk && txt.length > 9) {
        ver = parseIntStr(txt.substring(4, 6))
        nt = parseIntStr(txt.substring(6, 9))
    }
    return GgufInfoRec(path, magicOk, ver, nt)
}

record DeviceRec(String name, String kind, Int priority, Bool available)

HAL_CPU(): DeviceRec {
    return DeviceRec("cpu-simd", "CPU", 99, true)
}

halDetect(): List<DeviceRec> {
    var out = listOf<DeviceRec>()
    out.add(HAL_CPU())
    return out
}

halSelect(String overrideKind): DeviceRec {
    var devs = halDetect()
    if (overrideKind != "") {
        for (var d in devs) {
            if (d.kind == overrideKind) {
                return d
            }
        }
    }
    var best = HAL_CPU()
    for (var d in devs) {
        if (d.available && d.priority < best.priority) {
            best = d
        }
    }
    return best
}

halCopy(Int[] src): Int[] {
    var o = new Int[src.length]
    var i = 0
    while (i < src.length) {
        o[i] = src[i]
        i = i + 1
    }
    return o
}

halScale(Int[] src, Int k): Int[] {
    var o = new Int[src.length]
    var i = 0
    while (i < src.length) {
        o[i] = src[i] * k
        i = i + 1
    }
    return o
}

halDot(Int[] a, Int[] b): Int {
    var acc = 0
    var n = a.length
    if (b.length < n) {
        n = b.length
    }
    var i = 0
    while (i < n) {
        acc = acc + a[i] * b[i]
        i = i + 1
    }
    return acc
}

record BrainPlan(String intent, String entitiesJson, String contextJson, Int confidence, String ambiguitiesJson, String candidateToolsCsv, String candidateRecipesCsv, String candidateSymbolsCsv)

B_INTENT_UNKNOWN(): String { return "Unknown" }

brainSynonymIntent(String token): String {
    var s = retLower(token)
    if (s == "crie" || s == "cria" || s == "criar" || s == "faz" || s == "fazer" || s == "gera" || s == "gere" || s == "gerar") {
        return "create"
    }
    if (s == "edite" || s == "edita" || s == "editar" || s == "mude" || s == "mudar" || s == "altere") {
        return "edit"
    }
    if (s == "arruma" || s == "arrumar" || s == "corrija" || s == "corrigir" || s == "conserta") {
        return "repair"
    }
    if (s == "explique" || s == "explicar" || s == "o-que-e") {
        return "explain"
    }
    if (s == "refatore" || s == "refatorar") {
        return "refactor"
    }
    if (s == "busque" || s == "buscar" || s == "procure" || s == "procurar") {
        return "search"
    }
    if (s == "rode" || s == "rodar" || s == "teste" || s == "testar" || s == "execute") {
        return "runtests"
    }
    return ""
}

brainResolveIntent(List<String> tokens): String {
    var verb = ""
    var obj = ""
    for (var t in tokens) {
        var iv = brainSynonymIntent(t)
        if (iv != "" && verb == "") {
            verb = iv
        }
    }
    var joined = ""
    for (var t in tokens) {
        joined = joined + retLower(t) + " "
    }
    if (joined.contains(" site ") || joined.contains("website")) {
        obj = "Website"
    } else if (joined.contains("crud")) {
        obj = "CRUD"
    } else if (joined.contains(" api ")) {
        obj = "API"
    } else if (joined.contains("rpa")) {
        obj = "RPA"
    } else if (joined.contains(" ui ") || joined.contains("tela")) {
        obj = "UI"
    } else if (joined.contains("docs") || joined.contains("documentacao")) {
        obj = "Docs"
    } else if (joined.contains("teste")) {
        obj = "Tests"
    } else if (joined.contains("erro") || joined.contains("diagnostico")) {
        obj = "Diagnostic"
    } else if (joined.contains("simbolo") || joined.contains("funcao") || joined.contains("classe")) {
        obj = "Symbol"
    }
    if (verb == "") {
        return B_INTENT_UNKNOWN()
    }
    if (obj == "Website" && verb == "create") {
        return "CreateWebsite"
    }
    if (obj == "Website" && verb == "edit") {
        return "EditWebsite"
    }
    if (obj == "API" && (verb == "create" || verb == "edit")) {
        return "CreateAPI"
    }
    if (obj == "CRUD") {
        return "GenerateCRUD"
    }
    if (obj == "Diagnostic" && verb == "repair") {
        return "RepairDiagnostic"
    }
    if ((obj == "Diagnostic" && verb == "explain") || (verb == "explain" && obj == "")) {
        return "ExplainDiagnostic"
    }
    if (verb == "refactor") {
        return "Refactor"
    }
    if (obj == "Symbol" && verb == "search") {
        return "SearchSymbol"
    }
    if (obj == "RPA") {
        return "CreateRPA"
    }
    if ((obj == "Tests" && verb == "runtests") || verb == "runtests") {
        return "RunTests"
    }
    if (obj == "UI") {
        return "CreateUI"
    }
    if (obj == "Docs") {
        return "GenerateDocs"
    }
    if (verb == "create") {
        return "CreateFeature"
    }
    if (verb == "edit") {
        return "EditFeature"
    }
    if (verb == "repair") {
        return "RepairGeneric"
    }
    if (verb == "search") {
        return "SearchGeneric"
    }
    return B_INTENT_UNKNOWN()
}

brainExtractEntities(String text): String {
    var quoted = ""
    var q1 = text.indexOf("\"")
    if (q1 >= 0) {
        var q2 = text.indexOf("\"", q1 + 1)
        if (q2 > q1) {
            quoted = text.substring(q1 + 1, q2)
        }
    }
    var codes = ""
    for (var code in listOf<String>("ARITH001", "SEM011", "SEM015", "SEM010", "CONC001", "E999")) {
        if (text.contains(code)) {
            codes = code
        }
    }
    var paths = ""
    for (var t in splitStr(text, " ")) {
        if (t.endsWith(".kf") || t.startsWith("build/") || t.contains("/")) {
            paths = t
        }
    }
    return "{\"quoted\":\"" + escapeJson(quoted) + "\",\"diagCode\":\"" + codes + "\",\"path\":\"" + escapeJson(paths) + "\"}"
}

brainRequiredEntity(String intent): String {
    if (intent == "RepairDiagnostic") {
        return "diagCode"
    }
    if (intent == "EditWebsite" || intent == "EditFeature" || intent == "Refactor") {
        return "path"
    }
    return ""
}

brainConfidence(String intent, Bool hasVerb, Bool hasObj, Int ctxItems): Int {
    var score = 20
    if (hasVerb) {
        score = score + 30
    }
    if (intent != B_INTENT_UNKNOWN() && intent.contains("Create") || intent.contains("Edit") || intent.contains("Repair") || intent.contains("Search") || intent.contains("Run")) {
        score = score + 25
    }
    if (ctxItems > 0) {
        score = score + 15
    }
    if (score > 95) {
        score = 95
    }
    return score
}

brainCandidateTools(String intent): String {
    if (intent == "RepairDiagnostic") {
        return "compiler.check,search.text,patch.replace"
    }
    if (intent.startsWith("Create") || intent == "GenerateCRUD") {
        return "fs.write,ws.open,search.text"
    }
    if (intent == "RunTests") {
        return "compiler.run"
    }
    if (intent == "SearchSymbol") {
        return "search.symbol"
    }
    return ""
}

brainAmbiguitiesJson(String required, String entitiesJson, List<String> historyPaths): String {
    if (required == "") {
        return "[]"
    }
    var has = entitiesJson.contains("\"" + required + "\":\"")
    var filled = false
    if (entitiesJson.contains(required)) {
        var keyPart = "\"" + required + "\":\""
        var at = entitiesJson.indexOf(keyPart)
        if (at >= 0) {
            var vstart = at + keyPart.length
            var vend = entitiesJson.indexOf("\"", vstart)
            if (vend > vstart) {
                filled = true
            }
        }
    }
    if (!filled && historyPaths.size > 0) {
        filled = true
    }
    if (!filled) {
        return "[{\"missing\":\"" + required + "\",\"question\":\"Qual " + required + "?\"}]"
    }
    return "[]"
}

brainProcess(EventBus bus, CorpusIndex ix, String text, List<String> recentFiles, List<String> historyPaths): BrainPlan {
    bus.publish("brain.started", text)
    var tokens = retTokenize(text)
    var intent = brainResolveIntent(tokens)
    var entities = brainExtractEntities(text)
    var context = retBuildContext(ix, text, 5, 2000, recentFiles)
    var required = brainRequiredEntity(intent)
    var amb = brainAmbiguitiesJson(required, entities, historyPaths)
    var conf = brainConfidence(intent, tokens.size > 0, intent != B_INTENT_UNKNOWN(), 1)
    if (amb != "[]") {
        bus.publish("brain.ambiguity", amb)
        conf = 40
    }
    bus.publish("brain.intent", intent)
    bus.publish("brain.completed", intent + " conf=" + conf)
    var tools = brainCandidateTools(intent)
    var recipes = ""
    if (intent.contains("Website") || intent == "CreateAPI") {
        recipes = "recipe-rest-api"
    }
    var syms = ""
    return BrainPlan(intent, entities, context, conf, amb, tools, recipes, syms)
}

brainPlanJson(BrainPlan p): String {
    var out = "{\"intent\":\"" + p.intent + "\",\"confidence\":" + p.confidence
    out = out + ",\"entities\":" + p.entitiesJson
    out = out + ",\"context\":" + p.contextJson
    out = out + ",\"ambiguities\":" + p.ambiguitiesJson
    out = out + ",\"tools\":\"" + p.candidateToolsCsv + "\""
    out = out + ",\"recipes\":\"" + p.candidateRecipesCsv + "\""
    out = out + "}"
    return out
}

record PlanTaskRec(String id, String kind, String toolId, String argA, String argB, String depsCsv, String validation, String rollback)
record PlanValidationRec(String taskId, String kind, String detail)

PLANNER_VERSION(): Int { return 1 }

plStrategyFor(String intent): String {
    if (intent == "CreateWebsite" || intent == "CreateUI") {
        return "Web"
    }
    if (intent == "CreateAPI" || intent == "GenerateCRUD") {
        return "CRUD"
    }
    if (intent == "RepairDiagnostic") {
        return "Repair"
    }
    if (intent == "RunTests") {
        return "Compiler"
    }
    if (intent == "GenerateDocs") {
        return "Docs"
    }
    if (intent == "CreateRPA") {
        return "RPA"
    }
    return "Generic"
}

plEmit(EventBus bus, List<PlanTaskRec> tasks, String planId) {
    bus.publish("plan.created", planId + " tasks=" + tasks.size)
}

plTask(List<PlanTaskRec> out, String planId, Int seq, String kind, String toolId, String a, String b, String deps, String validation) {
    out.add(PlanTaskRec(planId + "-t" + seq, kind, toolId, a, b, deps, validation, ""))
}

plTasksFor(EventBus bus, BrainPlan plan, String targetFile): List<PlanTaskRec> {
    var out = listOf<PlanTaskRec>()
    var pid = "plan-" + plStrategyFor(plan.intent) + "-" + plan.confidence
    var seq = 0
    var last = ""
    if (plan.intent.startsWith("Create") || plan.intent == "GenerateCRUD") {
        seq = seq + 1
        plTask(out, pid, seq, "CreateDir", "fs.mkdir", joinPath("src", ""), "", "", "dir-exists")
        last = out.get(out.size - 1).id
        seq = seq + 1
        plTask(out, pid, seq, "CreateFile", "patch.file", joinPath("src", "main.kf"), "main() {\n}\n", last, "file-exists")
        last = out.get(out.size - 1).id
    }
    if (plan.intent == "RepairDiagnostic") {
        seq = seq + 1
        plTask(out, pid, seq, "CompileCheck", "compiler.check", targetFile, "", "", "compiles")
        last = out.get(out.size - 1).id
        seq = seq + 1
        plTask(out, pid, seq, "SearchText", "search.text", plan.entitiesJson, "", last, "results-found")
        last = out.get(out.size - 1).id
    }
    if (plan.intent == "RunTests") {
        seq = seq + 1
        plTask(out, pid, seq, "RunTests", "compiler.run", targetFile, "", "", "tests-pass")
        last = out.get(out.size - 1).id
    }
    if (out.size == 0) {
        seq = seq + 1
        plTask(out, pid, seq, "IndexWorkspace", "ws.open", "", "", "", "indexed")
        last = out.get(out.size - 1).id
    }
    plEmit(bus, out, pid)
    return out
}

plDepsSatisfiable(List<PlanTaskRec> tasks): Bool {
    var ids = listOf<String>()
    for (var t in tasks) {
        ids.add(t.id)
    }
    var ok = true
    for (var t in tasks) {
        if (t.depsCsv != "") {
            if (!wsInList(ids, t.depsCsv)) {
                ok = false
            }
        }
    }
    return ok
}

plHasCycle(List<PlanTaskRec> tasks): Bool {
    var edges = listOf<WsEdgeRec>()
    for (var t in tasks) {
        if (t.depsCsv != "") {
            edges.add(WsEdgeRec(t.id, t.depsCsv))
        }
    }
    return wsDetectCycle(edges).size > 0
}

plMergeDuplicates(List<PlanTaskRec> tasks): List<PlanTaskRec> {
    var out = listOf<PlanTaskRec>()
    for (var t in tasks) {
        var dup = false
        for (var o in out) {
            if (o.toolId == t.toolId && o.argA == t.argA && o.argB == t.argB) {
                dup = true
            }
        }
        if (!dup) {
            out.add(t)
        }
    }
    return out
}

class ExecutionPlan {
    String id = ""
    String intent = ""
    String strategy = ""
    List<PlanTaskRec> tasks = listOf<PlanTaskRec>()
    Bool acyclic = true
    Int version = PLANNER_VERSION()

    toJson(): String {
        var out = "{\"id\":\"" + id + "\",\"intent\":\"" + intent + "\",\"strategy\":\"" + strategy + "\""
        out = out + ",\"acyclic\":" + acyclic + ",\"tasks\":["
        var first = true
        for (var t in tasks) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"id\":\"" + t.id + "\",\"kind\":\"" + t.kind + "\",\"tool\":\"" + t.toolId + "\""
            if (t.depsCsv != "") {
                out = out + ",\"deps\":\"" + t.depsCsv + "\""
            }
            if (t.validation != "") {
                out = out + ",\"validate\":\"" + t.validation + "\""
            }
            out = out + "}"
        }
        out = out + "]}"
        return out
    }
}

plannerBuild(EventBus bus, BrainPlan plan, String targetFile): ExecutionPlan {
    var rawTasks = plTasksFor(bus, plan, targetFile)
    var merged = plMergeDuplicates(rawTasks)
    var plan0 = ExecutionPlan()
    plan0.intent = plan.intent
    plan0.strategy = plStrategyFor(plan.intent)
    plan0.tasks = merged
    plan0.acyclic = !plHasCycle(merged)
    bus.publish("plan.optimized", "tasks=" + merged.size)
    bus.publish("rollback.generated", "backups-via-katool-bak")
    return plan0
}

plValidateTask(ToolRegistry reg, ToolCtx ctx, PlanTaskRec t): PlanValidationRec {
    var kind = t.validation
    var ok = true
    var detail = kind
    if (kind == "file-exists") {
        var f = File(t.argA)
        ok = f.exists() && f.isFile()
    } else if (kind == "compiles") {
        ok = false
        detail = "GW-EXEC: compiler.check via ponte"
    } else if (kind == "tests-pass") {
        ok = false
        detail = "GW-EXEC: compiler.run via ponte"
    }
    if (ok) {
        ctx.bus.publish("task.validated", t.id)
    }
    return PlanValidationRec(t.id, kind, detail)
}

record ExecTaskState(String taskId, String state)
record RepairAttemptRec(Int attempt, String diagCode)

EXEC_READY(): String { return "READY" }
EXEC_RUNNING(): String { return "RUNNING" }
EXEC_SUCCESS(): String { return "SUCCESS" }
EXEC_FAILED(): String { return "FAILED" }
EXEC_SKIPPED(): String { return "SKIPPED" }
EXEC_ROLLED_BACK(): String { return "ROLLED_BACK" }

class ExecResult {
    Bool ok = true
    Int executed = 0
    Int failed = 0
    Int rolledBack = 0
    Int repairs = 0
    String lastError = ""
    constructor() {
    }
}

exRollback(ToolCtx c, ToolResult r): Bool {
    if (r.rollback.kind == "restore") {
        var rr = toolExec(defaultRegistry(), c, ToolCall("fs.rollbackRestore", c.requestId, r.rollback.backupPath, "", 0))
        return rr.status == "ok"
    }
    if (r.rollback.kind == "delete-created") {
        var f = File(r.rollback.backupPath)
        if (f.exists()) {
            f.delete()
        }
        return true
    }
    return false
}

exValidate(ToolCtx c, PlanTaskRec t): PlanValidationRec {
    return plValidateTask(defaultRegistry(), c, t)
}

exRepairAttempt(ToolCtx c, PlanTaskRec t, Int attempt): ToolResult {
    c.bus.publish("repair.started", t.id + " attempt=" + attempt)
    var diagCode = ""
    if (t.argA != "") {
        for (var code in listOf<String>("ARITH001", "SEM011", "SEM015", "SEM010")) {
            if (c.requestId.contains(code)) {
                diagCode = code
            }
        }
    }
    var r = toolErr("REPAIR-NOPATCH", "nenhum patch deterministico disponivel para " + diagCode)
    c.bus.publish("repair.finished", t.id)
    return r
}

exExecutePlan(ToolRegistry reg, ToolCtx ctx, ExecutionPlan plan, Int maxRepairs): ExecResult {
    ctx.bus.publish("plan.started", plan.id + " tasks=" + plan.tasks.size)
    var res = ExecResult()
    var states = listOf<ExecTaskState>()
    var i = 0
    while (i < plan.tasks.size) {
        states.add(ExecTaskState(plan.tasks.get(i).id, EXEC_READY()))
        i = i + 1
    }
    i = 0
    while (i < plan.tasks.size) {
        var t = plan.tasks.get(i)
        var depsOk = true
        if (t.depsCsv != "") {
            var j = 0
            while (j < i) {
                if (plan.tasks.get(j).id == t.depsCsv && states.get(j).state != EXEC_SUCCESS()) {
                    depsOk = false
                }
                j = j + 1
            }
        }
        var skipIt = false
        if (!depsOk) {
            skipIt = true
        }
        if (!skipIt) {
            states.get(i).state = EXEC_RUNNING()
            ctx.bus.publish("task.started", t.id)
            var r = toolExec(reg, ctx, ToolCall(t.toolId, ctx.requestId, t.argA, t.argB, 0))
            if (r.status != "ok") {
                states.get(i).state = EXEC_FAILED()
                res.failed = res.failed + 1
                res.lastError = r.data
                ctx.bus.publish("task.failed", t.id + ":" + r.data)
                var attempt = 1
                var repaired = false
                while (attempt <= maxRepairs) {
                    res.repairs = res.repairs + 1
                    var pr = exRepairAttempt(ctx, t, attempt)
                    if (pr.status == "ok") {
                        r = pr
                        repaired = true
                        attempt = maxRepairs + 1
                    }
                    attempt = attempt + 1
                }
                if (!repaired && r.rollback.kind != "") {
                    ctx.bus.publish("rollback.started", t.id)
                    if (exRollback(ctx, r)) {
                        states.get(i).state = EXEC_ROLLED_BACK()
                        res.rolledBack = res.rolledBack + 1
                    }
                    ctx.bus.publish("rollback.finished", t.id)
                }
            } else {
                states.get(i).state = EXEC_SUCCESS()
                res.executed = res.executed + 1
                ctx.bus.publish("task.completed", t.id)
            }
            if (!skipIt) {
            }
        }
        states.get(i).state = EXEC_RUNNING()
        ctx.bus.publish("task.started", t.id)
        var r = toolExec(reg, ctx, ToolCall(t.toolId, ctx.requestId, t.argA, t.argB, 0))
        if (r.status != "ok") {
            states.get(i).state = EXEC_FAILED()
            res.failed = res.failed + 1
            res.lastError = r.data
            ctx.bus.publish("task.failed", t.id + ":" + r.data)
            var attempt = 1
            while (attempt <= maxRepairs) {
                res.repairs = res.repairs + 1
                var pr = exRepairAttempt(ctx, t, attempt)
                if (pr.status == "ok") {
                    r = pr
                    break
                }
                attempt = attempt + 1
            }
            if (r.status != "ok" && r.rollback.kind != "") {
                ctx.bus.publish("rollback.started", t.id)
                if (exRollback(ctx, r)) {
                    states.get(i).state = EXEC_ROLLED_BACK()
                    res.rolledBack = res.rolledBack + 1
                }
                ctx.bus.publish("rollback.finished", t.id)
            }
        } else {
            states.get(i).state = EXEC_SUCCESS()
            res.executed = res.executed + 1
            ctx.bus.publish("task.completed", t.id)
        }
        i = i + 1
    }
    if (res.failed > 0) {
        res.ok = false
    }
    ctx.met.incByName("tasks.completed")
    ctx.bus.publish("plan.finished", plan.id + " ok=" + res.ok)
    return res
}

class RuntimeContext implements ContextView {
    Config cfg
    Logger logger
    EventBus bus = EventBus()
    Scheduler sched
    WorkerPool pool
    Lifecycle life = Lifecycle()
    Metrics met = Metrics()
    TimeSource clock

    constructor(Config c, TimeSource ts) {
        cfg = c
        clock = ts
        logger = Logger(ts)
        var lvlName = c.getStr("log.level", "INFO")
        var lvl = logLevelFromName(lvlName)
        if (lvl < 0) {
            lvl = LOG_INFO()
        }
        var col = false
        try {
            col = c.getBool("log.color", false)
        } catch (String e) {
            col = false
        }
        var js = false
        try {
            js = c.getBool("log.json", false)
        } catch (String e) {
            js = false
        }
        logger.configure(lvl, col, js)
        met.start(ts)
    }

    incMetric(String name) {
        met.incByName(name)
    }

    wire() {
        sched = Scheduler(this)
        pool = WorkerPool(sched, 1)
    }

    finishBoot(): Bool {
        life.transition(LC_READY())
        return true
    }

    shutdownGraceful() {
        if (life.state() == LC_READY()) {
            life.transition(LC_STOPPING())
        }
        sched.gracefulShutdown()
        life.transition(LC_STOPPED())
    }
}

runtimeStatusJson(RuntimeContext ctx): String {
    var out = "{\"state\":\"" + ctx.life.stateName() + "\""
    out = out + ",\"scheduler\":" + ctx.sched.statsJson()
    out = out + ",\"bus\":" + ctx.bus.statsJson()
    out = out + ",\"metrics\":" + ctx.met.snapshotJson(ctx.clock)
    out = out + "}"
    return out
}

class RealTimeClock implements TimeSource {
    constructor() {
    }
    nowMs(): Long {
        return now()
    }
}

WS_ROOT_C(): String { return "build/ws_c" }

setupC(): WorkspaceIndex {
    mkFile("build/ws_c/lib.kf", "record Shared(Int v)\n")
    var idx = WorkspaceIndex(WS_ROOT_C(), freshBus(), FixedClock(77))
    idx.fullRescan()
    return idx
}

test "dep edge from import to declaring file" {
    mkFile("build/ws_c/app.kf", "import Shared\n\nmain() {\n}\n")
    var idx = setupC()
    assert(idx.depsFrom(joinPath(WS_ROOT_C(), "app.kf")).size == 1)
    assert(idx.depsFrom(joinPath(WS_ROOT_C(), "lib.kf")).size == 0)
}
main() {
}
