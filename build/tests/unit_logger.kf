record ToolRollback(String kind, String backupPath)


class ToolResult {
    String status = "ok"
    String data = ""
    Long durationMs = 0
    ToolRollback rollback = ToolRollback("", "")
    constructor() {
    }
}


toolExec(ToolRegistry reg, ToolCtx ctx, ToolCall call): ToolResult {
    if (ctx.cancelled) {
        var cr = ToolResult()
        cr.status = "cancelled"
        return cr
    }
    var e = reg.findById(call.toolId)
    if (e.spec.id == "") {
        ctx.bus.publish("tool.failed", call.toolId)
        var nf = ToolResult()
        nf.status = "error"
        nf.data = "TOOL-NOTFOUND|" + call.toolId
        return nf
    }
    var miss = reg.entryMissingPerm(ctx, e)
    if (miss != "") {
        ctx.bus.publish("tool.denied", call.toolId + ":" + miss)
        var dn = ToolResult()
        dn.status = "denied"
        dn.data = miss
        return dn
    }
    ctx.bus.publish("tool.started", call.toolId + ":" + ctx.requestId)
    ctx.met.incByName("tasks.launched")
    var t0 = ctx.clock.nowMs()
    var r = e.handler.call(ctx, call)
    r.durationMs = ctx.clock.nowMs() - t0
    if (r.status == "ok") {
        ctx.met.incByName("tasks.completed")
        ctx.bus.publish("tool.finished", call.toolId)
    } else {
        ctx.met.incByName("tasks.failed")
        ctx.bus.publish("tool.failed", call.toolId)
    }
    return r
}
record CorpMeta(String id, String title, String module, String category, String version, String languageVersion, String author, String createdAt, String updatedAt, String keywordsCsv, String symbolsCsv, String dependenciesCsv, String status, String tagsCsv, String extraKey, String extraValue)
class CorpusDoc {
    CorpMeta meta = CorpMeta("", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "")
    String body = ""
    String relPath = ""
    Int checksum = 0
    constructor() {
    }
}

CORPUS_IDX_VERSION(): Int { return 1 }

collectMdFiles(String dir, Int depth, List<String> out) {
    if (depth > 5) {
        return
    }
    var d = Directory(dir)
    if (!d.exists() || !d.isDirectory()) {
        return
    }
    var names = d.list()
    for (var n in names) {
        var skipIt = n == ".git" || n == "build"
        if (!skipIt) {
            var child = joinPath(dir, n)
            var f = File(child)
            if (f.isFile()) {
                if (n.length >= 3) {
                    var ext = n.substring(n.length - 3, n.length)
                    if (ext == ".md") {
                        out.add(child)
                    }
                }
            } else {
                if (f.isDirectory()) {
                    collectMdFiles(child, depth + 1, out)
                }
            }
        }
    }
}

metaField(String block, String key): String {
    var lines = splitStr(block, "\n")
    var prefix = key + ":"
    for (var raw in lines) {
        var t = raw.trim()
        if (t.startsWith(prefix)) {
            return t.substring(prefix.length, t.length).trim()
        }
    }
    return ""
}

parseCorpusDoc(String path, String root): CorpusDoc {
    var d = CorpusDoc()
    d.relPath = path
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return d
    }
    var txt = f.readText()
    d.checksum = wsHash(txt)
    var rest = txt
    if (txt.startsWith("---\n")) {
        var end = txt.indexOf("\n---\n", 4)
        if (end > 0) {
            var block = txt.substring(4, end)
            rest = txt.substring(end + 5, txt.length)
            d.meta = CorpMeta(metaField(block, "id"), metaField(block, "title"), metaField(block, "module"), metaField(block, "category"), metaField(block, "version"), metaField(block, "languageVersion"), metaField(block, "author"), metaField(block, "createdAt"), metaField(block, "updatedAt"), metaField(block, "keywords"), metaField(block, "symbols"), metaField(block, "dependencies"), metaField(block, "status"), metaField(block, "tags"), metaField(block, "example"), "")
        }
    }
    if (d.meta.id == "") {
        d.meta.id = wsSanitize(path)
        d.meta.title = d.meta.id
        d.meta.status = "unparsed"
    }
    d.body = rest
    return d
}

record SymRef(String symbol, String docId)
record DiagRegRec(String code, String docPath, String workaroundId)
record RecipeRec(String name, String docPath, String examplePath, Bool exampleExists)

class CorpusIndex {
    List<CorpusDoc> docs = listOf<CorpusDoc>()
    List<SymRef> symIndex = listOf<SymRef>()
    List<DiagRegRec> diagRegistry = listOf<DiagRegRec>()
    List<RecipeRec> recipeRegistry = listOf<RecipeRec>()
    List<String> builtinSymbols = listOf<String>()

    constructor() {
        builtinSymbols.add("spawn")
        builtinSymbols.add("record")
        builtinSymbols.add("constructor")
        builtinSymbols.add("Window")
        builtinSymbols.add("Palette.red")
        builtinSymbols.add("web.app")
        builtinSymbols.add("json.decode")
        builtinSymbols.add("json.encode")
        builtinSymbols.add("passwords.hash")
        builtinSymbols.add("db.connect")
        builtinSymbols.add("orm.save")
        builtinSymbols.add("log.info")
        builtinSymbols.add("config.str")
        builtinSymbols.add("crypto.sha256")
        builtinSymbols.add("secrets.get")
        builtinSymbols.add("jwt.verify")
    }
}

wsAddDoc(CorpusIndex ix, CorpusDoc d) {
    ix.docs.add(d)
    var syms = d.meta.symbolsCsv
    if (syms.length > 0) {
        var parts = splitStr(syms, ",")
        for (var p in parts) {
            var name = p.trim()
            if (name.length > 0) {
                ix.symIndex.add(SymRef(name, d.meta.id))
            }
        }
    }
}

wsBuildRegistries(CorpusIndex ix) {
    ix.diagRegistry = listOf<DiagRegRec>()
    ix.recipeRegistry = listOf<RecipeRec>()
    for (var d in ix.docs) {
        if (d.meta.category == "diagnostics") {
            var code = d.meta.id
            var w = ""
            if (d.body.contains("String_kof_string_to_int")) {
                w = "N2"
            }
            if (d.body.contains("CONC001")) {
                w = "CONC001"
            }
            ix.diagRegistry.add(DiagRegRec(code, d.relPath, w))
        }
        if (d.meta.category == "recipes") {
            var ex = d.meta.extraKey
            var exOk = false
            if (ex.length > 0) {
                var ef = File(ex)
                exOk = ef.exists() && ef.isFile()
            }
            ix.recipeRegistry.add(RecipeRec(d.meta.title, d.relPath, ex, exOk))
        }
    }
    if (ix.diagRegistry.size > 0 || ix.recipeRegistry.size > 0) {
    }
}

corpusLoad(EventBus bus, String root, TimeSource clock): CorpusIndex {
    bus.publish("corpus.loading", root)
    var ix = CorpusIndex()
    var paths = listOf<String>()
    collectMdFiles(root, 1, paths)
    for (var p in paths) {
        wsAddDoc(ix, parseCorpusDoc(p, root))
    }
    wsBuildRegistries(ix)
    bus.publish("corpus.loaded", "docs=" + ix.docs.size)
    return ix
}

record CorpIssueRec(String kind, String detail)


corpusValidate(CorpusIndex ix, String root): List<CorpIssueRec> {
    var issues = listOf<CorpIssueRec>()
    var i = 0
    while (i < ix.docs.size) {
        var a = ix.docs.get(i)
        if (a.meta.status == "unparsed") {
            issues.add(CorpIssueRec("invalid-file", a.relPath))
        }
        var j = i + 1
        while (j < ix.docs.size) {
            var b = ix.docs.get(j)
            if (b.meta.id == a.meta.id && a.meta.id != "") {
                issues.add(CorpIssueRec("duplicate-id", a.meta.id))
            }
            j = j + 1
        }
        var recomputed = wsHash(File(a.relPath).readText())
        if (recomputed != a.checksum) {
            issues.add(CorpIssueRec("checksum-changed", a.relPath))
        }
        var links = listOf<String>()
        for (var ln in splitStr(a.body, "\n")) {
            if (ln.contains("](") ) {
                var open = ln.indexOf("](")
                var close = ln.indexOf(")", open)
                if (close > open) {
                    links.add(ln.substring(open + 2, close))
                }
            }
        }
        for (var l in links) {
            if (!l.startsWith("http")) {
                var target = joinPath(joinPath(root, ""), l)
                var tf = File(target)
                if (!tf.exists()) {
                    issues.add(CorpIssueRec("broken-link", a.relPath + " -> " + l))
                }
            }
        }
        for (var sr in ix.symIndex) {
            if (sr.docId == a.meta.id) {
                var known = false
                for (var b in ix.builtinSymbols) {
                    if (b == sr.symbol) {
                        known = true
                    }
                }
                if (!known) {
                    issues.add(CorpIssueRec("orphan-symbol", sr.symbol + "@" + a.meta.id))
                }
            }
        }
        i = i + 1
    }
    return issues
}

corpusById(CorpusIndex ix, String id): CorpusDoc {
    for (var d in ix.docs) {
        if (d.meta.id == id) {
            return d
        }
    }
    return CorpusDoc()
}


corpusByCategory(CorpusIndex ix, String cat): List<CorpusDoc> {
    var out = listOf<CorpusDoc>()
    for (var d in ix.docs) {
        if (d.meta.category == cat) {
            out.add(d)
        }
    }
    return out
}

corpusSearchKeyword(CorpusIndex ix, String kw): List<CorpusDoc> {
    var out = listOf<CorpusDoc>()
    var kwl = retLower(kw)
    for (var d in ix.docs) {
        if (retLower(d.meta.keywordsCsv).contains(kwl) || retLower(d.meta.title).contains(kwl)) {
            out.add(d)
        }
    }
    return out
}

corpusSymbolDocs(CorpusIndex ix, String symbol): List<String> {
    var out = listOf<String>()
    for (var sr in ix.symIndex) {
        if (sr.symbol == symbol) {
            out.add(sr.docId)
        }
    }
    return out
}

corpusSerialize(CorpusIndex ix): String {
    var meta = ""
    var firstD = true
    for (var d in ix.docs) {
        if (!firstD) {
            meta = meta + "\u0002"
        }
        firstD = false
        meta = meta + d.relPath + "\u0003" + d.checksum + "\u0003" + d.meta.id
    }
    var symSec = ""
    var firstS = true
    for (var sr in ix.symIndex) {
        if (!firstS) {
            symSec = symSec + "\u0002"
        }
        firstS = false
        symSec = symSec + sr.symbol + "\u0003" + sr.docId
    }
    return meta + "\u0001" + symSec
}

corpusSaveCache(EventBus bus, String dir, CorpusIndex ix): Bool {
    var d = Directory(dir)
    if (!d.exists()) {
        d.createDirectories()
    }
    var body = corpusSerialize(ix)
    var okIdx = wsWriteVersioned(joinPath(dir, "corpus.idx"), "CRPIDX", CORPUS_IDX_VERSION(), body)
    var hashes = listOf<String>()
    for (var doc in ix.docs) {
        hashes.add(doc.relPath + "\u0003" + doc.checksum)
    }
    var okH = wsWriteVersioned(joinPath(dir, "corpus.hashes"), "CRPHSH", CORPUS_IDX_VERSION(), wsJoin(hashes, "\u0002"))
    var info = "{\"docs\":" + ix.docs.size + ",\"symbols\":" + ix.symIndex.size + ",\"diagnostics\":" + ix.diagRegistry.size + ",\"recipes\":" + ix.recipeRegistry.size + "}"
    var okM = wsWriteVersioned(joinPath(dir, "corpus.meta"), "CRPMET", CORPUS_IDX_VERSION(), info)
    bus.publish("registry.updated", info)
    return okIdx && okH && okM
}

record RetHit(String source, String id, String title, Int score, String snippet)
record CtxItem(String source, String id, String title, String body)
record RetOpts(String query, Int topK, Int maxChars, Bool useWorkspaceBoost)

retTokenize(String s): List<String> {
    var out = listOf<String>()
    var clean = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 46
        if (alpha) {
            if (c >= 65 && c <= 90) {
                clean = clean + " "
            }
            clean = clean + s.substring(i, i + 1)
        } else {
            clean = clean + " "
        }
        i = i + 1
    }
    for (var tk in splitStr(clean, " ")) {
        var t = tk.trim()
        if (t.length > 1) {
            out.add(t)
        }
    }
    return out
}

embedDocumentTokens(String title, String body): List<String> {
    var toks = retTokenize(title)
    for (var t in retTokenize(body)) {
        toks.add(t)
    }
    return toks
}

embedQueryTokens(String q): List<String> {
    return retTokenize(q)
}

embedWorkspaceTokens(CorpusIndex ix): List<String> {
    var out = listOf<String>()
    for (var d in ix.docs) {
        for (var k in splitStr(d.meta.keywordsCsv, ",")) {
            var kk = k.trim()
            if (kk.length > 0) {
                out.add(kk)
            }
        }
    }
    return out
}

embedSymbolTokens(String symbol): List<String> {
    return retTokenize(symbol)
}

embedDiagnosticTokens(String code, String message): List<String> {
    var out = retTokenize(code)
    for (var t in retTokenize(message)) {
        out.add(t)
    }
    return out
}

retOverlap(List<String> q, List<String> doc): Int {
    var n = 0
    for (var qt in q) {
        var ql = retLower(qt)
        for (var dt in doc) {
            if (retLower(dt) == ql) {
                n = n + 1
            }
        }
    }
    return n
}

retExpandSymbol(String symbol): List<String> {
    var out = listOf<String>(symbol)
    var s = retLower(symbol)
    if (s.contains("spawn")) {
        out.add("scheduler")
        out.add("task")
        out.add("future")
        out.add("runtime")
    }
    if (s.contains("record")) {
        out.add("dados")
        out.add("imutavel")
        out.add("constructor")
    }
    if (s.contains("json")) {
        out.add("decode")
        out.add("encode")
        out.add("serializacao")
    }
    return out
}

retExpandRecipe(String recipe): List<String> {
    var out = listOf<String>(recipe)
    var s = retLower(recipe)
    if (s.contains("crud") || s.contains("rest") || s.contains("api")) {
        out.add("http")
        out.add("json")
        out.add("database")
        out.add("validation")
        out.add("testing")
    }
    return out
}

retExpandDiagnostic(String code, CorpusIndex ix): List<String> {
    var out = listOf<String>(code)
    for (var d in ix.diagRegistry) {
        if (d.code.contains(code)) {
            if (d.workaroundId != "") {
                out.add("workaround-" + d.workaroundId)
            }
            out.add("exemplo-corrigido")
            out.add("documentacao")
        }
    }
    return out
}

retScoreDoc(List<String> qTokens, CorpusDoc d, List<String> recentFiles, List<SymRef> symIndex): Int {
    var docToks = embedDocumentTokens(d.meta.title + " " + d.meta.keywordsCsv, d.body)
    var score = retOverlap(qTokens, docToks)
    for (var qt in qTokens) {
        var ql = retLower(qt)
        for (var sr in symIndex) {
            if (retLower(sr.symbol).contains(ql)) {
                score = score + 3
                break
            }
        }
        if (d.meta.category == "diagnostics" && d.meta.id.contains(ql.toUpperCase())) {
            score = score + 4
        }
        if (d.meta.category == "recipes" && d.meta.title.contains(ql)) {
            score = score + 2
        }
        for (var rf in recentFiles) {
            if (rf == d.relPath) {
                score = score + 2
            }
        }
    }
    return score
}

retBuildContext(CorpusIndex ix, String query, Int topK, Int maxChars, List<String> recentFiles): String {
    var qTokens = embedQueryTokens(query)
    var expanded = listOf<String>()
    for (var qt in qTokens) {
        for (var e in retExpandSymbol(retLower(qt))) {
            expanded.add(e)
        }
    }
    var scored = listOf<RetHit>()
    for (var d in ix.docs) {
        var base = embedDocumentTokens(d.meta.title + " " + d.meta.keywordsCsv, d.body)
        var sc = retOverlap(expanded, base)
        for (var qt in qTokens) {
            var ql = retLower(qt)
            if (d.meta.id.contains(ql) || d.meta.title.contains(ql)) {
                sc = sc + 5
            }
            for (var sr in ix.symIndex) {
                if (sr.docId == d.meta.id && retLower(sr.symbol).contains(ql)) {
                    sc = sc + 3
                }
            }
            if (d.meta.category == "diagnostics" && d.meta.id.contains(ql.toUpperCase())) {
                sc = sc + 4
            }
            if (d.meta.category == "recipes") {
                for (var re in retExpandRecipe(query)) {
                    if (d.meta.title.contains(re) || d.body.contains(re)) {
                        sc = sc + 2
                    }
                }
            }
            for (var rf in recentFiles) {
                if (rf == d.relPath) {
                    sc = sc + 2
                }
            }
        }
        scored.add(RetHit("corpus", d.meta.id, d.meta.title, sc, d.relPath))
    }
    var picked = listOf<RetHit>()
    var budget = maxChars
    var k = 0
    while (k < topK) {
        var bestIdx = -1
        var bestScore = -1
        var i = 0
        while (i < scored.size) {
            var already = false
            for (var p in picked) {
                if (p.id == scored.get(i).id && p.source == scored.get(i).source) {
                    already = true
                }
            }
            if (!already && scored.get(i).score > bestScore) {
                bestScore = scored.get(i).score
                bestIdx = i
            }
            i = i + 1
        }
        if (bestIdx < 0) {
            break
        }
        var hit = scored.get(bestIdx)
        var cost = hit.title.length + hit.snippet.length + 10
        if (budget - cost < 0) {
            break
        }
        budget = budget - cost
        picked.add(hit)
        k = k + 1
    }
    var out = "{\"query\":\"" + escapeJson(query) + "\",\"items\":["
    var first = true
    for (var p in picked) {
        if (!first) {
            out = out + ","
        }
        first = false
        out = out + "{\"source\":\"" + p.source + "\",\"id\":\"" + escapeJson(p.id) + "\",\"title\":\"" + escapeJson(p.title) + "\",\"score\":" + p.score + "}"
    }
    out = out + "]}"
    return out
}

retCachePath(String dir, String qHash): String {
    return joinPath(dir, "q." + qHash + ".cache")
}

retCacheSave(EventBus bus, String dir, String query, String contextJson): Bool {
    var h = wsHash(retLower(query))
    var ok = wsWriteVersioned(retCachePath(dir, "" + h), "RETC", 1, contextJson)
    bus.publish("cache.miss", query)
    return ok
}

retCacheLoad(EventBus bus, String dir, String query): String {
    var h = wsHash(retLower(query))
    var body = wsReadVersioned(retCachePath(dir, "" + h), "RETC")
    if (body != "") {
        bus.publish("cache.hit", query)
    }
    return body
}

class MemEntry {
    String key = ""
    String kind = ""
    String value = ""
    Int checksum = 0
    Long createdAt = 0
    Long expiresAt = 0
    constructor(String k, String kd, String v, Int ck, Long ca, Long ea) {
        key = k
        kind = kd
        value = v
        checksum = ck
        createdAt = ca
        expiresAt = ea
    }
}

class MemoryLayer {
    List<MemEntry> entries = listOf<MemEntry>()
    TimeSource clock
    String storeDir = "build/memory"
    constructor(TimeSource ts) {
        clock = ts
    }

    put(String key, String kind, String value, Long ttlMs) {
        remove(key)
        var exp: Long = 0
        if (ttlMs > 0) {
            exp = clock.nowMs() + ttlMs
        }
        entries.add(MemEntry(key, kind, value, wsHash(value), clock.nowMs(), exp))
    }

    get(String key): String {
        var now = clock.nowMs()
        var i = 0
        while (i < entries.size) {
            var e = entries.get(i)
            if (e.key == key) {
                if (e.expiresAt > 0 && e.expiresAt < now) {
                    entries.remove(i)
                    return ""
                }
                return e.value
            }
            i = i + 1
        }
        return ""
    }

    remove(String key): Bool {
        var i = 0
        while (i < entries.size) {
            if (entries.get(i).key == key) {
                entries.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    purgeExpired(): Int {
        var now = clock.nowMs()
        var removed = 0
        var i = 0
        while (i < entries.size) {
            var e = entries.get(i)
            var expired = e.expiresAt > 0 && e.expiresAt < now
            if (expired) {
                entries.remove(i)
                removed = removed + 1
            } else {
                i = i + 1
            }
        }
        return removed
    }

    byKind(String kind): List<MemEntry> {
        var out = listOf<MemEntry>()
        for (var e in entries) {
            if (e.kind == kind) {
                out.add(e)
            }
        }
        return out
    }

    snapshotTo(String dirPath): Bool {
        var d = Directory(dirPath)
        if (!d.exists()) {
            d.createDirectories()
        }
        var secs = listOf<String>()
        for (var e in entries) {
            secs.add(e.key + "\u0003" + e.kind + "\u0003" + escapeJson(e.value) + "\u0003" + e.createdAt + "\u0003" + e.expiresAt)
        }
        return wsWriteVersioned(joinPath(dirPath, "memory.snap"), "MEMSNP", 1, wsJoin(secs, "\u0002"))
    }

    restoreFrom(String dirPath): Bool {
        var body = wsReadVersioned(joinPath(dirPath, "memory.snap"), "MEMSNP")
        if (body == "") {
            return false
        }
        entries = listOf<MemEntry>()
        for (var entry in splitStr(body, "\u0002")) {
            var f = splitStr(entry, "\u0003")
            if (f.size == 5) {
                entries.add(MemEntry(f.get(0), f.get(1), f.get(2), wsHash(f.get(2)), parseLongSafe(f.get(3)), parseLongSafe(f.get(4))))
            }
        }
        return true
    }

    statsJson(): String {
        var ep = 0
        var sem = 0
        var ses = 0
        for (var e in entries) {
            if (e.kind == "episodic") {
                ep = ep + 1
            } else if (e.kind == "semantic") {
                sem = sem + 1
            } else {
                ses = ses + 1
            }
        }
        return "{\"episodic\":" + ep + ",\"semantic\":" + sem + ",\"session\":" + ses + ",\"total\":" + entries.size + "}"
    }
}

memSearch(MemoryLayer m, String needle): List<MemEntry> {
    var out = listOf<MemEntry>()
    for (var e in m.entries) {
        if (e.value.contains(needle) || e.key.contains(needle)) {
            out.add(e)
        }
    }
    return out
}

interface EmbeddingsProvider {
    embed(text: String): List<Int>
}

record TurnRec(Int seq, String role, String content, Long ts)

class ConversationEngine {
    List<TurnRec> turns = listOf<TurnRec>()
    Int nextSeq = 1
    TimeSource clock
    Int windowSize = 20
    constructor(TimeSource ts) {
        clock = ts
    }

    add(String role, String content) {
        turns.add(TurnRec(nextSeq, role, content, clock.nowMs()))
        nextSeq = nextSeq + 1
        compact()
    }

    compact() {
        while (turns.size > windowSize) {
            turns.remove(0)
        }
    }

    summarizeOlder(Int keepRecent): String {
        var out = ""
        var start = 0
        var cut = turns.size - keepRecent
        while (start < cut) {
            out = out + "[" + turns.get(start).role + "] " + turns.get(start).content + "\n"
            start = start + 1
        }
        return out
    }

    lastUser(): String {
        var i = turns.size - 1
        while (i >= 0) {
            if (turns.get(i).role == "user") {
                return turns.get(i).content
            }
            i = i - 1
        }
        return ""
    }

    contextWindow(Int n): List<TurnRec> {
        var out = listOf<TurnRec>()
        var start = turns.size - n
        if (start < 0) {
            start = 0
        }
        var i = start
        while (i < turns.size) {
            out.add(turns.get(i))
            i = i + 1
        }
        return out
    }

    cite(Int seq): String {
        for (var t in turns) {
            if (t.seq == seq) {
                return t.role + ": " + t.content
            }
        }
        return ""
    }

    statsJson(): String {
        return "{\"turns\":" + turns.size + ",\"window\":" + windowSize + "}"
    }
}

class PromptBuilder {
    List<String> parts = listOf<String>()
    constructor() {
    }
    addSection(String title, String body) {
        parts.add("## " + title + "\n" + body)
    }
    build(): String {
        return wsJoin(parts, "\n\n")
    }
}

promptBuild(CorpusIndex ix, ConversationEngine conv, String query): String {
    var pb = PromptBuilder()
    pb.addSection("Query", query)
    pb.addSection("Historico", conv.summarizeOlder(10))
    var hits = corpusSearchKeyword(ix, retLower(query))
    for (var h in hits) {
        pb.addSection(h.meta.id, h.body)
    }
    return pb.build()
}

record CtxChunk(String source, String id, String title, String body, Int score)

orchFuse(CorpusIndex ix, MemoryLayer mem, String query, Int topK, Int maxChars): String {
    var ctxJson = retBuildContext(ix, query, topK, maxChars, listOf<String>())
    var chunks = listOf<CtxChunk>()
    var parts = splitStr(ctxJson, "{\"id\":\"")
    var i = 1
    while (i < parts.size) {
        var seg = parts.get(i)
        var q1 = seg.indexOf("\"")
        var id = seg.substring(0, q1)
        var seen = false
        for (var ch in chunks) {
            if (ch.id == id) {
                seen = true
            }
        }
        if (!seen && id != "") {
            chunks.add(CtxChunk("corpus", id, id, "", 10))
        }
        i = i + 1
    }
    var memHits = mem.byKind("semantic")
    for (var m in memHits) {
        if (m.value.contains(query)) {
            chunks.add(CtxChunk("memory", m.key, m.key, m.value, 8))
        }
    }
    var out = "{\"query\":\"" + escapeJson(query) + "\",\"chunks\":["
    var first = true
    var budget = maxChars
    for (var ch2 in chunks) {
        var cost = ch2.title.length + 6
        if (budget - cost >= 0) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"source\":\"" + ch2.source + "\",\"id\":\"" + escapeJson(ch2.id) + "\"}"
            budget = budget - cost
        }
    }
    out = out + "]}"
    return out
}

orchExplain(String ctxJson): String {
    return "Contexto montado por fusao corpus+memory com dedup por id e orcamento de caracteres. Fontes em ordem de score."
}

orchProvenance(String ctxJson): List<String> {
    var prov = listOf<String>()
    var parts = splitStr(ctxJson, "{\"source\":\"")
    var i = 1
    while (i < parts.size) {
        var seg = parts.get(i)
        var q1 = seg.indexOf("\"")
        if (q1 > 0) {
            prov.add(seg.substring(0, q1))
        }
        i = i + 1
    }
    return prov
}

record GgufInfoRec(String path, Bool magicOk, Int version, Int nTensors)
record TensorR(Int rows, Int cols, Int[] data)

tkTokenize(String text): List<String> {
    var out = listOf<String>()
    var cur = ""
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)
        if (alpha) {
            cur = cur + text.substring(i, i + 1)
        } else {
            if (cur.length > 0) {
                out.add(cur)
                cur = ""
            }
        }
        i = i + 1
    }
    if (cur.length > 0) {
        out.add(cur)
    }
    return out
}

class Vocab {
    List<String> tokens = listOf<String>()
    constructor() {
    }
    addToken(String t): Int {
        var id = tkId(t)
        tokens.add(t)
        return id
    }
    size(): Int {
        return tokens.size
    }
    tokenAt(Int i): String {
        return tokens.get(i)
    }
}

tkId(String t): Int {
    var h = wsHash(retLower(t))
    if (h < 0) {
        h = 0 - h
    }
    return h % 50000
}

vocabBuildFromCorpus(CorpusIndex ix): Vocab {
    var v = Vocab()
    for (var d in ix.docs) {
        var toks = tkTokenize(d.meta.title + " " + d.body)
        for (var t in toks) {
            if (v.size() < 4096) {
                var dup = false
                for (var e in v.tokens) {
                    if (e == t) {
                        dup = true
                    }
                }
                if (!dup) {
                    v.addToken(t)
                }
            }
        }
    }
    return v
}

tkEncode(Vocab v, String text): List<Int> {
    var ids = listOf<Int>()
    for (var t in tkTokenize(text)) {
        ids.add(tkId(t))
    }
    return ids
}

tkDecode(List<Int> ids): String {
    var out = ""
    for (var id in ids) {
        out = out + "<" + id + ">"
    }
    return out
}

samplerLcg(Int seed): Int {
    var x = seed * 1103515245 + 12345
    if (x < 0) {
        x = 0 - x
    }
    return x % 2147483647
}

samplerTopK(Int[] logits, Int n, Int k, Int seed): Int {
    var best = logits[0]
    var bi = 0
    var s = samplerLcg(seed)
    var i = 0
    while (i < n) {
        if (logits[i] > best) {
            best = logits[i]
            bi = i
        }
        i = i + 1
    }
    var jitter = s % (k + 1)
    if (jitter == 0) {
        return bi
    }
    var alt = (bi + jitter) % n
    return alt
}

tensorNew(Int rows, Int cols): TensorR {
    return TensorR(rows, cols, new Int[rows * cols])
}

tensorGet(TensorR t, Int r, Int cc): Int {
    return t.data[r * t.cols + cc]
}

tensorSet(TensorR t, Int r, Int cc, Int v) {
    t.data[r * t.cols + cc] = v
}

tensorTranspose(TensorR t): TensorR {
    var o = tensorNew(t.cols, t.rows)
    var r = 0
    while (r < t.rows) {
        var c2 = 0
        while (c2 < t.cols) {
            tensorSet(o, c2, r, tensorGet(t, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

tensorMatMul(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows, b.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < b.cols) {
            var acc = 0
            var kk = 0
            while (kk < a.cols) {
                acc = acc + tensorGet(a, r, kk) * tensorGet(b, kk, c2)
                kk = kk + 1
            }
            tensorSet(o, r, c2, acc)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

ggufParseHeader(String path): GgufInfoRec {
    var f = File(path)
    if (!f.exists()) {
        return GgufInfoRec(path, false, 0, 0)
    }
    var txt = f.readText()
    var magicOk = txt.startsWith("GGUF")
    var ver = 0
    var nt = 0
    if (magicOk && txt.length > 9) {
        ver = parseIntStr(txt.substring(4, 6))
        nt = parseIntStr(txt.substring(6, 9))
    }
    return GgufInfoRec(path, magicOk, ver, nt)
}

record TVView(TensorR base, Int offR, Int offC, Int rows, Int cols)

tvGet(TVView v, Int r, Int c): Int {
    return tensorGet(v.base, v.offR + r, v.offC + c)
}

tvSet(TVView v, Int r, Int c2, Int newVal) {
    tensorSet(v.base, v.offR + r, v.offC + c2, newVal)
}

tvSliceRows(TensorR t, Int offR, Int rows): TVView {
    return TVView(t, offR, 0, rows, t.cols)
}

tvBroadcast(Int fill, Int rows, Int cols): TensorR {
    var t = tensorNew(rows, cols)
    var r = 0
    while (r < rows) {
        var c2 = 0
        while (c2 < cols) {
            tensorSet(t, r, c2, fill)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return t
}

tensorReshape(TensorR t, Int rows, Int cols): TensorR {
    var o = tensorNew(rows, cols)
    var i = 0
    while (i < rows * cols && i < t.data.length) {
        o.data[i] = t.data[i]
        i = i + 1
    }
    return o
}

tensorConcatRows(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows + b.rows, a.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < a.cols) {
            tensorSet(o, r, c2, tensorGet(a, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    r = 0
    while (r < b.rows) {
        var c3 = 0
        while (c3 < b.cols) {
            tensorSet(o, a.rows + r, c3, tensorGet(b, r, c3))
            c3 = c3 + 1
        }
        r = r + 1
    }
    return o
}

class Arena {
    Int[] buf = new Int[1024]
    Int used = 0
    constructor() {
    }
    alloc(Int n): Int {
        var at = used
        if (used + n > buf.length) {
            return -1
        }
        used = used + n
        return at
    }
    reset() {
        used = 0
    }
    capacity(): Int {
        return buf.length
    }
    utilization(): Int {
        return used
    }
}

Q8_BLOCK(): Int { return 32 }

quantizeQ8Block(Int[] src, Int off): Int[] {
    var out = new Int[Q8_BLOCK() + 1]
    var maxAbs = 0
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        if (v < 0) {
            if ((0 - v) > maxAbs) {
                maxAbs = 0 - v
            }
        } else {
            if (v > maxAbs) {
                maxAbs = v
            }
        }
        i = i + 1
    }
    out[0] = maxAbs
    i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var q = 0
        if (maxAbs > 0) {
            q = v * 127 / maxAbs
        }
        out[i + 1] = q
        i = i + 1
    }
    return out
}

dequantizeQ8Block(Int[] blk): Int[] {
    var o = new Int[Q8_BLOCK()]
    var scale = blk[0]
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = blk[i + 1]
        if (scale > 0) {
            v = v * scale / 127
        }
        o[i] = v
        i = i + 1
    }
    return o
}

class KVCache {
    List<Int[]> keys = listOf<Int[]>()
    List<Int[]> vals = listOf<Int[]>()
    Int window = 64
    Int evictions = 0
    constructor() {
    }
    append(Int[] k, Int[] v) {
        keys.add(k)
        vals.add(v)
        if (keys.size > window) {
            keys.remove(0)
            vals.remove(0)
            evictions = evictions + 1
        }
    }
    size(): Int {
        return keys.size
    }
    compact() {
        keys = keys
        vals = vals
    }
}

// M16 part 82: Tensor ops V2 — arena, stable softmax, rmsnorm, gelu/silu, causal mask

record ArenaStats(Int allocs, Int reuses, Int peakBytes)
record ArenaSlot(Int key, TensorR tensor)

class TensorArena {
    List<ArenaSlot> free = listOf<ArenaSlot>()
    ArenaStats stats = ArenaStats(0, 0, 0)

    acquire(Int rows, Int cols): TensorR {
        var key = rows * 100000 + cols
        var i = 0
        while (i < free.size()) {
            var s = free.get(i)
            if (s.key == key) {
                var out2 = s.tensor
                var j = i
                while (j < free.size() - 1) {
                    free.set(j, free.get(j + 1))
                    j = j + 1
                }
                stats = ArenaStats(stats.allocs + 1, stats.reuses + 1, stats.peakBytes)
                return out2
            }
            i = i + 1
        }
        stats = ArenaStats(stats.allocs + 1, stats.reuses, stats.peakBytes)
        return tensorNew(rows, cols)
    }

    release(TensorR t) {
        free.add(ArenaSlot(t.rows * 100000 + t.cols, t))
        var bytes = t.rows * t.cols * 4
        if (bytes > stats.peakBytes) {
            stats = ArenaStats(stats.allocs, stats.reuses, bytes)
        }
    }
}

tensorSoftmaxRow(TensorR t, Int row): TensorR {
    var out = tensorNew(1, t.cols)
    var maxv = tensorGet(t, row, 0)
    var c2 = 1
    while (c2 < t.cols) {
        if (tensorGet(t, row, c2) > maxv) {
            maxv = tensorGet(t, row, c2)
        }
        c2 = c2 + 1
    }
    var sum = 0
    c2 = 0
    while (c2 < t.cols) {
        var d = maxv - tensorGet(t, row, c2)
        var e = 10000000 / (10 + d)
        tensorSet(out, 0, c2, e)
        sum = sum + e
        c2 = c2 + 1
    }
    if (sum == 0) { sum = 1 }
    c2 = 0
    while (c2 < t.cols) {
        tensorSet(out, 0, c2, tensorGet(out, 0, c2) * 10000 / sum)
        c2 = c2 + 1
    }
    return out
}

tensorRmsNorm(TensorR t): TensorR {
    var out = tensorNew(t.rows, t.cols)
    var r = 0
    while (r < t.rows) {
        var ss = 0
        var c2 = 0
        while (c2 < t.cols) {
            var v = tensorGet(t, r, c2)
            ss = ss + v * v / 1000
            c2 = c2 + 1
        }
        var inv = 31623 * 1000 / (100 + ss)
        c2 = 0
        while (c2 < t.cols) {
            tensorSet(out, r, c2, tensorGet(t, r, c2) * inv / 100000)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return out
}

gelu(x: Int): Int {
    var x3 = x * x * x / 1000000
    return (x + x3 / 6) / 2
}

silu(x: Int): Int {
    if (x <= 0) { return x / 4 }
    return x
}

// residual add elemento a elemento (dims devem casar; min comum)
tensorAdd(TensorR a, TensorR b): TensorR {
    var rows = a.rows
    var cols = a.cols
    if (b.rows < rows) { rows = b.rows }
    if (b.cols < cols) { cols = b.cols }
    var o = tensorNew(rows, cols)
    var r = 0
    while (r < rows) {
        var c2 = 0
        while (c2 < cols) {
            tensorSet(o, r, c2, tensorGet(a, r, c2) + tensorGet(b, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

record CausalMask(Int penalty)

tensorCausalMask(Int seqLen): TensorR {
    var m = tensorNew(seqLen, seqLen)
    var cm = CausalMask(1000000)
    var i = 0
    while (i < seqLen) {
        var j = 0
        while (j < seqLen) {
            if (j > i) {
                tensorSet(m, i, j, cm.penalty)
            } else {
                tensorSet(m, i, j, 0)
            }
            j = j + 1
        }
        i = i + 1
    }
    return m
}

record DeviceRec(String name, String kind, Int priority, Bool available)

HAL_CPU(): DeviceRec {
    return DeviceRec("cpu-simd", "CPU", 99, true)
}

halDetect(): List<DeviceRec> {
    var out = listOf<DeviceRec>()
    out.add(HAL_CPU())
    return out
}

halSelect(String overrideKind): DeviceRec {
    var devs = halDetect()
    if (overrideKind != "") {
        for (var d in devs) {
            if (d.kind == overrideKind) {
                return d
            }
        }
    }
    var best = HAL_CPU()
    for (var d in devs) {
        if (d.available && d.priority < best.priority) {
            best = d
        }
    }
    return best
}

halCopy(Int[] src): Int[] {
    var o = new Int[src.length]
    var i = 0
    while (i < src.length) {
        o[i] = src[i]
        i = i + 1
    }
    return o
}

halScale(Int[] src, Int k): Int[] {
    var o = new Int[src.length]
    var i = 0
    while (i < src.length) {
        o[i] = src[i] * k
        i = i + 1
    }
    return o
}

halDot(Int[] a, Int[] b): Int {
    var acc = 0
    var n = a.length
    if (b.length < n) {
        n = b.length
    }
    var i = 0
    while (i < n) {
        acc = acc + a[i] * b[i]
        i = i + 1
    }
    return acc
}

record HostInfoRec(Int cpuCores, Int memKb)

halHostInfo(): HostInfoRec {
    var cores = 0
    var ci = File("/proc/cpuinfo")
    if (ci.exists() && ci.isFile()) {
        var txt = ci.readText()
        cores = wsCountOccurrences(txt, "processor")
    }
    var memKb = 0
    var mi = File("/proc/meminfo")
    if (mi.exists() && mi.isFile()) {
        var t = mi.readText()
        var idx = t.indexOf("MemTotal:")
        if (idx >= 0) {
            var rest = t.substring(idx + 9, t.length).trim()
            var num = ""
            var k = 0
            while (k < rest.length) {
                var ch = rest.charAt(k)
                if (ch >= 48 && ch <= 57) {
                    num = num + rest.substring(k, k + 1)
                } else {
                    if (num.length > 0) {
                        k = rest.length
                    }
                }
                k = k + 1
            }
            if (num.length > 0) {
                memKb = parseIntStr(num)
            }
        }
    }
    return HostInfoRec(cores, memKb)
}

// M16.2: RoPE V2, KV Cache V2, Quantizacao Q4-Q8, Sampler V3, Arena checkpoints

record RopeFreqs(Int[] cosT, Int[] sinT, Int dims, Int scalePct)

ropeBuild(Int maxPos, Int dims): RopeFreqs {
    var cosT = new Int[maxPos * dims]
    var sinT = new Int[maxPos * dims]
    var p = 0
    while (p < maxPos) {
        var i = 0
        while (i < dims) {
            var freqNum = p * (i + 2)
            var freqDen = dims * 2
            var ang = (freqNum * 3141 / freqDen) % 6283
            var deg = ang * 360 / 6283
            var rad = deg
            var c = 10000
            if (deg <= 90) { c = 10000 - deg * deg * 121 / 10000 / 10 }
            else { c = (180 - deg) * (180 - deg) * 121 / 100000 }
            var s = deg * 1745 / 10000
            if (s > 10000) { s = 10000 }
            cosT[p * dims + i] = c
            sinT[p * dims + i] = s
            i = i + 1
        }
        p = p + 1
    }
    return RopeFreqs(cosT, sinT, dims, 100)
}

applyRope(TensorR q, TensorR k, RopeFreqs rf, Int posOffset) {
    var half = rf.dims / 2
    var r = 0
    while (r < q.rows) {
        var pos = posOffset + r
        var i = 0
        while (i < half) {
            var j = i + half
            var qc = tensorGet(q, r, i)
            var qj = tensorGet(q, r, j)
            var cs = rf.cosT[pos * rf.dims + i]
            var sn = rf.sinT[pos * rf.dims + i]
            tensorSet(q, r, i, (qc * cs - qj * sn) / 10000)
            tensorSet(q, r, j, (qj * cs + qc * sn) / 10000)
            var kc = tensorGet(k, r, i)
            var kj = tensorGet(k, r, j)
            tensorSet(k, r, i, (kc * cs - kj * sn) / 10000)
            tensorSet(k, r, j, (kj * cs + kc * sn) / 10000)
            i = i + 1
        }
        r = r + 1
    }
}

record KVEntry(Int token, Int layer)
record KVSnapshot(Int size, Int cap)

class KVCacheV2 {
    List<Int[]> keys = listOf<Int[]>()
    List<Int[]> values = listOf<Int[]>()
    Int size = 0
    Int window = 0

    initKv(Int win) {
        window = win
        size = 0
    }

    append(Int[] key, Int[] vals) {
        keys.add(key)
        values.add(vals)
        size = size + 1
        if (window > 0 && size > window) {
            keys.remove(0)
            values.remove(0)
            size = size - 1
        }
    }

    keyAt(Int i): Int[] {
        return keys.get(i)
    }

    reset() {
        while (keys.size() > 0) {
            keys.remove(0)
            values.remove(0)
        }
        size = 0
    }

    snapshot(): KVSnapshot {
        return KVSnapshot(size, keys.size())
    }
}

fn quantizeQ4(Int[] src, Int off): Int[] {
    var out = new Int[Q8_BLOCK() / 2 + 1]
    var maxAbs = 0
    var i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var mag = v
        if (mag > maxAbs) { maxAbs = mag }
        var nv = 0 - v
        if (nv > maxAbs) { maxAbs = nv }
        i = i + 1
    }
    out[0] = maxAbs
    i = 0
    while (i < Q8_BLOCK()) {
        var v = src[off + i]
        var q = 0
        if (maxAbs > 0) { q = v * 7 / maxAbs }
        if (q < 0) { q = q + 15 }
        else { q = q }
        var nib = q
        if (nib > 15) { nib = 15 }
        var packed = out[i / 2 + 1]
        if (i % 2 == 0) {
            out[i / 2 + 1] = nib * 16 + packed % 16
        } else {
            out[(i - 1) / 2 + 1] = (packed / 16) * 16 + nib
        }
        i = i + 1
    }
    return out
}

fn dequantizeQ4(Int[] blk): Int[] {
    var o = new Int[Q8_BLOCK()]
    var scale = blk[0]
    var i = 0
    while (i < Q8_BLOCK()) {
        var packed = blk[i / 2 + 1]
        var nib = packed / 16
        if (i % 2 == 1) { nib = packed % 16 }
        var v = nib * scale / 7
        o[i] = v
        i = i + 1
    }
    return o
}

record SamplerConfig(Int temperature, Int topK, Int topP, Int minP, Int repPenalty, Int seed)

fn samplerGreedy(Int[] logits, Int n): Int {
    var best = 0
    var bv = logits[0]
    var i = 1
    while (i < n) {
        var v = logits[i]
        if (v > bv) { bv = v; best = i }
        i = i + 1
    }
    return best
}

record LcgState(Int v)

fn lcgNext(LcgState st): Int {
    var nv = st.v * 1103515245 + 12345
    if (nv < 0) { nv = 0 - nv }
    return nv % 2147483647
}

fn samplerTopKV3(Int[] logits, Int n, Int k, Int seed): Int {
    var chosen = samplerGreedy(logits, n)
    if (k >= n || k <= 0) { return chosen }
    var idx = lcgNext(LcgState(seed)) % n
    return idx
}

record NNLimitsRec(Int ropeDims, Int heads, Int kvLayers)

nnRMSNormApprox(Int[] x): Int[] {
    var acc = 0
    var i = 0
    while (i < x.length) {
        acc = acc + x[i] * x[i]
        i = i + 1
    }
    var mean = 0
    if (x.length > 0) {
        mean = acc / x.length
    }
    var scale = mean / 4 + 1
    var out = new Int[x.length]
    i = 0
    while (i < x.length) {
        out[i] = x[i] * 1000 / scale
        i = i + 1
    }
    return out
}

nnLayerNormApprox(Int[] x): Int[] {
    return nnRMSNormApprox(x)
}

nnRopeRotatePairs(Int[] q): Int[] {
    var out = new Int[q.length]
    var i = 0
    while (i + 1 < q.length) {
        out[i] = q[i + 1]
        out[i + 1] = 0 - q[i]
        i = i + 2
    }
    if (q.length % 2 == 1) {
        out[q.length - 1] = q[q.length - 1]
    }
    return out
}

nnFeedForwardInt(Int[] x, Int mult): Int[] {
    var o = new Int[x.length]
    var i = 0
    while (i < x.length) {
        o[i] = x[i] * mult
        i = i + 1
    }
    return o
}

nnResidual(Int[] a, Int[] b): Int[] {
    var o = new Int[a.length]
    var i = 0
    while (i < a.length && i < b.length) {
        o[i] = a[i] + b[i]
        i = i + 1
    }
    return o
}

nnAttentionScoresInt(Int[] q, List<Int[]> ks): List<Int> {
    var scores = listOf<Int>()
    for (var k in ks) {
        scores.add(halDot(q, k))
    }
    return scores
}

samplerRepeatPenalty(Int[] logits, List<Int> recent, Int penaltyNum, Int penaltyDen): Int[] {
    var out = new Int[logits.length]
    var i = 0
    while (i < logits.length) {
        out[i] = logits[i]
        var seen = false
        for (var r in recent) {
            if (r == i) {
                seen = true
            }
        }
        if (seen && out[i] > 0) {
            out[i] = out[i] * penaltyDen / penaltyNum
        }
        i = i + 1
    }
    return out
}

samplerTopPApprox(Int[] logits, Int n, Int topPPermille, Int seed): Int {
    var total = 0
    var i = 0
    while (i < n) {
        if (logits[i] > 0) {
            total = total + logits[i]
        }
        i = i + 1
    }
    if (total == 0) {
        return samplerTopK(logits, n, 1, seed)
    }
    var threshold = total * topPPermille / 1000
    var cum = 0
    var pick = 0
    i = 0
    while (i < n) {
        if (logits[i] > 0) {
            cum = cum + logits[i]
            if (cum >= threshold) {
                pick = i
                i = n
            }
        }
        i = i + 1
    }
    return pick
}

ggufMeta(String path, String key): String {
    return metaField(wsReadVersioned(path, "GGUFT"), key)
}

// M17: GGUF loader V2/V3 — parser tipado sobre bytes (IO binario pende RTL002)

record TokenizerMetadata(Int vocabSize, Int bosId, Int eosId, Int padId, Int unkId)
record RopeMetadataRec(Int dims, Int freqBase, String scaling, Int ctxLen)
record GgufHeader(Int version, Int tensorCount, Int metaCount, Int align)
record MetaValue(Int kind, Int intVal, String strVal)
record TensorEntry(String name, Int nDims, Int d0, Int d1, Int dtype, Int offset, Int size)
record GgufHandle(GgufHeader header, List<MetaValue> metaKeys, List<String> metaNames, List<TensorEntry> tensors, List<Int[]> blobs, Int errorCount, String errorCode)

fn ggufHexVal(Char c): Int {
    if (c >= '0' && c <= '9') { return c - '0' }
    return (c - 'a') + 10
}

fn ggufDecodeHex(String hex, Int byteOff): Int {
    var i = byteOff * 2
    if (i + 1 >= hex.length) { return 0 }
    var hi = ggufHexVal(hex.charAt(i))
    var lo = ggufHexVal(hex.charAt(i + 1))
    return hi * 16 + lo
}

ggufParseMeta(String metaLine): List<String> {
    var out = listOf<String>()
    var parts = splitStr(metaLine, "|")
    var i = 1
    while (i < parts.size()) {
        out.add(parts.get(i))
        i = i + 1
    }
    return out
}

record MetaPair(String key, Int kind, Int intVal)

ggufParsePairs(String metaLine): List<MetaPair> {
    var out = listOf<MetaPair>()
    var raw = ggufParseMeta(metaLine)
    var i = 0
    while (i < raw.size()) {
        var kv = splitStr(raw.get(i), "=")
        if (kv.size() == 2 && i + 1 < raw.size()) {
            out.add(MetaPair(kv.get(0), parseIntStr(kv.get(1)), parseIntStr(raw.get(i + 1))))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return out
}

record TensorSpec(String name, Int d0, Int d1, Int dtype, Int size, Int offset)

ggufParseTensors(String dirLine): List<TensorSpec> {
    var out = listOf<TensorSpec>()
    var dparts = splitStr(dirLine, "|")
    var align = 32
    var nSpecs = dparts.size()
    if (nSpecs > 0) {
        align = parseIntStr(dparts.get(nSpecs - 1))
        nSpecs = nSpecs - 1
    }
    var i = 0
    while (i < nSpecs) {
        var tp = splitStr(dparts.get(i), ",")
        if (tp.size() == 6) {
            var off = parseIntStr(tp.get(5))
            var sz = parseIntStr(tp.get(4))
            out.add(TensorSpec(tp.get(0), parseIntStr(tp.get(2)), parseIntStr(tp.get(3)), sz, sz, off))
        }
        i = i + 1
    }
    return out
}

ggufParse(String magicLine, String metaLine, String dirLine, String blobLine): GgufHandle {
    var errs = listOf<String>()
    if (!magicLine.startsWith("GGUF")) {
        errs.add("E_MAGIC")
    }
    var ver = parseIntStr(magicLine.substring(4))
    if (ver != 2 && ver != 3) {
        errs.add("E_VERSION")
    }
    var pairs = ggufParsePairs(metaLine)
    var names = listOf<String>()
    var vals = listOf<MetaValue>()
    var i = 0
    while (i < pairs.size()) {
        var pr = pairs.get(i)
        names.add(pr.key)
        vals.add(MetaValue(pr.kind, pr.intVal, ""))
        i = i + 1
    }
    var tensors = listOf<TensorEntry>()
    var specs = ggufParseTensors(dirLine)
    i = 0
    while (i < specs.size()) {
        var sp = specs.get(i)
        tensors.add(TensorEntry(sp.name, 2, sp.d0, sp.d1, sp.dtype, sp.offset, sp.size))
        i = i + 1
    }
    var blobs = listOf<Int[]>()
    var bparts = splitStr(blobLine, ":")
    if (bparts.size() == 2 && bparts.get(0) == "HEX") {
        var hexs = bparts.get(1)
        var total = hexs.length / 2
        var arr = new Int[total]
        var b = 0
        while (b < total) {
            arr[b] = ggufDecodeHex(hexs, b)
            b = b + 1
        }
        blobs.add(arr)
    }
    var align = 32
    var ec = errs.size()
    var code = ""
    if (ec > 0) {
        code = errs.get(0)
    }
    return GgufHandle(GgufHeader(ver, tensors.size(), pairs.size(), align), vals, names, tensors, blobs, ec, code)
}

openGGUF(String specPath): GgufHandle {
    var f = File(specPath)
    if (!f.exists()) {
        return GgufHandle(GgufHeader(0, 0, 0, 32), listOf<MetaValue>(), listOf<String>(), listOf<TensorEntry>(), listOf<Int[]>(), 1, "E_FILE_NOT_FOUND")
    }
    var lines = splitStr(f.readText(), "\n")
    if (lines.size() < 4) {
        return GgufHandle(GgufHeader(0, 0, 0, 32), listOf<MetaValue>(), listOf<String>(), listOf<TensorEntry>(), listOf<Int[]>(), 1, "E_FORMAT")
    }
    var blob = ""
    var li = 0
    while (li < lines.size()) {
        if (lines.get(li).startsWith("HEX")) {
            blob = lines.get(li)
        }
        li = li + 1
    }
    return ggufParse(lines.get(0), lines.get(1), lines.get(2), blob)
}

getMetadata(GgufHandle h, String key): MetaValue {
    var i = 0
    while (i < h.metaNames.size()) {
        if (h.metaNames.get(i) == key) {
            return h.metaKeys.get(i)
        }
        i = i + 1
    }
    return MetaValue(-1, 0, "")
}

hasTensor(GgufHandle h, String name): Bool {
    var i = 0
    while (i < h.tensors.size()) {
        if (h.tensors.get(i).name == name) {
            return true
        }
        i = i + 1
    }
    return false
}

listTensors(GgufHandle h): List<String> {
    var out = listOf<String>()
    var i = 0
    while (i < h.tensors.size()) {
        out.add(h.tensors.get(i).name)
        i = i + 1
    }
    return out
}

getTensorLazy(GgufHandle h, String name): Int[] {
    var i = 0
    while (i < h.tensors.size()) {
        if (h.tensors.get(i).name == name) {
            return h.blobs.get(0)
        }
        i = i + 1
    }
    return new Int[0]
}

tokenizerInfo(GgufHandle h): TokenizerMetadata {
    var bos = getMetadata(h, "tokenizer.bos_id")
    var eos = getMetadata(h, "tokenizer.eos_id")
    var pad = getMetadata(h, "tokenizer.pad_id")
    var unk = getMetadata(h, "tokenizer.unk_id")
    var vocab = getMetadata(h, "context_length")
    return TokenizerMetadata(vocab.intVal, bos.intVal, eos.intVal, pad.intVal, unk.intVal)
}

ropeInfo(GgufHandle h): RopeMetadataRec {
    var dim = getMetadata(h, "rope.dimension_count")
    var freq = getMetadata(h, "rope.freq_base")
    var scaling = getMetadata(h, "rope.scaling.type")
    var ctx = getMetadata(h, "context_length")
    return RopeMetadataRec(dim.intVal, freq.intVal, scaling.strVal, ctx.intVal)
}

ggufVersion(GgufHandle h): Int {
    var hdr = h.header
    return hdr.version
}

ggufTensorCount(GgufHandle h): Int {
    var hdr = h.header
    return hdr.tensorCount
}

ggufErrorCount(GgufHandle h): Int {
    return h.errorCount
}

ggufErrorCode(GgufHandle h): String {
    return h.errorCode
}

ggufMetaCount(GgufHandle h): Int {
    var hdr = h.header
    return hdr.metaCount
}

ggufTensorCount2(GgufHandle h): Int {
    var n = listTensors(h)
    return n.size()
}

record BrainPlan(String intent, String entitiesJson, String contextJson, Int confidence, String ambiguitiesJson, String candidateToolsCsv, String candidateRecipesCsv, String candidateSymbolsCsv)

B_INTENT_UNKNOWN(): String { return "Unknown" }

brainSynonymIntent(String token): String {
    var s = retLower(token)
    if (s == "crie" || s == "cria" || s == "criar" || s == "faz" || s == "fazer" || s == "gera" || s == "gere" || s == "gerar") {
        return "create"
    }
    if (s == "edite" || s == "edita" || s == "editar" || s == "mude" || s == "mudar" || s == "altere") {
        return "edit"
    }
    if (s == "arruma" || s == "arrumar" || s == "corrija" || s == "corrigir" || s == "conserta") {
        return "repair"
    }
    if (s == "explique" || s == "explicar" || s == "o-que-e") {
        return "explain"
    }
    if (s == "refatore" || s == "refatorar") {
        return "refactor"
    }
    if (s == "busque" || s == "buscar" || s == "procure" || s == "procurar") {
        return "search"
    }
    if (s == "rode" || s == "rodar" || s == "teste" || s == "testar" || s == "execute") {
        return "runtests"
    }
    return ""
}

brainResolveIntent(List<String> tokens): String {
    var verb = ""
    var obj = ""
    for (var t in tokens) {
        var iv = brainSynonymIntent(t)
        if (iv != "" && verb == "") {
            verb = iv
        }
    }
    var joined = ""
    for (var t in tokens) {
        joined = joined + retLower(t) + " "
    }
    if (joined.contains(" site ") || joined.contains("website")) {
        obj = "Website"
    } else if (joined.contains("crud")) {
        obj = "CRUD"
    } else if (joined.contains(" api ")) {
        obj = "API"
    } else if (joined.contains("rpa")) {
        obj = "RPA"
    } else if (joined.contains(" ui ") || joined.contains("tela")) {
        obj = "UI"
    } else if (joined.contains("docs") || joined.contains("documentacao")) {
        obj = "Docs"
    } else if (joined.contains("teste")) {
        obj = "Tests"
    } else if (joined.contains("erro") || joined.contains("diagnostico")) {
        obj = "Diagnostic"
    } else if (joined.contains("simbolo") || joined.contains("funcao") || joined.contains("classe")) {
        obj = "Symbol"
    }
    if (verb == "") {
        return B_INTENT_UNKNOWN()
    }
    if (obj == "Website" && verb == "create") {
        return "CreateWebsite"
    }
    if (obj == "Website" && verb == "edit") {
        return "EditWebsite"
    }
    if (obj == "API" && (verb == "create" || verb == "edit")) {
        return "CreateAPI"
    }
    if (obj == "CRUD") {
        return "GenerateCRUD"
    }
    if (obj == "Diagnostic" && verb == "repair") {
        return "RepairDiagnostic"
    }
    if ((obj == "Diagnostic" && verb == "explain") || (verb == "explain" && obj == "")) {
        return "ExplainDiagnostic"
    }
    if (verb == "refactor") {
        return "Refactor"
    }
    if (obj == "Symbol" && verb == "search") {
        return "SearchSymbol"
    }
    if (obj == "RPA") {
        return "CreateRPA"
    }
    if ((obj == "Tests" && verb == "runtests") || verb == "runtests") {
        return "RunTests"
    }
    if (obj == "UI") {
        return "CreateUI"
    }
    if (obj == "Docs") {
        return "GenerateDocs"
    }
    if (verb == "create") {
        return "CreateFeature"
    }
    if (verb == "edit") {
        return "EditFeature"
    }
    if (verb == "repair") {
        return "RepairGeneric"
    }
    if (verb == "search") {
        return "SearchGeneric"
    }
    return B_INTENT_UNKNOWN()
}

brainExtractEntities(String text): String {
    var quoted = ""
    var q1 = text.indexOf("\"")
    if (q1 >= 0) {
        var q2 = text.indexOf("\"", q1 + 1)
        if (q2 > q1) {
            quoted = text.substring(q1 + 1, q2)
        }
    }
    var codes = ""
    for (var code in listOf<String>("ARITH001", "SEM011", "SEM015", "SEM010", "CONC001", "E999")) {
        if (text.contains(code)) {
            codes = code
        }
    }
    var paths = ""
    for (var t in splitStr(text, " ")) {
        if (t.endsWith(".kf") || t.startsWith("build/") || t.contains("/")) {
            paths = t
        }
    }
    return "{\"quoted\":\"" + escapeJson(quoted) + "\",\"diagCode\":\"" + codes + "\",\"path\":\"" + escapeJson(paths) + "\"}"
}

brainRequiredEntity(String intent): String {
    if (intent == "RepairDiagnostic") {
        return "diagCode"
    }
    if (intent == "EditWebsite" || intent == "EditFeature" || intent == "Refactor") {
        return "path"
    }
    return ""
}

brainConfidence(String intent, Bool hasVerb, Bool hasObj, Int ctxItems): Int {
    var score = 20
    if (hasVerb) {
        score = score + 30
    }
    if (intent != B_INTENT_UNKNOWN() && intent.contains("Create") || intent.contains("Edit") || intent.contains("Repair") || intent.contains("Search") || intent.contains("Run")) {
        score = score + 25
    }
    if (ctxItems > 0) {
        score = score + 15
    }
    if (score > 95) {
        score = 95
    }
    return score
}

brainCandidateTools(String intent): String {
    if (intent == "RepairDiagnostic") {
        return "compiler.check,search.text,patch.replace"
    }
    if (intent.startsWith("Create") || intent == "GenerateCRUD") {
        return "fs.write,ws.open,search.text"
    }
    if (intent == "RunTests") {
        return "compiler.run"
    }
    if (intent == "SearchSymbol") {
        return "search.symbol"
    }
    return ""
}

brainAmbiguitiesJson(String required, String entitiesJson, List<String> historyPaths): String {
    if (required == "") {
        return "[]"
    }
    var has = entitiesJson.contains("\"" + required + "\":\"")
    var filled = false
    if (entitiesJson.contains(required)) {
        var keyPart = "\"" + required + "\":\""
        var at = entitiesJson.indexOf(keyPart)
        if (at >= 0) {
            var vstart = at + keyPart.length
            var vend = entitiesJson.indexOf("\"", vstart)
            if (vend > vstart) {
                filled = true
            }
        }
    }
    if (!filled && historyPaths.size > 0) {
        filled = true
    }
    if (!filled) {
        return "[{\"missing\":\"" + required + "\",\"question\":\"Qual " + required + "?\"}]"
    }
    return "[]"
}

brainProcess(EventBus bus, CorpusIndex ix, String text, List<String> recentFiles, List<String> historyPaths): BrainPlan {
    bus.publish("brain.started", text)
    var tokens = retTokenize(text)
    var intent = brainResolveIntent(tokens)
    var entities = brainExtractEntities(text)
    var context = retBuildContext(ix, text, 5, 2000, recentFiles)
    var required = brainRequiredEntity(intent)
    var amb = brainAmbiguitiesJson(required, entities, historyPaths)
    var conf = brainConfidence(intent, tokens.size > 0, intent != B_INTENT_UNKNOWN(), 1)
    if (amb != "[]") {
        bus.publish("brain.ambiguity", amb)
        conf = 40
    }
    bus.publish("brain.intent", intent)
    bus.publish("brain.completed", intent + " conf=" + conf)
    var tools = brainCandidateTools(intent)
    var recipes = ""
    if (intent.contains("Website") || intent == "CreateAPI") {
        recipes = "recipe-rest-api"
    }
    var syms = ""
    return BrainPlan(intent, entities, context, conf, amb, tools, recipes, syms)
}

brainPlanJson(BrainPlan p): String {
    var out = "{\"intent\":\"" + p.intent + "\",\"confidence\":" + p.confidence
    out = out + ",\"entities\":" + p.entitiesJson
    out = out + ",\"context\":" + p.contextJson
    out = out + ",\"ambiguities\":" + p.ambiguitiesJson
    out = out + ",\"tools\":\"" + p.candidateToolsCsv + "\""
    out = out + ",\"recipes\":\"" + p.candidateRecipesCsv + "\""
    out = out + "}"
    return out
}

record PlanTaskRec(String id, String kind, String toolId, String argA, String argB, String depsCsv, String validation, String rollback)
record PlanValidationRec(String taskId, String kind, String detail)

PLANNER_VERSION(): Int { return 1 }

plStrategyFor(String intent): String {
    if (intent == "CreateWebsite" || intent == "CreateUI") {
        return "Web"
    }
    if (intent == "CreateAPI" || intent == "GenerateCRUD") {
        return "CRUD"
    }
    if (intent == "RepairDiagnostic") {
        return "Repair"
    }
    if (intent == "RunTests") {
        return "Compiler"
    }
    if (intent == "GenerateDocs") {
        return "Docs"
    }
    if (intent == "CreateRPA") {
        return "RPA"
    }
    return "Generic"
}

plEmit(EventBus bus, List<PlanTaskRec> tasks, String planId) {
    bus.publish("plan.created", planId + " tasks=" + tasks.size)
}

plTask(List<PlanTaskRec> out, String planId, Int seq, String kind, String toolId, String a, String b, String deps, String validation) {
    out.add(PlanTaskRec(planId + "-t" + seq, kind, toolId, a, b, deps, validation, ""))
}

plTasksFor(EventBus bus, BrainPlan plan, String targetFile): List<PlanTaskRec> {
    var out = listOf<PlanTaskRec>()
    var pid = "plan-" + plStrategyFor(plan.intent) + "-" + plan.confidence
    var seq = 0
    var last = ""
    if (plan.intent.startsWith("Create") || plan.intent == "GenerateCRUD") {
        seq = seq + 1
        plTask(out, pid, seq, "CreateDir", "fs.mkdir", joinPath("src", ""), "", "", "dir-exists")
        last = out.get(out.size - 1).id
        seq = seq + 1
        plTask(out, pid, seq, "CreateFile", "patch.file", joinPath("src", "main.kf"), "main() {\n}\n", last, "file-exists")
        last = out.get(out.size - 1).id
    }
    if (plan.intent == "RepairDiagnostic") {
        seq = seq + 1
        plTask(out, pid, seq, "CompileCheck", "compiler.check", targetFile, "", "", "compiles")
        last = out.get(out.size - 1).id
        seq = seq + 1
        plTask(out, pid, seq, "SearchText", "search.text", plan.entitiesJson, "", last, "results-found")
        last = out.get(out.size - 1).id
    }
    if (plan.intent == "RunTests") {
        seq = seq + 1
        plTask(out, pid, seq, "RunTests", "compiler.run", targetFile, "", "", "tests-pass")
        last = out.get(out.size - 1).id
    }
    if (out.size == 0) {
        seq = seq + 1
        plTask(out, pid, seq, "IndexWorkspace", "ws.open", "", "", "", "indexed")
        last = out.get(out.size - 1).id
    }
    plEmit(bus, out, pid)
    return out
}

plDepsSatisfiable(List<PlanTaskRec> tasks): Bool {
    var ids = listOf<String>()
    for (var t in tasks) {
        ids.add(t.id)
    }
    var ok = true
    for (var t in tasks) {
        if (t.depsCsv != "") {
            if (!wsInList(ids, t.depsCsv)) {
                ok = false
            }
        }
    }
    return ok
}

plHasCycle(List<PlanTaskRec> tasks): Bool {
    var edges = listOf<WsEdgeRec>()
    for (var t in tasks) {
        if (t.depsCsv != "") {
            edges.add(WsEdgeRec(t.id, t.depsCsv))
        }
    }
    return wsDetectCycle(edges).size > 0
}

plMergeDuplicates(List<PlanTaskRec> tasks): List<PlanTaskRec> {
    var out = listOf<PlanTaskRec>()
    for (var t in tasks) {
        var dup = false
        for (var o in out) {
            if (o.toolId == t.toolId && o.argA == t.argA && o.argB == t.argB) {
                dup = true
            }
        }
        if (!dup) {
            out.add(t)
        }
    }
    return out
}

class ExecutionPlan {
    String id = ""
    String intent = ""
    String strategy = ""
    List<PlanTaskRec> tasks = listOf<PlanTaskRec>()
    Bool acyclic = true
    Int version = PLANNER_VERSION()

    toJson(): String {
        var out = "{\"id\":\"" + id + "\",\"intent\":\"" + intent + "\",\"strategy\":\"" + strategy + "\""
        out = out + ",\"acyclic\":" + acyclic + ",\"tasks\":["
        var first = true
        for (var t in tasks) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"id\":\"" + t.id + "\",\"kind\":\"" + t.kind + "\",\"tool\":\"" + t.toolId + "\""
            if (t.depsCsv != "") {
                out = out + ",\"deps\":\"" + t.depsCsv + "\""
            }
            if (t.validation != "") {
                out = out + ",\"validate\":\"" + t.validation + "\""
            }
            out = out + "}"
        }
        out = out + "]}"
        return out
    }
}

plannerBuild(EventBus bus, BrainPlan plan, String targetFile): ExecutionPlan {
    var rawTasks = plTasksFor(bus, plan, targetFile)
    var merged = plMergeDuplicates(rawTasks)
    var plan0 = ExecutionPlan()
    plan0.intent = plan.intent
    plan0.strategy = plStrategyFor(plan.intent)
    plan0.tasks = merged
    plan0.acyclic = !plHasCycle(merged)
    bus.publish("plan.optimized", "tasks=" + merged.size)
    bus.publish("rollback.generated", "backups-via-katool-bak")
    return plan0
}

plValidateTask(ToolRegistry reg, ToolCtx ctx, PlanTaskRec t): PlanValidationRec {
    var kind = t.validation
    var ok = true
    var detail = kind
    if (kind == "file-exists") {
        var f = File(t.argA)
        ok = f.exists() && f.isFile()
    } else if (kind == "compiles") {
        ok = false
        detail = "GW-EXEC: compiler.check via ponte"
    } else if (kind == "tests-pass") {
        ok = false
        detail = "GW-EXEC: compiler.run via ponte"
    }
    if (ok) {
        ctx.bus.publish("task.validated", t.id)
    }
    return PlanValidationRec(t.id, kind, detail)
}

record ExecTaskState(String taskId, String state)
record RepairAttemptRec(Int attempt, String diagCode)

EXEC_READY(): String { return "READY" }
EXEC_RUNNING(): String { return "RUNNING" }
EXEC_SUCCESS(): String { return "SUCCESS" }
EXEC_FAILED(): String { return "FAILED" }
EXEC_SKIPPED(): String { return "SKIPPED" }
EXEC_ROLLED_BACK(): String { return "ROLLED_BACK" }

class ExecResult {
    Bool ok = true
    Int executed = 0
    Int failed = 0
    Int rolledBack = 0
    Int repairs = 0
    String lastError = ""
    constructor() {
    }
}

exRollback(ToolCtx c, ToolResult r): Bool {
    if (r.rollback.kind == "restore") {
        var rr = toolExec(defaultRegistry(), c, ToolCall("fs.rollbackRestore", c.requestId, r.rollback.backupPath, "", 0))
        return rr.status == "ok"
    }
    if (r.rollback.kind == "delete-created") {
        var f = File(r.rollback.backupPath)
        if (f.exists()) {
            f.delete()
        }
        return true
    }
    return false
}

exValidate(ToolCtx c, PlanTaskRec t): PlanValidationRec {
    return plValidateTask(defaultRegistry(), c, t)
}

exRepairAttempt(ToolCtx c, PlanTaskRec t, Int attempt): ToolResult {
    c.bus.publish("repair.started", t.id + " attempt=" + attempt)
    var diagCode = ""
    if (t.argA != "") {
        for (var code in listOf<String>("ARITH001", "SEM011", "SEM015", "SEM010")) {
            if (c.requestId.contains(code)) {
                diagCode = code
            }
        }
    }
    var r = toolErr("REPAIR-NOPATCH", "nenhum patch deterministico disponivel para " + diagCode)
    c.bus.publish("repair.finished", t.id)
    return r
}

exExecutePlan(ToolRegistry reg, ToolCtx ctx, ExecutionPlan plan, Int maxRepairs): ExecResult {
    ctx.bus.publish("plan.started", plan.id + " tasks=" + plan.tasks.size)
    var res = ExecResult()
    var states = listOf<ExecTaskState>()
    var i = 0
    while (i < plan.tasks.size) {
        states.add(ExecTaskState(plan.tasks.get(i).id, EXEC_READY()))
        i = i + 1
    }
    i = 0
    while (i < plan.tasks.size) {
        var t = plan.tasks.get(i)
        var depsOk = true
        if (t.depsCsv != "") {
            var j = 0
            while (j < i) {
                if (plan.tasks.get(j).id == t.depsCsv && states.get(j).state != EXEC_SUCCESS()) {
                    depsOk = false
                }
                j = j + 1
            }
        }
        var skipIt = false
        if (!depsOk) {
            skipIt = true
        }
        if (!skipIt) {
            states.get(i).state = EXEC_RUNNING()
            ctx.bus.publish("task.started", t.id)
            var r = toolExec(reg, ctx, ToolCall(t.toolId, ctx.requestId, t.argA, t.argB, 0))
            if (r.status != "ok") {
                states.get(i).state = EXEC_FAILED()
                res.failed = res.failed + 1
                res.lastError = r.data
                ctx.bus.publish("task.failed", t.id + ":" + r.data)
                var attempt = 1
                var repaired = false
                while (attempt <= maxRepairs) {
                    res.repairs = res.repairs + 1
                    var pr = exRepairAttempt(ctx, t, attempt)
                    if (pr.status == "ok") {
                        r = pr
                        repaired = true
                        attempt = maxRepairs + 1
                    }
                    attempt = attempt + 1
                }
                if (!repaired && r.rollback.kind != "") {
                    ctx.bus.publish("rollback.started", t.id)
                    if (exRollback(ctx, r)) {
                        states.get(i).state = EXEC_ROLLED_BACK()
                        res.rolledBack = res.rolledBack + 1
                    }
                    ctx.bus.publish("rollback.finished", t.id)
                }
            } else {
                states.get(i).state = EXEC_SUCCESS()
                res.executed = res.executed + 1
                ctx.bus.publish("task.completed", t.id)
            }
            if (!skipIt) {
            }
        }
        states.get(i).state = EXEC_RUNNING()
        ctx.bus.publish("task.started", t.id)
        var r = toolExec(reg, ctx, ToolCall(t.toolId, ctx.requestId, t.argA, t.argB, 0))
        if (r.status != "ok") {
            states.get(i).state = EXEC_FAILED()
            res.failed = res.failed + 1
            res.lastError = r.data
            ctx.bus.publish("task.failed", t.id + ":" + r.data)
            var attempt = 1
            while (attempt <= maxRepairs) {
                res.repairs = res.repairs + 1
                var pr = exRepairAttempt(ctx, t, attempt)
                if (pr.status == "ok") {
                    r = pr
                    break
                }
                attempt = attempt + 1
            }
            if (r.status != "ok" && r.rollback.kind != "") {
                ctx.bus.publish("rollback.started", t.id)
                if (exRollback(ctx, r)) {
                    states.get(i).state = EXEC_ROLLED_BACK()
                    res.rolledBack = res.rolledBack + 1
                }
                ctx.bus.publish("rollback.finished", t.id)
            }
        } else {
            states.get(i).state = EXEC_SUCCESS()
            res.executed = res.executed + 1
            ctx.bus.publish("task.completed", t.id)
        }
        i = i + 1
    }
    if (res.failed > 0) {
        res.ok = false
    }
    ctx.met.incByName("tasks.completed")
    ctx.bus.publish("plan.finished", plan.id + " ok=" + res.ok)
    return res
}

class RuntimeContext implements ContextView {
    Config cfg
    Logger logger
    EventBus bus = EventBus()
    Scheduler sched
    WorkerPool pool
    Lifecycle life = Lifecycle()
    Metrics met = Metrics()
    TimeSource clock

    constructor(Config c, TimeSource ts) {
        cfg = c
        clock = ts
        logger = Logger(ts)
        var lvlName = c.getStr("log.level", "INFO")
        var lvl = logLevelFromName(lvlName)
        if (lvl < 0) {
            lvl = LOG_INFO()
        }
        var col = false
        try {
            col = c.getBool("log.color", false)
        } catch (String e) {
            col = false
        }
        var js = false
        try {
            js = c.getBool("log.json", false)
        } catch (String e) {
            js = false
        }
        logger.configure(lvl, col, js)
        met.start(ts)
    }

    incMetric(String name) {
        met.incByName(name)
    }

    wire() {
        sched = Scheduler(this)
        pool = WorkerPool(sched, 1)
    }

    finishBoot(): Bool {
        life.transition(LC_READY())
        return true
    }

    shutdownGraceful() {
        if (life.state() == LC_READY()) {
            life.transition(LC_STOPPING())
        }
        sched.gracefulShutdown()
        life.transition(LC_STOPPED())
    }
}

runtimeStatusJson(RuntimeContext ctx): String {
    var out = "{\"state\":\"" + ctx.life.stateName() + "\""
    out = out + ",\"scheduler\":" + ctx.sched.statsJson()
    out = out + ",\"bus\":" + ctx.bus.statsJson()
    out = out + ",\"metrics\":" + ctx.met.snapshotJson(ctx.clock)
    out = out + "}"
    return out
}

// M31.1/.2: GraphExecutor — sequência decoder por camada com arena reutilizável

record LayerPlan(Int idx, Int hidden, Int ffMult)
record GraphStats(Int layers, Int steps)

class GraphExecutor {
    List<LayerPlan> plan = listOf<LayerPlan>()
    TensorArena arena
    Int steps = 0

    constructor() {
        arena = TensorArena()
    }

    buildPlan(Int numLayers, Int hidden) {
        var i = 0
        while (i < numLayers) {
            plan.add(LayerPlan(i, hidden, 4))
            i = i + 1
        }
    }

    layerCount(): Int { return plan.size() }

    execLayer(TensorR x, LayerPlan lp): TensorR {
        steps = steps + 1
        // attention real (scaled dot-product causal) sobre a própria seq
        var scores = attnScores(x, x, x.rows)
        var attnOut = attnContext(scores, x, x.rows)
        // residual
        var resid = tensorAdd(x, attnOut)
        // FFN SwiGLU real
        var ffnOut = swigluFFN(resid, lp.hidden * lp.ffMult)
        // segunda residual + norm final
        var out = tensorAdd(resid, ffnOut)
        return tensorRmsNorm(out)
    }

    forwardAllLayers(TensorR x): TensorR {
        var i = 0
        while (i < plan.size()) {
            x = execLayer(x, plan.get(i))
            i = i + 1
        }
        return x
    }

    stepCount(): Int { return steps }
}

// M31.6: QuantDecoder F16 (half-float IEEE 754) + LayerExecExecutor
// F16: bit 15 sinal, 14-10 expoente (bias 15), 9-0 mantissa.
// Representamos valores em ponto fixo de milésimos (como o resto do M31).

fn f16ToMilli(Int bits): Int {
    var u = bits % 65536
    if (u < 0) {
        u = u + 65536
    }
    var signBit = u / 32768
    var v = u - signBit * 32768
    var exp = v / 1024
    var man = v % 1024
    var milli = 0
    if (exp == 31) {
        // Inf/NaN → saturar
        milli = 1000000
    } else if (exp == 0) {
        // subnormal: mantissa/1024 * 2^-14
        milli = man * 1000 / 1024 / 16384
    } else {
        // normal: (1.man) * 2^(exp-15)
        var mant = 1024 + man
        var e = exp - 15
        if (e >= 0) {
            milli = mant * 1000 * pow2(e) / 1024
        } else {
            milli = mant * 1000 / 1024 / pow2(0 - e)
        }
    }
    if (signBit == 1) {
        milli = 0 - milli
    }
    return milli
}

// f16 → MICRO (1e-6): precisão p/ pesos dequantizados do GGUF
// (d típico 0.01 → 10000 micro; milli perdia d subnormais/pequenos)
fn f16ToMicro(Int bits): Int {
    var u = bits % 65536
    if (u < 0) {
        u = u + 65536
    }
    var signBit = u / 32768
    var v = u - signBit * 32768
    var exp = v / 1024
    var man = v % 1024
    var micro = 0
    if (exp == 31) {
        micro = 1000000000
    } else if (exp == 0) {
        micro = man * 1000000 / 1024 / 16384
    } else {
        var mant = 1024 + man
        var e = exp - 15
        if (e >= 0) {
            micro = mant * 1000000 / 1024
            var k = 0
            while (k < e) {
                micro = micro * 2
                k = k + 1
            }
        } else {
            micro = mant * 1000000 / 1024
            var k = 0
            while (k < 0 - e) {
                micro = micro / 2
                k = k + 1
            }
        }
    }
    if (signBit == 1) {
        micro = 0 - micro
    }
    return micro
}

// f16 → NANO (1e-9): escala p/ pesos de matmul (d minúsculos precisos:
// d 9.24e-6 → 9238 nano; produto d*s*q cabe em Int32)
fn f16ToNano(Int bits): Long {
    var u = bits % 65536
    if (u < 0) {
        u = u + 65536
    }
    var signBit = u / 32768
    var v = u - signBit * 32768
    var exp = v / 1024
    var man = v % 1024
    // man/mant são Int: man×1e9 estoura Int (2^31) — calcular em Long
    var manl: Long = man
    var nano: Long = 0
    if (exp == 31) {
        nano = 2000000000
    } else if (exp == 0) {
        nano = manl * 1000000000 / 1024 / 16384
    } else {
        var mantl: Long = 1024 + man
        var e = exp - 15
        if (e >= 0) {
            nano = mantl * 1000000000 / 1024
            var k = 0
            while (k < e) {
                nano = nano * 2
                k = k + 1
            }
        } else {
            nano = mantl * 1000000000 / 1024
            var k = 0
            while (k < 0 - e) {
                nano = nano / 2
                k = k + 1
            }
        }
    }
    if (signBit == 1) {
        nano = 0 - nano
    }
    return nano
}

pow2(Int n): Int {
    var r = 1
    var k = 0
    while (k < n) {
        r = r * 2
        k = k + 1
    }
    return r
}

// Decodifica um bloco F16: 16 meia-palavras (cada uma um Int com 16 bits)
// para um tensor de 16 valores em ponto fixo (milésimos).
f16DecodeBlock(Int[] raw, Int off): Int[] {
    var out = new Int[16]
    var j = 0
    while (j < 16) {
        out[j] = f16ToMilli(raw[off + j])
        j = j + 1
    }
    return out
}

// Decodifica N blocos F16 (16 valores cada) para um tensor 1×N*16
f16DecodeTensor(Int[] raw, Int nBlocks): TensorR {
    var t = tensorNew(1, nBlocks * 16)
    var b = 0
    while (b < nBlocks) {
        var blk = f16DecodeBlock(raw, b * 16)
        var j = 0
        while (j < 16) {
            tensorSet(t, 0, b * 16 + j, blk[j])
            j = j + 1
        }
        b = b + 1
    }
    return t
}

// M31.8: K-quants (Q4_K_M / Q6_K) — decoders de bloco no formato
// simplificado do projeto (milésimos, inteiro). Cada bloco carrega o
// scale no slot 0 e os quantizados nos slots seguintes, coerente com
// q40DecodeBlock/q80DecodeBlock (156/157) e com ggufQuants() (143).

// Q4_K_M: bloco de 9 — scale + 8 nibbles (sub-blocos de 4 bits).
fn q4kDecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 9) {
        var nib = raw[off + i] % 16
        // K-quants usam min/scale por sub-bloco: nibble alto = 4 bits
        // de min, baixo = 4 bits de q. Reconstrói q0..q7 por nibble.
        var q = nib % 4
        var m = nib / 4
        acc = acc + (q * scale / 4 + m) / 2
        i = i + 1
    }
    return acc
}

// Q6_K: bloco de 9 — scale + 8 valores base 6-bit (0..63) com
// min implícito 32 (centro da faixa 6-bit).
fn q6kDecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 9) {
        var v = raw[off + i] % 64
        acc = acc + (v - 32) * scale / 64
        i = i + 1
    }
    return acc
}

// Seleciona o decoder pelo nome do quant (ggufQuants/143).
kqDecodeBlock(String quant, Int[] raw, Int off): Int {
    if (quant == "Q6_K") {
        return q6kDecodeBlock(raw, off)
    }
    return q4kDecodeBlock(raw, off)
}

// Decodifica N blocos do quant K informado (igual quantDecodeTensor/156).
kqDecodeTensor(String quant, Int[] raw, Int nBlocks): Int[] {
    var out = new Int[nBlocks]
    var b = 0
    while (b < nBlocks) {
        out[b] = kqDecodeBlock(quant, raw, b * 9)
        b = b + 1
    }
    return out
}

// M31.7: Shader HAL — SPIR-V module loader/validador + golden mirrors.
// Os .comp fontes ficam em gpu/shaders/ (compilados por glslangValidator -V).
// Em runtime com Vulkan device ativo, os .spv alimentam os pipelines compute.
// Sem device, as funções golden* executam a MESMA matemática em Kof
// (referência de validação — goldens são os valores esperados dos shaders).

record SpvModule(Int magicOk, Int version, Int words)

spvParseHeader(String path): SpvModule {
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return SpvModule(0, 0, 0)
    }
    var bytes = f.readBytes()
    if (bytes == null || bytes.length < 8) {
        return SpvModule(0, 0, 0)
    }
    // SPIR-V magic: 0x07230203 (little endian)
    var magic = bytes[0] + bytes[1] * 256 + bytes[2] * 65536 + bytes[3] * 16777216
    var ver = bytes[4] + bytes[5] * 256
    var words = bytes.length / 4
    var magicOk = 0
    if (magic == 119734787) {
        magicOk = 1
    }
    return SpvModule(magicOk, ver / 256, words)
}

// --- Golden: matmul (espelho de matmul.comp) ---
goldenMatmul(TensorR a, TensorR b): TensorR {
    return tensorMatMul(a, b)
}

// --- Golden: rmsnorm (espelho de rmsnorm.comp) ---
goldenRmsNorm(TensorR x): TensorR {
    return tensorRmsNorm(x)
}

// --- Golden: attention scores causais (espelho de attention_scores.comp) ---
goldenAttnScores(TensorR q, TensorR k, Int scale): TensorR {
    var s = tensorNew(q.rows, k.rows)
    var i = 0
    while (i < q.rows) {
        var j = 0
        while (j < k.rows) {
            if (j > i) {
                tensorSet(s, i, j, -2147483647)
            } else {
                var acc = 0
                var d = 0
                while (d < q.cols) {
                    acc = acc + tensorGet(q, i, d) * tensorGet(k, j, d)
                    d = d + 1
                }
                tensorSet(s, i, j, acc * scale / 1000)
            }
            j = j + 1
        }
        i = i + 1
    }
    return s
}

// --- Golden: embedding lookup (espelho de embedding.comp) ---
goldenEmbedding(TensorR table, Int tokenId): TensorR {
    var row = tokenId % table.rows
    if (row < 0) {
        row = row + table.rows
    }
    var out = tensorNew(1, table.cols)
    var j = 0
    while (j < table.cols) {
        tensorSet(out, 0, j, tensorGet(table, row, j))
        j = j + 1
    }
    return out
}

shaderSpvDir(): String {
    return "gpu/shaders"
}

// M32.2: dispatch Vulkan com fallback golden CPU. O compilador JVM emite
// kof_vk_dispatch (FFM); em native/js o namespace gpu.* não existe (GPU001)
// e usamos direto o golden. O contrato: 0 = ok (out preenchido), != 0 = CPU.

// M32.2: dispatch Vulkan com fallback golden CPU. O compilador JVM emite
// kof_vk_dispatch (FFM); em native/js o namespace gpu.* não existe (GPU001)
// e usamos direto o golden. O contrato: 0 = ok (out preenchido), != 0 = CPU.

gpuMatmul(TensorR a, TensorR b): TensorR {
    var m = a.rows
    var k = a.cols
    var n = b.cols
    var af = a.data
    var bf = b.data
    var cf = new Int[m * n]
    var rc = 1
    if (gpuAvailable()) {
        rc = gpu.dispatchMatmul(af, bf, cf, m, n, k)
    }
    if (rc != 0) {
        var gold = tensorMatMul(a, b)
        cf = gold.data
    }
    return TensorR(m, n, cf)
}

gpuAvailable(): Bool {
    return gpu.available()
}

// valida todos os 7 módulos SPIR-V do HAL
shadersValid(): Bool {
    var names = listOf<String>()
    names.add("matmul.spv")
    names.add("softmax_causal.spv")
    names.add("rmsnorm.spv")
    names.add("rope.spv")
    names.add("embedding.spv")
    names.add("swiglu.spv")
    names.add("attention_scores.spv")
    for (var n in names) {
        var m = spvParseHeader(joinPath(shaderSpvDir(), n))
        if (m.magicOk != 1) {
            return false
        }
        if (m.words <= 5) {
            return false
        }
    }
    return true
}

// M31.4/.5: AttentionExecutor (scaled dot-product + causal) e SwiGLU FFN reais

record AttnOut(TensorR ctx)

attnScores(TensorR q, TensorR k, Int posLen): TensorR {
    var d = q.cols
    var scale = 1000 / (1 + d)
    var s = tensorNew(posLen, k.rows)
    var i = 0
    while (i < posLen) {
        var j = 0
        while (j < k.rows && j <= i) {
            var sum = 0
            var c2 = 0
            while (c2 < d) {
                sum = sum + tensorGet(q, i, c2) * tensorGet(k, j, c2)
                c2 = c2 + 1
            }
            tensorSet(s, i, j, sum * scale / 1000)
            j = j + 1
        }
        i = i + 1
    }
    return s
}

attnContext(TensorR scores, TensorR v, Int posLen): TensorR {
    var out = tensorNew(1, v.cols)
    var sm = tensorSoftmaxRow(scores, posLen - 1)
    var c2 = 0
    while (c2 < v.cols) {
        var acc = 0
        var j = 0
        while (j < posLen) {
            acc = acc + tensorGet(sm, 0, j) * tensorGet(v, j, c2) / 1000
            j = j + 1
        }
        tensorSet(out, 0, c2, acc)
        c2 = c2 + 1
    }
    return out
}

swigluFFN(TensorR x, Int hiddenDim): TensorR {
    var out = tensorNew(1, x.cols)
    var c2 = 0
    while (c2 < x.cols && c2 < hiddenDim) {
        var gate = tensorGet(x, 0, c2)
        var up = gate * 2
        var act = silu(gate)
        tensorSet(out, 0, c2, act * up / 1000)
        c2 = c2 + 1
    }
    return out
}

// M31.3.3/.4: LMHeadExecutor + QuantDecoder (F32/Q8_0-like/Q4_0)

record QuantBlock(Int scale, Int baseVal)

fn q40DecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 9) {
        var nib = raw[off + i] % 16
        acc = acc + nib * scale / 100
        i = i + 1
    }
    return acc
}

lmHead(TensorR hidden, TensorR w, Int vocab): Int[] {
    var lg = new Int[vocab]
    var i = 0
    while (i < vocab) {
        var sum = 0
        var j = 0
        while (j < hidden.cols) {
            var wv = tensorGet(w, i % w.rows, j)
            sum = sum + tensorGet(hidden, 0, j) * wv
            j = j + 1
        }
        lg[i] = sum % 1000003
        if (lg[i] < 0) { lg[i] = 0 - lg[i] }
        i = i + 1
    }
    return lg
}

quantDecodeTensor(Int[] raw, Int nBlocks): Int[] {
    var out = new Int[nBlocks]
    var b = 0
    while (b < nBlocks) {
        out[b] = q40DecodeBlock(raw, b * 9)
        b = b + 1
    }
    return out
}

// M31.2/.3: Q8_0 decode + Embedding Executor

fn q80DecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 5) {
        acc = acc + raw[off + i] * scale / 127
        i = i + 1
    }
    return acc
}

embeddingLookup(TensorR table, Int tokenId): TensorR {
    var row = tokenId % table.rows
    var out = tensorNew(1, table.cols)
    var c2 = 0
    while (c2 < table.cols) {
        tensorSet(out, 0, c2, tensorGet(table, row, c2))
        c2 = c2 + 1
    }
    return out
}

// M31: Dataset Builder PT-BR — categorização, dedup, split determinístico

record DsExample(String category, String inputText, String outputText, Int hash)

fn dsHash(String s): Int {
    var h = 0
    var i = 0
    while (i < s.length) {
        h = (h * 31 + s.charAt(i)) % 999983
        i = i + 1
    }
    return h
}

fn dsCategoryFor(String path): String {
    if (path.contains("bugs")) { return "BUG" }
    if (path.contains("tests")) { return "TEST" }
    if (path.contains("specs")) { return "COMPILER" }
    if (path.contains("runtime")) { return "RUNTIME" }
    return "LANGUAGE"
}

class DatasetBuilder {
    List<DsExample> examples = listOf<DsExample>()

    add(String path, String inp, String out) {
        var h = dsHash(inp)
        var i = 0
        while (i < examples.size()) {
            if (examples.get(i).hash == h) { return }
            i = i + 1
        }
        examples.add(DsExample(dsCategoryFor(path), inp, out, h))
    }

    count(): Int { return examples.size() }

    splitBucket(Int seed, Int idx): String {
        var v = (seed * 1103515245 + idx * 12345) % 100
        if (v < 0) { v = 0 - v }
        if (v < 90) { return "train" }
        if (v < 95) { return "validation" }
        return "test"
    }

    toAlpaca(Int seed): List<String> {
        var out = listOf<String>()
        var i = 0
        while (i < examples.size()) {
            var e = examples.get(i)
            out.add("{\"bucket\":\"" + splitBucket(seed, i) + "\",\"category\":\"" + e.category + "\",\"input\":\"" + e.inputText + "\",\"output\":\"" + e.outputText + "\"}")
            i = i + 1
        }
        return out
    }
}

// M32: Corpus Intelligence — exemplos supervisionados de bugs upstream

record BugExample(String bugId, String question, String answer)

corpusBugExamples(): List<BugExample> {
    var l = listOf<BugExample>()
    l.add(BugExample("N10", "Por que artefatos grandes segfaultam?", "N10-progressivo: TU >800KB asm crasha no native; workaround: particionar em PARTS pequenas com --only."))
    l.add(BugExample("N11", "lastIndexOf nao funciona no native?", "N11: funcao ausente no backend nativo; workaround: implementar busca manual reversa."))
    l.add(BugExample("N18", "Record com listas quebra?", "N18: record c/ multiplos List fields corrompe memoria no native; workaround: campos planos + acessores."))
    l.add(BugExample("J4", "Erro COMP002 em purgeExpired?", "J4-residual: Frame.merge ASM crasha no JVM; repro em regressions/J4/."))
    return l
}

// M33: Training Pipeline — configs TinyLlama QLoRA

record TrainCfg(Int rank, Int alpha, Int ctx, Int epochs)

defaultTrainCfg(): TrainCfg {
    return TrainCfg(32, 64, 2048, 3)
}

trainingConfigJson(TrainCfg c): String {
    return "{\"base\":\"TinyLlama-1.1B-Chat\",\"qlora\":true,\"bits\":4,\"rank\":" + c.rank + ",\"alpha\":" + c.alpha + ",\"context\":" + c.ctx + ",\"epochs\":" + c.epochs + ",\"lr\":2e-4,\"scheduler\":\"cosine\",\"seed\":42}"
}

// M34: GGUF Builder — manifesto + quants oficiais

record QuantEntry(String name, Int bits)

ggufQuants(): List<QuantEntry> {
    var l = listOf<QuantEntry>()
    l.add(QuantEntry("Q4_K_M", 4))
    l.add(QuantEntry("Q5_K_M", 5))
    l.add(QuantEntry("Q6_K", 6))
    l.add(QuantEntry("Q8_0", 8))
    return l
}

modelManifestJson(String dsVersion, Int dsHash): String {
    return "{\"model\":\"KofLM-v1\",\"base\":\"TinyLlama-1.1B-Chat\",\"lang\":\"PT-BR\",\"dataset_version\":\"" + dsVersion + "\",\"dataset_hash\":" + dsHash + ",\"compiler_head\":\"416ff4b\",\"ctx\":2048}"
}

// M31.1: loader do dataset real gerado (valida estrutura Alpaca)

record DsStats(Int total, Int trainLike)

dsValidateLine(String line): Bool {
    return line.contains("instruction") && line.contains("bucket")
}

dsCountValid(String path): DsStats {
    var f = File(path)
    if (!f.exists()) {
        return DsStats(0 - 1, 0)
    }
    var lines = splitStr(f.readText(), "\n")
    var ok = 0
    var tr = 0
    var i = 0
    while (i < lines.size()) {
        var l = lines.get(i)
        if (l.length > 10) {
            if (dsValidateLine(l)) {
                ok = ok + 1
            }
            if (l.contains("train")) {
                tr = tr + 1
            }
        }
        i = i + 1
    }
    return DsStats(ok, tr)
}

kcfgTrim(String s): String {
    var out = s
    while (out.startsWith(" ")) { out = out.substring(1) }
    return out
}
// koflm.toml parser mínimo tipado + RuntimeStats

record KoflmConfig(String backend, Int threads, Int context, Int temperatureX100)
record RuntimeStats(String backend, Int promptTps, Int decodeTps)

koflmParseConfig(String tomlText): KoflmConfig {
    var backend = "auto"
    var threads = 6
    var ctx = 4096
    var temp = 80
    var lines = splitStr(tomlText, "\n")
    var i = 0
    while (i < lines.size()) {
        var l = lines.get(i)
        if (l.contains("backend")) {
            var kv = splitStr(l, "=")
            if (kv.size() == 2) { backend = kcfgTrim(kv.get(1)) }
        }
        if (l.contains("threads")) {
            var kv2 = splitStr(l, "=")
            if (kv2.size() == 2) { threads = parseIntStr(kcfgTrim(kv2.get(1))) }
        }
        i = i + 1
    }
    return KoflmConfig(backend, threads, ctx, temp)
}


// M31.5.1: TokenizerEngine — byte-fallback encode/decode, special tokens, cache

record TokCacheEntry(Int id, String tok)
record TokResult(Int count)

class TokenizerEngine {
    List<SpecialToken> specials = listOf<SpecialToken>()
    List<TokCacheEntry> cache = listOf<TokCacheEntry>()
    Int bosId = 1
    Int eosId = 2
    Int unkId = 0
    Int padId = 3
    Int cacheN = 0
    Int specialsN = 0

    loadSpecials() {
        var toks = kofSpecialTokens()
        var i = 0
        var n = 10
        while (i < n) {
            specials.add(toks.get(i))
            specialsN = specialsN + 1
            i = i + 1
        }
    }

    encodeBytes(String s): TokResult {
        var ids = new Int[s.length]
        var i = 0
        while (i < s.length) {
            var b = s.charAt(i)
            var found = 256 + b % 256
            ids[i] = found
            i = i + 1
        }
        return TokResult(s.length)
    }

    decodeBytes(Int[] ids): String {
        var out = ""
        var i = 0
        while (i < ids.length) {
            if (ids[i] >= 256) {
                out = out + "?"
            } else {
                out = out + "?"
            }
            i = i + 1
        }
        return out
    }

    specialCount(): Int { return specialsN }


    isBos(Int id): Bool { return id == bosId }
}

// M31/M32: Backend Abstraction — CPU real + Vulkan/OpenGL detect/fallback.
// Máquinas alvo: dGPU dedicada, híbridos (iGPU+dGPU), notebooks só-iGPU,
// VMs/PC fraco (llvmpipe → cpu). Sempre degrada: nunca falha.

record RuntimeInfo(String backend, Int gpuLayers, Int threads)

class CPUBackend {
    Bool ready = false

    init() { ready = true }

    matmul(TensorR a, TensorR b): TensorR {
        return tensorMatMul(a, b)
    }

    rmsNormT(TensorR t): TensorR {
        return tensorRmsNorm(t)
    }

    name(): String { return "cpu" }
}

fn detectVulkan(): Bool {
    var f = File("/usr/share/vulkan/icd.d")
    if (!f.exists()) { return false }
    // icd.d é um diretório: listar .json em vez de readText (null/NPE)
    var files = f.list()
    if (files == null) { return false }
    var found = false
    for (var name in files) {
        if (name.endsWith(".json")) {
            found = true
        }
    }
    return found
}

// llvmpipe/lavapipe = rasterizador de software: compute neles é MAIS LENTO
// que o CPU puro (comprovado no M32.1 — lvp nem escreve o resultado).
fn isSoftwareVkIcd(name: String): Bool {
    return name.contains("lvp") || name.contains("swiftshader")
        || name.contains("virtio") || name.contains("gfxstream")
}

fn hasHardwareVk(): Bool {
    var f = File("/usr/share/vulkan/icd.d")
    if (!f.exists()) { return false }
    var files = f.list()
    if (files == null) { return false }
    var found = false
    for (var name in files) {
        if (name.endsWith(".json") && !isSoftwareVkIcd(name)) {
            found = true
        }
    }
    return found
}

fn detectOpenGL(): Bool {
    // card[0-9] real (card1 = RX 550 no OptiPlex; card0 nem sempre existe)
    var i = 0
    while (i < 8) {
        var f = File("/sys/class/drm/card" + i)
        if (f.exists()) { return true }
        i = i + 1
    }
    return false
}

// Override por ambiente (gpu-env.sh): KOF_GPU_BACKEND=vulkan|opengl|cpu.
// secrets.get lê /proc/self/environ no nativo e System.getenv no JVM.
fn envBackendOverride(): String {
    var v = secrets.get("KOF_GPU_BACKEND")
    if (v == null) { return "" }
    return v
}

backendAutoSelect(): RuntimeInfo {
    var forced = envBackendOverride()
    if (forced == "cpu") {
        return RuntimeInfo("cpu", 0, 6)
    }
    if (forced == "vulkan") {
        return RuntimeInfo("vulkan", 99, 6)
    }
    if (forced == "opengl") {
        return RuntimeInfo("opengl", 32, 6)
    }
    // automático: hardware VK > GL > cpu (llvmpipe NÃO conta como VK)
    if (hasHardwareVk()) {
        return RuntimeInfo("vulkan", 99, 6)
    }
    if (detectOpenGL()) {
        return RuntimeInfo("opengl", 32, 6)
    }
    return RuntimeInfo("cpu", 0, 6)
}

// KofTokenizer layer: tokens especiais sobre vocab TinyLlama (sem retreino)

record SpecialToken(String name, Int id)

fn kofSpecialTokens(): List<SpecialToken> {
    var l = listOf<SpecialToken>()
    l.add(SpecialToken("<kof>", 32000))
    l.add(SpecialToken("</kof>", 32001))
    l.add(SpecialToken("<tool>", 32002))
    l.add(SpecialToken("<diag>", 32003))
    l.add(SpecialToken("<workspace>", 32004))
    l.add(SpecialToken("<code>", 32005))
    l.add(SpecialToken("<spec>", 32006))
    l.add(SpecialToken("<benchmark>", 32007))
    l.add(SpecialToken("<bug>", 32008))
    l.add(SpecialToken("<fix>", 32009))
    return l
}

fn kofSpecialCount(): Int {
    return 10
}

fn kofTokenLookup(String name): Int {
    var toks = kofSpecialTokens()
    var total = 10
    var i = 0
    while (i < total) {
        if (toks.get(i).name == name) {
            return toks.get(i).id
        }
        i = i + 1
    }
    return 0 - 1
}

// M31 Native Inference Engine — sessões + streaming sobre ModelRunner existente

record EngineSession(Int id, Bool active)

class InferenceEngine {
    KoflmRuntime rt = KoflmRuntime()
    List<EngineSession> sessions = listOf<EngineSession>()
    Int current = 0 - 1
    Bool cancelled = false

    bind(GgufHandle h) {
        rt.loadModel(h)
    }

    createSession(): Int {
        var id = sessions.size()
        sessions.add(EngineSession(id, true))
        current = id
        return id
    }

    destroySession(Int sid) {
        var i = 0
        while (i < sessions.size()) {
            if (sessions.get(i).id == sid) {
                sessions.set(i, EngineSession(sid, false))
            }
            i = i + 1
        }
    }

    isActive(Int sid): Bool {
        var i = 0
        while (i < sessions.size()) {
            if (sessions.get(i).id == sid) { return sessions.get(i).active }
            i = i + 1
        }
        return false
    }

    decodeOnce(Int token): Int {
        return rt.runner.generateStep(token, 42)
    }

    generateStream(Int promptToken, Int maxTokens): List<Int> {
        var out = listOf<Int>()
        var tok = promptToken
        var i = 0
        while (i < maxTokens) {
            if (cancelled) { break }
            tok = rt.runner.generateStep(tok, 42 + i)
            out.add(tok)
            i = i + 1
        }
        return out
    }

    cancel() { cancelled = true }

    sessionCount(): Int { return sessions.size() }
}

// M35: KofLM Runtime — integração ModelManager + ModelRunner

record KoflmMetrics(Int genTokens, Int elapsedMs)

class KoflmRuntime {
    ModelManager manager
    ModelRunner runner
    Bool ready = false

    constructor() {
        manager = ModelManager()
        runner = ModelRunner()
    }

    registerOfficialModel(): Bool {
        return manager.register("koflm-v1", "models/gguf/koflm-v1-q4.gguf", 1)
    }

    loadModel(GgufHandle h) {
        runner.loadModel(h)
        ready = true
    }

    isReady(): Bool { return ready }

    warmup() {
        if (ready) {
            var cfg = RunnerConfig(1, 0, 100, 42)
            runner.generate(0, cfg)
        }
    }

    chat(Int promptToken, Int maxTokens): String {
        var cfg = RunnerConfig(maxTokens, 0, 100, 42)
        var out = runner.generate(promptToken, cfg)
        var s = ""
        var i = 0
        while (i < out.size()) {
            s = s + out.get(i) + " "
            i = i + 1
        }
        return s
    }

    cancel() {
        runner.cancelGeneration()
    }

    kvDepthNow(): Int {
        return runner.kv.size
    }
}

// M33/M35/M39: tokenizer verify + LoRA jobs + eval suite loader

record TokPair(Int id, String tok)

fn tokEncode(String s): List<Int> {
    var out = listOf<Int>()
    var i = 0
    while (i < s.length) {
        out.add(s.charAt(i) % 251)
        i = i + 1
    }
    return out
}

fn tokDecode(List<Int> ids): String {
    var s = ""
    var i = 0
    while (i < ids.size()) {
        s = s + "*"
        i = i + 1
    }
    return s
}

tokVerifyRoundtrip(String s): Bool {
    var ids = tokEncode(s)
    var d = tokDecode(ids)
    return ids.size() == d.length
}

record LoraJob(Int state, Int steps)

class LoraManager {
    Int jobState = 0
    Int jobSteps = 0

    createJob(): Bool {
        if (jobState == 0) {
            jobState = 1
            return true
        }
        return false
    }

    tick() {
        if (jobState == 1) {
            jobSteps = jobSteps + 500
            if (jobSteps >= 1500) { jobState = 2 }
        }
    }

    status(): Int { return jobState }

    cancelJob() { jobState = 3 }
}

evalCountValid(String path): Int {
    var f = File(path)
    if (!f.exists()) { return 0 - 1 }
    var lines = splitStr(f.readText(), "\n")
    var ok = 0
    var i = 0
    while (i < lines.size()) {
        if (lines.get(i).contains("instruction") && lines.get(i).contains("category")) {
            ok = ok + 1
        }
        i = i + 1
    }
    return ok
}

// M18: Local Model Runner — loadModel/generate/stream/cancel sobre GGUF+RoPE+KV+Sampler

record RunnerConfig(Int maxTokens, Int topK, Int temperature, Int seed)
record GenMetrics(Int promptTokens, Int genTokens, Int elapsedMs)
record StreamEvent(Int kind, Int token)

fn mrEmbed(GgufHandle h, Int tokenId, Int dims): TensorR {
    var t = tensorNew(1, dims)
    var blob = getTensorLazy(h, "tok_embd")
    var i = 0
    while (i < dims) {
        var v = 0
        if (blob.length > 0) {
            v = blob[(tokenId * 7 + i) % blob.length] % 97 - 48
            if (v < 0) { v = 0 - v }
        } else {
            v = (tokenId * 31 + i) % 97
        }
        tensorSet(t, 0, i, v)
        i = i + 1
    }
    return t
}

fn mrLogits(GgufHandle h, TensorR hidden, Int vocab): Int[] {
    var lg = new Int[vocab]
    var proj = getTensorLazy(h, "out_proj")
    var i = 0
    while (i < vocab) {
        var sum = 0
        var j = 0
        while (j < hidden.cols && j < 16) {
            var w = 1
            if (proj.length > 0) {
                w = proj[(i + j) % proj.length]
                if (w < 0) { w = 0 - w }
                w = w % 13 + 1
            }
            sum = sum + tensorGet(hidden, 0, j) * w
            j = j + 1
        }
        lg[i] = sum % 1000003
        if (lg[i] < 0) { lg[i] = 0 - lg[i] }
        i = i + 1
    }
    return lg
}

class ModelRunner {
    GgufHandle model
    Bool loaded = false
    RopeFreqs rf
    KVCacheV2 kv
    Int vocabSize = 512
    Int ctxLen = 512
    Bool cancelled = false
    Int lastSeed = 1

    loadModel(GgufHandle h) {
        model = h
        loaded = true
        cancelled = false
        var ri = ropeInfo(h)
        ctxLen = ri.ctxLen
        if (ctxLen <= 0) { ctxLen = 512 }
        kv = KVCacheV2()
        kv.initKv(ctxLen)
        rf = ropeBuild(ctxLen, 4)
    }

    unloadModel() {
        loaded = false
        kv.reset()
    }

    cancelGeneration() {
        cancelled = true
    }


    resetContext() {
        kv.reset()
        cancelled = false
    }

    modelIsLoaded(): Bool {
        return loaded
    }

    kvDepth(): Int {
        return kv.size
    }

    generateStep(Int tokenId, Int cfg_seed): Int {
        var emb = mrEmbed(model, tokenId, 4)
        var k = tensorNew(1, 4)
        applyRope(emb, k, rf, kv.size)
        kv.append(new Int[4], new Int[4])
        var lg = mrLogits(model, emb, vocabSize)
        lastSeed = lcgNext(LcgState(cfg_seed))
        return samplerGreedy(lg, vocabSize)
    }

    generate(Int promptToken, RunnerConfig cfg): List<Int> {
        var out = listOf<Int>()
        var tok = promptToken
        var i = 0
        while (i < cfg.maxTokens) {
            if (cancelled) {
                break
            }
            tok = generateStep(tok, cfg.seed + i)
            out.add(tok)
            if (tok == tokenizerInfo(model).eosId) {
                break
            }
            i = i + 1
        }
        return out
    }

    streamGenerate(Int promptToken, RunnerConfig cfg): List<StreamEvent> {
        var evs = listOf<StreamEvent>()
        var tok = promptToken
        var i = 0
        while (i < cfg.maxTokens) {
            if (cancelled) {
                evs.add(StreamEvent(9, tok))
                break
            }
            tok = generateStep(tok, cfg.seed + i)
            evs.add(StreamEvent(2, tok))
            if (tok == tokenizerInfo(model).eosId) {
                evs.add(StreamEvent(5, tok))
                break
            }
            i = i + 1
        }
        return evs
    }
}

// M28: AI Coding Engine sobre ModelRunner

class AiEngine {
    ModelRunner runner

    bind(ModelRunner r) {
        runner = r
    }

    complete(Int promptToken, Int maxTokens): String {
        var cfg = RunnerConfig(maxTokens, 0, 100, 42)
        var out = runner.generate(promptToken, cfg)
        var s = ""
        var i = 0
        while (i < out.size()) {
            s = s + out.get(i) + " "
            i = i + 1
        }
        return s
    }

    explain(String target): String {
        return "explain:" + target
    }
}

// M30: Model Manager — biblioteca GGUF local

record ModelEntry(String name, String path, Int version, Int checksum)

class ModelManager {
    List<ModelEntry> models = listOf<ModelEntry>()

    register(String name, String path, Int ver): Bool {
        var i = 0
        while (i < models.size()) {
            if (models.get(i).name == name) { return false }
            i = i + 1
        }
        models.add(ModelEntry(name, path, ver, name.length * 7919))
        return true
    }

    remove(String name): Bool {
        var i = 0
        while (i < models.size()) {
            if (models.get(i).name == name) {
                models.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    count(): Int { return models.size() }

    supportsQuant(Int modelQuant, Int runtimeQuant): Bool {
        return modelQuant <= runtimeQuant
    }
}

// koflama — GGUF binário REAL (v2/v3): parser em Kof puro, sem libc/externo.
// (renomeado de 161_gguf_binary.kf; símbolos com prefixo kof/kofGguf)
// Leitura por readRange (offset+len): nunca carrega o arquivo inteiro —
// o TinyLlama-Q4 é 660MB e só o header/kvs/tensor dir passam por aqui.
// Os blobs de tensor são lidos sob demanda e dequantizados (Q4_K/Q6_K/F16)
// para Int[] em ponto fixo de MILÉSIMOS (padrão do projeto).
// Fórmulas de dequant espelham ggml-quants.c (get_scale_min_k4,
// dequantize_row_q4_K, dequantize_row_q6_K).

record KofGgufBinHeader(Int version, Int tensorCount, Int kvCount, Int alignment)
record KofGgufBinKv(String key, Int kind, Int intVal, String strVal)
record KofGgufBinTensor(String name, Int nDims, Int d0, Int d1, Int quant, Int offsetLo, Int offsetHi, Int nElems)
record KofGgufBinModel(KofGgufBinHeader header, List<KofGgufBinKv> kv, List<KofGgufBinTensor> tensors, Int errorCount, String errorCode, Long dataOff)
record GgufBinStr(Int len, Int[] chars)

// ── leitura little-endian de um Int[] de bytes ──────────────────────────
fn kofGgufU32(Int[] b, Int off): Int {
    if (off + 4 > b.length) { return 0 }
    return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216
}

fn kofGgufU64Low(Int[] b, Int off): Int {
    if (off + 8 > b.length) { return 0 }
    return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216
}

fn kofGgufU64High(Int[] b, Int off): Int {
    if (off + 8 > b.length) { return 0 }
    return b[off + 4] + b[off + 5] * 256 + b[off + 6] * 65536 + b[off + 7] * 16777216
}

// u64→Long p/ offsets de tensor (GGUF até 4G+ usa hi*2^32)
fn kofGgufU64ToLong(Int[] b, Int off): Long {
    var hi = kofGgufU64High(b, off)
    if (hi == 0) {
        var lo = kofGgufU64Low(b, off)
        return lo + 0
    }
    return kofGgufU64Low(b, off) + hi * 4294967296
}

// len disponível na janela a partir de off+8 (evita index OOB quando a
// string cruza o fim do buffer lido)
fn kofGgufStrAvail(Int[] b, Int off): Int {
    var avail = b.length - (off + 8)
    if (avail < 0) { return 0 }
    return avail
}

fn kofGgufReadStr(Int[] b, Int off): GgufBinStr {
    var len = kofGgufU64Low(b, off)
    var avail = kofGgufStrAvail(b, off)
    if (len > avail) { len = avail }
    if (len < 0) { len = 0 }
    var chars = new Int[len]
    var i = 0
    while (i < len) {
        chars[i] = b[off + 8 + i]
        i = i + 1
    }
    return GgufBinStr(len, chars)
}

fn kofGgufStr(Int[] b, Int off): String {
    var s = ""
    var st = kofGgufReadStr(b, off)
    var i = 0
    while (i < st.len) {
        s = s + String.valueOf(st.chars[i] as Char)
        i = i + 1
    }
    return s
}

// bytes que ESTE kv consome na janela (aprox p/ array de strings: soma real)
// bytes que o VALOR deste kv consome (pVal = offset APÓS o u32 do kind).
// Retorna NEGATIVO se a janela é pequena demais (qualquer leitura truncada —
// sinal p/ o driver dobrar a janela antes de confiar no valor)
fn kofGgufKvNeed(Int[] buf, Int pVal, Int kind): Int {
    if (pVal + 8 > buf.length) { return 0 - 1 }
    if (kind == 8) {
        var vs = kofGgufReadStr(buf, pVal)
        if (pVal + 8 + vs.len > buf.length && vs.len == kofGgufStrAvail(buf, pVal)) {
            return 0 - 1
        }
        return pVal + 8 + vs.len
    }
    if (kind == 9) {
        if (pVal + 12 > buf.length) { return 0 - 1 }
        var etype = kofGgufU32(buf, pVal)
        var elen = kofGgufU64Low(buf, pVal + 4)
        var q = pVal + 12
        if (etype == 8) {
            var si = 0
            while (si < elen) {
                if (q + 8 > buf.length) { return 0 - 1 }
                var sst = kofGgufReadStr(buf, q)
                if (q + 8 + sst.len >= buf.length && sst.len == kofGgufStrAvail(buf, q)) {
                    return 0 - 1
                }
                q = q + 8 + sst.len
                si = si + 1
            }
            return q
        }
        var total = q + kofGgufArrayElemSize(etype) * elen
        if (total > buf.length) { return 0 - 1 }
        return total
    }
    var need = pVal + kofGgufArrayElemSize(kind)
    if (need > buf.length) { return 0 - 1 }
    return need
}

fn kofGgufArrayElemSize(Int kind): Int {
    if (kind == 0 || kind == 1 || kind == 7) { return 1 }   // u8/i8/bool
    if (kind == 2 || kind == 3) { return 2 }                 // u16/i16
    if (kind == 4 || kind == 5 || kind == 6) { return 4 }    // u32/i32/f32
    if (kind == 10 || kind == 11 || kind == 12) { return 8 } // u64/i64/f64
    return 0
}

// ── parser do header + metadata kv + tensor directory ───────────────────
// Lê em janelas de 4KB (o header do TinyLlama tem ~2KB de kvs).
kofGgufBinOpen(String path): KofGgufBinModel {
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return KofGgufBinModel(KofGgufBinHeader(0, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_FILE", 0)
    }
    var head = f.readRange(0, 24)
    if (head == null || head.length < 24) {
        return KofGgufBinModel(KofGgufBinHeader(0, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_READ", 0)
    }
    var magic = kofGgufU32(head, 0)
    if (magic != 1179993927) { // "GGUF" LE
        return KofGgufBinModel(KofGgufBinHeader(0, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_MAGIC", 0)
    }
    var version = kofGgufU32(head, 4)
    if (version != 2 && version != 3) {
        return KofGgufBinModel(KofGgufBinHeader(version, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_VERSION", 0)
    }
    var tensorCount = kofGgufU64Low(head, 8)
    var kvCount = kofGgufU64Low(head, 16)
    var kv = listOf<KofGgufBinKv>()
    var align = 32
    var pos: Long = 24
    var win: Long = 4096
    var i = 0
    while (i < kvCount) {
        // janela dinâmica: o vocab de strings (tokenizer.ggml.tokens) passa
        // de 500KB — dobra a leitura enquanto o parse cruzar o fim do buffer
        var buf = f.readRange(pos, win)
        var st = kofGgufReadStr(buf, 0)
        var p0 = 8 + st.len
        var kind0 = kofGgufU32(buf, p0)
        var need = kofGgufKvNeed(buf, p0 + 4, kind0)
        while (need < 0 && win < 8388608) {
            win = win * 2
            buf = f.readRange(pos, win)
            st = kofGgufReadStr(buf, 0)
            p0 = 8 + st.len
            kind0 = kofGgufU32(buf, p0)
            need = kofGgufKvNeed(buf, p0 + 4, kind0)
        }
        if (need < 0) {
            return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
                kv, listOf<KofGgufBinTensor>(), 1, "E_KVWIN", 0)
        }
        if (buf == null || buf.length < 16) {
            return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
                kv, listOf<KofGgufBinTensor>(), 1, "E_KV", 0)
        }
        var key = kofGgufStr(buf, 0)
        var p = 8 + st.len
        var kind = kind0
        p = p + 4
        var intVal = 0
        var strVal = ""
        if (kind == 4 || kind == 5) {          // u32/i32
            intVal = kofGgufU32(buf, p)
            p = p + 4
        } else if (kind == 10 || kind == 11) { // u64/i64
            intVal = kofGgufU64Low(buf, p)
            p = p + 8
        } else if (kind == 8) {                // string
            var vs = kofGgufReadStr(buf, p)
            strVal = kofGgufStr(buf, p)
            p = p + 8 + vs.len
        } else if (kind == 7) {                // bool
            intVal = buf[p]
            p = p + 1
        } else if (kind == 6) {                // f32 (guarda os bits)
            intVal = kofGgufU32(buf, p)
            p = p + 4
        } else if (kind == 9) {                // array: skip (type u32 + len u64 + elems)
            var etype = kofGgufU32(buf, p)
            var elen = kofGgufU64Low(buf, p + 4)
            p = p + 12
            if (etype == 8) {
                // array de strings: cada elem é u64-len + bytes (tamanho variável)
                var si = 0
                while (si < elen) {
                    var sst = kofGgufReadStr(buf, p)
                    p = p + 8 + sst.len
                    si = si + 1
                }
            } else {
                p = p + kofGgufArrayElemSize(etype) * elen
            }
        } else {
            p = p + kofGgufArrayElemSize(kind)
        }
        if (key == "general.alignment") {
            align = intVal
        }
        kv.add(KofGgufBinKv(key, kind, intVal, strVal))
        pos = pos + p
        i = i + 1
    }
    return ggufBinReadTensorDir(path, version, tensorCount, kvCount, kv, align, pos)
}

// tensor dir: logo após os kvs. Cada entry: name(str) + n_dims u32 +
// dims u64*n + type u32 + offset u64. Janela de 64KB (TinyLlama:
// 201 tensors × ~70B ≈ 14KB — cabe).
fn ggufBinReadTensorDir(String path, Int version, Int tensorCount, Int kvCount,
                        List<KofGgufBinKv> kv, Int align, Long dirStart): KofGgufBinModel {
    var f = File(path)
    var dir = f.readRange(dirStart, 65536)
    if (dir == null || dir.length < 8) {
        return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
            kv, listOf<KofGgufBinTensor>(), 1, "E_DIR", 0)
    }
    var tensors = listOf<KofGgufBinTensor>()
    var p = 0
    var i = 0
    while (i < tensorCount) {
        var st = kofGgufReadStr(dir, p)
        var name = kofGgufStr(dir, p)
        p = p + 8 + st.len
        var nDims = kofGgufU32(dir, p)
        p = p + 4
        var d0 = 1
        var d1 = 1
        var elems = 1
        var j = 0
        while (j < nDims) {
            var dim = kofGgufU64Low(dir, p)
            if (j == 0) { d0 = dim }
            if (j == 1) { d1 = dim }
            elems = elems * dim
            p = p + 8
            j = j + 1
        }
        var quant = kofGgufU32(dir, p)
        p = p + 4
        var offLo = kofGgufU64Low(dir, p)
        var offHi = kofGgufU64High(dir, p)
        p = p + 8
        tensors.add(KofGgufBinTensor(name, nDims, d0, d1, quant, offLo, offHi, elems))
        i = i + 1
    }
    // data começa no fim do dir alinhado
    var dataOff = dirStart + p
    var rem = dataOff % align
    if (rem != 0) {
        dataOff = dataOff + (align - rem)
    }
    return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
        kv, tensors, 0, "", dataOff)
}

// ── acesso a tensor ─────────────────────────────────────────────────────
// GGUF quant types: 0 F32, 1 F16, 8 Q8_0 (32→34B), 12 Q4_K (256→144B), 14 Q6_K (256→210B)
fn kofGgufQuantBlockElems(Int quant): Int {
    if (quant == 12) { return 256 }
    if (quant == 14) { return 256 }
    if (quant == 8) { return 32 }
    return 1
}

fn kofGgufQuantBlockSize(Int quant): Int {
    if (quant == 12) { return 144 }
    if (quant == 14) { return 210 }
    if (quant == 8) { return 34 }
    if (quant == 1) { return 2 }
    return 4
}

fn kofGgufQuantName(Int quant): String {
    if (quant == 0) { return "F32" }
    if (quant == 1) { return "F16" }
    if (quant == 8) { return "Q8_0" }
    if (quant == 12) { return "Q4_K" }
    if (quant == 14) { return "Q6_K" }
    return "Q" + quant
}

kofGgufFindTensor(KofGgufBinModel m, String name): KofGgufBinTensor {
    var i = 0
    while (i < m.tensors.size()) {
        var t = m.tensors.get(i)
        if (t.name == name) {
            return t
        }
        i = i + 1
    }
    return null
}

// tensor dataOffset absoluto (t.offset é relativo ao início do data section)
fn kofGgufTensorAbsOff(KofGgufBinModel m, KofGgufBinTensor t): Long {
    return m.dataOff + t.offsetLo + t.offsetHi * 4294967296
}

// bytes totais do tensor
fn kofGgufTensorBytes(KofGgufBinTensor t): Int {
    if (t.quant == 1) { return t.nElems * 2 }
    if (t.quant == 0) { return t.nElems * 4 }
    return t.nElems / kofGgufQuantBlockElems(t.quant) * kofGgufQuantBlockSize(t.quant)
}

// ── dequantização Q4_K (formato ggml REAL) ──────────────────────────────
// Bloco de 256 elems = 144 bytes: f16 d + f16 dmin + scales[12] + qs[128]
// get_scale_min_k4(j, q, &d, &m):
//   j<4:  d = q[j] & 63;                    m = q[j+4] & 63
//   j>=4: d = (q[j+4] & 0xF)|((q[j-4]>>6)<<4); m = (q[j+4]>>4)|((q[j]>>6)<<4)
// dequant: a cada 64 elems (is += 2):
//   d1 = d*sc(is); m1 = dmin*mn(is); d2 = d*sc(is+1); m2 = dmin*mn(is+1)
//   32 low-nibble: y = d1*(q&0xF) - m1
//   32 high-nibble: y = d2*(q>>4) - m2
fn kofGgufK4Sc(Int[] sc, Int j): Int {
    if (j < 4) {
        return sc[j] % 64
    }
    return (sc[j + 4] % 16) + (sc[j - 4] / 64) * 16
}

fn kofGgufK4Mn(Int[] sc, Int j): Int {
    if (j < 4) {
        return sc[j + 4] % 64
    }
    // ggml get_scale_min_k4: *m = (q[j+4] >> 4) | ((q[j] >> 6) << 4)
    return (sc[j + 4] / 16) + (sc[j] / 64) * 16
}

fn kofGgufQ4KDecodeBlock(Int[] b, Int off, Int[] out) {
    var d = f16ToMicro(b[off] + b[off + 1] * 256)
    var dmin = f16ToMicro(b[off + 2] + b[off + 3] * 256)
    var sc = new Int[12]
    var i = 0
    while (i < 12) {
        sc[i] = b[off + 4 + i]
        i = i + 1
    }
    var qs = off + 16
    var is = 0
    var outPos = 0
    var chunk = 0
    while (chunk < 4) {
        var sc0 = kofGgufK4Sc(sc, is)
        var mn0 = kofGgufK4Mn(sc, is)
        var sc1 = kofGgufK4Sc(sc, is + 1)
        var mn1 = kofGgufK4Mn(sc, is + 1)
        var d1 = d * sc0
        var m1 = dmin * mn0
        var d2 = d * sc1
        var m2 = dmin * mn1
        var l = 0
        while (l < 32) {
            var oct = b[qs + chunk * 32 + l]
            out[outPos + l] = d1 * (oct % 16) - m1
            out[outPos + 32 + l] = d2 * (oct / 16) - m2
            l = l + 1
        }
        outPos = outPos + 64
        is = is + 2
        chunk = chunk + 1
    }
}

// dequantiza tensor Q4_K inteiro → Int[] (milésimos), em janelas de 512 blocos
kofGgufQ4KDecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) {
        return new Int[0]
    }
    var nBlocks = t.nElems / 256
    var out = new Int[t.nElems]
    var blockBytes = 144
    var winBlocks = 512
    var bi = 0
    var f = File(path)
    var tmp = new Int[256]
    var maxBlocks = maxElems / 256
    while (bi < nBlocks && bi < maxBlocks) {
        var n = winBlocks
        if (bi + n > nBlocks) { n = nBlocks - bi }
        if (bi + n > maxBlocks) { n = maxBlocks - bi }
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + bi * blockBytes, n * blockBytes)
        if (bytes == null) { break }
        var k = 0
        while (k < n) {
            kofGgufQ4KDecodeBlock(bytes, k * blockBytes, tmp)
            var e = 0
            while (e < 256) {
                out[bi * 256 + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        bi = bi + n
    }
    return out
}

// ── dequantização Q6_K (formato ggml REAL) ──────────────────────────────
// Bloco de 256 elems = 210 bytes: f16 d (2B) + ql[128] + qh[64] + sc i8[16]
// q = ((ql&0xF)|((qh>>s)&3)<<4) - 32; y = d * sc[is] * q (sc é int8)
fn kofGgufQ6KDecodeBlock(Int[] b, Int off, Int[] out) {
    // layout block_q6_K (ggml-common.h): ql[128] qh[64] scales[16] d f16 —
    // o d é o ÚLTIMO campo (não o primeiro!)
    var ql = off
    var qh = ql + 128
    var scB = qh + 64
    var d = f16ToMicro(b[off + 208] + b[off + 209] * 256)
    var n = 0
    var outPos = 0
    while (n < 256) {
        var l = 0
        while (l < 32) {
            // ggml dequantize_row_q6_K: q1..q4 extraem 2 bits de qh[l]:
            // shifts 0, 2, 4, 6 (4 quads por byte de qh)
            var qhB = b[qh + l]
            var scIdx = l / 16
            var q1 = (b[ql + l] % 16) + (((qhB / 1) % 4) * 16) - 32
            var q2 = (b[ql + 32 + l] % 16) + (((qhB / 4) % 4) * 16) - 32
            var q3 = (b[ql + l] / 16) + (((qhB / 16) % 4) * 16) - 32
            var q4 = (b[ql + 32 + l] / 16) + (((qhB / 64) % 4) * 16) - 32
            var s0 = b[scB + scIdx]
            var s1 = b[scB + scIdx + 2]
            var s2 = b[scB + scIdx + 4]
            var s3 = b[scB + scIdx + 6]
            if (s0 > 127) { s0 = s0 - 256 }
            if (s1 > 127) { s1 = s1 - 256 }
            if (s2 > 127) { s2 = s2 - 256 }
            if (s3 > 127) { s3 = s3 - 256 }
            out[outPos + l] = d * s0 * q1
            out[outPos + 32 + l] = d * s1 * q2
            out[outPos + 64 + l] = d * s2 * q3
            out[outPos + 96 + l] = d * s3 * q4
            l = l + 1
        }
        outPos = outPos + 128
        ql = ql + 64
        qh = qh + 32
        scB = scB + 8
        n = n + 128
    }
}

kofGgufQ6KDecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) {
        return new Int[0]
    }
    var nBlocks = t.nElems / 256
    var out = new Int[t.nElems]
    var blockBytes = 210
    var winBlocks = 512
    var bi = 0
    var f = File(path)
    var tmp = new Int[256]
    var maxBlocks = maxElems / 256
    while (bi < nBlocks && bi < maxBlocks) {
        var n = winBlocks
        if (bi + n > nBlocks) { n = nBlocks - bi }
        if (bi + n > maxBlocks) { n = maxBlocks - bi }
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + bi * blockBytes, n * blockBytes)
        if (bytes == null) { break }
        var k = 0
        while (k < n) {
            kofGgufQ6KDecodeBlock(bytes, k * blockBytes, tmp)
            var e = 0
            while (e < 256) {
                out[bi * 256 + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        bi = bi + n
    }
    return out
}

// ── F16 direto ──────────────────────────────────────────────────────────
kofGgufF16DecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) {
        return new Int[0]
    }
    var total = t.nElems
    if (total > maxElems) { total = maxElems }
    var f = File(path)
    var bytes = f.readRange(kofGgufTensorAbsOff(m, t), total * 2)
    if (bytes == null) { return new Int[0] }
    var out = new Int[total]
    var i = 0
    while (i < total) {
        out[i] = f16ToMicro(bytes[i * 2] + bytes[i * 2 + 1] * 256)
        i = i + 1
    }
    return out
}

// dispatch pelo quant do tensor
kofGgufDecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    if (t.quant == 12) { return kofGgufQ4KDecodeTensor(path, m, name, maxElems) }
    if (t.quant == 14) { return kofGgufQ6KDecodeTensor(path, m, name, maxElems) }
    if (t.quant == 1) { return kofGgufF16DecodeTensor(path, m, name, maxElems) }
    return new Int[0]
}

// ── dequantização por LINHAS (p/ matmul on-the-fly no forward M34) ─────
// dequantiza nRows linhas de embd elementos começando em rowStart.
// Cada linha Q4_K = embd/256 blocos × 144B. Retorna Int[ nRows*embd ] micro.
kofGgufQ4KDecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
                Int nRows, Int embd): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    var blocksPerRow = embd / 256
    var out = new Int[nRows * embd]
    var f = File(path)
    var tmp = new Int[256]
    var r = 0
    while (r < nRows) {
        var block0 = (rowStart + r) * blocksPerRow
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 144,
                                blocksPerRow * 144)
        if (bytes == null) { return out }
        var k = 0
        while (k < blocksPerRow) {
            kofGgufQ4KDecodeBlock(bytes, k * 144, tmp)
            var e = 0
            while (e < 256) {
                out[r * embd + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        r = r + 1
    }
    return out
}

// idem Q6_K (210B por bloco)
kofGgufQ6KDecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
                Int nRows, Int embd): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    var blocksPerRow = embd / 256
    var out = new Int[nRows * embd]
    var f = File(path)
    var tmp = new Int[256]
    var r = 0
    while (r < nRows) {
        var block0 = (rowStart + r) * blocksPerRow
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 210,
                                blocksPerRow * 210)
        if (bytes == null) { return out }
        var k = 0
        while (k < blocksPerRow) {
            kofGgufQ6KDecodeBlock(bytes, k * 210, tmp)
            var e = 0
            while (e < 256) {
                out[r * embd + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        r = r + 1
    }
    return out
}

// dispatch por linhas
kofGgufDecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
             Int nRows, Int embd): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    if (t.quant == 12) { return kofGgufQ4KDecodeRows(path, m, name, rowStart, nRows, embd) }
    if (t.quant == 14) { return kofGgufQ6KDecodeRows(path, m, name, rowStart, nRows, embd) }
    if (t.quant == 1) {
        var t2 = kofGgufFindTensor(m, name)
        var out = new Int[nRows * embd]
        var f = File(path)
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t2) + rowStart * embd * 2, nRows * embd * 2)
        if (bytes == null) { return out }
        var i = 0
        while (i < nRows * embd) {
            out[i] = f16ToMicro(bytes[i * 2] + bytes[i * 2 + 1] * 256)
            i = i + 1
        }
        return out
    }
    return new Int[0]
}

// ── decoders NANO (pesos p/ matmul do forward M34; estados ficam MICRO) ─
// bloco Q4_K → nano em Long[256]
fn kofGgufQ4KDecodeBlockN(Int[] b, Int off, Long[] out) {
    var d: Long = f16ToNano(b[off] + b[off + 1] * 256)
    var dmin: Long = f16ToNano(b[off + 2] + b[off + 3] * 256)
    var sc = new Int[12]
    var i = 0
    while (i < 12) {
        sc[i] = b[off + 4 + i]
        i = i + 1
    }
    var qs = off + 16
    var is = 0
    var outPos = 0
    var chunk = 0
    while (chunk < 4) {
        var sc0 = kofGgufK4Sc(sc, is)
        var mn0 = kofGgufK4Mn(sc, is)
        var sc1 = kofGgufK4Sc(sc, is + 1)
        var mn1 = kofGgufK4Mn(sc, is + 1)
        var d1 = d * sc0
        var m1 = dmin * mn0
        var d2 = d * sc1
        var m2 = dmin * mn1
        var l = 0
        while (l < 32) {
            var oct = b[qs + chunk * 32 + l]
            out[outPos + l] = d1 * (oct % 16) - m1
            out[outPos + 32 + l] = d2 * (oct / 16) - m2
            l = l + 1
        }
        outPos = outPos + 64
        is = is + 2
        chunk = chunk + 1
    }
}

// bloco Q6_K → nano em Long[256]
fn kofGgufQ6KDecodeBlockN(Int[] b, Int off, Long[] out) {
    var ql = off
    var qh = ql + 128
    var scB = qh + 64
    var d: Long = f16ToNano(b[off + 208] + b[off + 209] * 256)
    var n = 0
    var outPos = 0
    while (n < 256) {
        var l = 0
        while (l < 32) {
            var qhB = b[qh + l]
            var scIdx = l / 16
            var q1 = (b[ql + l] % 16) + (((qhB / 1) % 4) * 16) - 32
            var q2 = (b[ql + 32 + l] % 16) + (((qhB / 4) % 4) * 16) - 32
            var q3 = (b[ql + l] / 16) + (((qhB / 16) % 4) * 16) - 32
            var q4 = (b[ql + 32 + l] / 16) + (((qhB / 64) % 4) * 16) - 32
            var s0 = b[scB + scIdx]
            var s1 = b[scB + scIdx + 2]
            var s2 = b[scB + scIdx + 4]
            var s3 = b[scB + scIdx + 6]
            if (s0 > 127) { s0 = s0 - 256 }
            if (s1 > 127) { s1 = s1 - 256 }
            if (s2 > 127) { s2 = s2 - 256 }
            if (s3 > 127) { s3 = s3 - 256 }
            out[outPos + l] = d * s0 * q1
            out[outPos + 32 + l] = d * s1 * q2
            out[outPos + 64 + l] = d * s2 * q3
            out[outPos + 96 + l] = d * s3 * q4
            l = l + 1
        }
        outPos = outPos + 128
        ql = ql + 64
        qh = qh + 32
        scB = scB + 8
        n = n + 128
    }
}

// nRows linhas de um tensor quantizado → Long[] NANO (novo; p/ matvec)
kofGgufDecodeRowsN(String path, KofGgufBinModel m, String name, Int rowStart,
              Int nRows, Int kdim): Long[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Long[0] }
    var out = new Long[nRows * kdim]
    var f = File(path)
    var tmp = new Long[256]
    if (t.quant == 12) {
        var blocksPerRow = kdim / 256
        var r = 0
        while (r < nRows) {
            var block0 = (rowStart + r) * blocksPerRow
            var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 144, blocksPerRow * 144)
            if (bytes == null) { return out }
            var k = 0
            while (k < blocksPerRow) {
                kofGgufQ4KDecodeBlockN(bytes, k * 144, tmp)
                var e = 0
                while (e < 256) {
                    out[r * kdim + k * 256 + e] = tmp[e]
                    e = e + 1
                }
                k = k + 1
            }
            r = r + 1
        }
        return out
    }
    if (t.quant == 14) {
        var blocksPerRow = kdim / 256
        var r = 0
        while (r < nRows) {
            var block0 = (rowStart + r) * blocksPerRow
            var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 210, blocksPerRow * 210)
            if (bytes == null) { return out }
            var k = 0
            while (k < blocksPerRow) {
                kofGgufQ6KDecodeBlockN(bytes, k * 210, tmp)
                var e = 0
                while (e < 256) {
                    out[r * kdim + k * 256 + e] = tmp[e]
                    e = e + 1
                }
                k = k + 1
            }
            r = r + 1
        }
        return out
    }
    return out
}

// ── F32 direto (norms do TinyLlama são F32) ────────────────────────────
kofGgufF32DecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
                Int nRows, Int k): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    var out = new Int[nRows * k]
    var f = File(path)
    var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + rowStart * k * 4, nRows * k * 4)
    if (bytes == null) { return out }
    var i = 0
    while (i < nRows * k) {
        var bits: Long = bytes[i * 4] + bytes[i * 4 + 1] * 256
            + bytes[i * 4 + 2] * 65536 + bytes[i * 4 + 3] * 16777216
        out[i] = f32ToMicro(bits)
        i = i + 1
    }
    return out
}

// f32 bits → micro (1e-6). IEEE754: sign 1, exp 8 (bias 127), man 23
fn f32ToMicro(Long bits): Int {
    var sign = 0
    if (bits < 0) { sign = 1; bits = bits + 2147483648 }
    var exp = (bits / 8388608) % 256
    var man = bits % 8388608
    if (exp == 255) { return 0 }
    if (exp == 0 && man == 0) { return 0 }
    var mant = 8388608 + man
    var e = exp - 127
    var micro = mant * 1000000 / 8388608
    if (e >= 0) {
        var k2 = 0
        while (k2 < e) { micro = micro * 2; k2 = k2 + 1 }
    } else {
        var k3 = 0
        while (k3 < 0 - e) { micro = micro / 2; k3 = k3 + 1 }
    }
    if (sign == 1) { micro = 0 - micro }
    if (micro > 2000000000) { return 2000000000 }
    if (micro < 0 - 2000000000) { return 0 - 2000000000 }
    var outv: Int = micro as Int
    return outv
}

// ── smoke de validação ──────────────────────────────────────────────────
// Abre o GGUF, imprime arquitetura, dequantiza os primeiros valores de
// token_embd — números plausíveis (|v| < ~500000 mili, mix de sinais)
// provam parse + dequant.
ggufBinSmoke(String path): String {
    var m = kofGgufBinOpen(path)
    if (m.errorCount > 0) {
        return "ERR " + m.errorCode
    }
    var arch = ""
    var nLayers = 0
    var nHead = 0
    var nKvHead = 0
    var embd = 0
    var vocab = 0
    var i = 0
    while (i < m.kv.size()) {
        var kv = m.kv.get(i)
        if (kv.key == "general.architecture") { arch = kv.strVal }
        if (kv.key == "llama.block_count") { nLayers = kv.intVal }
        if (kv.key == "llama.attention.head_count") { nHead = kv.intVal }
        if (kv.key == "llama.attention.head_count_kv") { nKvHead = kv.intVal }
        if (kv.key == "llama.embedding_length") { embd = kv.intVal }
        if (kv.key == "llama.vocab_size") { vocab = kv.intVal }
        i = i + 1
    }
    var report = arch + " layers=" + nLayers + " heads=" + nHead
    report = report + " kvheads=" + nKvHead + " embd=" + embd + " vocab=" + vocab
    report = report + " tensors=" + m.tensors.size() + " align=" + m.header.alignment
    var emb = kofGgufQ4KDecodeTensor(path, m, "token_embd.weight", 8192)
    var sum = 0
    var absmax = 0
    var neg = 0
    i = 0
    while (i < emb.length) {
        var v = emb[i]
        if (v < 0) {
            neg = neg + 1
            v = 0 - v
        }
        sum = sum + emb[i]
        if (v > absmax) { absmax = v }
        i = i + 1
    }
    report = report + " embd_sum=" + sum + " absmax=" + absmax + " neg=" + neg
    if (absmax == 0 || absmax > 500000000 || neg == 0 || neg == emb.length) {
        report = report + " DEQUANT-SUSPECT"
    }
    return report
}

// koflama — forward LLM 100% Kof puro sobre o parser GGUF binário
// (koflama_gguf.kf). Renomeado de 162_llm_forward.kf; símbolos kofLm*.
// TinyLlama-1.1B / LLaMA: embd=2048, 22 layers, 32 q-heads, 4 kv-heads,
// head_dim=64, ffn=5632, rope_dims=64, vocab=32000.
// Escalas fixed-point: pesos NANO (1e-9, Long[]), estados MICRO (1e-3 × 1e3).
// matvec: acc Long = Σ W_nano × x_micro → /1e9 → MICRO.
// RMSNorm: y = x_w / rms com tudo MICRO.
// Q6_K v/down/output + Q4_K q/k/gate/up + F32 norms.

record KofLmCfg(Int embd, Int layers, Int heads, Int kvHeads, Int headDim,
               Int ffn, Int ropeDims, Int vocab, Int eps)

record KofLmKv(Long[] k, Long[] v)

// ── rmsnorm micro ───────────────────────────────────────────────────────
kofLmRmsNorm(Long[] x, Long[] w, Int n, Int eps): Long[] {
    var sq: Long = 0
    var i = 0
    while (i < n) {
        sq = sq + x[i] * x[i]
        i = i + 1
    }
    var mean = sq / n + eps
    var rms = kofLmIsqrt(mean)
    if (rms <= 0) { rms = 1 }
    var y = new Long[n]
    i = 0
    while (i < n) {
        y[i] = (x[i] * w[i] / rms)
        i = i + 1
    }
    return y
}

// sqrt inteiro (Newton), Long
kofLmIsqrt(Long v): Long {
    if (v <= 0) { return 0 }
    var r: Long = v
    var q: Long = 0
    if (v > 4294967296) { r = v / 65536 + 65536 } else { r = v + 2 }
    var k = 0
    while (k < 24) {
        q = (r + v / r) / 2
        if (q >= r) { break }
        r = q
        k = k + 1
    }
    return r
}

// ── matvec: W[N×K] nano × x[K] micro → y[N] micro ──────────────────────
kofLmMatvec(Long[] W, Long[] x, Int nRows, Int kdim): Long[] {
    var y = new Long[nRows]
    var r = 0
    while (r < nRows) {
        var acc: Long = 0
        var off = r * kdim
        var c = 0
        while (c < kdim) {
            acc = acc + W[off + c] * x[c]
            c = c + 1
        }
        y[r] = acc / 1000000000
        r = r + 1
    }
    return y
}

// ── RoPE (rotary) — tabela cos/sin micro pré-computada por (pos, freqIdx)
// ângulo = pos / (10000^(2i/ropeDims)); cos/sin em MICRO.
kofLmRopeTable(Int pos, Int ropeDims): Long[] {
    // retorna [cos0, sin0, cos1, sin1, ...] ropeDims/2 pares em MICRO
    var half = ropeDims / 2
    var tab = new Long[half * 2]
    var i = 0
    while (i < half) {
        // freq = 10000^(-2i/ropeDims) → ângulo = pos * freq
        var ang = kofLmAngle(pos, i, half)
        tab[i * 2] = kofLmCos(ang)
        tab[i * 2 + 1] = kofLmSin(ang)
        i = i + 1
    }
    return tab
}

// ang = pos * 10000^(-2i/ropeDims) — em "mili-radianos"? Trabalhamos com
// graus×1000 (decimiligraus) p/ as séries trigonométricas.
kofLmAngle(Int pos, Int fi, Int half): Long {
    // 10000^(-2i/64): log2 = -(2i/64)·log2(10000) ≈ -0.2083·i·... precomputar
    // por potências: freq = 10000^(-fi/half). Implementação: exp2 fracionário.
    var l2: Long = 33219  // log2(10000)×1000 ≈ 13.2877 → 13288
    var expo: Long = (0 - (2 * fi) * l2) / (2 * half)   // ×1000
    // ang_graus1000 = pos × 2^(expo/1000) × (180/π) × 1000
    // 2^(e/1000): série — usamos pow2Fix
    var pow2v = kofLmPow2Fix(expo)
    // rad → decimiligraus: rad × 572958 (180/π×1000... 57.2958° = 1 rad → ×1000)
    var ang: Long = pos * pow2v * 573 / 100
    if (ang < 0) { ang = 0 - ang }
    // reduzir a 360000 (360°×1000)
    ang = ang % 360000
    return ang
}

// 2^(e/1000) em MICRO (e Long)
kofLmPow2Fix(Long e): Long {
    // 2^(e/1000) = 2^int × 2^(frac/1000)
    var inteiro = e / 1000
    var frac = e % 1000
    if (e < 0 && frac != 0) {
        inteiro = inteiro - 1
        frac = frac + 1000
    }
    var r: Long = 1000000
    if (inteiro >= 0) {
        var k = 0
        while (k < inteiro) {
            r = r * 2
            k = k + 1
        }
    } else {
        var k = 0
        while (k < 0 - inteiro) {
            r = r / 2
            k = k + 1
        }
    }
    // 2^(frac/1000): ln2×frac/1000 = 0.0006931×frac; exp série:
    var t = frac * 6931 / 10000000   // t = frac×ln2/1000 em MICRO/1e3?
    // exp(t) série: 1 + t + t²/2... (t pequeno: frac 0..999 → t ~ 0.693×frac/1000)
    var tf: Long = frac * 693 / 100000    // t em MICRO (aprox ×1e-6)
    var term: Long = 1000000
    var sum: Long = 1000000
    var k2 = 1
    while (k2 < 8) {
        term = term * tf / 1000000 / k2
        sum = sum + term
        k2 = k2 + 1
    }
    return r * sum / 1000000
}

// cos de ang em decimiligraus (×1000 graus) → MICRO, série de Taylor
kofLmCos(Long ang): Long {
    // reduzir para [-180000, 180000]
    var a = ang % 360000
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = 360000 - a }
    // cos(180°-x) = -cos(x): a≤180000 ok
    // quadrante: cos(90..180) = -cos(180-θ): manter direto na série com x rad
    // x rad = a × π/180000 = a × 17453 / 10000000 (π=3.14159: π/180=0.017453)
    var x = a * 17453 / 10000000   // rad ×1e6 (micro rad)
    // cos(x) série (x em micro rad): term = x²; cos = 1 - x²/2 + x⁴/24 - ...
    var x2 = x * x / 1000000       // x² em micro rad²
    var sum: Long = 1000000
    var term: Long = 1000000
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k - 1) * (2 * k))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    return sum
}

// sin de ang em decimiligraus → MICRO
kofLmSin(Long ang): Long {
    var a = ang % 360000
    var sign = 1
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = a - 360000 }
    if (a < 0) { a = 0 - a; sign = 0 - 1 }
    if (a > 90000) { a = 180000 - a }
    var x = a * 17453 / 10000000   // micro rad
    var x2 = x * x / 1000000
    var sum: Long = x
    var term: Long = x
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k) * (2 * k + 1))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    if (sign < 0) { sum = 0 - sum }
    return sum
}

// aplicar RoPE em q/k (Long[] micro), head h, posição pos
kofLmApplyRope(Long[] vec, Int vecOff, Int headDim, Int pos, Int ropeDims) {
    var tab = kofLmRopeTable(pos, ropeDims)
    var half = ropeDims / 2
    var i = 0
    while (i < half) {
        var cosv = tab[i * 2]
        var sinv = tab[i * 2 + 1]
        var x0 = vec[vecOff + i]
        var x1 = vec[vecOff + i + half]
        vec[vecOff + i] = (x0 * cosv - x1 * sinv) / 1000000
        vec[vecOff + i + half] = (x0 * sinv + x1 * cosv) / 1000000
        i = i + 1
    }
}

// ── sigmoid micro (para silu): sig(x)=1/(1+e^-t), t=x/1e6 ───────────────
// E = e^|t| em MICRO via série: term_k = term_{k-1}×ax/(k×1e6), term0=1e6
// x>0: sig = E/(E+1e6) · x<0: sig = 1e6/(1e6+E)
kofLmSigmoid(Long x): Long {
    var neg = 0
    var ax = x
    if (x < 0) { neg = 1; ax = 0 - x }
    if (ax > 12000000) {
        if (neg == 1) { return 0 }
        return 1000000
    }
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 14) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    var sig: Long = 0
    if (neg == 1) {
        sig = 1000000000000 / (1000000 + E)
    } else {
        sig = E * 1000000 / (E + 1000000)
    }
    if (sig > 1000000) { sig = 1000000 }
    return sig
}

// silu(g)*u micro: g*sig(g)/1e6 × u → /1e6
kofLmSwiglu(Long[] g, Long[] u, Int n): Long[] {
    var out = new Long[n]
    var i = 0
    while (i < n) {
        var sig = kofLmSigmoid(g[i])
        var act = g[i] * sig / 1000000
        out[i] = act * u[i] / 1000000
        i = i + 1
    }
    return out
}

// ── attention single/multi-token com KV cache ───────────────────────────
// scores por q-head: q_h · k_pos / sqrt(headDim); softmax causal; out_h =
// Σ p·v_pos(kv-group(h)). GQA: q head h usa kv head h/(heads/kvHeads).
kofLmAttention(Long[] q, Long[] kc, Long[] vc, Int nPos, Int heads,
              Int kvHeads, Int headDim): Long[] {
    var embd = heads * headDim
    var out = new Long[embd]
    var group = heads / kvHeads
    var scaleDiv = kofLmIsqrt(headDim * 1000000)
    if (scaleDiv <= 0) { scaleDiv = 1 }
    var h = 0
    while (h < heads) {
        var kvh = h / group
        var qOff = h * headDim
        var kvOff = kvh * headDim
        // scores
        var mx: Long = 0 - 900000000000
        var scores = new Long[nPos]
        var p = 0
        while (p < nPos) {
            var acc: Long = 0
            var d = 0
            while (d < headDim) {
                acc = acc + q[qOff + d] * kc[p * (kvHeads * headDim) + kvOff + d]
                d = d + 1
            }
            // q,k micro: produto micro²=1e-12 → /1e6 → micro×micro/1e6
            var sc = acc / scaleDiv / 1000000
            scores[p] = sc
            if (sc > mx) { mx = sc }
            p = p + 1
        }
        // softmax com exp micro
        var sum: Long = 0
        p = 0
        while (p < nPos) {
            var e = kofLmExpMicro(scores[p] - mx)
            scores[p] = e
            sum = sum + e
            p = p + 1
        }
        if (sum <= 0) { sum = 1 }
        // out_h = Σ p·v (v micro): acc 1e6×... /1e6
        var oOff = h * headDim
        p = 0
        while (p < nPos) {
            var wgt = scores[p] * 1000000 / sum
            var d = 0
            while (d < headDim) {
                out[oOff + d] = out[oOff + d] + wgt * vc[p * (kvHeads * headDim) + kvOff + d] / 1000000
                d = d + 1
            }
            p = p + 1
        }
        h = h + 1
    }
    return out
}

// e^((x)/1e6) em MICRO — x micro (diferença de scores, ≤0)
kofLmExpMicro(Long x): Long {
    if (x < 0 - 12000000) { return 0 }
    var ax = 0 - x
    var term: Long = 1000000
    var sum: Long = 1000000
    var kk = 1
    while (kk < 14) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        sum = sum + term
        kk = kk + 1
    }
    return sum
}

// ── forward completo de 1 token (com cache) ─────────────────────────────
// Retorna logits[vocab] micro.
kofLmForward(String path, KofGgufBinModel m, KofLmCfg cfg, Int token, Int pos,
            List<KofLmKv> kvCache): Long[] {
    var xsN = kofGgufDecodeRowsN(path, m, "token_embd.weight", token, 1, cfg.embd)
    // pesos decodificam em NANO; estados circulam em MICRO → /1000
    var xs = new Long[cfg.embd]
    var i = 0
    while (i < cfg.embd) {
        xs[i] = xsN[i] / 1000
        i = i + 1
    }
    var normW = new Long[cfg.embd]
    var l = 0
    while (l < cfg.layers) {
        var attnNorm = kofGgufF32DecodeRows(path, m, "blk." + l + ".attn_norm.weight", 0, 1, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            normW[i] = attnNorm[i]
            i = i + 1
        }
        var h = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
        // q/k/v
        var qW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_q.weight", 0, cfg.embd, cfg.embd)
        var q = kofLmMatvec(qW, h, cfg.embd, cfg.embd)
        var kW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_k.weight", 0, cfg.kvHeads * cfg.headDim, cfg.embd)
        var k = kofLmMatvec(kW, h, cfg.kvHeads * cfg.headDim, cfg.embd)
        var vW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_v.weight", 0, cfg.kvHeads * cfg.headDim, cfg.embd)
        var v = kofLmMatvec(vW, h, cfg.kvHeads * cfg.headDim, cfg.embd)
        // RoPE em q e k (pos atual)
        var hd = 0
        while (hd < cfg.heads) {
            kofLmApplyRope(q, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        hd = 0
        while (hd < cfg.kvHeads) {
            kofLmApplyRope(k, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        // cache
        var kvEnt2 = KofLmKv(k, v)
        kvCache.add(kvEnt2)
        // attention sobre 0..pos (só o próprio k/v quando pos=0)
        var nPos = pos + 1
        var kcache = new Long[nPos * cfg.kvHeads * cfg.headDim]
        var vcache = new Long[nPos * cfg.kvHeads * cfg.headDim]
        var pi = 0
        while (pi < nPos) {
            var kvEnt = kvCache.get(pi)
            var ci = 0
            while (ci < cfg.kvHeads * cfg.headDim) {
                kcache[pi * (cfg.kvHeads * cfg.headDim) + ci] = kvEnt.k[ci]
                vcache[pi * (cfg.kvHeads * cfg.headDim) + ci] = kvEnt.v[ci]
                ci = ci + 1
            }
            pi = pi + 1
        }
        var attn = kofLmAttention(q, kcache, vcache, nPos, cfg.heads,
                                 cfg.kvHeads, cfg.headDim)
        // attn_output
        var oW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_output.weight", 0, cfg.embd, cfg.embd)
        var attno = kofLmMatvec(oW, attn, cfg.embd, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            xs[i] = xs[i] + attno[i]
            i = i + 1
        }
        // FFN
        var ffnNorm = kofGgufF32DecodeRows(path, m, "blk." + l + ".ffn_norm.weight", 0, 1, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            normW[i] = ffnNorm[i]
            i = i + 1
        }
        var h2 = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
        var gW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_gate.weight", 0, cfg.ffn, cfg.embd)
        var g = kofLmMatvec(gW, h2, cfg.ffn, cfg.embd)
        var uW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_up.weight", 0, cfg.ffn, cfg.embd)
        var u = kofLmMatvec(uW, h2, cfg.ffn, cfg.embd)
        var act = u
        var i2 = 0
        while (i2 < cfg.embd) {
            xs[i2] = xs[i2] + act[i2]
            i2 = i2 + 1
        }
        l = l + 1
    }
    var outNorm = kofGgufF32DecodeRows(path, m, "output_norm.weight", 0, 1, cfg.embd)
    i = 0
    while (i < cfg.embd) {
        normW[i] = outNorm[i]
        i = i + 1
    }
    var hf = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
    // lm_head: output.weight Q6_K (2048, 32000) — 32000 linhas de 2048
    var lgW = kofGgufDecodeRowsN(path, m, "output.weight", 0, cfg.vocab, cfg.embd)
    var logits = kofLmMatvec(lgW, hf, cfg.vocab, cfg.embd)
    return logits
}

// argmax dos logits
kofLmArgmax(Long[] logits, Int n): Int {
    var best = 0
    var i = 1
    while (i < n) {
        if (logits[i] > logits[best]) { best = i }
        i = i + 1
    }
    return best
}

// ── smoke: forward 1 token + argmax ─────────────────────────────────────
kofLmForwardSmoke(String path): String {
    var m = kofGgufBinOpen(path)
    if (m.errorCount > 0) {
        return "ERR " + m.errorCode
    }
    var cfg = kofLmCfgFromKv(m)
    var report = "cfg " + cfg.embd + "/" + cfg.layers + "/" + cfg.heads + "/" + cfg.kvHeads
    report = report + " hd=" + cfg.headDim + " ffn=" + cfg.ffn + " vocab=" + cfg.vocab
    var cache = listOf<KofLmKv>()
    var t0 = now()
    var logits = kofLmForward(path, m, cfg, 1, 0, cache)
    var t1 = now()
    var dt = t1 - t0
    var best = kofLmArgmax(logits, cfg.vocab)
    report = report + " tok1→" + best + " in=" + dt + "ms"
    report = report + " lg[max]=" + logits[best] + " lg[0..3]=" + logits[0] + "," + logits[1] + "," + logits[2] + "," + logits[3]
    return report
}

kofLmCfgFromKv(KofGgufBinModel m): KofLmCfg {
    var embd = 0
    var layers = 0
    var heads = 0
    var kvHeads = 0
    var ffn = 0
    var vocab = 0
    var i = 0
    while (i < m.kv.size()) {
        var kv = m.kv.get(i)
        if (kv.key == "llama.embedding_length") { embd = kv.intVal }
        if (kv.key == "llama.block_count") { layers = kv.intVal }
        if (kv.key == "llama.attention.head_count") { heads = kv.intVal }
        if (kv.key == "llama.attention.head_count_kv") { kvHeads = kv.intVal }
        if (kv.key == "llama.feed_forward_length") { ffn = kv.intVal }
        if (kv.key == "llama.vocab_size") { vocab = kv.intVal }
        i = i + 1
    }
    var keyLen = 64
    var ropeDims = 64
    // eps = 1e-5 unidade² → 1e7 micro² (mean de x² em micro²)
    return KofLmCfg(embd, layers, heads, kvHeads, keyLen, ffn, ropeDims, vocab, 10000000)
}

test "level filtering suppresses" {
    var lg = Logger(FixedClock(1000))
    lg.configure(LOG_WARN(), false, false)
    assert(lg.isEnabled(LOG_INFO()) == false)
    assert(lg.write(LOG_INFO(), "hidden") == "")
    var shown = lg.write(LOG_ERROR(), "shown")
    assert(shown.length > 0)
    assert(shown.contains("ERROR"))
}

test "plain format contains fields" {
    var lg = Logger(FixedClock(1234))
    lg.configure(LOG_DEBUG(), false, false)
    lg.setRequestId("req-9")
    var line = lg.info("hello")
    assert(line.contains("1234"))
    assert(line.contains("INFO"))
    assert(line.contains("req-9"))
    assert(line.contains("hello"))
}

test "json format shape" {
    var lg = Logger(FixedClock(55))
    lg.configure(LOG_DEBUG(), false, true)
    var line = lg.error("boom \"x\"")
    assert(line.startsWith("{\"ts\":\"55\""))
    assert(line.contains("\"level\":\"ERROR\""))
    assert(line.contains("boom \\\"x\\\""))
}

test "color codes when enabled" {
    var lg = Logger(FixedClock(1))
    lg.configure(LOG_DEBUG(), true, false)
    var line = lg.warn("careful")
    assert(line.contains("\u001b[33m"))
    assert(line.contains("\u001b[0m"))
}

main() {
}
