WS_T(): String { return "build/tt_ws" }

setupWsT(): ToolCtx {
    mkFile("build/tt_ws/lib.kf", "record Shared(Int v)\n")
    mkFile("build/tt_ws/app.kf", "import Shared\n\nmain() {\n}\n")
    var c = mkCtx()
    c.wsi = WorkspaceIndex(WS_T(), c.bus, FixedClock(5))
    c.wsi.fullRescan()
    return c
}

test "search.text counts occurrences" {
    mkFile("build/tt_ws/hay.kf", "agulha aqui\nagulha la\n")
    var c = setupWsT()
    c.wsi.fullRescan()
    var r = toolExec(defaultRegistry(), c, ToolCall("search.text", "w7", "agulha", "", 0))
    assert(r.status == "ok")
    assert(r.data.contains("hay.kf"))
    assert(r.data.contains("\"count\":2"))
}
main() {
}
