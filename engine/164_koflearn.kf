// E8: KofLearn — modelo de intencao TREINAVEL em Kof puro (int64 fixo, micro
// 1e6). Bag-of-tokens hash + 3 celulas sigmoid (EXECUTE/ASK/REFUSE), SGD
// one-vs-rest. E aprendizado de verdade: pesos iniciam em zero e mudam a
// cada exemplo. Confianca baixa = "nao sei, me ensine" (comportamento
// emergente do treino, nao if de vocabulario).

KFL_NFEAT(): Int { return 8192 }
KFL_MICRO(): Long { return 1000000 }

KFL_EXEC(): Int { return 0 }
KFL_ASK(): Int { return 1 }
KFL_REFUSE(): Int { return 2 }

class KflModel {
    Long[] w = new Long[0]
    Long[] bias = new Long[3]
    Int nfeat = 0

    init(Int n) {
        nfeat = n
        w = new Long[n * 3]
        bias = new Long[3]
    }

    ready(): Bool { return nfeat > 0 && w.length == nfeat * 3 }
}

kflLabelCode(String action): Int {
    if (action == "EXECUTE") {
        return KFL_EXEC()
    }
    if (action == "ASK") {
        return KFL_ASK()
    }
    if (action == "REFUSE") {
        return KFL_REFUSE()
    }
    return 0 - 1
}

kflLabelName(Int c): String {
    if (c == KFL_EXEC()) {
        return "EXECUTE"
    }
    if (c == KFL_ASK()) {
        return "ASK"
    }
    if (c == KFL_REFUSE()) {
        return "REFUSE"
    }
    return "?"
}

// campos "chave":"valor" de uma linha JSONL, respeitando \" escapado
kflJsonField(String line, String key): String {
    var at = line.indexOf("\"" + key + "\"")
    if (at < 0) {
        return ""
    }
    var i = at + key.length + 2
    var n = line.length
    while (i < n && (line.charAt(i) == 32 || line.charAt(i) == 58)) {
        i = i + 1
    }
    if (i >= n || line.charAt(i) != 34) {
        return ""
    }
    i = i + 1
    var out = ""
    while (i < n) {
        var ch = line.charAt(i)
        if (ch == 92) {
            if (i + 1 < n) {
                out = out + line.substring(i + 1, i + 2)
            }
            i = i + 2
        } else {
            if (ch == 34) {
                return out
            }
            out = out + line.substring(i, i + 1)
            i = i + 1
        }
    }
    return out
}

// features: tokens alfanumericos minusculados -> balde djb2 (ctxTextHash, 160)
kflAddFeat(String tok, List<Int> idx) {
    var h = ctxTextHash(tok)
    if (h < 0) {
        h = 0 - h
    }
    idx.add(h % KFL_NFEAT())
}

kflFeatures(String text, List<Int> idx) {
    var toks = retTokenize(text)
    for (var t in toks) {
        var w = retLower(t)
        kflAddFeat(w, idx)
        if (w.length > 3) {
            var i = 0
            while (i + 3 <= w.length) {
                kflAddFeat(w.substring(i, i + 3), idx)
                i = i + 1
            }
        }
    }
}

kflScore(KflModel m, List<Int> idx, Int cls): Long {
    var s = m.bias[cls]
    var i = 0
    while (i < idx.size) {
        s = s + m.w[idx.get(i) * 3 + cls]
        i = i + 1
    }
    return s
}

// um passo SGD; retorna as 3 probabilidades micro em ps (chamador decide)
kflTrainStep(KflModel m, String text, Int label): Long {
    var idx = listOf<Int>()
    kflFeatures(text, idx)
    if (idx.size == 0) {
        return 0
    }
    var n = idx.size
    var top: Long = 0
    var c = 0
    while (c < 3) {
        var p = kofLmSigmoid(kflScore(m, idx, c))
        var one = 0
        if (c == label) {
            one = 1
        }
        var grad = (one * KFL_MICRO() - p) / n
        var dw = grad * 60000 / KFL_MICRO()
        var i = 0
        while (i < n) {
            var at = idx.get(i) * 3 + c
            m.w[at] = m.w[at] + dw
            i = i + 1
        }
        m.bias[c] = m.bias[c] + dw
        if (p > top) {
            top = p
        }
        c = c + 1
    }
    return top
}

kflPredict(KflModel m, String text): Int {
    var idx = listOf<Int>()
    kflFeatures(text, idx)
    var best = KFL_EXEC()
    var bestP = 0 - KFL_MICRO()
    var c = 0
    while (c < 3) {
        var p = kofLmSigmoid(kflScore(m, idx, c))
        if (p > bestP) {
            bestP = p
            best = c
        }
        c = c + 1
    }
    return best
}

kflConfMicro(KflModel m, String text): Long {
    var idx = listOf<Int>()
    kflFeatures(text, idx)
    var top: Long = 0 - KFL_MICRO()
    var seg: Long = 0 - KFL_MICRO()
    var c = 0
    while (c < 3) {
        var p = kofLmSigmoid(kflScore(m, idx, c))
        if (p > top) {
            seg = top
            top = p
        } else {
            if (p > seg) {
                seg = p
            }
        }
        c = c + 1
    }
    if (top - seg < 0) {
        return 0
    }
    return top - seg
}

// treina um arquivo jsonl (campos instruction + action); retorna exemplos vistos
kflTrainFile(KflModel m, String path, Int epochs): Int {
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return 0
    }
    var seen = 0
    var e = 0
    while (e < epochs) {
        var txt = f.readText()
        var pos = 0
        while (pos < txt.length) {
            var nl = txt.indexOf("\n", pos)
            var ln = ""
            if (nl < 0) {
                ln = txt.substring(pos, txt.length)
                pos = txt.length
            } else {
                ln = txt.substring(pos, nl)
                pos = nl + 1
            }
            var lab = kflLabelCode(kflJsonField(ln, "action"))
            var ins = kflJsonField(ln, "instruction")
            if (lab >= 0 && ins.length > 0) {
                kflTrainStep(m, ins, lab)
                seen = seen + 1
            }
        }
        e = e + 1
    }
    return seen
}

// eval rotulado (instruction + expected_action): acc, chute errado, nao-sei
kflEvalFile(KflModel m, String path, Int confMinMilli): String {
    var f = File(path)
    if (!f.exists() || !m.ready()) {
        return "ERR"
    }
    var total = 0
    var okc = 0
    var chute = 0
    var perguntou = 0
    var txt = f.readText()
    var pos = 0
    while (pos < txt.length) {
        var nl = txt.indexOf("\n", pos)
        var ln = ""
        if (nl < 0) {
            ln = txt.substring(pos, txt.length)
            pos = txt.length
        } else {
            ln = txt.substring(pos, nl)
            pos = nl + 1
        }
        var ea = kflJsonField(ln, "expected_action")
        if (ea == "") {
            ea = kflJsonField(ln, "action")
        }
        var gold = kflLabelCode(ea)
        var ins = kflJsonField(ln, "instruction")
        if (gold >= 0 && ins.length > 0) {
            total = total + 1
            var pred = kflPredict(m, ins)
            var conf = kflConfMicro(m, ins) * 1000 / KFL_MICRO()
            if (conf < confMinMilli) {
                perguntou = perguntou + 1
                if (gold == KFL_ASK()) {
                    okc = okc + 1
                }
            } else {
                if (pred != gold && gold != KFL_ASK()) {
                    chute = chute + 1
                }
                if (pred == gold) {
                    okc = okc + 1
                }
            }
        }
    }
    var accPct = 0
    if (total > 0) {
        accPct = okc * 100 / total
    }
    var chutePct = 0
    if (total > 0) {
        chutePct = chute * 100 / total
    }
    return "total=" + total + " acc=" + accPct + "% chute=" + chutePct + "% perguntou=" + perguntou
}

kflSerialize(KflModel m): String {
    var out = ""
    var i = 0
    while (i < m.w.length) {
        out = out + m.w[i]
        if (i + 1 < m.w.length) {
            out = out + ","
        }
        i = i + 1
    }
    out = out + ";" + m.bias[0] + "," + m.bias[1] + "," + m.bias[2]
    return out
}

kflLoadModel(String path): KflModel {
    var m = KflModel()
    var body = wsReadVersioned(path, "KFLR")
    if (body == "") {
        return m
    }
    var sp = splitStr(body, ";")
    if (sp.size() != 2) {
        return m
    }
    var ws = splitStr(sp.get(0), ",")
    var bs = splitStr(sp.get(1), ",")
    if (bs.size() != 3) {
        return m
    }
    m.init(ws.size() / 3)
    var i = 0
    while (i < ws.size() && i < m.w.length) {
        m.w[i] = parseLongSafe(ws.get(i))
        i = i + 1
    }
    m.bias[0] = parseLongSafe(bs.get(0))
    m.bias[1] = parseLongSafe(bs.get(1))
    m.bias[2] = parseLongSafe(bs.get(2))
    return m
}

kflSaveModel(String path, KflModel m): Bool {
    return wsWriteVersioned(path, "KFLR", 1, kflSerialize(m))
}

// colheu exemplo que ele nao soube classificar — insumo do proximo treino
kflHarvest(String root, String text, Int pred, Long confMilli) {
    var path = joinPath(root, "datasets/jsonl/koflm-errors.jsonl")
    var line = "{\"instruction\":\"" + escapeJson(text) + "\",\"predicted\":\"" + kflLabelName(pred) + "\",\"confidence\":" + confMilli + ",\"action\":\"\"}"
    var f = File(path)
    if (!f.exists()) {
        mkFile(path, line + "\n")
        return
    }
    f.appendText(line + "\n")
}

// ---- KFLQ v1: pesos int8 por classe (quantizacao simetrica por amax de classe).
// Layout: 'KFLQ'(4) ver(1) nfeat i32(4) scales 3xi64(24) bias 3xi64(24) crc i32(4)
//         pesos (nfeat*3) int8 LE-ish. ~24.6KB p/ 8192 features.

kflqPutI32(Int[] b, Int at, Int v) {
    b[at] = v & 255
    b[at + 1] = (v / 256) & 255
    b[at + 2] = (v / 65536) & 255
    b[at + 3] = (v / 16777216) & 255
}

kflqGetI32(Int[] b, Int at): Int {
    return b[at] + b[at + 1] * 256 + b[at + 2] * 65536 + b[at + 3] * 16777216
}

kflqPutI64(Int[] b, Int at, Long v) {
    var x = v
    var i = 0
    while (i < 8) {
        var by = x - (x / 256) * 256
        if (by < 0) {
            by = by + 256
        }
        b[at + i] = by
        x = (x - by) / 256
        i = i + 1
    }
}

kflqGetI64(Int[] b, Int at): Long {
    var acc: Long = b[at + 7]
    if (acc > 127) {
        acc = acc - 256
    }
    var i = 6
    while (i >= 0) {
        acc = acc * 256 + b[at + i]
        i = i - 1
    }
    return acc
}

kflqCrc(Int[] b, Int from, Int n): Int {
    var h = 0 - 2128831035
    var i = 0
    while (i < n) {
        h = (h * 31 + b[from + i]) & 2147483647
        i = i + 1
    }
    return h
}

kflqQuantizeLong(Long w, Long scale): Long {
    var s = scale
    if (s <= 0) {
        return 0
    }
    if (w >= 0) {
        var q = (2 * w + s) / (2 * s)
        if (q > 127) {
            q = 127
        }
        return q
    }
    var nq = (0 - (2 * (0 - w) + s)) / (2 * s)
    if (nq < 0 - 128) {
        nq = 0 - 128
    }
    return nq
}

kflQuantSaveDbg(String path, KflModel m): Int {
    var n = m.w.length
    var amax0: Long = 0
    var amax1: Long = 0
    var amax2: Long = 0
    var i = 0
    while (i < n) {
        var a = m.w[i]
        if (a < 0) {
            a = 0 - a
        }
        var cls = i - (i / 3) * 3
        if (cls == 0) {
            if (a > amax0) { amax0 = a }
        } else if (cls == 1) {
            if (a > amax1) { amax1 = a }
        } else {
            if (a > amax2) { amax2 = a }
        }
        i = i + 1
    }
    var s0 = (amax0 + 126) / 127
    var s1 = (amax1 + 126) / 127
    var s2 = (amax2 + 126) / 127
    if (s0 <= 0) { s0 = 1 }
    if (s1 <= 0) { s1 = 1 }
    if (s2 <= 0) { s2 = 1 }
    var hdr = 61
    var b = new Int[hdr + n]
    b[0] = 75
    b[1] = 70
    b[2] = 76
    b[3] = 81
    b[4] = 1
    kflqPutI32(b, 5, m.nfeat)
    kflqPutI64(b, 9, s0)
    kflqPutI64(b, 17, s1)
    kflqPutI64(b, 25, s2)
    kflqPutI64(b, 33, m.bias[0])
    kflqPutI64(b, 41, m.bias[1])
    kflqPutI64(b, 49, m.bias[2])
    var bad = 0
    i = 0
    while (i < 61) {
        if (b[i] < 0 || b[i] > 255) { bad = i + 1000 }
        i = i + 1
    }
    if (bad != 0) { return bad }
    i = 0
    while (i < n) {
        var cls2 = i - (i / 3) * 3
        var sc = s0
        if (cls2 == 1) {
            sc = s1
        } else if (cls2 == 2) {
            sc = s2
        }
        var q = kflqQuantizeLong(m.w[i], sc)
        if (q < 0) {
            q = q + 256
        }
        if (q < 0 || q > 255) {
            return 2000 + (i - (i / 1000) * 1000)
        }
        b[hdr + i] = q
        i = i + 1
    }
    var crc = kflqCrc(b, hdr, n)
    kflqPutI32(b, 57, crc)
    var f = File(path)
    if (!f.writeBytes(b)) {
        return 9
    }
    return 0
}

kflQuantSave(String path, KflModel m): Bool {
    var n = m.w.length
    var amax0: Long = 0
    var amax1: Long = 0
    var amax2: Long = 0
    var i = 0
    while (i < n) {
        var a = m.w[i]
        if (a < 0) {
            a = 0 - a
        }
        var cls = i - (i / 3) * 3
        if (cls == 0) {
            if (a > amax0) { amax0 = a }
        } else if (cls == 1) {
            if (a > amax1) { amax1 = a }
        } else {
            if (a > amax2) { amax2 = a }
        }
        i = i + 1
    }
    var s0 = (amax0 + 126) / 127
    var s1 = (amax1 + 126) / 127
    var s2 = (amax2 + 126) / 127
    if (s0 <= 0) { s0 = 1 }
    if (s1 <= 0) { s1 = 1 }
    if (s2 <= 0) { s2 = 1 }
    var hdr = 61
    var b = new Int[hdr + n]
    b[0] = 75
    b[1] = 70
    b[2] = 76
    b[3] = 81
    b[4] = 1
    kflqPutI32(b, 5, m.nfeat)
    kflqPutI64(b, 9, s0)
    kflqPutI64(b, 17, s1)
    kflqPutI64(b, 25, s2)
    kflqPutI64(b, 33, m.bias[0])
    kflqPutI64(b, 41, m.bias[1])
    kflqPutI64(b, 49, m.bias[2])
    i = 0
    while (i < n) {
        var cls2 = i - (i / 3) * 3
        var sc = s0
        if (cls2 == 1) {
            sc = s1
        } else if (cls2 == 2) {
            sc = s2
        }
        var q = kflqQuantizeLong(m.w[i], sc)
        if (q < 0) {
            q = q + 256
        }
        b[hdr + i] = q
        i = i + 1
    }
    var crc = kflqCrc(b, hdr, n)
    kflqPutI32(b, 57, crc)
    var f = File(path)
    return f.writeBytes(b)
}

kflQuantLoad(String path): KflModel {
    var m = KflModel()
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return m
    }
    var hb = f.readRange(0, 61)
    if (hb.length < 61 || hb[0] != 75 || hb[1] != 70 || hb[2] != 76 || hb[3] != 81) {
        return m
    }
    var nfeat = kflqGetI32(hb, 5)
    if (nfeat <= 0 || nfeat > 16777216) {
        return m
    }
    m.init(nfeat)
    var s0 = kflqGetI64(hb, 9)
    var s1 = kflqGetI64(hb, 17)
    var s2 = kflqGetI64(hb, 25)
    m.bias[0] = kflqGetI64(hb, 33)
    m.bias[1] = kflqGetI64(hb, 41)
    m.bias[2] = kflqGetI64(hb, 49)
    var n = nfeat * 3
    var wb = f.readRange(61, n)
    if (wb.length < n) {
        return KofLmEmptyKfl()
    }
    if (kflqCrc(wb, 0, n) != kflqGetI32(hb, 57)) {
        return KofLmEmptyKfl()
    }
    var i = 0
    while (i < n) {
        var q = wb[i]
        if (q > 127) {
            q = q - 256
        }
        var cls = i - (i / 3) * 3
        var sc = s0
        if (cls == 1) {
            sc = s1
        } else if (cls == 2) {
            sc = s2
        }
        m.w[i] = q * sc
        i = i + 1
    }
    return m
}

KofLmEmptyKfl(): KflModel {
    return KflModel()
}

// concordancia de previsao (por mil) entre dois pesos sobre o mesmo corpus
kflqAgreement(KflModel a, KflModel b, String path): Long {
    var f = File(path)
    if (!f.exists()) {
        return 0
    }
    var txt = f.readText()
    var pos = 0
    var n = 0
    var same = 0
    while (pos < txt.length) {
        var ln = ""
        var nl = txt.indexOf("\n", pos)
        if (nl < 0) {
            ln = txt.substring(pos, txt.length)
            pos = txt.length
        } else {
            ln = txt.substring(pos, nl)
            pos = nl + 1
        }
        if (ln.length > 12) {
            var ins = kflJsonField(ln, "instruction")
            if (ins.length > 0) {
                n = n + 1
                if (kflPredict(a, ins) == kflPredict(b, ins)) {
                    same = same + 1
                }
            }
        }
    }
    if (n == 0) {
        return 0
    }
    return same * 1000 / n
}
