GGDBG(s: String) {
    File("/tmp/opencode/p2.log").appendText(s + "\n")
}

Int kofGgufBufLen(Int[] b): Int {
    if (b == null) { return 0 - 1 }
    return b.length
}

main() {
    File("/tmp/opencode/p2.log").writeText("pre\n")
    var m = kofGgufBinOpen("/home/mel/Downloads/kof-data/models/TinyLlama-Q4_K_M.gguf")
    GGDBG("done err=" + m.errorCount + " code=" + m.errorCode + " tens=" + m.tensors.size())
}
