test "runtime validates good dag" {
    var b = EventBus()
    var rt = AgentRuntime(b, RealTimeClock())
    var nodes = listOf<PlanNode>()
    nodes.add(PlanNode("fetch", 0, -1))
    nodes.add(PlanNode("parse", 1, 0))
    assert(rt.dryRun(nodes))
}

test "runtime rejects bad dag" {
    var b = EventBus()
    var rt = AgentRuntime(b, RealTimeClock())
    var nodes = listOf<PlanNode>()
    nodes.add(PlanNode("a", 0, 5))
    assert(!rt.dryRun(nodes))
}

test "run executes plan end to end" {
    var b = EventBus()
    var rt = AgentRuntime(b, RealTimeClock())
    var nodes = listOf<PlanNode>()
    nodes.add(PlanNode("t1", 0, -1))
    var r = rt.runPlan(nodes, OrchTool(1, 1, 100, 0))
    assert(r.failedSteps == 0)
}

test "journal records steps" {
    var b = EventBus()
    var rt = AgentRuntime(b, RealTimeClock())
    var nodes = listOf<PlanNode>()
    nodes.add(PlanNode("j1", 0, -1))
    rt.runPlan(nodes, OrchTool(1, 1, 100, 0))
    assert(rt.journalSize() >= 3)
}

test "cancel stops run" {
    var b = EventBus()
    var rt = AgentRuntime(b, RealTimeClock())
    rt.cancelRun()
    var nodes = listOf<PlanNode>()
    nodes.add(PlanNode("x", 0, -1))
    var r = rt.runPlan(nodes, OrchTool(1, 1, 100, 0))
    assert(r.steps == 0)
}

test "stream emits start and final" {
    var b = EventBus()
    var rt = AgentRuntime(b, RealTimeClock())
    var nodes = listOf<PlanNode>()
    nodes.add(PlanNode("s1", 0, -1))
    var evs = rt.streamRun(nodes, OrchTool(1, 1, 100, 0))
    var n = evs.size()
    assert(n == 2)
}
