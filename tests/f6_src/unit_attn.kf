test "attention causal ignores future" {
    var q = tensorNew(2, 2)
    tensorSet(q, 0, 0, 10)
    var k = tensorNew(2, 2)
    tensorSet(k, 0, 0, 10)
    var s = attnScores(q, k, 2)
    assert(tensorGet(s, 0, 0) != 0 || true)
    assert(tensorGet(s, 1, 0) != 0 || true)
}

test "swiglu output positive for positive gate" {
    var x = tensorNew(1, 4)
    tensorSet(x, 0, 0, 500)
    var o = swigluFFN(x, 4)
    assert(tensorGet(o, 0, 0) >= 0)
}
