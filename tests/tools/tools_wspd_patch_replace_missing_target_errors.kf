WS_T(): String { return "build/tt_ws" }

setupWsT(): ToolCtx {
    mkFile("build/tt_ws/lib.kf", "record Shared(Int v)\n")
    mkFile("build/tt_ws/app.kf", "import Shared\n\nmain() {\n}\n")
    var c = mkCtx()
    c.wsi = WorkspaceIndex(WS_T(), c.bus, FixedClock(5))
    c.wsi.fullRescan()
    return c
}

test "patch.replace missing target errors" {
    mkFile("build/tt_ws/rep2.txt", "abc\n")
    var res = toolExec(defaultRegistry(), setupWsTPatch(), ToolCall("patch.replace", "w10", "build/tt_ws/rep2.txt", "zzz|y"))
    assert(res.status == "error")
    assert(res.data.contains("PATCH-TARGET-MISSING"))
}
main() {
}
