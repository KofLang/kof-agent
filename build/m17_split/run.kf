record CheckRec(String id, Bool ok, String detail)

interface TimeSource {
    nowMs(): Long
}

class FixedClock implements TimeSource {
    Long value = 0
    constructor(Long v) {
        value = v
    }
    nowMs(): Long {
        return value
    }
    advance(Long ms) {
        value = value + ms
    }
}

parseIntStr(String s): Int {
    var n = 0
    var i = 0
    if (s.length == 0) {
        throw "parse: empty integer"
    }
    var start = 0
    if (s.charAt(0) == 45) {
        start = 1
        if (s.length == 1) {
            throw "parse: invalid integer '" + s + "'"
        }
    }
    i = start
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < 48 || c > 57) {
            throw "parse: invalid integer '" + s + "'"
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if (start == 1) {
        n = 0 - n
    }
    return n
}

parseBoolStr(String s): Bool {
    var v = s.toLowerCase()
    if (v == "true" || v == "1" || v == "yes" || v == "on") {
        return true
    }
    if (v == "false" || v == "0" || v == "no" || v == "off" || v == "") {
        return false
    }
    throw "parse: invalid boolean '" + s + "'"
}

escapeJson(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 34) {
            out = out + "\\\""
        } else if (c == 92) {
            out = out + "\\\\"
        } else if (c == 10) {
            out = out + "\\n"
        } else if (c == 13) {
            out = out + "\\r"
        } else if (c == 9) {
            out = out + "\\t"
        } else {
            out = out + s.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

joinPath(String a, String b): String {
    if (a == "") {
        return b
    }
    if (a.substring(a.length - 1, a.length) == "/") {
        return a + b
    }
    return a + "/" + b
}

splitStr(String s, String sep): List<String> {
    var out = listOf<String>()
    if (s.length == 0) {
        return out
    }
    var sc = sep.charAt(0)
    var start = 0
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == sc) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, s.length))
    return out
}

loadArgsFile(String path): List<String> {
    var argv = listOf<String>()
    var f = File(path)
    if (!f.exists()) {
        return argv
    }
    var txt = f.readText()
    var lines = splitStr(txt, "\n")
    for (var line in lines) {
        var t = line.trim()
        if (t.length > 0) {
            argv.add(t)
        }
    }
    return argv
}

sortInts(Int[] a, Int n) {
    var i = 1
    while (i < n) {
        var key = a[i]
        var j = i - 1
        var placed = false
        while (!placed) {
            if (j < 0) {
                placed = true
            } else {
                if (a[j] > key) {
                    a[j + 1] = a[j]
                    j = j - 1
                } else {
                    placed = true
                }
            }
        }
        a[j + 1] = key
        i = i + 1
    }
}

mkFile(String path, String content): Bool {
    var parent = ""
    var parts = splitStr(path, "/")
    if (parts.size > 1) {
        var i = 0
        while (i < parts.size - 1) {
            if (parent == "") {
                parent = parts.get(i)
            } else {
                parent = joinPath(parent, parts.get(i))
            }
            i = i + 1
        }
        var d = Directory(parent)
        if (!d.exists()) {
            d.createDirectories()
        }
    }
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
    return f.writeText(content)
}

class EventCounter implements EventHandler {
    Int count = 0
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        count = count + 1
        return true
    }
}

class RecordingHandler implements EventHandler {
    List<String> seen = listOf<String>()
    constructor() {
    }
    onEvent(EventEnvelope e): Bool {
        seen.add(e.topic + "=" + e.payload)
        return true
    }
}

freshBus(): EventBus {
    return EventBus()
}

record CfgEntry(String key, String value)

class Config {
    List<CfgEntry> entries = listOf<CfgEntry>()
    String sourcePath = ""
    Bool loaded = false

    loadFile(String path): Bool {
        entries = listOf<CfgEntry>()
        sourcePath = path
        var f = File(path)
        if (!f.exists()) {
            loaded = false
            return false
        }
        if (!f.isFile()) {
            loaded = false
            return false
        }
        var text = f.readText()
        parseInto(text)
        loaded = true
        return true
    }

    reload(): Bool {
        return loadFile(sourcePath)
    }

    parseInto(String text) {
        var lines = splitStr(text, "\n")
        for (var raw in lines) {
            var line = raw.trim()
            if (line.length > 0) {
                if (!line.startsWith("#")) {
                    var kv = splitStr(line, "=")
                    if (kv.size == 2) {
                        var k = kv.get(0).trim()
                        var v = kv.get(1).trim()
                        entries.add(CfgEntry(k, v))
                    }
                }
            }
        }
    }

    has(String key): Bool {
        for (var e in entries) {
            if (e.key == key) {
                return true
            }
        }
        return false
    }

    getRaw(String key): String {
        for (var e in entries) {
            if (e.key == key) {
                return e.value
            }
        }
        throw "config: missing key '" + key + "'"
    }

    getStr(String key, String def): String {
        if (!has(key)) {
            return def
        }
        return getRaw(key)
    }

    getInt(String key, Int def): Int {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseIntStr(v)
        } catch (String e) {
            throw "config: invalid integer for '" + key + "': '" + v + "'"
        }
    }

    getBool(String key, Bool def): Bool {
        if (!has(key)) {
            return def
        }
        var v = getRaw(key)
        try {
            return parseBoolStr(v)
        } catch (String e) {
            throw "config: invalid boolean for '" + key + "': '" + v + "'"
        }
    }

    snapshotJson(): String {
        var out = "{\"source\":\"" + escapeJson(sourcePath) + "\",\"loaded\":"
        if (loaded) {
            out = out + "true"
        } else {
            out = out + "false"
        }
        out = out + ",\"entries\":["
        var first = true
        for (var e in entries) {
            if (!first) {
                out = out + ","
            }
            first = false
            out = out + "{\"key\":\"" + escapeJson(e.key) + "\",\"value\":\"" + escapeJson(e.value) + "\"}"
        }
        out = out + "]}"
        return out
    }
}

TASK_CREATED(): Int { return 0 }
TASK_QUEUED(): Int { return 1 }
TASK_RUNNING(): Int { return 2 }
TASK_WAITING(): Int { return 3 }
TASK_COMPLETED(): Int { return 4 }
TASK_CANCELLED(): Int { return 5 }
TASK_FAILED(): Int { return 6 }

taskStateName(Int st): String {
    if (st == TASK_CREATED()) { return "CREATED" }
    if (st == TASK_QUEUED()) { return "QUEUED" }
    if (st == TASK_RUNNING()) { return "RUNNING" }
    if (st == TASK_WAITING()) { return "WAITING" }
    if (st == TASK_COMPLETED()) { return "COMPLETED" }
    if (st == TASK_CANCELLED()) { return "CANCELLED" }
    return "FAILED"
}

interface ContextView {
    incMetric(String name)
}

interface TaskBody {
    run(ContextView v)
}

class Future {
    Bool done = false
    Bool ok = false
    Int result = 0
    String error = ""
    constructor() {
    }
}

class TaskNode {
    Int id
    Int priority
    Int seq
    String name
    Int st = TASK_CREATED()
    Bool cancelled = false
    TaskBody body
    constructor(Int tid, Int prio, Int sq, String nm, TaskBody b) {
        id = tid
        priority = prio
        seq = sq
        name = nm
        body = b
    }
}

class FutureJob implements TaskBody {
    TaskBody inner
    Future future
    constructor(TaskBody i, Future f) {
        inner = i
        future = f
    }
    run(ContextView v) {
        try {
            inner.run(v)
            future.ok = true
        } catch (String e) {
            future.error = e
            throw e
        } finally {
            future.done = true
        }
    }
}

class Scheduler {
    List<TaskNode> tasks = listOf<TaskNode>()
    Int[] heapPrio = new Int[64]
    Int[] heapSeq = new Int[64]
    Int[] heapIdx = new Int[64]
    Int heapSize = 0
    Int heapCap = 64
    Int nextId = 1
    Int nextSeq = 1
    Int maxPending = 0
    Bool accepting = true
    Int launchedCount = 0
    Int completedCount = 0
    Int failedCount = 0
    Int cancelledCount = 0
    Int rejectedCount = 0
    String lastError = ""
    ContextView view

    constructor(ContextView v) {
        view = v
    }

    ensureCap(Int need) {
        if (need <= heapCap) {
            return
        }
        var nc = heapCap * 2
        while (nc < need) {
            nc = nc * 2
        }
        var np = new Int[nc]
        var ns = new Int[nc]
        var ni = new Int[nc]
        var i = 0
        while (i < heapSize) {
            np[i] = heapPrio[i]
            ns[i] = heapSeq[i]
            ni[i] = heapIdx[i]
            i = i + 1
        }
        heapPrio = np
        heapSeq = ns
        heapIdx = ni
        heapCap = nc
    }

    lessThan(Int a, Int b): Bool {
        if (heapPrio[a] > heapPrio[b]) {
            return true
        }
        if (heapPrio[a] < heapPrio[b]) {
            return false
        }
        return heapSeq[a] < heapSeq[b]
    }

    swapAt(Int a, Int b) {
        var tp = heapPrio[a]
        heapPrio[a] = heapPrio[b]
        heapPrio[b] = tp
        var ts = heapSeq[a]
        heapSeq[a] = heapSeq[b]
        heapSeq[b] = ts
        var ti = heapIdx[a]
        heapIdx[a] = heapIdx[b]
        heapIdx[b] = ti
    }

    heapPush(Int taskIndex) {
        ensureCap(heapSize + 1)
        var i = heapSize
        heapPrio[i] = tasks.get(taskIndex).priority
        heapSeq[i] = tasks.get(taskIndex).seq
        heapIdx[i] = taskIndex
        heapSize = heapSize + 1
        while (i > 0) {
            var parent = (i - 1) / 2
            if (lessThan(i, parent)) {
                swapAt(i, parent)
                i = parent
            } else {
                break
            }
        }
    }

    heapPop(): Int {
        var top = heapIdx[0]
        heapSize = heapSize - 1
        if (heapSize > 0) {
            heapPrio[0] = heapPrio[heapSize]
            heapSeq[0] = heapSeq[heapSize]
            heapIdx[0] = heapIdx[heapSize]
            var i = 0
            while (true) {
                var l = i * 2 + 1
                var r = l + 1
                var m = i
                if (l < heapSize) {
                    if (lessThan(l, m)) {
                        m = l
                    }
                }
                if (r < heapSize) {
                    if (lessThan(r, m)) {
                        m = r
                    }
                }
                if (m == i) {
                    break
                }
                swapAt(i, m)
                i = m
            }
        }
        return top
    }

    launch(TaskBody body, String name, Int priority): Int {
        if (!accepting) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: rejecting launch after shutdown"
        }
        if (maxPending > 0 && heapSize >= maxPending) {
            rejectedCount = rejectedCount + 1
            throw "scheduler: backpressure (pending=" + heapSize + ", max=" + maxPending + ")"
        }
        var node = TaskNode(nextId, priority, nextSeq, name, body)
        nextId = nextId + 1
        nextSeq = nextSeq + 1
        node.st = TASK_QUEUED()
        tasks.add(node)
        heapPush(tasks.size - 1)
        launchedCount = launchedCount + 1
        return node.id
    }

    launchFuture(TaskBody body, String name, Int priority): Future {
        var f = Future()
        var wrapped = FutureJob(body, f)
        launch(wrapped, name, priority)
        return f
    }

    cancel(Int taskId): Bool {
        var idx = taskId - 1
        if (idx < 0 || idx >= tasks.size) {
            return false
        }
        var node = tasks.get(idx)
        if (node.st == TASK_QUEUED() && !node.cancelled) {
            node.cancelled = true
            node.st = TASK_CANCELLED()
            cancelledCount = cancelledCount + 1
            return true
        }
        return false
    }

    executeOne(): Bool {
        if (heapSize == 0) {
            return false
        }
        var idx = heapPop()
        var node = tasks.get(idx)
        if (node.cancelled || node.st == TASK_CANCELLED()) {
            return true
        }
        node.st = TASK_RUNNING()
        try {
            node.body.run(view)
            node.st = TASK_COMPLETED()
            completedCount = completedCount + 1
        } catch (String e) {
            node.st = TASK_FAILED()
            failedCount = failedCount + 1
            lastError = e
        }
        return true
    }

    run(Int maxTasks): Int {
        var n = 0
        while (n < maxTasks) {
            if (!executeOne()) {
                break
            }
            n = n + 1
        }
        return n
    }

    drain() {
        while (executeOne()) {
        }
    }

    await(Future f) {
        while (!f.done) {
            if (heapSize == 0) {
                throw "scheduler: deadlock in await (future unresolved, queue empty)"
            }
            executeOne()
        }
    }

    pending(): Int {
        return heapSize
    }

    gracefulShutdown() {
        accepting = false
        drain()
    }

    statsJson(): String {
        return "{\"pending\":" + heapSize + ",\"launched\":" + launchedCount + ",\"completed\":" + completedCount + ",\"failed\":" + failedCount + ",\"cancelled\":" + cancelledCount + ",\"rejected\":" + rejectedCount + ",\"accepting\":" + accepting + "}"
    }
}

class WorkerPool {
    Int size = 1
    Scheduler sched
    String affinityHint = ""

    constructor(Scheduler s, Int n) {
        sched = s
        if (n != 1) {
            throw "TP001: worker pool size " + n + " unsupported on this target (upstream CONC001); use 1"
        }
        size = n
    }

    launch(TaskBody body, String name): Int {
        return sched.launch(body, name, 5)
    }

    dynamicResize(Int n) {
        throw "TP001: dynamic pool resize unsupported on this target (upstream CONC001)"
    }

    setAffinity(String hint) {
        throw "TP002: affinity unsupported on this target"
    }
}

record EventEnvelope(String topic, String payload, Int seq)

interface EventHandler {
    onEvent(EventEnvelope e): Bool
}

class Subscription {
    Int id
    String topic
    EventHandler h
    Bool once = false
    constructor(Int sid, String t, EventHandler handler, Bool onceFlag) {
        id = sid
        topic = t
        h = handler
        once = onceFlag
    }
}

class EventBus {
    List<Subscription> subs = listOf<Subscription>()
    Int nextId = 1
    Int seq = 1

    subscribe(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, false)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    once(String topic, EventHandler h): Int {
        var s = Subscription(nextId, topic, h, true)
        nextId = nextId + 1
        subs.add(s)
        return s.id
    }

    unsubscribe(Int id): Bool {
        var i = 0
        while (i < subs.size) {
            if (subs.get(i).id == id) {
                subs.remove(i)
                return true
            }
            i = i + 1
        }
        return false
    }

    publishEnvelope(EventEnvelope e): Int {
        var matched = listOf<Int>()
        var i = 0
        while (i < subs.size) {
            var s = subs.get(i)
            if (s.topic == e.topic || s.topic == "*") {
                matched.add(i)
            }
            i = i + 1
        }
        var called = 0
        for (var m in matched) {
            var sub = subs.get(m)
            if (sub.once) {
                unsubscribe(sub.id)
            }
            called = called + 1
            var cont = sub.h.onEvent(e)
            if (!cont) {
                break
            }
        }
        return called
    }

    publish(String topic, String payload): Int {
        var env = EventEnvelope(topic, payload, seq)
        seq = seq + 1
        return publishEnvelope(env)
    }

    broadcast(String payload): Int {
        return publish("*", payload)
    }

    publishAsync(Scheduler sched, ContextView view, String topic, String payload): Int {
        var job = PublishJob(this, topic, payload)
        return sched.launch(job, "event.publish", 5)
    }

    statsJson(): String {
        return "{\"subscribers\":" + subs.size + ",\"published\":" + (seq - 1) + "}"
    }
}

class PublishJob implements TaskBody {
    EventBus bus
    String topic
    String payload
    constructor(EventBus b, String t, String p) {
        bus = b
        topic = t
        payload = p
    }
    run(ContextView v) {
        bus.publish(topic, payload)
    }
}

class WorkspaceReport {
    String root = ""
    Bool valid = false
    Bool hasGit = false
    Bool hasConfigFile = false
    Bool hasCacheDir = false
    Int kfFiles = 0
    Int totalEntries = 0
    Int ignoreRules = 0
    String detail = ""
}

countKfFiles(String dir, Int depth): Int {
    if (depth > 3) {
        return 0
    }
    var d = Directory(dir)
    if (!d.exists() || !d.isDirectory()) {
        return 0
    }
    var names = d.list()
    var n = 0
    for (var name in names) {
        var child = joinPath(dir, name)
        var f = File(child)
        if (f.isFile()) {
            if (name.length >= 3) {
                var ext = name.substring(name.length - 3, name.length)
                if (ext == ".kf") {
                    n = n + 1
                }
            }
        } else if (f.isDirectory()) {
            if (name != ".git") {
                n = n + countKfFiles(child, depth + 1)
            }
        }
    }
    return n
}

listTopEntries(String dir): Int {
    var d = Directory(dir)
    if (!d.exists() || !d.isDirectory()) {
        return 0
    }
    var names = d.list()
    return names.size
}

scanWorkspace(String root): WorkspaceReport {
    var r = WorkspaceReport()
    r.root = root
    var d = Directory(root)
    if (!d.exists()) {
        r.valid = false
        r.detail = "root does not exist"
        return r
    }
    if (!d.isDirectory()) {
        r.valid = false
        r.detail = "root is not a directory"
        return r
    }
    r.valid = true
    r.detail = "ok"
    var gitDir = Directory(joinPath(root, ".git"))
    r.hasGit = gitDir.exists()
    var cfgFile = File(joinPath(root, "kof.config"))
    r.hasConfigFile = cfgFile.exists()
    var cacheDir = Directory(joinPath(root, "build"))
    r.hasCacheDir = cacheDir.exists()
    r.kfFiles = countKfFiles(root, 1)
    r.totalEntries = listTopEntries(root)
    var gi = File(joinPath(root, ".gitignore"))
    if (gi.exists() && gi.isFile()) {
        var txt = gi.readText()
        var lines = splitStr(txt, "\n")
        for (var raw in lines) {
            var line = raw.trim()
            if (line.length > 0) {
                var first = line.substring(0, 1)
                if (first != "#") {
                    r.ignoreRules = r.ignoreRules + 1
                }
            }
        }
    }
    return r
}

WS_IDX_VERSION(): Int { return 3 }

WsSnapEmpty(): WsSnap {
    return WsSnap()
}


WS_MAGIC_A(): Int { return 87 }
WS_MAGIC_B(): Int { return 83 }
WS_MAGIC_C(): Int { return 73 }
WS_MAGIC_D(): Int { return 88 }

record WsFileRec(String path, Int hash, Int sizeChars)
record WsSymRec(String name, String kind, String file)
record WsImpRec(String file, String name)
record WsEdgeRec(String from, String to)
record WsGitRec(String branch, String commit)
class WsSnap {
    String workspaceId = ""
    String root = ""
    String gitBranch = ""
    String gitCommit = ""
    String target = ""
    Long timestamp = 0
    List<WsFileRec> files = listOf<WsFileRec>()
    List<WsSymRec> symbols = listOf<WsSymRec>()
    List<WsImpRec> imports = listOf<WsImpRec>()
    List<WsEdgeRec> deps = listOf<WsEdgeRec>()
    constructor() {
    }
}

record WsParsedRec(String path, Int hash, String pkg, List<String> imports, List<WsSymRec> syms)
record WsDiffRec(List<String> added, List<String> modified, List<String> deleted, List<String> renamedOld, List<String> renamedNew, List<String> symAdded, List<String> symRemoved)
record WsDiagRec(String file, Int hash, Int diagCount, String codes)

wsHash(String s): Int {
    var h = 5381
    var i = 0
    while (i < s.length) {
        h = h * 33 + s.charAt(i)
        i = i + 1
    }
    return h
}

wsSanitize(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 1 || c == 2 || c == 3) {
            out = out + "?"
        } else {
            out = out + s.substring(i, i + 1)
        }
        i = i + 1
    }
    return out
}

wsJoin(List<String> xs, String sep): String {
    var out = ""
    var first = true
    for (var x in xs) {
        if (!first) {
            out = out + sep
        }
        first = false
        out = out + x
    }
    return out
}

wsInList(List<String> xs, String v): Bool {
    for (var x in xs) {
        if (x == v) {
            return true
        }
    }
    return false
}

parseLongSafe(String s): Long {
    var n = 0
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c >= 48 && c <= 57) {
            n = n * 10 + (c - 48)
        }
        i = i + 1
    }
    return n
}

wsCountOccurrences(String textIn, String needle): Int {
    var n = 0
    var rest = textIn
    while (rest.length >= needle.length) {
        var idx = rest.indexOf(needle)
        if (idx < 0) {
            break
        }
        n = n + 1
        rest = rest.substring(idx + needle.length, rest.length)
    }
    return n
}

wsFirstToken(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == 40 || c == 32 || c == 123 || c == 58 || c == 61) {
            break
        }
        out = out + s.substring(i, i + 1)
        i = i + 1
    }
    return out.trim()
}

wsLastSpace(String s): Int {
    var found = 0 - 1
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == 32) {
            found = i
        }
        i = i + 1
    }
    return found
}

wsIsKeyword(String t): Bool {
    if (t == "if") { return true }
    if (t == "for") { return true }
    if (t == "while") { return true }
    if (t == "switch") { return true }
    if (t == "return") { return true }
    if (t == "catch") { return true }
    if (t == "else") { return true }
    if (t == "do") { return true }
    if (t == "spawn") { return true }
    if (t == "assert") { return true }
    return false
}

wsCollectFiles(String dir, Int depth, List<String> out) {
    if (depth > 6) {
        return
    }
    var d = Directory(dir)
    if (!d.exists()) {
        return
    }
    if (!d.isDirectory()) {
        return
    }
    var names = d.list()
    for (var n in names) {
        var skipIt = n == ".git" || n == "build" || n == "out"
        if (!skipIt) {
            var child = joinPath(dir, n)
            var f = File(child)
            if (f.isFile()) {
                if (n.length >= 3) {
                    var ext = n.substring(n.length - 3, n.length)
                    if (ext == ".kf") {
                        out.add(child)
                    }
                }
            } else {
                if (f.isDirectory()) {
                    wsCollectFiles(child, depth + 1, out)
                }
            }
        }
    }
}

wsParseFile(String path): WsParsedRec {
    var f = File(path)
    var txt = ""
    if (f.exists() && f.isFile()) {
        txt = f.readText()
    }
    var hash = wsHash(txt)
    var imports = listOf<String>()
    var syms = listOf<WsSymRec>()
    var pkg = ""
    var lines = splitStr(txt, "\n")
    for (var raw in lines) {
        var t = raw.trim()
        if (t.length > 0) {
            var isComment = t.startsWith("//")
            if (!isComment) {
                var isPkg = t.startsWith("package ")
                var isImp = t.startsWith("import ")
                if (isPkg) {
                    pkg = t.substring(8, t.length).trim()
                }
                if (isImp) {
                    imports.add(t.substring(7, t.length).trim())
                }
                if (!isPkg && !isImp) {
                    var kind = ""
                    if (t.startsWith("record ")) {
                        kind = "record"
                    }
                    if (kind == "" && t.startsWith("interface ")) {
                        kind = "interface"
                    }
                    if (kind == "" && t.startsWith("entity ")) {
                        kind = "entity"
                    }
                    if (kind == "" && t.startsWith("abstract class ")) {
                        kind = "class"
                    }
                    if (kind == "" && t.startsWith("class ")) {
                        kind = "class"
                    }
                    if (kind != "") {
                        var rest = ""
                        if (t.startsWith("abstract class ")) {
                            rest = t.substring(15, t.length)
                        } else if (t.startsWith("record ")) {
                            rest = t.substring(7, t.length)
                        } else if (t.startsWith("interface ")) {
                            rest = t.substring(10, t.length)
                        } else if (t.startsWith("entity ")) {
                            rest = t.substring(7, t.length)
                        } else {
                            rest = t.substring(6, t.length)
                        }
                        var nm = wsFirstToken(rest)
                        if (nm.length > 0) {
                            syms.add(WsSymRec(nm, kind, path))
                        }
                    } else {
                        var p2 = t.indexOf("(")
                        if (p2 > 0) {
                            var head = t.substring(0, p2).trim()
                            var sp = wsLastSpace(head)
                            var cand = head
                            if (sp >= 0) {
                                cand = head.substring(sp + 1, head.length)
                            }
                            var looksFn = false
                            if (cand.length > 0) {
                                var c0 = cand.charAt(0)
                                var alpha = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
                                if (alpha) {
                                    var kw = wsIsKeyword(cand)
                                    if (!kw) {
                                        var hasRet = t.contains("): ")
                                        var hasExpr = t.contains(") = ")
                                        var hasBrace = t.endsWith("{")
                                        if (hasRet || hasExpr || hasBrace) {
                                            looksFn = true
                                        }
                                    }
                                }
                            }
                            if (looksFn) {
                                syms.add(WsSymRec(cand, "function", path))
                            }
                        }
                    }
                }
            }
        }
    }
    return WsParsedRec(path, hash, pkg, imports, syms)
}

wsGitInfo(String root): WsGitRec {
    var headFile = File(joinPath(joinPath(root, ".git"), "HEAD"))
    var branch = ""
    var commit = ""
    if (headFile.exists() && headFile.isFile()) {
        var head = headFile.readText().trim()
        if (head.startsWith("ref: refs/heads/")) {
            branch = head.substring(16, head.length).trim()
            var refFile = File(joinPath(joinPath(root, ".git"), joinPath("refs", "heads")))
            var shaFile = File(joinPath(joinPath(joinPath(root, ".git"), "refs"), joinPath("heads", branch)))
            if (shaFile.exists() && shaFile.isFile()) {
                commit = shaFile.readText().trim()
            }
        } else {
            commit = head
        }
    }
    return WsGitRec(branch, commit)
}

wsBuildEdges(List<WsParsedRec> parsed, List<WsImpRec> flatImports): List<WsEdgeRec> {
    var edges = listOf<WsEdgeRec>()
    for (var imp in flatImports) {
        var target = ""
        for (var p in parsed) {
            if (target == "") {
                for (var s in p.syms) {
                    if (target == "" && s.name == imp.name && s.file != imp.file) {
                        target = p.path
                    }
                }
            }
        }
        if (target != "") {
            edges.add(WsEdgeRec(imp.file, target))
        }
    }
    return edges
}

wsUnusedImports(List<WsParsedRec> parsed, List<WsImpRec> flatAll): List<WsImpRec> {
    var unused = listOf<WsImpRec>()
    for (var imp in flatAll) {
        var txt = ""
        var rf = File(imp.file)
        if (rf.exists() && rf.isFile()) {
            txt = rf.readText()
        }
        var occurrences = wsCountOccurrences(txt, imp.name)
        if (occurrences <= 1) {
            unused.add(imp)
        }
    }
    return unused
}

wsHasCycleRec(String node, List<WsEdgeRec> edges, List<String> visited, List<String> stack, List<String> cycleOut): Bool {
    if (wsInList(stack, node)) {
        cycleOut.add(node)
        return true
    }
    if (wsInList(visited, node)) {
        return false
    }
    visited.add(node)
    stack.add(node)
    for (var e in edges) {
        if (e.from == node) {
            var found = wsHasCycleRec(e.to, edges, visited, stack, cycleOut)
            if (found) {
                return true
            }
        }
    }
    stack.remove(stack.size - 1)
    return false
}

wsDetectCycle(List<WsEdgeRec> edges): List<String> {
    var visited = listOf<String>()
    var stack = listOf<String>()
    var cycle = listOf<String>()
    var roots = listOf<String>()
    for (var e in edges) {
        if (!wsInList(roots, e.from)) {
            roots.add(e.from)
        }
    }
    for (var r in roots) {
        var found = wsHasCycleRec(r, edges, visited, stack, cycle)
        if (found) {
            return cycle
        }
    }
    return cycle
}

wsFullScan(EventBus bus, String root, TimeSource clock): WsSnap {
    bus.publish("workspace.indexing", root)
    var paths = listOf<String>()
    wsCollectFiles(root, 1, paths)
    var files = listOf<WsFileRec>()
    var syms = listOf<WsSymRec>()
    var imps = listOf<WsImpRec>()
    var parsedAll = listOf<WsParsedRec>()
    for (var p in paths) {
        var pr = wsParseFile(p)
        parsedAll.add(pr)
        var sz = 0
        var rf = File(p)
        if (rf.exists() && rf.isFile()) {
            sz = rf.readText().length
        }
        files.add(WsFileRec(p, pr.hash, sz))
        for (var s in pr.syms) {
            syms.add(s)
        }
        for (var i in pr.imports) {
            imps.add(WsImpRec(p, i))
        }
    }
    var deps = wsBuildEdges(parsedAll, imps)
    var gi = wsGitInfo(root)
    var cfg = Config()
    cfg.loadFile(joinPath(root, "kof.config"))
    var target = cfg.getStr("target", "native")
    var wsId = "" + wsHash(root + "|" + gi.branch + "|" + gi.commit)
    var snap = WsSnap()
    snap.workspaceId = wsId
    snap.root = root
    snap.gitBranch = gi.branch
    snap.gitCommit = gi.commit
    snap.target = target
    snap.timestamp = clock.nowMs()
    snap.files = files
    snap.symbols = syms
    snap.imports = imps
    snap.deps = deps
    bus.publish("snapshot.created", root)
    bus.publish("workspace.indexed", "files=" + files.size + " symbols=" + syms.size)
    return snap
}


wsMetaLine(String snap): String {
    return snap.workspaceId + "\u0003" + wsSanitize(snap.root) + "\u0003" + wsSanitize(snap.gitBranch) + "\u0003" + wsSanitize(snap.gitCommit) + "\u0003" + snap.target + "\u0003" + snap.timestamp
}

wsSerializeIndex(WsSnap snap): String {
    var filesSec = ""
    var firstF = true
    for (var f in snap.files) {
        if (!firstF) {
            filesSec = filesSec + "\u0002"
        }
        firstF = false
        filesSec = filesSec + f.path + "\u0003" + f.hash + "\u0003" + f.sizeChars
    }
    var symSec = ""
    var firstS = true
    for (var x in snap.symbols) {
        if (!firstS) {
            symSec = symSec + "\u0002"
        }
        firstS = false
        symSec = symSec + x.name + "\u0003" + x.kind + "\u0003" + x.file
    }
    var impSec = ""
    var firstI = true
    for (var x in snap.imports) {
        if (!firstI) {
            impSec = impSec + "\u0002"
        }
        firstI = false
        impSec = impSec + x.file + "\u0003" + x.name
    }
    var depSec = ""
    var firstD = true
    for (var x in snap.deps) {
        if (!firstD) {
            depSec = depSec + "\u0002"
        }
        firstD = false
        depSec = depSec + x.from + "\u0003" + x.to
    }
    var payload = wsMetaLine(snap)
    payload = payload + "\u0001" + filesSec
    payload = payload + "\u0001" + symSec
    payload = payload + "\u0001" + impSec
    payload = payload + "\u0001" + depSec
    return payload
}

wsWriteVersioned(String path, String magic, Int version, String payload): Bool {
    var crc = wsHash(payload)
    var head = magic + "|" + version + "|" + crc + "\n"
    var f = File(path)
    if (f.exists()) {
        f.delete()
    }
    return f.writeText(head + payload)
}

wsSaveAll(EventBus bus, String dir, WsSnap snap): Bool {
    var d = Directory(dir)
    if (!d.exists()) {
        d.createDirectories()
    }
    var body = wsSerializeIndex(snap)
    var okIdx = wsWriteVersioned(joinPath(dir, "workspace.idx"), "WSIDX", WS_IDX_VERSION(), body)
    var okSnap = wsWriteVersioned(joinPath(dir, "workspace.snapshot"), "WSSNP", WS_IDX_VERSION(), body)
    var hashes = listOf<String>()
    for (var f in snap.files) {
        hashes.add("" + f.hash)
    }
    var okH = wsWriteVersioned(joinPath(dir, "workspace.hashes"), "WSHSH", WS_IDX_VERSION(), wsJoin(hashes, "\u0002"))
    bus.publish("snapshot.created", dir)
    return okIdx && okSnap && okH
}

wsReadVersioned(String path, String wantMagic): String {
    var f = File(path)
    if (!f.exists()) {
        return ""
    }
    if (!f.isFile()) {
        return ""
    }
    var txt = f.readText()
    var nl = txt.indexOf("\n")
    if (nl < 0) {
        return ""
    }
    var head = txt.substring(0, nl).trim()
    var payload = txt.substring(nl + 1, txt.length)
    var hp = splitStr(head, "|")
    if (hp.size != 3) {
        return ""
    }
    if (hp.get(0) != wantMagic) {
        return ""
    }
    if (parseIntStr(hp.get(1)) != WS_IDX_VERSION()) {
        return ""
    }
    var crc = parseIntStr(hp.get(2))
    if (wsHash(payload) != crc) {
        return ""
    }
    return payload
}

wsSection(String payload, Int idx): String {
    var parts = splitStr(payload, "\u0001")
    if (idx < parts.size) {
        return parts.get(idx)
    }
    return ""
}

wsParseMeta(String sec, String fallbackRoot): WsSnap {
    var f6 = splitStr(sec, "\u0003")
    if (f6.size < 6) {
        return WsSnapEmpty()
    }
    var out2 = WsSnap()
    if (f6.size >= 6) {
        out2.workspaceId = f6.get(0)
        out2.root = f6.get(1)
        out2.gitBranch = f6.get(2)
        out2.gitCommit = f6.get(3)
        out2.target = f6.get(4)
        out2.timestamp = parseLongSafe(f6.get(5))
    }
    return out2
}

wsLoadIndex(String path): WsSnap {
    var payload = wsReadVersioned(path, "WSIDX")
    if (payload == "") {
        return WsSnapEmpty()
    }
    var meta = wsParseMeta(wsSection(payload, 0), "")
    var files = meta.files
    var fsec = wsSection(payload, 1)
    for (var entry in splitStr(fsec, "\u0002")) {
        var fl = splitStr(entry, "\u0003")
        if (fl.size == 3) {
            files.add(WsFileRec(fl.get(0), parseIntStr(fl.get(1)), parseIntStr(fl.get(2))))
        }
    }
    var syms = meta.symbols
    var ssec = wsSection(payload, 2)
    for (var entry in splitStr(ssec, "\u0002")) {
        var sl = splitStr(entry, "\u0003")
        if (sl.size == 3) {
            syms.add(WsSymRec(sl.get(0), sl.get(1), sl.get(2)))
        }
    }
    var imps = meta.imports
    var isec = wsSection(payload, 3)
    for (var entry in splitStr(isec, "\u0002")) {
        var il = splitStr(entry, "\u0003")
        if (il.size == 2) {
            imps.add(WsImpRec(il.get(0), il.get(1)))
        }
    }
    var deps = meta.deps
    var dsec = wsSection(payload, 4)
    for (var entry in splitStr(dsec, "\u0002")) {
        var dl = splitStr(entry, "\u0003")
        if (dl.size == 2) {
            deps.add(WsEdgeRec(dl.get(0), dl.get(1)))
        }
    }
    meta.files = files
    meta.symbols = syms
    meta.imports = imps
    meta.deps = deps
    return meta
}

wsDiff(List<WsFileRec> prevFiles, List<WsFileRec> nextFiles): WsDiffRec {
    var added = listOf<String>()
    var modified = listOf<String>()
    var unchanged = listOf<String>()
    var deleted = listOf<String>()
    for (var nf in nextFiles) {
        var found = false
        var oldHash = 0
        for (var pf in prevFiles) {
            if (pf.path == nf.path) {
                found = true
                oldHash = pf.hash
            }
        }
        if (!found) {
            added.add(nf.path)
        } else if (oldHash != nf.hash) {
            modified.add(nf.path)
        } else {
            unchanged.add(nf.path)
        }
    }
    for (var pf in prevFiles) {
        var still = false
        for (var nf in nextFiles) {
            if (nf.path == pf.path) {
                still = true
            }
        }
        if (!still) {
            deleted.add(pf.path)
        }
    }
    var renamedOld = listOf<String>()
    var renamedNew = listOf<String>()
    for (var delPath in deleted) {
        var delHash = 0
        for (var pf in prevFiles) {
            if (pf.path == delPath) {
                delHash = pf.hash
            }
        }
        for (var addPath in added) {
            var addHash = 0
            for (var nf in nextFiles) {
                if (nf.path == addPath) {
                    addHash = nf.hash
                }
            }
            if (addHash == delHash && delHash != 0) {
                renamedOld.add(delPath)
                renamedNew.add(addPath)
            }
        }
    }
    var realAdded = listOf<String>()
    for (var a in added) {
        if (!wsInList(renamedNew, a)) {
            realAdded.add(a)
        }
    }
    var realDeleted = listOf<String>()
    for (var d in deleted) {
        if (!wsInList(renamedOld, d)) {
            realDeleted.add(d)
        }
    }
    return WsDiffRec(realAdded, modified, realDeleted, renamedOld, renamedNew, listOf<String>(), listOf<String>())
}

class WorkspaceIndex {
    String root = "."
    EventBus bus
    WsSnap current = WsSnap()
    List<WsDiagRec> diagCache = listOf<WsDiagRec>()
    Bool loaded = false

    TimeSource clock

    constructor(String r, EventBus b) {
        root = r
        bus = b
        clock = FixedClock(0)
    }

    constructor(String r, EventBus b, TimeSource ts) {
        root = r
        bus = b
        clock = ts
    }

    fullRescan(): WsSnap {
        var snap = wsFullScan(bus, root, clock)
        var diff = wsDiff(current.files, snap.files)
        publishFileEvents(diff)
        current = snap
        loaded = true
        return snap
    }

    incremental(): WsSnap {
        if (!loaded) {
            return fullRescan()
        }
        var fresh = wsFullScan(bus, root, clock)
        var diff = wsDiff(current.files, fresh.files)
        fresh.workspaceId = current.workspaceId
        current = fresh
        bus.publish("workspace.changed", "added=" + diff.added.size + " modified=" + diff.modified.size + " deleted=" + diff.deleted.size + " renamed=" + diff.renamedOld.size)
        publishFileEvents(diff)
        return fresh
    }

    publishFileEvents(WsDiffRec d) {
        for (var a in d.added) {
            bus.publish("file.added", a)
        }
        for (var m in d.modified) {
            bus.publish("file.modified", m)
        }
        for (var x in d.deleted) {
            bus.publish("file.removed", x)
        }
        if (d.renamedOld.size > 0) {
            bus.publish("file.renamed", d.renamedOld.get(0) + "->" + d.renamedNew.get(0))
        }
        bus.publish("diff.computed", "added=" + d.added.size + ",deleted=" + d.deleted.size + ",modified=" + d.modified.size)
    }

    save(): Bool {
        return wsSaveAll(bus, joinPath(root, "build"), current)
    }

    load(): Bool {
        var idxPath = joinPath(joinPath(root, "build"), "workspace.idx")
        var snap = wsLoadIndex(idxPath)
        if (snap.root == "") {
            loaded = false
            bus.publish("workspace.cacheInvalid", idxPath)
            return false
        }
        if (snap.root != root) {
            bus.publish("workspace.cacheInvalid", "root mismatch")
            return false
        }
        current = snap
        loaded = true
        return true
    }

    symbolsOf(String file): List<WsSymRec> {
        var out = listOf<WsSymRec>()
        for (var s in current.symbols) {
            if (s.file == file) {
                out.add(s)
            }
        }
        return out
    }

    findSymbol(String name): List<WsSymRec> {
        var out = listOf<WsSymRec>()
        for (var s in current.symbols) {
            if (s.name == name) {
                out.add(s)
            }
        }
        return out
    }

    importsOf(String file): List<String> {
        var out = listOf<String>()
        for (var i in current.imports) {
            if (i.file == file) {
                out.add(i.name)
            }
        }
        return out
    }

    depsFrom(String file): List<String> {
        var out = listOf<String>()
        for (var e in current.deps) {
            if (e.from == file) {
                out.add(e.to)
            }
        }
        return out
    }

    cycles(): List<String> {
        return wsDetectCycle(current.deps)
    }

    unusedImports(): List<WsImpRec> {
        var parsed = listOf<WsParsedRec>()
        for (var f in current.files) {
            parsed.add(wsParseFile(f.path))
        }
        var flat = current.imports
        return wsUnusedImports(parsed, flat)
    }

    diffVsCurrent(): WsDiffRec {
        var freshPaths = listOf<String>()
        wsCollectFiles(root, 1, freshPaths)
        var nextFiles = listOf<WsFileRec>()
        for (var p in freshPaths) {
            var pr = wsParseFile(p)
            var sz = 0
            nextFiles.add(WsFileRec(p, pr.hash, sz))
        }
        return wsDiff(current.files, nextFiles)
    }

    putDiag(String file, Int hash, Int count, String codes) {
        diagCache.add(WsDiagRec(file, hash, count, codes))
    }

    cachedDiag(String file, Int hash): WsDiagRec {
        for (var d in diagCache) {
            if (d.file == file && d.hash == hash) {
                return d
            }
        }
        return WsDiagRec("", 0, -1, "")
    }

    statsJson(): String {
        var out = "{\"root\":\"" + escapeJson(root) + "\""
        out = out + ",\"files\":" + current.files.size
        out = out + ",\"symbols\":" + current.symbols.size
        out = out + ",\"imports\":" + current.imports.size
        out = out + ",\"deps\":" + current.deps.size
        out = out + ",\"branch\":\"" + escapeJson(current.gitBranch) + "\""
        out = out + ",\"commit\":\"" + escapeJson(current.gitCommit) + "\""
        out = out + ",\"target\":\"" + current.target + "\""
        out = out + ",\"loaded\":" + loaded
        out = out + "}"
        return out
    }
}

record RetHit(String source, String id, String title, Int score, String snippet)
record CtxItem(String source, String id, String title, String body)
record RetOpts(String query, Int topK, Int maxChars, Bool useWorkspaceBoost)

retTokenize(String s): List<String> {
    var out = listOf<String>()
    var clean = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 46
        if (alpha) {
            if (c >= 65 && c <= 90) {
                clean = clean + " "
            }
            clean = clean + s.substring(i, i + 1)
        } else {
            clean = clean + " "
        }
        i = i + 1
    }
    for (var tk in splitStr(clean, " ")) {
        var t = tk.trim()
        if (t.length > 1) {
            out.add(t)
        }
    }
    return out
}

retLower(String s): String {
    return s.toLowerCase()
}

embedDocumentTokens(String title, String body): List<String> {
    var toks = retTokenize(title)
    for (var t in retTokenize(body)) {
        toks.add(t)
    }
    return toks
}

embedQueryTokens(String q): List<String> {
    return retTokenize(q)
}

embedWorkspaceTokens(CorpusIndex ix): List<String> {
    var out = listOf<String>()
    for (var d in ix.docs) {
        for (var k in splitStr(d.meta.keywordsCsv, ",")) {
            var kk = k.trim()
            if (kk.length > 0) {
                out.add(kk)
            }
        }
    }
    return out
}

embedSymbolTokens(String symbol): List<String> {
    return retTokenize(symbol)
}

embedDiagnosticTokens(String code, String message): List<String> {
    var out = retTokenize(code)
    for (var t in retTokenize(message)) {
        out.add(t)
    }
    return out
}

retOverlap(List<String> q, List<String> doc): Int {
    var n = 0
    for (var qt in q) {
        var ql = retLower(qt)
        for (var dt in doc) {
            if (retLower(dt) == ql) {
                n = n + 1
            }
        }
    }
    return n
}

retExpandSymbol(String symbol): List<String> {
    var out = listOf<String>(symbol)
    var s = retLower(symbol)
    if (s.contains("spawn")) {
        out.add("scheduler")
        out.add("task")
        out.add("future")
        out.add("runtime")
    }
    if (s.contains("record")) {
        out.add("dados")
        out.add("imutavel")
        out.add("constructor")
    }
    if (s.contains("json")) {
        out.add("decode")
        out.add("encode")
        out.add("serializacao")
    }
    return out
}

retExpandRecipe(String recipe): List<String> {
    var out = listOf<String>(recipe)
    var s = retLower(recipe)
    if (s.contains("crud") || s.contains("rest") || s.contains("api")) {
        out.add("http")
        out.add("json")
        out.add("database")
        out.add("validation")
        out.add("testing")
    }
    return out
}

retExpandDiagnostic(String code, CorpusIndex ix): List<String> {
    var out = listOf<String>(code)
    for (var d in ix.diagRegistry) {
        if (d.code.contains(code)) {
            if (d.workaroundId != "") {
                out.add("workaround-" + d.workaroundId)
            }
            out.add("exemplo-corrigido")
            out.add("documentacao")
        }
    }
    return out
}

retScoreDoc(List<String> qTokens, CorpusDoc d, List<String> recentFiles, List<SymRef> symIndex): Int {
    var docToks = embedDocumentTokens(d.meta.title + " " + d.meta.keywordsCsv, d.body)
    var score = retOverlap(qTokens, docToks)
    for (var qt in qTokens) {
        var ql = retLower(qt)
        for (var sr in symIndex) {
            if (retLower(sr.symbol).contains(ql)) {
                score = score + 3
                break
            }
        }
        if (d.meta.category == "diagnostics" && d.meta.id.contains(ql.toUpperCase())) {
            score = score + 4
        }
        if (d.meta.category == "recipes" && d.meta.title.contains(ql)) {
            score = score + 2
        }
        for (var rf in recentFiles) {
            if (rf == d.relPath) {
                score = score + 2
            }
        }
    }
    return score
}

retBuildContext(CorpusIndex ix, String query, Int topK, Int maxChars, List<String> recentFiles): String {
    var qTokens = embedQueryTokens(query)
    var expanded = listOf<String>()
    for (var qt in qTokens) {
        for (var e in retExpandSymbol(retLower(qt))) {
            expanded.add(e)
        }
    }
    var scored = listOf<RetHit>()
    for (var d in ix.docs) {
        var base = embedDocumentTokens(d.meta.title + " " + d.meta.keywordsCsv, d.body)
        var sc = retOverlap(expanded, base)
        for (var qt in qTokens) {
            var ql = retLower(qt)
            if (d.meta.id.contains(ql) || d.meta.title.contains(ql)) {
                sc = sc + 5
            }
            for (var sr in ix.symIndex) {
                if (sr.docId == d.meta.id && retLower(sr.symbol).contains(ql)) {
                    sc = sc + 3
                }
            }
            if (d.meta.category == "diagnostics" && d.meta.id.contains(ql.toUpperCase())) {
                sc = sc + 4
            }
            if (d.meta.category == "recipes") {
                for (var re in retExpandRecipe(query)) {
                    if (d.meta.title.contains(re) || d.body.contains(re)) {
                        sc = sc + 2
                    }
                }
            }
            for (var rf in recentFiles) {
                if (rf == d.relPath) {
                    sc = sc + 2
                }
            }
        }
        scored.add(RetHit("corpus", d.meta.id, d.meta.title, sc, d.relPath))
    }
    var picked = listOf<RetHit>()
    var budget = maxChars
    var k = 0
    while (k < topK) {
        var bestIdx = -1
        var bestScore = -1
        var i = 0
        while (i < scored.size) {
            var already = false
            for (var p in picked) {
                if (p.id == scored.get(i).id && p.source == scored.get(i).source) {
                    already = true
                }
            }
            if (!already && scored.get(i).score > bestScore) {
                bestScore = scored.get(i).score
                bestIdx = i
            }
            i = i + 1
        }
        if (bestIdx < 0) {
            break
        }
        var hit = scored.get(bestIdx)
        var cost = hit.title.length + hit.snippet.length + 10
        if (budget - cost < 0) {
            break
        }
        budget = budget - cost
        picked.add(hit)
        k = k + 1
    }
    var out = "{\"query\":\"" + escapeJson(query) + "\",\"items\":["
    var first = true
    for (var p in picked) {
        if (!first) {
            out = out + ","
        }
        first = false
        out = out + "{\"source\":\"" + p.source + "\",\"id\":\"" + escapeJson(p.id) + "\",\"title\":\"" + escapeJson(p.title) + "\",\"score\":" + p.score + "}"
    }
    out = out + "]}"
    return out
}

retCachePath(String dir, String qHash): String {
    return joinPath(dir, "q." + qHash + ".cache")
}

retCacheSave(EventBus bus, String dir, String query, String contextJson): Bool {
    var h = wsHash(retLower(query))
    var ok = wsWriteVersioned(retCachePath(dir, "" + h), "RETC", 1, contextJson)
    bus.publish("cache.miss", query)
    return ok
}

retCacheLoad(EventBus bus, String dir, String query): String {
    var h = wsHash(retLower(query))
    var body = wsReadVersioned(retCachePath(dir, "" + h), "RETC")
    if (body != "") {
        bus.publish("cache.hit", query)
    }
    return body
}

record GgufInfoRec(String path, Bool magicOk, Int version, Int nTensors)
record TensorR(Int rows, Int cols, Int[] data)

tkTokenize(String text): List<String> {
    var out = listOf<String>()
    var cur = ""
    var i = 0
    while (i < text.length) {
        var c = text.charAt(i)
        var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)
        if (alpha) {
            cur = cur + text.substring(i, i + 1)
        } else {
            if (cur.length > 0) {
                out.add(cur)
                cur = ""
            }
        }
        i = i + 1
    }
    if (cur.length > 0) {
        out.add(cur)
    }
    return out
}

class Vocab {
    List<String> tokens = listOf<String>()
    constructor() {
    }
    addToken(String t): Int {
        var id = tkId(t)
        tokens.add(t)
        return id
    }
    size(): Int {
        return tokens.size
    }
    tokenAt(Int i): String {
        return tokens.get(i)
    }
}

tkId(String t): Int {
    var h = wsHash(retLower(t))
    if (h < 0) {
        h = 0 - h
    }
    return h % 50000
}

vocabBuildFromCorpus(CorpusIndex ix): Vocab {
    var v = Vocab()
    for (var d in ix.docs) {
        var toks = tkTokenize(d.meta.title + " " + d.body)
        for (var t in toks) {
            if (v.size() < 4096) {
                var dup = false
                for (var e in v.tokens) {
                    if (e == t) {
                        dup = true
                    }
                }
                if (!dup) {
                    v.addToken(t)
                }
            }
        }
    }
    return v
}

tkEncode(Vocab v, String text): List<Int> {
    var ids = listOf<Int>()
    for (var t in tkTokenize(text)) {
        ids.add(tkId(t))
    }
    return ids
}

tkDecode(List<Int> ids): String {
    var out = ""
    for (var id in ids) {
        out = out + "<" + id + ">"
    }
    return out
}

samplerLcg(Int seed): Int {
    var x = seed * 1103515245 + 12345
    if (x < 0) {
        x = 0 - x
    }
    return x % 2147483647
}

samplerTopK(Int[] logits, Int n, Int k, Int seed): Int {
    var best = logits[0]
    var bi = 0
    var s = samplerLcg(seed)
    var i = 0
    while (i < n) {
        if (logits[i] > best) {
            best = logits[i]
            bi = i
        }
        i = i + 1
    }
    var jitter = s % (k + 1)
    if (jitter == 0) {
        return bi
    }
    var alt = (bi + jitter) % n
    return alt
}

tensorNew(Int rows, Int cols): TensorR {
    return TensorR(rows, cols, new Int[rows * cols])
}

tensorGet(TensorR t, Int r, Int cc): Int {
    return t.data[r * t.cols + cc]
}

tensorSet(TensorR t, Int r, Int cc, Int v) {
    t.data[r * t.cols + cc] = v
}

tensorTranspose(TensorR t): TensorR {
    var o = tensorNew(t.cols, t.rows)
    var r = 0
    while (r < t.rows) {
        var c2 = 0
        while (c2 < t.cols) {
            tensorSet(o, c2, r, tensorGet(t, r, c2))
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

tensorMatMul(TensorR a, TensorR b): TensorR {
    var o = tensorNew(a.rows, b.cols)
    var r = 0
    while (r < a.rows) {
        var c2 = 0
        while (c2 < b.cols) {
            var acc = 0
            var kk = 0
            while (kk < a.cols) {
                acc = acc + tensorGet(a, r, kk) * tensorGet(b, kk, c2)
                kk = kk + 1
            }
            tensorSet(o, r, c2, acc)
            c2 = c2 + 1
        }
        r = r + 1
    }
    return o
}

ggufParseHeader(String path): GgufInfoRec {
    var f = File(path)
    if (!f.exists()) {
        return GgufInfoRec(path, false, 0, 0)
    }
    var txt = f.readText()
    var magicOk = txt.startsWith("GGUF")
    var ver = 0
    var nt = 0
    if (magicOk && txt.length > 9) {
        ver = parseIntStr(txt.substring(4, 6))
        nt = parseIntStr(txt.substring(6, 9))
    }
    return GgufInfoRec(path, magicOk, ver, nt)
}

// M17: GGUF loader V2/V3 — parser tipado sobre bytes (IO binario pende RTL002)

record TokenizerMetadata(Int vocabSize, Int bosId, Int eosId, Int padId, Int unkId)
record RopeMetadataRec(Int dims, Int freqBase, String scaling, Int ctxLen)
record GgufHeader(Int version, Int tensorCount, Int metaCount, Int align)
record MetaValue(Int kind, Int intVal, String strVal)
record TensorEntry(String name, Int nDims, Int d0, Int d1, Int dtype, Int offset, Int size)
record GgufHandle(GgufHeader header, List<MetaValue> metaKeys, List<String> metaNames, List<TensorEntry> tensors, List<Int[]> blobs, Int errorCount, String errorCode)

fn ggufHexVal(Char c): Int {
    if (c >= '0' && c <= '9') { return c - '0' }
    return (c - 'a') + 10
}

fn ggufDecodeHex(String hex, Int byteOff): Int {
    var i = byteOff * 2
    if (i + 1 >= hex.length) { return 0 }
    var hi = ggufHexVal(hex.charAt(i))
    var lo = ggufHexVal(hex.charAt(i + 1))
    return hi * 16 + lo
}

ggufParseMeta(String metaLine): List<String> {
    var out = listOf<String>()
    var parts = splitStr(metaLine, "|")
    var i = 1
    while (i < parts.size()) {
        out.add(parts.get(i))
        i = i + 1
    }
    return out
}

record MetaPair(String key, Int kind, Int intVal)

ggufParsePairs(String metaLine): List<MetaPair> {
    var out = listOf<MetaPair>()
    var raw = ggufParseMeta(metaLine)
    var i = 0
    while (i < raw.size()) {
        var kv = splitStr(raw.get(i), "=")
        if (kv.size() == 2 && i + 1 < raw.size()) {
            out.add(MetaPair(kv.get(0), parseIntStr(kv.get(1)), parseIntStr(raw.get(i + 1))))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return out
}

record TensorSpec(String name, Int d0, Int d1, Int dtype, Int size, Int offset)

ggufParseTensors(String dirLine): List<TensorSpec> {
    var out = listOf<TensorSpec>()
    var dparts = splitStr(dirLine, "|")
    var align = 32
    var nSpecs = dparts.size()
    if (nSpecs > 0) {
        align = parseIntStr(dparts.get(nSpecs - 1))
        nSpecs = nSpecs - 1
    }
    var i = 0
    while (i < nSpecs) {
        var tp = splitStr(dparts.get(i), ",")
        if (tp.size() == 6) {
            var off = parseIntStr(tp.get(5))
            var sz = parseIntStr(tp.get(4))
            out.add(TensorSpec(tp.get(0), parseIntStr(tp.get(2)), parseIntStr(tp.get(3)), sz, sz, off))
        }
        i = i + 1
    }
    return out
}

ggufParse(String magicLine, String metaLine, String dirLine, String blobLine): GgufHandle {
    var errs = listOf<String>()
    if (!magicLine.startsWith("GGUF")) {
        errs.add("E_MAGIC")
    }
    var ver = parseIntStr(magicLine.substring(4))
    if (ver != 2 && ver != 3) {
        errs.add("E_VERSION")
    }
    var pairs = ggufParsePairs(metaLine)
    var names = listOf<String>()
    var vals = listOf<MetaValue>()
    var i = 0
    while (i < pairs.size()) {
        var pr = pairs.get(i)
        names.add(pr.key)
        vals.add(MetaValue(pr.kind, pr.intVal, ""))
        i = i + 1
    }
    var tensors = listOf<TensorEntry>()
    var specs = ggufParseTensors(dirLine)
    i = 0
    while (i < specs.size()) {
        var sp = specs.get(i)
        tensors.add(TensorEntry(sp.name, 2, sp.d0, sp.d1, sp.dtype, sp.offset, sp.size))
        i = i + 1
    }
    var blobs = listOf<Int[]>()
    var bparts = splitStr(blobLine, ":")
    if (bparts.size() == 2 && bparts.get(0) == "HEX") {
        var hexs = bparts.get(1)
        var total = hexs.length / 2
        var arr = new Int[total]
        var b = 0
        while (b < total) {
            arr[b] = ggufDecodeHex(hexs, b)
            b = b + 1
        }
        blobs.add(arr)
    }
    var align = 32
    var ec = errs.size()
    var code = ""
    if (ec > 0) {
        code = errs.get(0)
    }
    return GgufHandle(GgufHeader(ver, tensors.size(), pairs.size(), align), vals, names, tensors, blobs, ec, code)
}

openGGUF(String specPath): GgufHandle {
    var f = File(specPath)
    if (!f.exists()) {
        return GgufHandle(GgufHeader(0, 0, 0, 32), listOf<MetaValue>(), listOf<String>(), listOf<TensorEntry>(), listOf<Int[]>(), 1, "E_FILE_NOT_FOUND")
    }
    var lines = splitStr(f.readText(), "\n")
    if (lines.size() < 4) {
        return GgufHandle(GgufHeader(0, 0, 0, 32), listOf<MetaValue>(), listOf<String>(), listOf<TensorEntry>(), listOf<Int[]>(), 1, "E_FORMAT")
    }
    var blob = ""
    var li = 0
    while (li < lines.size()) {
        if (lines.get(li).startsWith("HEX")) {
            blob = lines.get(li)
        }
        li = li + 1
    }
    return ggufParse(lines.get(0), lines.get(1), lines.get(2), blob)
}

getMetadata(GgufHandle h, String key): MetaValue {
    var i = 0
    while (i < h.metaNames.size()) {
        if (h.metaNames.get(i) == key) {
            return h.metaKeys.get(i)
        }
        i = i + 1
    }
    return MetaValue(-1, 0, "")
}

hasTensor(GgufHandle h, String name): Bool {
    var i = 0
    while (i < h.tensors.size()) {
        if (h.tensors.get(i).name == name) {
            return true
        }
        i = i + 1
    }
    return false
}

listTensors(GgufHandle h): List<String> {
    var out = listOf<String>()
    var i = 0
    while (i < h.tensors.size()) {
        out.add(h.tensors.get(i).name)
        i = i + 1
    }
    return out
}

getTensorLazy(GgufHandle h, String name): Int[] {
    var i = 0
    while (i < h.tensors.size()) {
        if (h.tensors.get(i).name == name) {
            return h.blobs.get(0)
        }
        i = i + 1
    }
    return new Int[0]
}

tokenizerInfo(GgufHandle h): TokenizerMetadata {
    var bos = getMetadata(h, "tokenizer.bos_id")
    var eos = getMetadata(h, "tokenizer.eos_id")
    var pad = getMetadata(h, "tokenizer.pad_id")
    var unk = getMetadata(h, "tokenizer.unk_id")
    var vocab = getMetadata(h, "context_length")
    return TokenizerMetadata(vocab.intVal, bos.intVal, eos.intVal, pad.intVal, unk.intVal)
}

ropeInfo(GgufHandle h): RopeMetadataRec {
    var dim = getMetadata(h, "rope.dimension_count")
    var freq = getMetadata(h, "rope.freq_base")
    var scaling = getMetadata(h, "rope.scaling.type")
    var ctx = getMetadata(h, "context_length")
    return RopeMetadataRec(dim.intVal, freq.intVal, scaling.strVal, ctx.intVal)
}

ggufVersion(GgufHandle h): Int {
    var hdr = h.header
    return hdr.version
}

ggufTensorCount(GgufHandle h): Int {
    var hdr = h.header
    return hdr.tensorCount
}

ggufErrorCount(GgufHandle h): Int {
    return h.errorCount
}

ggufErrorCode(GgufHandle h): String {
    return h.errorCode
}

ggufMetaCount(GgufHandle h): Int {
    var hdr = h.header
    return hdr.metaCount
}

ggufTensorCount2(GgufHandle h): Int {
    var n = listTensors(h)
    return n.size()
}

test "tokenizer info bos eos" {
    var h = openGGUF("fixtures/tiny.gguf")
    var ti = tokenizerInfo(h)
    var bos = ti.bosId
    assert(bos == 1)
}