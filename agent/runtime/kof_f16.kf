// M31.6: QuantDecoder F16 (half-float IEEE 754) + LayerExecExecutor
// F16: bit 15 sinal, 14-10 expoente (bias 15), 9-0 mantissa.
// Representamos valores em ponto fixo de milésimos (como o resto do M31).

fn f16ToMilli(Int bits): Int {
    var u = bits % 65536
    if (u < 0) {
        u = u + 65536
    }
    var signBit = u / 32768
    var v = u - signBit * 32768
    var exp = v / 1024
    var man = v % 1024
    var milli = 0
    if (exp == 31) {
        // Inf/NaN → saturar
        milli = 1000000
    } else if (exp == 0) {
        // subnormal: mantissa/1024 * 2^-14
        milli = man * 1000 / 1024 / 16384
    } else {
        // normal: (1.man) * 2^(exp-15)
        var mant = 1024 + man
        var e = exp - 15
        if (e >= 0) {
            milli = mant * 1000 * pow2(e) / 1024
        } else {
            milli = mant * 1000 / 1024 / pow2(0 - e)
        }
    }
    if (signBit == 1) {
        milli = 0 - milli
    }
    return milli
}

// f16 → MICRO (1e-6): precisão p/ pesos dequantizados do GGUF
// (d típico 0.01 → 10000 micro; milli perdia d subnormais/pequenos)
fn f16ToMicro(Int bits): Int {
    var u = bits % 65536
    if (u < 0) {
        u = u + 65536
    }
    var signBit = u / 32768
    var v = u - signBit * 32768
    var exp = v / 1024
    var man = v % 1024
    var micro = 0
    if (exp == 31) {
        micro = 1000000000
    } else if (exp == 0) {
        micro = man * 1000000 / 1024 / 16384
    } else {
        var mant = 1024 + man
        var e = exp - 15
        if (e >= 0) {
            micro = mant * 1000000 / 1024
            var k = 0
            while (k < e) {
                micro = micro * 2
                k = k + 1
            }
        } else {
            micro = mant * 1000000 / 1024
            var k = 0
            while (k < 0 - e) {
                micro = micro / 2
                k = k + 1
            }
        }
    }
    if (signBit == 1) {
        micro = 0 - micro
    }
    return micro
}

// f16 → NANO (1e-9): escala p/ pesos de matmul (d minúsculos precisos:
// d 9.24e-6 → 9238 nano; produto d*s*q cabe em Int32)
fn f16ToNano(Int bits): Int {
    var u = bits % 65536
    if (u < 0) {
        u = u + 65536
    }
    var signBit = u / 32768
    var v = u - signBit * 32768
    var exp = v / 1024
    var man = v % 1024
    var nano = 0
    if (exp == 31) {
        nano = 2000000000
    } else if (exp == 0) {
        nano = man * 1000000000 / 1024 / 16384
    } else {
        var mant = 1024 + man
        var e = exp - 15
        if (e >= 0) {
            nano = mant * 1000000000 / 1024
            var k = 0
            while (k < e) {
                nano = nano * 2
                k = k + 1
            }
        } else {
            nano = mant * 1000000000 / 1024
            var k = 0
            while (k < 0 - e) {
                nano = nano / 2
                k = k + 1
            }
        }
    }
    if (signBit == 1) {
        nano = 0 - nano
    }
    return nano
}

pow2(Int n): Int {
    var r = 1
    var k = 0
    while (k < n) {
        r = r * 2
        k = k + 1
    }
    return r
}

// Decodifica um bloco F16: 16 meia-palavras (cada uma um Int com 16 bits)
// para um tensor de 16 valores em ponto fixo (milésimos).
f16DecodeBlock(Int[] raw, Int off): Int[] {
    var out = new Int[16]
    var j = 0
    while (j < 16) {
        out[j] = f16ToMilli(raw[off + j])
        j = j + 1
    }
    return out
}

// Decodifica N blocos F16 (16 valores cada) para um tensor 1×N*16
f16DecodeTensor(Int[] raw, Int nBlocks): TensorR {
    var t = tensorNew(1, nBlocks * 16)
    var b = 0
    while (b < nBlocks) {
        var blk = f16DecodeBlock(raw, b * 16)
        var j = 0
        while (j < 16) {
            tensorSet(t, 0, b * 16 + j, blk[j])
            j = j + 1
        }
        b = b + 1
    }
    return t
}

// M31.8: K-quants (Q4_K_M / Q6_K) — decoders de bloco no formato
// simplificado do projeto (milésimos, inteiro). Cada bloco carrega o
// scale no slot 0 e os quantizados nos slots seguintes, coerente com
// q40DecodeBlock/q80DecodeBlock (156/157) e com ggufQuants() (143).

// Q4_K_M: bloco de 9 — scale + 8 nibbles (sub-blocos de 4 bits).
fn q4kDecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 9) {
        var nib = raw[off + i] % 16
        // K-quants usam min/scale por sub-bloco: nibble alto = 4 bits
        // de min, baixo = 4 bits de q. Reconstrói q0..q7 por nibble.
        var q = nib % 4
        var m = nib / 4
        acc = acc + (q * scale / 4 + m) / 2
        i = i + 1
    }
    return acc
}

// Q6_K: bloco de 9 — scale + 8 valores base 6-bit (0..63) com
// min implícito 32 (centro da faixa 6-bit).
fn q6kDecodeBlock(Int[] raw, Int off): Int {
    var scale = raw[off]
    var acc = 0
    var i = 1
    while (i < 9) {
        var v = raw[off + i] % 64
        acc = acc + (v - 32) * scale / 64
        i = i + 1
    }
    return acc
}

// Seleciona o decoder pelo nome do quant (ggufQuants/143).
kqDecodeBlock(String quant, Int[] raw, Int off): Int {
    if (quant == "Q6_K") {
        return q6kDecodeBlock(raw, off)
    }
    return q4kDecodeBlock(raw, off)
}

// Decodifica N blocos do quant K informado (igual quantDecodeTensor/156).
kqDecodeTensor(String quant, Int[] raw, Int nBlocks): Int[] {
    var out = new Int[nBlocks]
    var b = 0
    while (b < nBlocks) {
        out[b] = kqDecodeBlock(quant, raw, b * 9)
        b = b + 1
    }
    return out
}
