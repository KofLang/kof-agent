mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkCtxGrant(): ToolCtx {
    var c = mkCtx()
    c.grant(PERM_FS_WRITE())
    return c
}

test "fs read missing errors" {
    var r = toolExec(defaultRegistry(), mkCtx(), ToolCall("fs.read", "t2", "build/tt/missing.kf", "", 0))
    assert(r.status == "error")
    assert(r.data.contains("FS-NOTFOUND"))
}
main() {
}
