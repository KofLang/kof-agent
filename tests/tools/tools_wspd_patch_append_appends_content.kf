WS_T(): String { return "build/tt_ws" }

setupWsT(): ToolCtx {
    mkFile("build/tt_ws/lib.kf", "record Shared(Int v)\n")
    mkFile("build/tt_ws/app.kf", "import Shared\n\nmain() {\n}\n")
    var c = mkCtx()
    c.wsi = WorkspaceIndex(WS_T(), c.bus, FixedClock(5))
    c.wsi.fullRescan()
    return c
}

test "patch.append appends content" {
    mkFile("build/tt_ws/ap.txt", "linha1\n")
    var res = toolExec(defaultRegistry(), setupWsTPatch(), ToolCall("patch.append", "w11", "build/tt_ws/ap.txt", "linha2\n"))
    assert(res.status == "ok")
    assert(File("build/tt_ws/ap.txt").readText().contains("linha2"))
}
main() {
}
