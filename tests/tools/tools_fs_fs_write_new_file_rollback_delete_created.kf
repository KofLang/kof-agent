mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkCtxGrant(): ToolCtx {
    var c = mkCtx()
    c.grant(PERM_FS_WRITE())
    return c
}

test "fs write new file rollback delete-created" {
    var res = toolExec(defaultRegistry(), mkCtxGrant(), ToolCall("fs.write", "t9", "build/tt/new.txt", "v1", 0))
    assert(res.status == "ok")
    assert(res.rollback.kind == "delete-created")
    File("build/tt/new.txt").delete()
}
main() {
}
