// koflama — forward LLM 100% Kof puro sobre o parser GGUF binário
// (koflama_gguf.kf). Renomeado de 162_llm_forward.kf; símbolos kofLm*.
// TinyLlama-1.1B / LLaMA: embd=2048, 22 layers, 32 q-heads, 4 kv-heads,
// head_dim=64, ffn=5632, rope_dims=64, vocab=32000.
// Escalas fixed-point: pesos NANO (1e-9, Long[]), estados MICRO (1e-3 × 1e3).
// matvec: acc Long = Σ W_nano × x_micro → /1e9 → MICRO.
// RMSNorm: y = x_w / rms com tudo MICRO.
// Q6_K v/down/output + Q4_K q/k/gate/up + F32 norms.

record KofLmCfg(Int embd, Int layers, Int heads, Int kvHeads, Int headDim,
               Int ffn, Int ropeDims, Int vocab, Int eps)

record KofLmKv(Long[] k, Long[] v)

// ── rmsnorm micro ───────────────────────────────────────────────────────
kofLmRmsNorm(Long[] x, Long[] w, Int n, Int eps): Long[] {
    // Σx² máx ~ 2048×(1.4e8)² ~ 4e16 < 9.2e18: sem escala necessária
    var sq: Long = 0
    var i = 0
    while (i < n) {
        sq = sq + x[i] * x[i]
        i = i + 1
    }
    var mean = sq / n + eps
    var rms = kofLmIsqrt(mean)
    if (rms <= 0) { rms = 1 }
    var y = new Long[n]
    i = 0
    while (i < n) {
        y[i] = (x[i] * w[i] / rms)
        i = i + 1
    }
    return y
}

// sqrt inteiro (Newton), Long
kofLmIsqrt(Long v): Long {
    if (v <= 0) { return 0 }
    var r: Long = v
    var q: Long = 0
    if (v > 4294967296) { r = v / 65536 + 65536 } else { r = v + 2 }
    var k = 0
    while (k < 24) {
        q = (r + v / r) / 2
        if (q >= r) { break }
        r = q
        k = k + 1
    }
    // round: floor(r) vs floor(r)+1 — o mais próximo de sqrt(v)
    if (r < 2000000000 && (r + 1) * (r + 1) - v < v - r * r) { r = r + 1 }
    return r
}

// ── matvec: W[N×K] nano × x[K] micro → y[N] micro ──────────────────────
// termo = nano×micro ~ 1e7×1e8 = 1e15; Σ K=2048/5632 termos extrapola
// o Long (9.2e18). Acumular em CHUNKS de 32 termos: acc32 ~ 3e16 seguro;
// após cada chunk: total += acc32/1e9 (micro), retomando o resíduo
// sub-micro no próximo chunk (loss < 1e-9 por chunk).
kofLmMatvec(Long[] W, Long[] x, Int nRows, Int kdim): Long[] {
    var y = new Long[nRows]
    var r = 0
    while (r < nRows) {
        var off = r * kdim
        var total: Long = 0
        var rem: Long = 0
        var c = 0
        while (c < kdim) {
            var acc: Long = 0
            var ce = 0
            while (ce < 32 && c < kdim) {
                acc = acc + W[off + c] * x[c]
                c = c + 1
                ce = ce + 1
            }
            total = total + acc / 1000000000
            rem = rem + acc % 1000000000
            if (rem > 1000000000 || rem < 0 - 1000000000) {
                total = total + rem / 1000000000
                rem = rem % 1000000000
            }
        }
        y[r] = total + rem / 1000000000
        r = r + 1
    }
    return y
}

// ── RoPE (rotary) — tabela cos/sin micro pré-computada por (pos, freqIdx)
// ângulo = pos / (10000^(2i/ropeDims)); cos/sin em MICRO.
kofLmRopeTable(Int pos, Int ropeDims): Long[] {
    // retorna [cos0, sin0, cos1, sin1, ...] ropeDims/2 pares em MICRO
    var half = ropeDims / 2
    var tab = new Long[half * 2]
    var i = 0
    while (i < half) {
        // freq = 10000^(-2i/ropeDims) → ângulo = pos * freq
        var ang = kofLmAngle(pos, i, half)
        tab[i * 2] = kofLmCos(ang)
        tab[i * 2 + 1] = kofLmSin(ang)
        i = i + 1
    }
    return tab
}

// ang = pos * 10000^(-2i/ropeDims) — em "mili-radianos"? Trabalhamos com
// graus×1000 (decimiligraus) p/ as séries trigonométricas.
kofLmAngle(Int pos, Int fi, Int half): Long {
    // 10000^(-2i/64): log2 = -(2i/64)·log2(10000) ≈ -0.2083·i·... precomputar
    // por potências: freq = 10000^(-fi/half). Implementação: exp2 fracionário.
    var l2: Long = 13288  // log2(10000)×1000 = 13.2877×1000
    var expo: Long = (0 - (2 * fi) * l2) / (2 * half)   // ×1000
    // ang_graus1000 = pos × 2^(expo/1000) × (180/π) × 1000
    // 2^(e/1000): série — usamos pow2Fix
    var pow2v = kofLmPow2Fix(expo)
    // rad → decimiligraus: rad × 572958 (180/π×1000... 57.2958° = 1 rad → ×1000)
    // rad→decimiligraus: pos×freq(rad)×57.2958×1000 = pos×pow2v(micro)×572958/1e7
    var ang: Long = pos * pow2v * 572958 / 10000000
    if (ang < 0) { ang = 0 - ang }
    // reduzir a 360000 (360°×1000)
    ang = ang % 360000
    return ang
}

// 2^(e/1000) em MICRO (e Long)
kofLmPow2Fix(Long e): Long {
    // 2^(e/1000) = 2^int × 2^(frac/1000)
    var inteiro = e / 1000
    var frac = e % 1000
    if (e < 0 && frac != 0) {
        inteiro = inteiro - 1
        frac = frac + 1000
    }
    var r: Long = 1000000
    if (inteiro >= 0) {
        var k = 0
        while (k < inteiro) {
            r = r * 2
            k = k + 1
        }
    } else {
        var k = 0
        while (k < 0 - inteiro) {
            r = r / 2
            k = k + 1
        }
    }
    // 2^(frac/1000) = exp(t), t = frac×ln2/1000 — em MICRO: ×1e6
    var tf: Long = frac * 6931 / 10       // t em MICRO (frac×ln2/1000×1e6)
    var term: Long = 1000000
    var sum: Long = 1000000
    var k2 = 1
    while (k2 < 8) {
        term = term * tf / 1000000 / k2
        sum = sum + term
        k2 = k2 + 1
    }
    return r * sum / 1000000
}

// cos de ang em decimiligraus (×1000 graus) → MICRO, série de Taylor
kofLmCos(Long ang): Long {
    // reduzir para [-180000, 180000]
    var a = ang % 360000
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = 360000 - a }
    // cos(180°-x) = -cos(x): a≤180000 ok
    // quadrante: cos(90..180) = -cos(180-θ): manter direto na série com x rad
    // x rad = a × π/180000 = a × 17453 / 10000000 (π=3.14159: π/180=0.017453)
    var x = a * 174533 / 10000   // micro rad (1 rad = 1e6)
    // cos(x) série (x em micro rad): term = x²; cos = 1 - x²/2 + x⁴/24 - ...
    var x2 = x * x / 1000000       // x² em micro rad²
    var sum: Long = 1000000
    var term: Long = 1000000
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k - 1) * (2 * k))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    return sum
}

// sin de ang em decimiligraus → MICRO
kofLmSin(Long ang): Long {
    var a = ang % 360000
    var sign = 1
    if (a < 0) { a = a + 360000 }
    if (a > 180000) { a = a - 360000 }
    if (a < 0) { a = 0 - a; sign = 0 - 1 }
    if (a > 90000) { a = 180000 - a }
    var x = a * 174533 / 10000   // micro rad (1 rad = 1e6)
    var x2 = x * x / 1000000
    var sum: Long = x
    var term: Long = x
    var k = 1
    while (k < 6) {
        term = term * x2 / 1000000 / ((2 * k) * (2 * k + 1))
        if (k % 2 == 1) { sum = sum - term } else { sum = sum + term }
        k = k + 1
    }
    if (sign < 0) { sum = 0 - sum }
    return sum
}

// aplicar RoPE em q/k (Long[] micro), head h, posição pos
kofLmApplyRope(Long[] vec, Int vecOff, Int headDim, Int pos, Int ropeDims) {
    var tab = kofLmRopeTable(pos, ropeDims)
    var half = ropeDims / 2
    var i = 0
    while (i < half) {
        var cosv = tab[i * 2]
        var sinv = tab[i * 2 + 1]
        var x0 = vec[vecOff + i]
        var x1 = vec[vecOff + i + half]
        vec[vecOff + i] = (x0 * cosv - x1 * sinv) / 1000000
        vec[vecOff + i + half] = (x0 * sinv + x1 * cosv) / 1000000
        i = i + 1
    }
}

// ── sigmoid micro (para silu): sig(x)=1/(1+e^-t), t=x/1e6 ───────────────
// E = e^|t| em MICRO via série: term_k = term_{k-1}×ax/(k×1e6), term0=1e6
// x>0: sig = E/(E+1e6) · x<0: sig = 1e6/(1e6+E)
kofLmSigmoid(Long x): Long {
    var neg = 0
    var ax = x
    if (x < 0) { neg = 1; ax = 0 - x }
    if (ax > 12000000) {
        if (neg == 1) { return 0 }
        return 1000000
    }
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 14) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    var sig: Long = 0
    if (neg == 1) {
        sig = 1000000000000 / (1000000 + E)
    } else {
        sig = E * 1000000 / (E + 1000000)
    }
    if (sig > 1000000) { sig = 1000000 }
    return sig
}

// silu(g)*u micro: g*sig(g)/1e6 × u → /1e6
kofLmSwiglu(Long[] g, Long[] u, Int n): Long[] {
    var out = new Long[n]
    var i = 0
    while (i < n) {
        var sig = kofLmSigmoid(g[i])
        var act = g[i] * sig / 1000000
        out[i] = act * u[i] / 1000000
        i = i + 1
    }
    return out
}

// ── attention single/multi-token com KV cache ───────────────────────────
// scores por q-head: q_h · k_pos / sqrt(headDim); softmax causal; out_h =
// Σ p·v_pos(kv-group(h)). GQA: q head h usa kv head h/(heads/kvHeads).
kofLmAttention(Long[] q, Long[] kc, Long[] vc, Int nPos, Int heads,
              Int kvHeads, Int headDim): Long[] {
    var embd = heads * headDim
    var out = new Long[embd]
    var group = heads / kvHeads
    var scaleDiv = kofLmIsqrt(headDim * 1000000)
    if (scaleDiv <= 0) { scaleDiv = 1 }
    var h = 0
    while (h < heads) {
        var kvh = h / group
        var qOff = h * headDim
        var kvOff = kvh * headDim
        // scores
        var mx: Long = 0 - 900000000000
        var scores = new Long[nPos]
        var p = 0
        while (p < nPos) {
            var acc: Long = 0
            var d = 0
            while (d < headDim) {
                acc = acc + q[qOff + d] * kc[p * (kvHeads * headDim) + kvOff + d]
                d = d + 1
            }
            // q,k micro: produto micro² (1e-12 real); score real =
            // acc/sqrt(hd)/1e12; em MICRO (×1e6): acc/sqrt(hd)/1e6 =
            // acc/(scaleDiv×1000)
            var sc = acc / scaleDiv / 1000
            scores[p] = sc
            if (sc > mx) { mx = sc }
            p = p + 1
        }
        // softmax com exp micro
        var sum: Long = 0
        p = 0
        while (p < nPos) {
            var e = kofLmExpMicro(scores[p] - mx)
            scores[p] = e
            sum = sum + e
            p = p + 1
        }
        if (sum <= 0) { sum = 1 }
        // out_h = Σ p·v (v micro): acc 1e6×... /1e6
        var oOff = h * headDim
        p = 0
        while (p < nPos) {
            var wgt = scores[p] * 1000000 / sum
            var d = 0
            while (d < headDim) {
                out[oOff + d] = out[oOff + d] + wgt * vc[p * (kvHeads * headDim) + kvOff + d] / 1000000
                d = d + 1
            }
            p = p + 1
        }
        h = h + 1
    }
    return out
}

// e^((x)/1e6) em MICRO — x micro (diferença de scores, ≤0): e^(-t),
// t = |x|/1e6 real. Estável: E = e^t (série positiva, sem cancela-
// mento); e^-t = 1e12/E (micro × micro / 1e6... E micro: e^-t micro =
// 1e6×1e6/E).
kofLmExpMicro(Long x): Long {
    if (x < 0 - 12000000) { return 0 }
    var ax = 0 - x
    var term: Long = 1000000
    var E: Long = 1000000
    var kk = 1
    while (kk < 20) {
        term = term * ax / 1000000 / kk
        if (term == 0) { break }
        E = E + term
        kk = kk + 1
    }
    return 1000000000000 / E
}

// ── forward completo de 1 token (com cache) ─────────────────────────────
// Retorna logits[vocab] micro.
kofLmForward(String path, KofGgufBinModel m, KofLmCfg cfg, Int token, Int pos,
            List<List<KofLmKv>> kvCache): Long[] {
    var xsN = kofGgufDecodeRowsN(path, m, "token_embd.weight", token, 1, cfg.embd)
    // pesos decodificam em NANO; estados circulam em MICRO → /1000
    var xs = new Long[cfg.embd]
    var i = 0
    while (i < cfg.embd) {
        xs[i] = xsN[i] / 1000
        i = i + 1
    }

    var normW = new Long[cfg.embd]
    var l = 0
    while (l < cfg.layers) {
        var attnNorm = kofGgufF32DecodeRows(path, m, "blk." + l + ".attn_norm.weight", 0, 1, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            normW[i] = attnNorm[i]
            i = i + 1
        }
        var h = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
        // q/k/v
        var qW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_q.weight", 0, cfg.embd, cfg.embd)
        var q = kofLmMatvec(qW, h, cfg.embd, cfg.embd)
        var kW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_k.weight", 0, cfg.kvHeads * cfg.headDim, cfg.embd)
        var k = kofLmMatvec(kW, h, cfg.kvHeads * cfg.headDim, cfg.embd)
        var vW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_v.weight", 0, cfg.kvHeads * cfg.headDim, cfg.embd)
        var v = kofLmMatvec(vW, h, cfg.kvHeads * cfg.headDim, cfg.embd)
        // RoPE em q e k (pos atual)
        var hd = 0
        while (hd < cfg.heads) {
            kofLmApplyRope(q, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        hd = 0
        while (hd < cfg.kvHeads) {
            kofLmApplyRope(k, hd * cfg.headDim, cfg.headDim, pos, cfg.ropeDims)
            hd = hd + 1
        }
        // cache por layer: cache[l] = K/v das posições 0..pos
        var kvEnt2 = KofLmKv(k, v)
        if (kvCache.size() <= l) {
            kvCache.add(listOf<KofLmKv>())
        }
        kvCache.get(l).add(kvEnt2)
        // attention sobre 0..pos (só o próprio k/v quando pos=0)
        var nPos = pos + 1
        var kcache = new Long[nPos * cfg.kvHeads * cfg.headDim]
        var vcache = new Long[nPos * cfg.kvHeads * cfg.headDim]
        var layerCache = kvCache.get(l)
        var pi = 0
        while (pi < nPos) {
            var kvEnt = layerCache.get(pi)
            var ci = 0
            while (ci < cfg.kvHeads * cfg.headDim) {
                kcache[pi * (cfg.kvHeads * cfg.headDim) + ci] = kvEnt.k[ci]
                vcache[pi * (cfg.kvHeads * cfg.headDim) + ci] = kvEnt.v[ci]
                ci = ci + 1
            }
            pi = pi + 1
        }
        var attn = kofLmAttention(q, kcache, vcache, nPos, cfg.heads,
                                 cfg.kvHeads, cfg.headDim)
        // attn_output
        var oW = kofGgufDecodeRowsN(path, m, "blk." + l + ".attn_output.weight", 0, cfg.embd, cfg.embd)
        var attno = kofLmMatvec(oW, attn, cfg.embd, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            xs[i] = xs[i] + attno[i]
            i = i + 1
        }
        // FFN
        var ffnNorm = kofGgufF32DecodeRows(path, m, "blk." + l + ".ffn_norm.weight", 0, 1, cfg.embd)
        i = 0
        while (i < cfg.embd) {
            normW[i] = ffnNorm[i]
            i = i + 1
        }
        var h2 = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
        var gW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_gate.weight", 0, cfg.ffn, cfg.embd)
        var g = kofLmMatvec(gW, h2, cfg.ffn, cfg.embd)
        var uW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_up.weight", 0, cfg.ffn, cfg.embd)
        var u = kofLmMatvec(uW, h2, cfg.ffn, cfg.embd)
        var act = kofLmSwiglu(g, u, cfg.ffn)
        var dW = kofGgufDecodeRowsN(path, m, "blk." + l + ".ffn_down.weight", 0, cfg.embd, cfg.ffn)
        var d = kofLmMatvec(dW, act, cfg.embd, cfg.ffn)
        var i2 = 0
        while (i2 < cfg.embd) {
            xs[i2] = xs[i2] + d[i2]
            i2 = i2 + 1
        }
        l = l + 1
    }
    var outNorm = kofGgufF32DecodeRows(path, m, "output_norm.weight", 0, 1, cfg.embd)
    i = 0
    while (i < cfg.embd) {
        normW[i] = outNorm[i]
        i = i + 1
    }
    var hf = kofLmRmsNorm(xs, normW, cfg.embd, cfg.eps)
    // lm_head: output.weight Q6_K (2048, 32000) — 32000 linhas de 2048
    var lgW = kofGgufDecodeRowsN(path, m, "output.weight", 0, cfg.vocab, cfg.embd)
    var logits = kofLmMatvec(lgW, hf, cfg.vocab, cfg.embd)
    return logits
}

// argmax dos logits
kofLmArgmax(Long[] logits, Int n): Int {
    var best = 0
    var i = 1
    while (i < n) {
        if (logits[i] > logits[best]) { best = i }
        i = i + 1
    }
    return best
}

// ── smoke: forward 1 token + argmax ─────────────────────────────────────
kofLmForwardSmoke(String path): String {
    var m = kofGgufBinOpen(path)
    if (m.errorCount > 0) {
        return "ERR " + m.errorCode
    }
    var cfg = kofLmCfgFromKv(m)
    var report = "cfg " + cfg.embd + "/" + cfg.layers + "/" + cfg.heads + "/" + cfg.kvHeads
    report = report + " hd=" + cfg.headDim + " ffn=" + cfg.ffn + " vocab=" + cfg.vocab
    var cache = listOf<List<KofLmKv>>()
    var t0 = now()
    var logits = kofLmForward(path, m, cfg, 1, 0, cache)
    var t1 = now()
    var dt = t1 - t0
    var best = kofLmArgmax(logits, cfg.vocab)
    report = report + " tok1→" + best + " in=" + dt + "ms"
    report = report + " lg[max]=" + logits[best] + " lg[0..3]=" + logits[0] + "," + logits[1] + "," + logits[2] + "," + logits[3]
    return report
}

kofLmCfgFromKv(KofGgufBinModel m): KofLmCfg {
    var embd = 0
    var layers = 0
    var heads = 0
    var kvHeads = 0
    var ffn = 0
    var vocab = 0
    var i = 0
    while (i < m.kv.size()) {
        var kv = m.kv.get(i)
        if (kv.key == "llama.embedding_length") { embd = kv.intVal }
        if (kv.key == "llama.block_count") { layers = kv.intVal }
        if (kv.key == "llama.attention.head_count") { heads = kv.intVal }
        if (kv.key == "llama.attention.head_count_kv") { kvHeads = kv.intVal }
        if (kv.key == "llama.feed_forward_length") { ffn = kv.intVal }
        if (kv.key == "llama.vocab_size") { vocab = kv.intVal }
        i = i + 1
    }
    var keyLen = 64
    var ropeDims = 64
    // eps = 1e-5 unidade² → 1e7 micro² (mean de x² em micro²)
    return KofLmCfg(embd, layers, heads, kvHeads, keyLen, ffn, ropeDims, vocab, 10000000)
}
