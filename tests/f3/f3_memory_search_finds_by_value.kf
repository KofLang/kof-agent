test "memory put get" {
    var m = MemoryLayer(FixedClock(100))
    m.put("k1", "session", "v1", 0)
    assert(m.get("k1") == "v1")
}

test "memory search finds by value" {
    var m = MemoryLayer(FixedClock(1))
    m.put("sym:spawn", "semantic", "doc sobre spawn", 0)
    var r = memSearch(m, "spawn")
    assert(r.size == 1)
}
main() {
}
