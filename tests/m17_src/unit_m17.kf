test "header valid v3 via accessors" {
    var h = openGGUF("fixtures/tiny.gguf")
    assert(ggufVersion(h) == 3)
    assert(ggufTensorCount(h) == 2)
}

test "bad magic yields error" {
    var h = openGGUF("fixtures/bad_magic.gguf")
    assert(ggufErrorCount(h) >= 1)
}

test "bad version yields error" {
    var h = openGGUF("fixtures/bad_version.gguf")
    assert(ggufErrorCount(h) >= 1)
}

test "metadata typed read bos" {
    var h = openGGUF("fixtures/tiny.gguf")
    var mv = getMetadata(h, "tokenizer.bos_id")
    var iv = mv.intVal
    assert(iv == 1)
}

test "metadata missing kind -1" {
    var h = openGGUF("fixtures/tiny.gguf")
    var mv = getMetadata(h, "nope")
    var k = mv.kind
    assert(k == -1)
}

test "tensor lookup by name" {
    var h = openGGUF("fixtures/tiny.gguf")
    assert(hasTensor(h, "tok_embd"))
    assert(!hasTensor(h, "nope"))
}

test "list tensors two entries" {
    var h = openGGUF("fixtures/tiny.gguf")
    var l = listTensors(h)
    var n = l.size()
    assert(n == 2)
}

test "lazy tensor hex decoded" {
    var h = openGGUF("fixtures/tiny.gguf")
    var b = getTensorLazy(h, "tok_embd")
    var len = b.length
    var last = b[31]
    assert(len == 32)
    assert(last == 31)
}

test "missing file typed error" {
    var h = openGGUF("fixtures/nope.gguf")
    var n = ggufErrorCount(h)
    assert(n == 1)
}

test "tokenizer info bos eos" {
    var h = openGGUF("fixtures/tiny.gguf")
    var ti = tokenizerInfo(h)
    var bos = ti.bosId
    assert(bos == 1)
}

test "rope ctx len" {
    var h = openGGUF("fixtures/tiny.gguf")
    var ri = ropeInfo(h)
    var ctx = ri.ctxLen
    assert(ctx == 512)
}
