// koflama — GGUF binário REAL (v2/v3): parser em Kof puro, sem libc/externo.
// (renomeado de 161_gguf_binary.kf; símbolos com prefixo kof/kofGguf)
// Leitura por readRange (offset+len): nunca carrega o arquivo inteiro —
// o TinyLlama-Q4 é 660MB e só o header/kvs/tensor dir passam por aqui.
// Os blobs de tensor são lidos sob demanda e dequantizados (Q4_K/Q6_K/F16)
// para Int[] em ponto fixo de MILÉSIMOS (padrão do projeto).
// Fórmulas de dequant espelham ggml-quants.c (get_scale_min_k4,
// dequantize_row_q4_K, dequantize_row_q6_K).

record KofGgufBinHeader(Int version, Int tensorCount, Int kvCount, Int alignment)
record KofGgufBinKv(String key, Int kind, Int intVal, String strVal)
record KofGgufBinTensor(String name, Int nDims, Int d0, Int d1, Int quant, Int offsetLo, Int offsetHi, Int nElems)
record KofGgufBinModel(KofGgufBinHeader header, List<KofGgufBinKv> kv, List<KofGgufBinTensor> tensors, Int errorCount, String errorCode, Long dataOff)
record GgufBinStr(Int len, Int[] chars)

// ── leitura little-endian de um Int[] de bytes ──────────────────────────
fn kofGgufU32(Int[] b, Int off): Int {
    if (off + 4 > b.length) { return 0 }
    return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216
}

fn kofGgufU64Low(Int[] b, Int off): Int {
    if (off + 8 > b.length) { return 0 }
    return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216
}

fn kofGgufU64High(Int[] b, Int off): Int {
    if (off + 8 > b.length) { return 0 }
    return b[off + 4] + b[off + 5] * 256 + b[off + 6] * 65536 + b[off + 7] * 16777216
}

// u64→Long p/ offsets de tensor (GGUF até 4G+ usa hi*2^32)
fn kofGgufU64ToLong(Int[] b, Int off): Long {
    var hi = kofGgufU64High(b, off)
    if (hi == 0) {
        var lo = kofGgufU64Low(b, off)
        return lo + 0
    }
    return kofGgufU64Low(b, off) + hi * 4294967296
}

// len disponível na janela a partir de off+8 (evita index OOB quando a
// string cruza o fim do buffer lido)
fn kofGgufStrAvail(Int[] b, Int off): Int {
    var avail = b.length - (off + 8)
    if (avail < 0) { return 0 }
    return avail
}

fn kofGgufReadStr(Int[] b, Int off): GgufBinStr {
    var len = kofGgufU64Low(b, off)
    var avail = kofGgufStrAvail(b, off)
    if (len > avail) { len = avail }
    if (len < 0) { len = 0 }
    var chars = new Int[len]
    var i = 0
    while (i < len) {
        chars[i] = b[off + 8 + i]
        i = i + 1
    }
    return GgufBinStr(len, chars)
}

// byte → String com decode UTF-8 (ASCII 1B, cont 2B/3B/4B). O Kof
// String é UTF-16; o vocab SPM tem ▁ (E2 96 81) e <0xXX> ASCII.
fn kofGgufStr(Int[] b, Int off): String {
    var s = ""
    var st = kofGgufReadStr(b, off)
    var i = 0
    while (i < st.len) {
        var c = st.chars[i]
        var cp = 0
        if (c < 0x80) {
            cp = c
        } else if (c >= 0xC0 && c < 0xE0 && i + 1 < st.len) {
            cp = (c - 0xC0) * 64 + (st.chars[i + 1] - 0x80)
            i = i + 1
        } else if (c >= 0xE0 && c < 0xF0 && i + 2 < st.len) {
            cp = (c - 0xE0) * 4096 + (st.chars[i + 1] - 0x80) * 64 + (st.chars[i + 2] - 0x80)
            i = i + 2
        } else if (c >= 0xF0 && i + 3 < st.len) {
            cp = (c - 0xF0) * 262144 + (st.chars[i + 1] - 0x80) * 4096 + (st.chars[i + 2] - 0x80) * 64 + (st.chars[i + 3] - 0x80)
            i = i + 3
        } else {
            cp = 0xFFFD
        }
        s = s + String.valueOf(cp as Char)
        i = i + 1
    }
    return s
}

// bytes que ESTE kv consome na janela (aprox p/ array de strings: soma real)
// bytes que o VALOR deste kv consome (pVal = offset APÓS o u32 do kind).
// Retorna NEGATIVO se a janela é pequena demais (qualquer leitura truncada —
// sinal p/ o driver dobrar a janela antes de confiar no valor)
fn kofGgufKvNeed(Int[] buf, Int pVal, Int kind): Int {
    if (pVal + 8 > buf.length) { return 0 - 1 }
    if (kind == 8) {
        var vs = kofGgufReadStr(buf, pVal)
        if (pVal + 8 + vs.len > buf.length && vs.len == kofGgufStrAvail(buf, pVal)) {
            return 0 - 1
        }
        return pVal + 8 + vs.len
    }
    if (kind == 9) {
        if (pVal + 12 > buf.length) { return 0 - 1 }
        var etype = kofGgufU32(buf, pVal)
        var elen = kofGgufU64Low(buf, pVal + 4)
        var q = pVal + 12
        if (etype == 8) {
            var si = 0
            while (si < elen) {
                if (q + 8 > buf.length) { return 0 - 1 }
                var sst = kofGgufReadStr(buf, q)
                if (q + 8 + sst.len >= buf.length && sst.len == kofGgufStrAvail(buf, q)) {
                    return 0 - 1
                }
                q = q + 8 + sst.len
                si = si + 1
            }
            return q
        }
        var total = q + kofGgufArrayElemSize(etype) * elen
        if (total > buf.length) { return 0 - 1 }
        return total
    }
    var need = pVal + kofGgufArrayElemSize(kind)
    if (need > buf.length) { return 0 - 1 }
    return need
}

fn kofGgufArrayElemSize(Int kind): Int {
    if (kind == 0 || kind == 1 || kind == 7) { return 1 }   // u8/i8/bool
    if (kind == 2 || kind == 3) { return 2 }                 // u16/i16
    if (kind == 4 || kind == 5 || kind == 6) { return 4 }    // u32/i32/f32
    if (kind == 10 || kind == 11 || kind == 12) { return 8 } // u64/i64/f64
    return 0
}

// ── parser do header + metadata kv + tensor directory ───────────────────
// Lê em janelas de 4KB (o header do TinyLlama tem ~2KB de kvs).
kofGgufBinOpen(String path): KofGgufBinModel {
    var f = File(path)
    if (!f.exists() || !f.isFile()) {
        return KofGgufBinModel(KofGgufBinHeader(0, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_FILE", 0)
    }
    var head = f.readRange(0, 24)
    if (head == null || head.length < 24) {
        return KofGgufBinModel(KofGgufBinHeader(0, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_READ", 0)
    }
    var magic = kofGgufU32(head, 0)
    if (magic != 1179993927) { // "GGUF" LE
        return KofGgufBinModel(KofGgufBinHeader(0, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_MAGIC", 0)
    }
    var version = kofGgufU32(head, 4)
    if (version != 2 && version != 3) {
        return KofGgufBinModel(KofGgufBinHeader(version, 0, 0, 0), listOf<KofGgufBinKv>(),
            listOf<KofGgufBinTensor>(), 1, "E_VERSION", 0)
    }
    var tensorCount = kofGgufU64Low(head, 8)
    var kvCount = kofGgufU64Low(head, 16)
    var kv = listOf<KofGgufBinKv>()
    var align = 32
    var pos: Long = 24
    var win: Long = 4096
    var i = 0
    while (i < kvCount) {
        // janela dinâmica: o vocab de strings (tokenizer.ggml.tokens) passa
        // de 500KB — dobra a leitura enquanto o parse cruzar o fim do buffer
        var buf = f.readRange(pos, win)
        var st = kofGgufReadStr(buf, 0)
        var p0 = 8 + st.len
        var kind0 = kofGgufU32(buf, p0)
        var need = kofGgufKvNeed(buf, p0 + 4, kind0)
        while (need < 0 && win < 8388608) {
            win = win * 2
            buf = f.readRange(pos, win)
            st = kofGgufReadStr(buf, 0)
            p0 = 8 + st.len
            kind0 = kofGgufU32(buf, p0)
            need = kofGgufKvNeed(buf, p0 + 4, kind0)
        }
        if (need < 0) {
            return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
                kv, listOf<KofGgufBinTensor>(), 1, "E_KVWIN", 0)
        }
        if (buf == null || buf.length < 16) {
            return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
                kv, listOf<KofGgufBinTensor>(), 1, "E_KV", 0)
        }
        var key = kofGgufStr(buf, 0)
        var p = 8 + st.len
        var kind = kind0
        p = p + 4
        var intVal = 0
        var strVal = ""
        if (kind == 4 || kind == 5) {          // u32/i32
            intVal = kofGgufU32(buf, p)
            p = p + 4
        } else if (kind == 10 || kind == 11) { // u64/i64
            intVal = kofGgufU64Low(buf, p)
            p = p + 8
        } else if (kind == 8) {                // string
            var vs = kofGgufReadStr(buf, p)
            strVal = kofGgufStr(buf, p)
            p = p + 8 + vs.len
        } else if (kind == 7) {                // bool
            intVal = buf[p]
            p = p + 1
        } else if (kind == 6) {                // f32 (guarda os bits)
            intVal = kofGgufU32(buf, p)
            p = p + 4
        } else if (kind == 9) {                // array: skip (type u32 + len u64 + elems)
            var etype = kofGgufU32(buf, p)
            var elen = kofGgufU64Low(buf, p + 4)
            p = p + 12
            if (etype == 8) {
                // array de strings: cada elem é u64-len + bytes (tamanho variável)
                var si = 0
                while (si < elen) {
                    var sst = kofGgufReadStr(buf, p)
                    p = p + 8 + sst.len
                    si = si + 1
                }
            } else {
                p = p + kofGgufArrayElemSize(etype) * elen
            }
        } else {
            p = p + kofGgufArrayElemSize(kind)
        }
        if (key == "general.alignment") {
            align = intVal
        }
        kv.add(KofGgufBinKv(key, kind, intVal, strVal))
        pos = pos + p
        i = i + 1
    }
    return ggufBinReadTensorDir(path, version, tensorCount, kvCount, kv, align, pos)
}

// tensor dir: logo após os kvs. Cada entry: name(str) + n_dims u32 +
// dims u64*n + type u32 + offset u64. Janela de 64KB (TinyLlama:
// 201 tensors × ~70B ≈ 14KB — cabe).
fn ggufBinReadTensorDir(String path, Int version, Int tensorCount, Int kvCount,
                        List<KofGgufBinKv> kv, Int align, Long dirStart): KofGgufBinModel {
    var f = File(path)
    var dir = f.readRange(dirStart, 65536)
    if (dir == null || dir.length < 8) {
        return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
            kv, listOf<KofGgufBinTensor>(), 1, "E_DIR", 0)
    }
    var tensors = listOf<KofGgufBinTensor>()
    var p = 0
    var i = 0
    while (i < tensorCount) {
        var st = kofGgufReadStr(dir, p)
        var name = kofGgufStr(dir, p)
        p = p + 8 + st.len
        var nDims = kofGgufU32(dir, p)
        p = p + 4
        var d0 = 1
        var d1 = 1
        var elems = 1
        var j = 0
        while (j < nDims) {
            var dim = kofGgufU64Low(dir, p)
            if (j == 0) { d0 = dim }
            if (j == 1) { d1 = dim }
            elems = elems * dim
            p = p + 8
            j = j + 1
        }
        var quant = kofGgufU32(dir, p)
        p = p + 4
        var offLo = kofGgufU64Low(dir, p)
        var offHi = kofGgufU64High(dir, p)
        p = p + 8
        tensors.add(KofGgufBinTensor(name, nDims, d0, d1, quant, offLo, offHi, elems))
        i = i + 1
    }
    // data começa no fim do dir alinhado
    var dataOff = dirStart + p
    var rem = dataOff % align
    if (rem != 0) {
        dataOff = dataOff + (align - rem)
    }
    return KofGgufBinModel(KofGgufBinHeader(version, tensorCount, kvCount, align),
        kv, tensors, 0, "", dataOff)
}

// ── acesso a tensor ─────────────────────────────────────────────────────
// GGUF quant types: 0 F32, 1 F16, 8 Q8_0 (32→34B), 12 Q4_K (256→144B), 14 Q6_K (256→210B)
fn kofGgufQuantBlockElems(Int quant): Int {
    if (quant == 12) { return 256 }
    if (quant == 14) { return 256 }
    if (quant == 8) { return 32 }
    return 1
}

fn kofGgufQuantBlockSize(Int quant): Int {
    if (quant == 12) { return 144 }
    if (quant == 14) { return 210 }
    if (quant == 8) { return 34 }
    if (quant == 1) { return 2 }
    return 4
}

fn kofGgufQuantName(Int quant): String {
    if (quant == 0) { return "F32" }
    if (quant == 1) { return "F16" }
    if (quant == 8) { return "Q8_0" }
    if (quant == 12) { return "Q4_K" }
    if (quant == 14) { return "Q6_K" }
    return "Q" + quant
}

kofGgufFindTensor(KofGgufBinModel m, String name): KofGgufBinTensor {
    var i = 0
    while (i < m.tensors.size()) {
        var t = m.tensors.get(i)
        if (t.name == name) {
            return t
        }
        i = i + 1
    }
    return null
}

// tensor dataOffset absoluto (t.offset é relativo ao início do data section)
fn kofGgufTensorAbsOff(KofGgufBinModel m, KofGgufBinTensor t): Long {
    return m.dataOff + t.offsetLo + t.offsetHi * 4294967296
}

// bytes totais do tensor
fn kofGgufTensorBytes(KofGgufBinTensor t): Int {
    if (t.quant == 1) { return t.nElems * 2 }
    if (t.quant == 0) { return t.nElems * 4 }
    return t.nElems / kofGgufQuantBlockElems(t.quant) * kofGgufQuantBlockSize(t.quant)
}

// ── dequantização Q4_K (formato ggml REAL) ──────────────────────────────
// Bloco de 256 elems = 144 bytes: f16 d + f16 dmin + scales[12] + qs[128]
// get_scale_min_k4(j, q, &d, &m):
//   j<4:  d = q[j] & 63;                    m = q[j+4] & 63
//   j>=4: d = (q[j+4] & 0xF)|((q[j-4]>>6)<<4); m = (q[j+4]>>4)|((q[j]>>6)<<4)
// dequant: a cada 64 elems (is += 2):
//   d1 = d*sc(is); m1 = dmin*mn(is); d2 = d*sc(is+1); m2 = dmin*mn(is+1)
//   32 low-nibble: y = d1*(q&0xF) - m1
//   32 high-nibble: y = d2*(q>>4) - m2
fn kofGgufK4Sc(Int[] sc, Int j): Int {
    if (j < 4) {
        return sc[j] % 64
    }
    return (sc[j + 4] % 16) + (sc[j - 4] / 64) * 16
}

fn kofGgufK4Mn(Int[] sc, Int j): Int {
    if (j < 4) {
        return sc[j + 4] % 64
    }
    // ggml get_scale_min_k4: *m = (q[j+4] >> 4) | ((q[j] >> 6) << 4)
    return (sc[j + 4] / 16) + (sc[j] / 64) * 16
}

fn kofGgufQ4KDecodeBlock(Int[] b, Int off, Int[] out) {
    var d = f16ToMicro(b[off] + b[off + 1] * 256)
    var dmin = f16ToMicro(b[off + 2] + b[off + 3] * 256)
    var sc = new Int[12]
    var i = 0
    while (i < 12) {
        sc[i] = b[off + 4 + i]
        i = i + 1
    }
    var qs = off + 16
    var is = 0
    var outPos = 0
    var chunk = 0
    while (chunk < 4) {
        var sc0 = kofGgufK4Sc(sc, is)
        var mn0 = kofGgufK4Mn(sc, is)
        var sc1 = kofGgufK4Sc(sc, is + 1)
        var mn1 = kofGgufK4Mn(sc, is + 1)
        var d1 = d * sc0
        var m1 = dmin * mn0
        var d2 = d * sc1
        var m2 = dmin * mn1
        var l = 0
        while (l < 32) {
            var oct = b[qs + chunk * 32 + l]
            out[outPos + l] = d1 * (oct % 16) - m1
            out[outPos + 32 + l] = d2 * (oct / 16) - m2
            l = l + 1
        }
        outPos = outPos + 64
        is = is + 2
        chunk = chunk + 1
    }
}

// dequantiza tensor Q4_K inteiro → Int[] (milésimos), em janelas de 512 blocos
kofGgufQ4KDecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) {
        return new Int[0]
    }
    var nBlocks = t.nElems / 256
    var out = new Int[t.nElems]
    var blockBytes = 144
    var winBlocks = 512
    var bi = 0
    var f = File(path)
    var tmp = new Int[256]
    var maxBlocks = maxElems / 256
    while (bi < nBlocks && bi < maxBlocks) {
        var n = winBlocks
        if (bi + n > nBlocks) { n = nBlocks - bi }
        if (bi + n > maxBlocks) { n = maxBlocks - bi }
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + bi * blockBytes, n * blockBytes)
        if (bytes == null) { break }
        var k = 0
        while (k < n) {
            kofGgufQ4KDecodeBlock(bytes, k * blockBytes, tmp)
            var e = 0
            while (e < 256) {
                out[bi * 256 + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        bi = bi + n
    }
    return out
}

// ── dequantização Q6_K (formato ggml REAL) ──────────────────────────────
// Bloco de 256 elems = 210 bytes: f16 d (2B) + ql[128] + qh[64] + sc i8[16]
// q = ((ql&0xF)|((qh>>s)&3)<<4) - 32; y = d * sc[is] * q (sc é int8)
fn kofGgufQ6KDecodeBlock(Int[] b, Int off, Int[] out) {
    // layout block_q6_K (ggml-common.h): ql[128] qh[64] scales[16] d f16 —
    // o d é o ÚLTIMO campo (não o primeiro!)
    var ql = off
    var qh = ql + 128
    var scB = qh + 64
    var d = f16ToMicro(b[off + 208] + b[off + 209] * 256)
    var n = 0
    var outPos = 0
    while (n < 256) {
        var l = 0
        while (l < 32) {
            // ggml dequantize_row_q6_K: q1..q4 extraem 2 bits de qh[l]:
            // shifts 0, 2, 4, 6 (4 quads por byte de qh)
            var qhB = b[qh + l]
            var scIdx = l / 16
            var q1 = (b[ql + l] % 16) + (((qhB / 1) % 4) * 16) - 32
            var q2 = (b[ql + 32 + l] % 16) + (((qhB / 4) % 4) * 16) - 32
            var q3 = (b[ql + l] / 16) + (((qhB / 16) % 4) * 16) - 32
            var q4 = (b[ql + 32 + l] / 16) + (((qhB / 64) % 4) * 16) - 32
            var s0 = b[scB + scIdx]
            var s1 = b[scB + scIdx + 2]
            var s2 = b[scB + scIdx + 4]
            var s3 = b[scB + scIdx + 6]
            if (s0 > 127) { s0 = s0 - 256 }
            if (s1 > 127) { s1 = s1 - 256 }
            if (s2 > 127) { s2 = s2 - 256 }
            if (s3 > 127) { s3 = s3 - 256 }
            out[outPos + l] = d * s0 * q1
            out[outPos + 32 + l] = d * s1 * q2
            out[outPos + 64 + l] = d * s2 * q3
            out[outPos + 96 + l] = d * s3 * q4
            l = l + 1
        }
        outPos = outPos + 128
        ql = ql + 64
        qh = qh + 32
        scB = scB + 8
        n = n + 128
    }
}

kofGgufQ6KDecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) {
        return new Int[0]
    }
    var nBlocks = t.nElems / 256
    var out = new Int[t.nElems]
    var blockBytes = 210
    var winBlocks = 512
    var bi = 0
    var f = File(path)
    var tmp = new Int[256]
    var maxBlocks = maxElems / 256
    while (bi < nBlocks && bi < maxBlocks) {
        var n = winBlocks
        if (bi + n > nBlocks) { n = nBlocks - bi }
        if (bi + n > maxBlocks) { n = maxBlocks - bi }
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + bi * blockBytes, n * blockBytes)
        if (bytes == null) { break }
        var k = 0
        while (k < n) {
            kofGgufQ6KDecodeBlock(bytes, k * blockBytes, tmp)
            var e = 0
            while (e < 256) {
                out[bi * 256 + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        bi = bi + n
    }
    return out
}

// ── F16 direto ──────────────────────────────────────────────────────────
kofGgufF16DecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) {
        return new Int[0]
    }
    var total = t.nElems
    if (total > maxElems) { total = maxElems }
    var f = File(path)
    var bytes = f.readRange(kofGgufTensorAbsOff(m, t), total * 2)
    if (bytes == null) { return new Int[0] }
    var out = new Int[total]
    var i = 0
    while (i < total) {
        out[i] = f16ToMicro(bytes[i * 2] + bytes[i * 2 + 1] * 256)
        i = i + 1
    }
    return out
}

// dispatch pelo quant do tensor
kofGgufDecodeTensor(String path, KofGgufBinModel m, String name, Int maxElems): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    if (t.quant == 12) { return kofGgufQ4KDecodeTensor(path, m, name, maxElems) }
    if (t.quant == 14) { return kofGgufQ6KDecodeTensor(path, m, name, maxElems) }
    if (t.quant == 1) { return kofGgufF16DecodeTensor(path, m, name, maxElems) }
    return new Int[0]
}

// ── dequantização por LINHAS (p/ matmul on-the-fly no forward M34) ─────
// dequantiza nRows linhas de embd elementos começando em rowStart.
// Cada linha Q4_K = embd/256 blocos × 144B. Retorna Int[ nRows*embd ] micro.
kofGgufQ4KDecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
                Int nRows, Int embd): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    var blocksPerRow = embd / 256
    var out = new Int[nRows * embd]
    var f = File(path)
    var tmp = new Int[256]
    var r = 0
    while (r < nRows) {
        var block0 = (rowStart + r) * blocksPerRow
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 144,
                                blocksPerRow * 144)
        if (bytes == null) { return out }
        var k = 0
        while (k < blocksPerRow) {
            kofGgufQ4KDecodeBlock(bytes, k * 144, tmp)
            var e = 0
            while (e < 256) {
                out[r * embd + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        r = r + 1
    }
    return out
}

// idem Q6_K (210B por bloco)
kofGgufQ6KDecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
                Int nRows, Int embd): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    var blocksPerRow = embd / 256
    var out = new Int[nRows * embd]
    var f = File(path)
    var tmp = new Int[256]
    var r = 0
    while (r < nRows) {
        var block0 = (rowStart + r) * blocksPerRow
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 210,
                                blocksPerRow * 210)
        if (bytes == null) { return out }
        var k = 0
        while (k < blocksPerRow) {
            kofGgufQ6KDecodeBlock(bytes, k * 210, tmp)
            var e = 0
            while (e < 256) {
                out[r * embd + k * 256 + e] = tmp[e]
                e = e + 1
            }
            k = k + 1
        }
        r = r + 1
    }
    return out
}

// dispatch por linhas
kofGgufDecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
             Int nRows, Int embd): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    if (t.quant == 12) { return kofGgufQ4KDecodeRows(path, m, name, rowStart, nRows, embd) }
    if (t.quant == 14) { return kofGgufQ6KDecodeRows(path, m, name, rowStart, nRows, embd) }
    if (t.quant == 1) {
        var t2 = kofGgufFindTensor(m, name)
        var out = new Int[nRows * embd]
        var f = File(path)
        var bytes = f.readRange(kofGgufTensorAbsOff(m, t2) + rowStart * embd * 2, nRows * embd * 2)
        if (bytes == null) { return out }
        var i = 0
        while (i < nRows * embd) {
            out[i] = f16ToMicro(bytes[i * 2] + bytes[i * 2 + 1] * 256)
            i = i + 1
        }
        return out
    }
    return new Int[0]
}

// ── decoders NANO (pesos p/ matmul do forward M34; estados ficam MICRO) ─
// bloco Q4_K → nano em Long[256]
fn kofGgufQ4KDecodeBlockN(Int[] b, Int off, Long[] out) {
    var d: Long = f16ToNano(b[off] + b[off + 1] * 256)
    var dmin: Long = f16ToNano(b[off + 2] + b[off + 3] * 256)
    var sc = new Int[12]
    var i = 0
    while (i < 12) {
        sc[i] = b[off + 4 + i]
        i = i + 1
    }
    var qs = off + 16
    var is = 0
    var outPos = 0
    var chunk = 0
    while (chunk < 4) {
        var sc0 = kofGgufK4Sc(sc, is)
        var mn0 = kofGgufK4Mn(sc, is)
        var sc1 = kofGgufK4Sc(sc, is + 1)
        var mn1 = kofGgufK4Mn(sc, is + 1)
        var d1 = d * sc0
        var m1 = dmin * mn0
        var d2 = d * sc1
        var m2 = dmin * mn1
        var l = 0
        while (l < 32) {
            var oct = b[qs + chunk * 32 + l]
            out[outPos + l] = d1 * (oct % 16) - m1
            out[outPos + 32 + l] = d2 * (oct / 16) - m2
            l = l + 1
        }
        outPos = outPos + 64
        is = is + 2
        chunk = chunk + 1
    }
}

// bloco Q6_K → nano em Long[256]
fn kofGgufQ6KDecodeBlockN(Int[] b, Int off, Long[] out) {
    var ql = off
    var qh = ql + 128
    var scB = qh + 64
    var d: Long = f16ToNano(b[off + 208] + b[off + 209] * 256)
    var n = 0
    var outPos = 0
    while (n < 256) {
        var l = 0
        while (l < 32) {
            var qhB = b[qh + l]
            var scIdx = l / 16
            var q1 = (b[ql + l] % 16) + (((qhB / 1) % 4) * 16) - 32
            var q2 = (b[ql + 32 + l] % 16) + (((qhB / 4) % 4) * 16) - 32
            var q3 = (b[ql + l] / 16) + (((qhB / 16) % 4) * 16) - 32
            var q4 = (b[ql + 32 + l] / 16) + (((qhB / 64) % 4) * 16) - 32
            var s0 = b[scB + scIdx]
            var s1 = b[scB + scIdx + 2]
            var s2 = b[scB + scIdx + 4]
            var s3 = b[scB + scIdx + 6]
            if (s0 > 127) { s0 = s0 - 256 }
            if (s1 > 127) { s1 = s1 - 256 }
            if (s2 > 127) { s2 = s2 - 256 }
            if (s3 > 127) { s3 = s3 - 256 }
            out[outPos + l] = d * s0 * q1
            out[outPos + 32 + l] = d * s1 * q2
            out[outPos + 64 + l] = d * s2 * q3
            out[outPos + 96 + l] = d * s3 * q4
            l = l + 1
        }
        outPos = outPos + 128
        ql = ql + 64
        qh = qh + 32
        scB = scB + 8
        n = n + 128
    }
}

// nRows linhas de um tensor quantizado → Long[] NANO (novo; p/ matvec)
kofGgufDecodeRowsN(String path, KofGgufBinModel m, String name, Int rowStart,
              Int nRows, Int kdim): Long[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Long[0] }
    var out = new Long[nRows * kdim]
    var f = File(path)
    var tmp = new Long[256]
    if (t.quant == 12) {
        var blocksPerRow = kdim / 256
        var r = 0
        while (r < nRows) {
            var block0 = (rowStart + r) * blocksPerRow
            var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 144, blocksPerRow * 144)
            if (bytes == null) { return out }
            var k = 0
            while (k < blocksPerRow) {
                kofGgufQ4KDecodeBlockN(bytes, k * 144, tmp)
                var e = 0
                while (e < 256) {
                    out[r * kdim + k * 256 + e] = tmp[e]
                    e = e + 1
                }
                k = k + 1
            }
            r = r + 1
        }
        return out
    }
    if (t.quant == 14) {
        var blocksPerRow = kdim / 256
        var r = 0
        while (r < nRows) {
            var block0 = (rowStart + r) * blocksPerRow
            var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + block0 * 210, blocksPerRow * 210)
            if (bytes == null) { return out }
            var k = 0
            while (k < blocksPerRow) {
                kofGgufQ6KDecodeBlockN(bytes, k * 210, tmp)
                var e = 0
                while (e < 256) {
                    out[r * kdim + k * 256 + e] = tmp[e]
                    e = e + 1
                }
                k = k + 1
            }
            r = r + 1
        }
        return out
    }
    return out
}

// ── F32 direto (norms do TinyLlama são F32) ────────────────────────────
kofGgufF32DecodeRows(String path, KofGgufBinModel m, String name, Int rowStart,
                Int nRows, Int k): Int[] {
    var t = kofGgufFindTensor(m, name)
    if (t == null) { return new Int[0] }
    var out = new Int[nRows * k]
    var f = File(path)
    var bytes = f.readRange(kofGgufTensorAbsOff(m, t) + rowStart * k * 4, nRows * k * 4)
    if (bytes == null) { return out }
    var i = 0
    while (i < nRows * k) {
        var bits: Long = bytes[i * 4] + bytes[i * 4 + 1] * 256
            + bytes[i * 4 + 2] * 65536 + bytes[i * 4 + 3] * 16777216
        out[i] = f32ToMicro(bits)
        i = i + 1
    }
    return out
}

// f32 bits → micro (1e-6). IEEE754: sign 1, exp 8 (bias 127), man 23
// f32 → MICRO em Long (sem clamp — p/ SPM scores que chegam a -29613)
fn f32ToMicroLong(Long bits): Long {
    var sign = 0
    if (bits < 0) { sign = 1; bits = bits + 2147483648 }
    var exp = (bits / 8388608) % 256
    var man = bits % 8388608
    if (exp == 255) { return 0 }
    if (exp == 0 && man == 0) { return 0 }
    var mant = 8388608 + man
    var e = exp - 127
    var micro: Long = mant * 1000000 / 8388608
    if (e >= 0) {
        var k2 = 0
        while (k2 < e) { micro = micro * 2; k2 = k2 + 1 }
    } else {
        var k3 = 0
        while (k3 < 0 - e) { micro = micro / 2; k3 = k3 + 1 }
    }
    if (sign == 1) { micro = 0 - micro }
    return micro
}

fn f32ToMicro(Long bits): Int {
    var sign = 0
    if (bits < 0) { sign = 1; bits = bits + 2147483648 }
    var exp = (bits / 8388608) % 256
    var man = bits % 8388608
    if (exp == 255) { return 0 }
    if (exp == 0 && man == 0) { return 0 }
    var mant = 8388608 + man
    var e = exp - 127
    var micro = mant * 1000000 / 8388608
    if (e >= 0) {
        var k2 = 0
        while (k2 < e) { micro = micro * 2; k2 = k2 + 1 }
    } else {
        var k3 = 0
        while (k3 < 0 - e) { micro = micro / 2; k3 = k3 + 1 }
    }
    if (sign == 1) { micro = 0 - micro }
    if (micro > 2000000000) { return 2000000000 }
    if (micro < 0 - 2000000000) { return 0 - 2000000000 }
    var outv: Int = micro as Int
    return outv
}

// ── smoke de validação ──────────────────────────────────────────────────
// Abre o GGUF, imprime arquitetura, dequantiza os primeiros valores de
// token_embd — números plausíveis (|v| < ~500000 mili, mix de sinais)
// provam parse + dequant.
ggufBinSmoke(String path): String {
    var m = kofGgufBinOpen(path)
    if (m.errorCount > 0) {
        return "ERR " + m.errorCode
    }
    var arch = ""
    var nLayers = 0
    var nHead = 0
    var nKvHead = 0
    var embd = 0
    var vocab = 0
    var i = 0
    while (i < m.kv.size()) {
        var kv = m.kv.get(i)
        if (kv.key == "general.architecture") { arch = kv.strVal }
        if (kv.key == "llama.block_count") { nLayers = kv.intVal }
        if (kv.key == "llama.attention.head_count") { nHead = kv.intVal }
        if (kv.key == "llama.attention.head_count_kv") { nKvHead = kv.intVal }
        if (kv.key == "llama.embedding_length") { embd = kv.intVal }
        if (kv.key == "llama.vocab_size") { vocab = kv.intVal }
        i = i + 1
    }
    var report = arch + " layers=" + nLayers + " heads=" + nHead
    report = report + " kvheads=" + nKvHead + " embd=" + embd + " vocab=" + vocab
    report = report + " tensors=" + m.tensors.size() + " align=" + m.header.alignment
    var emb = kofGgufQ4KDecodeTensor(path, m, "token_embd.weight", 8192)
    var sum = 0
    var absmax = 0
    var neg = 0
    i = 0
    while (i < emb.length) {
        var v = emb[i]
        if (v < 0) {
            neg = neg + 1
            v = 0 - v
        }
        sum = sum + emb[i]
        if (v > absmax) { absmax = v }
        i = i + 1
    }
    report = report + " embd_sum=" + sum + " absmax=" + absmax + " neg=" + neg
    if (absmax == 0 || absmax > 500000000 || neg == 0 || neg == emb.length) {
        report = report + " DEQUANT-SUSPECT"
    }
    return report
}
