test "memory put get" {
    var m = MemoryLayer(FixedClock(100))
    m.put("k1", "session", "v1", 0)
    assert(m.get("k1") == "v1")
}

test "cite finds by seq" {
    var cv = ConversationEngine(FixedClock(1))
    cv.add("user", "encontrada")
    assert(cv.cite(1).contains("encontrada"))
    assert(cv.cite(999) == "")
}
main() {
}
