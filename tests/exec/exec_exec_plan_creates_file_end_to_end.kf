mkCtxGrant(): ToolCtx {
    var c = ToolCtx(freshBus(), FixedClock(10))
    c.grant(PERM_FS_WRITE())
    return c
}

mkCtx(): ToolCtx {
    return ToolCtx(freshBus(), FixedClock(10))
}

mkExec(): ToolCtx {
    var c = mkCtxGrant()
    c.wsi = WorkspaceIndex("build/tt_exec", c.bus, FixedClock(2))
    return c
}

test "exec plan creates file end to end" {
    var plan0 = ExecutionPlan()
    plan0.id = "p-ok"
    plan0.intent = "CreateWebsite"
    plan0.strategy = "Web"
    plTask(plan0.tasks, "p-ok", 1, "CreateDir", "fs.mkdir", "build/tt_exec/dir1", "", "", "dir-exists")
    plTask(plan0.tasks, "p-ok", 2, "CreateFile", "fs.write", "build/tt_exec/dir1/main.kf", "main() {\n}\n", "p-ok-t1", "file-exists")
    var r = exExecutePlan(defaultRegistry(), mkExec(), plan0, 0)
    assert(r.ok)
    assert(r.executed == 2)
    assert(File("build/tt_exec/dir1/main.kf").readText().contains("main"))
}
main() {
}
