test "tool started and finished events fire" {
    mkFile("build/tt/e1.txt", "x\n")
    var rec = RecordingHandler()
    var bus = freshBus()
    bus.subscribe("tool.started", rec)
    bus.subscribe("tool.finished", rec)
    var c = ToolCtx(bus, FixedClock(3))
    toolExec(defaultRegistry(), c, ToolCall("fs.read", "m1", "build/tt/e1.txt", "", 0))
    assert(rec.seen.size == 2)
}

test "failed event on unknown tool" {
    var rec = RecordingHandler()
    var bus = freshBus()
    bus.subscribe("tool.failed", rec)
    var c = ToolCtx(bus, FixedClock(3))
    var r = toolExec(defaultRegistry(), c, ToolCall("nao.existe", "m2", "", "", 0))
    assert(r.status == "error")
    assert(rec.seen.size == 1)
}
main() {
}
