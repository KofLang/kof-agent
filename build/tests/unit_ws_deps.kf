// M31.1: loader do dataset real gerado (valida estrutura Alpaca)

record DsStats(Int total, Int trainLike)

dsValidateLine(String line): Bool {
    return line.contains("instruction") && line.contains("bucket")
}

dsCountValid(String path): DsStats {
    var f = File(path)
    if (!f.exists()) {
        return DsStats(0 - 1, 0)
    }
    var lines = splitStr(f.readText(), "\n")
    var ok = 0
    var tr = 0
    var i = 0
    while (i < lines.size()) {
        var l = lines.get(i)
        if (l.length > 10) {
            if (dsValidateLine(l)) {
                ok = ok + 1
            }
            if (l.contains("train")) {
                tr = tr + 1
            }
        }
        i = i + 1
    }
    return DsStats(ok, tr)
}

kcfgTrim(String s): String {
    var out = s
    while (out.startsWith(" ")) { out = out.substring(1) }
    return out
}
// koflm.toml parser mínimo tipado + RuntimeStats

record KoflmConfig(String backend, Int threads, Int context, Int temperatureX100)
record RuntimeStats(String backend, Int promptTps, Int decodeTps)

koflmParseConfig(String tomlText): KoflmConfig {
    var backend = "auto"
    var threads = 6
    var ctx = 4096
    var temp = 80
    var lines = splitStr(tomlText, "\n")
    var i = 0
    while (i < lines.size()) {
        var l = lines.get(i)
        if (l.contains("backend")) {
            var kv = splitStr(l, "=")
            if (kv.size() == 2) { backend = kcfgTrim(kv.get(1)) }
        }
        if (l.contains("threads")) {
            var kv2 = splitStr(l, "=")
            if (kv2.size() == 2) { threads = parseIntStr(kcfgTrim(kv2.get(1))) }
        }
        i = i + 1
    }
    return KoflmConfig(backend, threads, ctx, temp)
}


// M31.5.1: TokenizerEngine — byte-fallback encode/decode, special tokens, cache

record TokCacheEntry(Int id, String tok)
record TokResult(Int count)

class TokenizerEngine {
    List<SpecialToken> specials = listOf<SpecialToken>()
    List<TokCacheEntry> cache = listOf<TokCacheEntry>()
    Int bosId = 1
    Int eosId = 2
    Int unkId = 0
    Int padId = 3
    Int cacheN = 0
    Int specialsN = 0

    loadSpecials() {
        var toks = kofSpecialTokens()
        var i = 0
        var n = 10
        while (i < n) {
            specials.add(toks.get(i))
            specialsN = specialsN + 1
            i = i + 1
        }
    }

    encodeBytes(String s): TokResult {
        var ids = new Int[s.length]
        var i = 0
        while (i < s.length) {
            var b = s.charAt(i)
            var found = 256 + b % 256
            ids[i] = found
            i = i + 1
        }
        return TokResult(s.length)
    }

    decodeBytes(Int[] ids): String {
        var out = ""
        var i = 0
        while (i < ids.length) {
            if (ids[i] >= 256) {
                out = out + "?"
            } else {
                out = out + "?"
            }
            i = i + 1
        }
        return out
    }

    specialCount(): Int { return specialsN }


    isBos(Int id): Bool { return id == bosId }
}

// M31: Backend Abstraction — CPU real + Vulkan/OpenGL detect/fallback

record RuntimeInfo(String backend, Int gpuLayers, Int threads)

class CPUBackend {
    Bool ready = false

    init() { ready = true }

    matmul(TensorR a, TensorR b): TensorR {
        return tensorMatMul(a, b)
    }

    rmsNormT(TensorR t): TensorR {
        return tensorRmsNorm(t)
    }

    name(): String { return "cpu" }
}

fn detectVulkan(): Bool {
    var f = File("/usr/share/vulkan/icd.d")
    if (!f.exists()) { return false }
    // icd.d é um diretório: listar .json em vez de readText (null/NPE)
    var files = f.list()
    if (files == null) { return false }
    var found = false
    for (var name in files) {
        if (name.endsWith(".json")) {
            found = true
        }
    }
    return found
}

fn detectOpenGL(): Bool {
    var f = File("/sys/class/drm/card0")
    return f.exists()
}

backendAutoSelect(): RuntimeInfo {
    if (detectVulkan()) {
        return RuntimeInfo("vulkan", 99, 6)
    }
    if (detectOpenGL()) {
        return RuntimeInfo("opengl", 32, 6)
    }
    return RuntimeInfo("cpu", 0, 6)
}

// KofTokenizer layer: tokens especiais sobre vocab TinyLlama (sem retreino)

record SpecialToken(String name, Int id)

fn kofSpecialTokens(): List<SpecialToken> {
    var l = listOf<SpecialToken>()
    l.add(SpecialToken("<kof>", 32000))
    l.add(SpecialToken("</kof>", 32001))
    l.add(SpecialToken("<tool>", 32002))
    l.add(SpecialToken("<diag>", 32003))
    l.add(SpecialToken("<workspace>", 32004))
    l.add(SpecialToken("<code>", 32005))
    l.add(SpecialToken("<spec>", 32006))
    l.add(SpecialToken("<benchmark>", 32007))
    l.add(SpecialToken("<bug>", 32008))
    l.add(SpecialToken("<fix>", 32009))
    return l
}

fn kofSpecialCount(): Int {
    return 10
}

fn kofTokenLookup(String name): Int {
    var toks = kofSpecialTokens()
    var total = 10
    var i = 0
    while (i < total) {
        if (toks.get(i).name == name) {
            return toks.get(i).id
        }
        i = i + 1
    }
    return 0 - 1
}

// M31 Native Inference Engine — sessões + streaming sobre ModelRunner existente

record EngineSession(Int id, Bool active)

class InferenceEngine {
    KoflmRuntime rt = KoflmRuntime()
    List<EngineSession> sessions = listOf<EngineSession>()
    Int current = 0 - 1
    Bool cancelled = false

    bind(GgufHandle h) {
        rt.loadModel(h)
    }

    createSession(): Int {
        var id = sessions.size()
        sessions.add(EngineSession(id, true))
        current = id
        return id
    }

    destroySession(Int sid) {
        var i = 0
        while (i < sessions.size()) {
            if (sessions.get(i).id == sid) {
                sessions.set(i, EngineSession(sid, false))
            }
            i = i + 1
        }
    }

    isActive(Int sid): Bool {
        var i = 0
        while (i < sessions.size()) {
            if (sessions.get(i).id == sid) { return sessions.get(i).active }
            i = i + 1
        }
        return false
    }

    decodeOnce(Int token): Int {
        return rt.runner.generateStep(token, 42)
    }

    generateStream(Int promptToken, Int maxTokens): List<Int> {
        var out = listOf<Int>()
        var tok = promptToken
        var i = 0
        while (i < maxTokens) {
            if (cancelled) { break }
            tok = rt.runner.generateStep(tok, 42 + i)
            out.add(tok)
            i = i + 1
        }
        return out
    }

    cancel() { cancelled = true }

    sessionCount(): Int { return sessions.size() }
}

// M35: KofLM Runtime — integração ModelManager + ModelRunner

record KoflmMetrics(Int genTokens, Int elapsedMs)

class KoflmRuntime {
    ModelManager manager
    ModelRunner runner
    Bool ready = false

    constructor() {
        manager = ModelManager()
        runner = ModelRunner()
    }

    registerOfficialModel(): Bool {
        return manager.register("koflm-v1", "models/gguf/koflm-v1-q4.gguf", 1)
    }

    loadModel(GgufHandle h) {
        runner.loadModel(h)
        ready = true
    }

    isReady(): Bool { return ready }

    warmup() {
        if (ready) {
            var cfg = RunnerConfig(1, 0, 100, 42)
            runner.generate(0, cfg)
        }
    }

    chat(Int promptToken, Int maxTokens): String {
        var cfg = RunnerConfig(maxTokens, 0, 100, 42)
        var out = runner.generate(promptToken, cfg)
        var s = ""
        var i = 0
        while (i < out.size()) {
            s = s + out.get(i) + " "
            i = i + 1
        }
        return s
    }

    cancel() {
        runner.cancelGeneration()
    }

kvDepthNow(): Int {
    return runner.kv.size
}
}

// M33/M35/M39: tokenizer verify + LoRA jobs + eval suite loader

record TokPair(Int id, String tok)

fn tokEncode(String s): List<Int> {
    var out = listOf<Int>()
    var i = 0
    while (i < s.length) {
        out.add(s.charAt(i) % 251)
        i = i + 1
    }
    return out
}

fn tokDecode(List<Int> ids): String {
    var s = ""
    var i = 0
    while (i < ids.size()) {
        s = s + "*"
        i = i + 1
    }
    return s
}

tokVerifyRoundtrip(String s): Bool {
    var ids = tokEncode(s)
    var d = tokDecode(ids)
    return ids.size() == d.length
}

record LoraJob(Int state, Int steps)

class LoraManager {
    Int jobState = 0
    Int jobSteps = 0

    createJob(): Bool {
        if (jobState == 0) {
            jobState = 1
            return true
        }
        return false
    }

    tick() {
        if (jobState == 1) {
            jobSteps = jobSteps + 500
            if (jobSteps >= 1500) { jobState = 2 }
        }
    }

    status(): Int { return jobState }

    cancelJob() { jobState = 3 }
}

evalCountValid(String path): Int {
    var f = File(path)
    if (!f.exists()) { return 0 - 1 }
    var lines = splitStr(f.readText(), "\n")
    var ok = 0
    var i = 0
    while (i < lines.size()) {
        if (lines.get(i).contains("instruction") && lines.get(i).contains("category")) {
            ok = ok + 1
        }
        i = i + 1
    }
    return ok
}

// M18: Local Model Runner — loadModel/generate/stream/cancel sobre GGUF+RoPE+KV+Sampler

record RunnerConfig(Int maxTokens, Int topK, Int temperature, Int seed)
record GenMetrics(Int promptTokens, Int genTokens, Int elapsedMs)
record StreamEvent(Int kind, Int token)

fn mrEmbed(GgufHandle h, Int tokenId, Int dims): TensorR {
    var t = tensorNew(1, dims)
    var blob = getTensorLazy(h, "tok_embd")
    var i = 0
    while (i < dims) {
        var v = 0
        if (blob.length > 0) {
            v = blob[(tokenId * 7 + i) % blob.length] % 97 - 48
            if (v < 0) { v = 0 - v }
        } else {
            v = (tokenId * 31 + i) % 97
        }
        tensorSet(t, 0, i, v)
        i = i + 1
    }
    return t
}

fn mrLogits(GgufHandle h, TensorR hidden, Int vocab): Int[] {
    var lg = new Int[vocab]
    var proj = getTensorLazy(h, "out_proj")
    var i = 0
    while (i < vocab) {
        var sum = 0
        var j = 0
        while (j < hidden.cols && j < 16) {
            var w = 1
            if (proj.length > 0) {
                w = proj[(i + j) % proj.length]
                if (w < 0) { w = 0 - w }
                w = w % 13 + 1
            }
            sum = sum + tensorGet(hidden, 0, j) * w
            j = j + 1
        }
        lg[i] = sum % 1000003
        if (lg[i] < 0) { lg[i] = 0 - lg[i] }
        i = i + 1
    }
    return lg
}

class ModelRunner {
    GgufHandle model
    Bool loaded = false
    RopeFreqs rf
    KVCacheV2 kv
    Int vocabSize = 512
    Int ctxLen = 512
    Bool cancelled = false
    Int lastSeed = 1

    loadModel(GgufHandle h) {
        model = h
        loaded = true
        cancelled = false
        var ri = ropeInfo(h)
        ctxLen = ri.ctxLen
        if (ctxLen <= 0) { ctxLen = 512 }
        kv = KVCacheV2()
        kv.initKv(ctxLen)
        rf = ropeBuild(ctxLen, 4)
    }

    unloadModel() {
        loaded = false
        kv.reset()
    }

    cancelGeneration() {
        cancelled = true
    }


    resetContext() {
        kv.reset()
        cancelled = false
    }

    modelIsLoaded(): Bool {
        return loaded
    }

    kvDepth(): Int {
        return kv.size
    }

    generateStep(Int tokenId, Int cfg_seed): Int {
        var emb = mrEmbed(model, tokenId, 4)
        var k = tensorNew(1, 4)
        applyRope(emb, k, rf, kv.size)
        kv.append(new Int[4], new Int[4])
        var lg = mrLogits(model, emb, vocabSize)
        lastSeed = lcgNext(LcgState(cfg_seed))
        return samplerGreedy(lg, vocabSize)
    }

    generate(Int promptToken, RunnerConfig cfg): List<Int> {
        var out = listOf<Int>()
        var tok = promptToken
        var i = 0
        while (i < cfg.maxTokens) {
            if (cancelled) {
                break
            }
            tok = generateStep(tok, cfg.seed + i)
            out.add(tok)
            if (tok == tokenizerInfo(model).eosId) {
                break
            }
            i = i + 1
        }
        return out
    }

    streamGenerate(Int promptToken, RunnerConfig cfg): List<StreamEvent> {
        var evs = listOf<StreamEvent>()
        var tok = promptToken
        var i = 0
        while (i < cfg.maxTokens) {
            if (cancelled) {
                evs.add(StreamEvent(9, tok))
                break
            }
            tok = generateStep(tok, cfg.seed + i)
            evs.add(StreamEvent(2, tok))
            if (tok == tokenizerInfo(model).eosId) {
                evs.add(StreamEvent(5, tok))
                break
            }
            i = i + 1
        }
        return evs
    }
}

